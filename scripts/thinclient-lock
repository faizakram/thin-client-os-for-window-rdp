def run_lock_gui():
    """Show the fullscreen lock (GTK). Imported lazily so the set-password CLI
    path never needs a display or the GTK stack."""
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib

    class LockScreen(Gtk.Window):
        def __init__(self):
            super().__init__(type=Gtk.WindowType.TOPLEVEL)
            # unlock | cur | new | confirm | remind | lockedout | adminwait
            self.mode = "unlock"
            self._new_pw = None
            self._was_admin = False     # did this lock session ever see an admin lock?
            self._was_lockout = False   # ...and was that lock a wrong-password lockout?
            self._forced = False        # a new password is REQUIRED before unlocking

            prov = Gtk.CssProvider(); prov.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

            self.set_decorated(False)
            self.get_style_context().add_class("lockroot")
            self.set_position(Gtk.WindowPosition.CENTER_ALWAYS)   # no top-left flash before fullscreen
            self.fullscreen()
            self.set_keep_above(True)
            self.set_skip_taskbar_hint(True)
            self.set_skip_pager_hint(True)
            self.connect("delete-event", lambda *a: True)   # cannot be closed

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            box.set_valign(Gtk.Align.CENTER); box.set_halign(Gtk.Align.CENTER)

            self.clock = Gtk.Label(); self.clock.get_style_context().add_class("lockclock")
            box.pack_start(self.clock, False, False, 0)
            self.datelbl = Gtk.Label(); self.datelbl.get_style_context().add_class("locksub")
            box.pack_start(self.datelbl, False, False, 0)

            self.title_lbl = Gtk.Label(label="Screen locked"); self.title_lbl.get_style_context().add_class("locktitle")
            box.pack_start(self.title_lbl, False, False, 0)
            self.sub_lbl = Gtk.Label(label="Enter your password to unlock"); self.sub_lbl.get_style_context().add_class("locksub")
            box.pack_start(self.sub_lbl, False, False, 0)

            self.entry = Gtk.Entry(); self.entry.set_visibility(False); self.entry.set_placeholder_text("Password")
            self.entry.get_style_context().add_class("lockentry"); self.entry.set_halign(Gtk.Align.CENTER)
            self.entry.connect("activate", self._submit)
            box.pack_start(self.entry, False, False, 0)

            self.err = Gtk.Label(label=""); self.err.get_style_context().add_class("lockerr")
            box.pack_start(self.err, False, False, 0)

            self.btn = Gtk.Button(label="Unlock"); self.btn.get_style_context().add_class("lockbtn")
            self.btn.set_halign(Gtk.Align.CENTER); self.btn.connect("clicked", self._submit)
            box.pack_start(self.btn, False, False, 0)

            self.change_link = Gtk.Button(label="Change password"); self.change_link.set_relief(Gtk.ReliefStyle.NONE)
            self.change_link.get_style_context().add_class("locklink")
            self.change_link.connect("clicked", self._start_change)
            box.pack_start(self.change_link, False, False, 6)

            # --- reaching the administrator (admin lock only) ------------------
            # The chat bubble the operator already uses, with a word beside it. Icon
            # alone would be the more elegant thing on a screen they visit daily —
            # but they land here locked out and wanting help, which is the worst
            # moment to make somebody guess what a symbol does. The bubble gives
            # instant recognition, the label removes the guess.
            self.msg_link = Gtk.Button()
            self.msg_link.set_relief(Gtk.ReliefStyle.NONE)
            self.msg_link.get_style_context().add_class("lockbubblebtn")
            self.msg_link.set_halign(Gtk.Align.CENTER)
            self.msg_link.set_no_show_all(True)          # only ever shown in adminwait
            self.msg_link.connect("clicked", self._open_msg)
            self.msg_link.add(self._build_bubble(Gtk))
            box.pack_start(self.msg_link, False, False, 4)

            self.msg_box = self._build_msg_pane(Gtk)
            self.msg_box.set_no_show_all(True)
            box.pack_start(self.msg_box, False, False, 0)
            self._msg_open = False
            self._msg_stamp = None

            # LAST, once every widget it touches exists.
            #
            # _tick() is not just the clock: when the device is already admin-locked it
            # rewrites the title, the subtitle and the buttons. Running it from the
            # middle of __init__ meant that on a device that was ALREADY locked by an
            # administrator, the very first call hit self.title_lbl before it had been
            # created and killed the lock screen on construction. The boot lock then
            # retried sixty times and fell through to the connect window, so the one
            # screen that should have said "Locked by your administrator" never
            # appeared. Caught by driving the real GTK stack under Xvfb; it had been
            # shipping since at least 1.0.143.
            self._tick(); GLib.timeout_add_seconds(1, self._tick)

            self.add(box)
            self.connect("show", lambda *a: GLib.timeout_add(80, self._grab))

        def _build_bubble(self, Gtk):
            """The launcher's bubble, beside a label. Cairo when it is available,
            and the launcher's own text glyph when it is not — the chat launcher has
            exactly the same fallback, so the two still match on a device without
            pycairo."""
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.set_halign(Gtk.Align.CENTER)
            if HAVE_CAIRO:
                self.bubble = Gtk.DrawingArea()
                self.bubble.set_size_request(BUBBLE_SIZE, BUBBLE_SIZE)
                self.bubble.connect("draw", self._draw_bubble)
                row.pack_start(self.bubble, False, False, 0)
            else:
                self.bubble = None
                glyph = Gtk.Label()
                glyph.set_markup("<span foreground='#ffffff' size='xx-large'>✉</span>")
                glyph.get_style_context().add_class("lockbubblefallback")
                row.pack_start(glyph, False, False, 0)
            lbl = Gtk.Label(label="Message your administrator")
            lbl.get_style_context().add_class("lockbubblelabel")
            row.pack_start(lbl, False, False, 0)
            return row

        def _draw_bubble(self, _w, cr):
            # Kept deliberately identical to thinclient-chat's launcher: same circle,
            # same diagonal gradient, same highlight, hairline ring, speech glyph and
            # unread badge.
            sz = BUBBLE_SIZE
            grad = cairo.LinearGradient(0, 0, sz, sz)
            grad.add_color_stop_rgb(0, BUBBLE_A1[0] / 255, BUBBLE_A1[1] / 255, BUBBLE_A1[2] / 255)
            grad.add_color_stop_rgb(1, BUBBLE_A2[0] / 255, BUBBLE_A2[1] / 255, BUBBLE_A2[2] / 255)
            cr.arc(sz / 2.0, sz / 2.0, sz / 2.0 - 1, 0, 2 * math.pi)
            cr.set_source(grad); cr.fill()
            cr.arc(sz / 2.0, sz / 2.0, sz / 2.0 - 1, math.pi, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, 0.10); cr.fill()
            cr.set_line_width(1.4); cr.set_source_rgba(1, 1, 1, 0.28)
            cr.arc(sz / 2.0, sz / 2.0, sz / 2.0 - 1.4, 0, 2 * math.pi); cr.stroke()
            cr.set_source_rgb(1, 1, 1)
            self._speech(cr, sz / 2.0, sz / 2.0 - 1, sz * 0.42)
            unread = _chat_unread()
            if unread:
                bx, by, br = sz - 11, 11, 9
                cr.set_source_rgb(1, 1, 1); cr.arc(bx, by, br + 1.6, 0, 2 * math.pi); cr.fill()
                cr.set_source_rgb(BUBBLE_BADGE[0] / 255, BUBBLE_BADGE[1] / 255, BUBBLE_BADGE[2] / 255)
                cr.arc(bx, by, br, 0, 2 * math.pi); cr.fill()
                cr.set_source_rgb(1, 1, 1)
                cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(11)
                txt = str(unread) if unread < 10 else "9+"
                ext = cr.text_extents(txt)
                cr.move_to(bx - ext.width / 2 - ext.x_bearing, by - ext.height / 2 - ext.y_bearing)
                cr.show_text(txt)
            return False

        def _speech(self, cr, cx, cy, w):
            h = w * 0.74; x = cx - w / 2.0; y = cy - h / 2.0; r = w * 0.24
            cr.new_sub_path()
            cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
            cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
            cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
            cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
            cr.close_path(); cr.fill()
            cr.move_to(x + w * 0.30, y + h - 1)
            cr.line_to(x + w * 0.12, y + h + h * 0.26)
            cr.line_to(x + w * 0.52, y + h - 1)
            cr.close_path(); cr.fill()

        def _build_msg_pane(self, Gtk):
            """The conversation, the box to type in, and nothing else.

            No attachments, no image viewer, no file chooser — see the note at the
            top of this file. Everything lives in the lock's own window, so the seat
            grab never has to be released and no new window is ever mapped."""
            pane = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            pane.get_style_context().add_class("lockmsg")
            pane.set_halign(Gtk.Align.CENTER)

            title = Gtk.Label(label="Message your administrator")
            title.get_style_context().add_class("lockmsgtitle")
            title.set_halign(Gtk.Align.START)
            pane.pack_start(title, False, False, 0)

            self.msg_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_size_request(420, 200)
            scroller.add(self.msg_list)
            self._msg_scroll = scroller
            pane.pack_start(scroller, False, False, 0)

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            self.msg_entry = Gtk.Entry()
            self.msg_entry.set_placeholder_text("Type a message…")
            self.msg_entry.set_max_length(MSG_MAX)
            self.msg_entry.get_style_context().add_class("lockentry")
            self.msg_entry.connect("activate", self._send_msg)
            row.pack_start(self.msg_entry, True, True, 0)
            send = Gtk.Button(label="Send")
            send.get_style_context().add_class("lockbtn")
            send.connect("clicked", self._send_msg)
            row.pack_start(send, False, False, 0)
            pane.pack_start(row, False, False, 0)

            self.msg_note = Gtk.Label(label="")
            self.msg_note.get_style_context().add_class("lockmsgsent")
            self.msg_note.set_halign(Gtk.Align.START)
            pane.pack_start(self.msg_note, False, False, 0)

            close = Gtk.Button(label="Hide messages")
            close.set_relief(Gtk.ReliefStyle.NONE)
            close.get_style_context().add_class("locklink")
            close.connect("clicked", self._close_msg)
            pane.pack_start(close, False, False, 0)
            return pane

        def _open_msg(self, *_):
            self._msg_open = True
            self.msg_link.hide()
            # The pane is built with no-show-all so the window's own show_all() at
            # startup cannot reveal it on an ordinary lock. That same flag makes
            # show_all() a no-op here, so it has to be lifted before the children
            # will map — otherwise the pane appears empty.
            self.msg_box.set_no_show_all(False)
            self.msg_box.show_all()
            self._render_msgs(force=True)
            self.msg_entry.grab_focus()

        def _close_msg(self, *_):
            self._msg_open = False
            self.msg_box.hide()
            self.msg_box.set_no_show_all(True)
            self.msg_link.set_no_show_all(False)
            self.msg_link.show_all()

        def _send_msg(self, *_):
            body = self.msg_entry.get_text().strip()
            if not body:
                return
            ok = _chat_send(body)
            self.msg_entry.set_text("")
            self.msg_note.set_text(
                "Sent — your administrator will see it in the console."
                if ok else "Couldn't send that. It will work again once the device is back online.")
            self._render_msgs(force=True)
            self.msg_entry.grab_focus()

        def _render_msgs(self, force=False):
            """Redraw only when the conversation actually changed — this runs once a
            second behind a lock screen that may be up for hours."""
            from gi.repository import Gtk, GLib
            hist = _chat_history()
            key = (_chat_stamp(), len(hist))
            if not force and key == self._msg_stamp:
                return
            self._msg_stamp = key
            for child in self.msg_list.get_children():
                self.msg_list.remove(child)
            if not hist:
                empty = Gtk.Label(label="No messages yet. Send one and your administrator will see it.")
                empty.get_style_context().add_class("lockmsgempty")
                empty.set_halign(Gtk.Align.START)
                empty.set_line_wrap(True)
                self.msg_list.pack_start(empty, False, False, 0)
            for who, body in hist:
                item = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                tag = Gtk.Label(label=who.upper())
                tag.get_style_context().add_class("lockmsgwho")
                tag.set_halign(Gtk.Align.START)
                item.pack_start(tag, False, False, 0)
                txt = Gtk.Label(label=body)
                txt.get_style_context().add_class("lockmsgbody")
                if who == "You":
                    txt.get_style_context().add_class("lockmsgmine")
                txt.set_halign(Gtk.Align.START)
                txt.set_line_wrap(True)
                txt.set_max_width_chars(52)
                txt.set_xalign(0.0)
                item.pack_start(txt, False, False, 0)
                self.msg_list.pack_start(item, False, False, 0)
            self.msg_list.show_all()
            # Newest message in view, once GTK has laid the new rows out.
            GLib.idle_add(self._scroll_msgs_to_end)

        def _scroll_msgs_to_end(self):
            try:
                adj = self._msg_scroll.get_vadjustment()
                adj.set_value(max(0, adj.get_upper() - adj.get_page_size()))
            except Exception:
                pass
            return False

        def _tick(self):
            # Local time in the machine's configured timezone (set by the agent
            # from the tenant/device policy). %Z shows the zone (e.g. IST/UTC).
            # Seed TZ from the live /etc/localtime, THEN tzset(): glibc keys its
            # re-read on the TZ string, so with TZ unset tzset() no-ops and this
            # process would stay on whatever zone it first saw (UTC at boot,
            # before the agent applied the policy zone). Setting TZ to the current
            # zone forces the re-read, so the boot lock self-corrects within 1s of
            # the agent applying the zone — and a mid-session change reflects live.
            z = _current_zone()
            if z and os.environ.get("TZ") != z:
                os.environ["TZ"] = z
            try: time.tzset()
            except Exception: pass
            # 12-hour clock (e.g. "2:32 PM"); lstrip drops the leading zero so it
            # reads "9:05 AM" not "09:05 AM". Kept consistent with the connect screen.
            self.clock.set_text(time.strftime("%I:%M %p").lstrip("0"))
            self.datelbl.set_text(time.strftime("%A, %d %B · %Z"))
            # Admin lock: the operator cannot unlock — reflect it live, and auto-
            # dismiss the lock once the manager (or the auto-expiry) clears it.
            lockout = lockout_active()
            if lockout:
                self._was_lockout = True
            if _admin_locked():
                self._was_admin = True
                if self.mode != "adminwait":
                    self.mode = "adminwait"
                    if os.path.exists(WIPED_MARK):
                        self.title_lbl.set_text("This device has been reset")
                        self.sub_lbl.set_text("It was reset for security reasons. Contact your administrator.")
                    elif lockout:
                        # The agent turned a wrong-password lockout into an admin lock;
                        # say WHY it is locked, not "outside your working hours".
                        self.title_lbl.set_text(LOCKOUT_TITLE)
                        self.sub_lbl.set_text(LOCKOUT_SUB)
                    else:
                        self.title_lbl.set_text(
                            "Outside your working hours" if _admin_lock_is_schedule()
                            else "Locked by your administrator")
                        self.sub_lbl.set_text(_admin_lock_sub())
                    self.err.set_text("")
                    # no-show-all as well as hide: the window's show_all() runs AFTER
                    # __init__, so on a device that was already admin-locked a plain
                    # hide() here would be undone a moment later and the operator would
                    # be staring at a password box that cannot work.
                    for w in (self.entry, self.btn, self.change_link):
                        w.set_no_show_all(True); w.hide()
                    # The operator cannot clear this lock, so give them the one thing
                    # they still need: a way to reach whoever set it. Only here — on an
                    # ordinary lock they simply type their password.
                    # show_all(), not show(): show() maps this widget ONLY. The
                    # bubble and its label are children, and with no-show-all set on
                    # the button the window's own show_all() skipped the whole subtree
                    # — so show() left an empty button on screen with no bubble in it.
                    # That shipped in 1.0.146 and is exactly why the icon was missing.
                    self.msg_link.set_no_show_all(False)
                    self.msg_link.show_all()
                if self.bubble is not None:
                    self.bubble.queue_draw()      # keep the unread badge current
                if self._msg_open:
                    # Keep the conversation live, and ask the agent to poll chat
                    # quickly while somebody is actually waiting on a reply.
                    try:
                        open(CHAT_ACTIVE, "w").close()
                    except OSError:
                        pass
                    self._render_msgs()
            elif lockout:
                # Locked out, and the agent has not (yet) raised the admin lock — it is
                # offline, or between polls. The lock screen holds the line on its own.
                if self.mode != "lockedout":
                    self._show_lockout()
            elif self._was_lockout:
                self._restore_unlock()  # lockout lifted by the manager → password again
            elif self._was_admin:
                self._ungrab_quit()   # admin unlocked (or lock auto-expired) → release
            return True

        def _grab(self):
            try:
                seat = self.get_display().get_default_seat()
                st = seat.grab(self.get_window(),
                               Gdk.SeatCapabilities.KEYBOARD | Gdk.SeatCapabilities.POINTER,
                               True, None, None, None, None)
                self.entry.grab_focus()
                return st != Gdk.GrabStatus.SUCCESS   # keep retrying until grabbed
            except Exception:
                return False

        def _ungrab_quit(self):
            try:
                self.get_display().get_default_seat().ungrab()
            except Exception:
                pass
            Gtk.main_quit()

        def _flash(self, msg):
            self.err.set_text(msg)
            self.entry.set_text(""); self.entry.grab_focus()

        def _submit(self, *a):
            pw = self.entry.get_text()
            if self.mode in ("adminwait", "lockedout") or _admin_locked():
                self._flash("You can’t unlock right now — locked by your administrator. Please wait.")
                return
            if self.mode == "remind":
                self._ungrab_quit()                  # "Continue" — change it another time
                return
            if self.mode == "unlock":
                result, detail = attempt_unlock(pw)
                if result == "locked":
                    self._show_lockout()
                elif result == "wrong":
                    self._flash(detail)
                elif result == "change":
                    self._begin_new(detail, forced=True)
                elif result == "remind":
                    self._show_remind(detail)
                else:
                    self._ungrab_quit()
            elif self.mode == "cur":
                result, detail = attempt_current(pw)
                if result == "locked":
                    self._show_lockout()
                elif result == "wrong":
                    self._flash(detail)
                else:
                    self._begin_new("Enter a NEW password", forced=False)
            elif self.mode == "new":
                why = validate_new(pw)
                if why:
                    self._flash(why); return
                self._new_pw = pw; self.mode = "confirm"
                self.sub_lbl.set_text("Re-enter the new password")
                self.entry.set_text(""); self.entry.grab_focus()
            elif self.mode == "confirm":
                if pw == self._new_pw:
                    try:
                        set_password(pw)
                        self._ungrab_quit()          # new password proven -> unlock
                    except Exception as e:
                        self._flash("Could not save: %s" % e)
                else:
                    self.mode = "new"; self._new_pw = None
                    self.sub_lbl.set_text("Didn’t match — enter a NEW password"); self.entry.set_text("")

        def _begin_new(self, reason, forced):
            """Ask for a new password. FORCED (expired, factory default, too weak, or an
            administrator's reset): there is no way back to the desktop until it is set."""
            self._forced = forced
            self.mode = "new"; self._new_pw = None
            self.title_lbl.set_text("Set a new password" if forced else "Change lock password")
            self.sub_lbl.set_text(reason)
            self.err.set_text(""); self.entry.set_text("")
            self.btn.set_label("Next"); self.change_link.hide()
            self.entry.grab_focus()

        def _show_remind(self, days):
            self.mode = "remind"
            self.title_lbl.set_text("Your password expires in %d day%s" % (days, "" if days == 1 else "s"))
            self.sub_lbl.set_text("Change it now, or continue and change it later.")
            self.err.set_text(""); self.entry.set_text("")
            self.entry.hide()
            self.btn.set_label("Continue")
            self.change_link.set_label("Change it now"); self.change_link.show()

        def _show_lockout(self):
            """Too many wrong passwords. Nothing typed here can unlock it any more —
            the agent turns this into an administrator lock and tells the manager. The
            one thing left is the way to reach the administrator."""
            self.mode = "lockedout"; self._was_lockout = True
            self.title_lbl.set_text(LOCKOUT_TITLE)
            self.sub_lbl.set_text(LOCKOUT_SUB)
            self.err.set_text("")
            for w in (self.entry, self.btn, self.change_link):
                w.set_no_show_all(True); w.hide()
            self.msg_link.set_no_show_all(False)
            self.msg_link.show_all()

        def _restore_unlock(self):
            """The administrator lifted a LOCKOUT. Back to the password prompt with a fresh
            set of tries — never straight in. Whoever made the wrong guesses should not be
            handed the desktop because someone asked nicely in the chat; if the operator
            really forgot it, the administrator resets it as well."""
            self.mode = "unlock"; self._was_lockout = False; self._was_admin = False
            self._forced = False
            self.title_lbl.set_text("Screen locked")
            self.sub_lbl.set_text("Unlocked by your administrator — enter your password")
            self.err.set_text("")
            self.btn.set_label("Unlock"); self.change_link.set_label("Change password")
            for w in (self.entry, self.btn, self.change_link):
                w.set_no_show_all(False); w.show()
            self.msg_link.hide(); self.msg_box.hide(); self._msg_open = False
            self.entry.set_text(""); self.entry.grab_focus()

        def _start_change(self, *a):
            if self.mode == "remind":
                self.entry.show()
                self._begin_new("Enter a NEW password", forced=False)
                return
            self.mode = "cur"
            self.title_lbl.set_text("Change lock password")
            self.sub_lbl.set_text("Enter your CURRENT password")
            self.err.set_text(""); self.entry.set_text("")
            self.btn.set_label("Next"); self.change_link.hide()
            self.entry.grab_focus()

    win = LockScreen()
    win.show_all()
    # Re-assert fullscreen after mapping — if the WM wasn't managing yet the lock
    # could otherwise appear as a small box instead of covering the screen.
    win.fullscreen()
    GLib.timeout_add(400, lambda: (win.fullscreen(), False)[1])
    Gtk.main()


def _cli_target(user):
    """Point LOCK_FILE / LOCK_STATE at `user`'s home (the agent runs as root)."""
    import pwd
    global LOCK_FILE, LOCK_STATE
    rec = pwd.getpwnam(user)
    LOCK_FILE = os.path.join(rec.pw_dir, ".thinclient-lock")
    LOCK_STATE = os.path.join(rec.pw_dir, ".thinclient-lock-state.json")
    return rec


def _cli_finish(rec):
    """Hand every file back to the kiosk user, and clear the wrong-guess count — an
    administrator just set the password. A LOCKOUT is deliberately left alone: lifting
    it is a separate decision (Unlock on the device page)."""
    for f in (LOCK_FILE, _meta_path()):
        try:
            os.chown(f, rec.pw_uid, rec.pw_gid)
        except Exception:
            pass
    st = lock_state()
    if st.get("fails") and not st.get("locked_at"):
        try:
            _json_save(LOCK_STATE, {"fails": 0}); os.chown(LOCK_STATE, rec.pw_uid, rec.pw_gid)
        except Exception:
            pass


def _cli_set_password(argv):
    """Older managers send the new password itself. Still accepted; the operator must
    change it at their next unlock, because someone else has seen it."""
    import sys
    user = argv[3] if len(argv) > 3 else (os.environ.get("SUDO_USER") or "thinclient")
    try:
        rec = _cli_target(user)
    except KeyError:
        print("no such user: %s" % user, file=sys.stderr)
        return 2
    set_password(argv[2], must_change=True)
    _cli_finish(rec)
    return 0


def _cli_set_hash(argv):
    """thinclient-lock set-hash SALT:HASH [USER] — an administrator's reset, delivered
    as the salted hash only. The manager computes it with the same PBKDF2 parameters, so
    the plain password is never stored or transmitted; the admin is shown it once."""
    import sys
    rec_text = (argv[2] or "").strip().lower()
    try:
        salt, h = rec_text.split(":", 1)
        bytes.fromhex(salt); bytes.fromhex(h)
        if len(salt) != 16 or len(h) != 64:
            raise ValueError
    except ValueError:
        print("set-hash: expected 16-hex-salt:64-hex-hash", file=sys.stderr)
        return 2
    user = argv[3] if len(argv) > 3 else "thinclient"
    try:
        rec = _cli_target(user)
    except KeyError:
        print("no such user: %s" % user, file=sys.stderr)
        return 2
    prev = None
    try:
        with open(LOCK_FILE) as f:
            prev = f.read().strip() or None
    except OSError:
        pass
    tmp = LOCK_FILE + ".tmp"
    with open(tmp, "w") as f:
        f.write("%s:%s\n" % (salt, h))
    os.chmod(tmp, 0o600)
    os.replace(tmp, LOCK_FILE)
    _record_new_password(LOCK_FILE, prev, must_change=True)
    _cli_finish(rec)
    return 0


def main():
    import sys
    # Headless CLI (no GTK/display): set/reset a user's lock password — used by
    # the agent to apply a tenant admin's remote reset of a forgotten PIN.
    if len(sys.argv) >= 3 and sys.argv[1] == "set-password":
        return _cli_set_password(sys.argv)
    if len(sys.argv) >= 3 and sys.argv[1] == "set-hash":
        return _cli_set_hash(sys.argv)

    # single instance: a second Super+L press must not stack lockers
    try:
        fd = os.open(os.path.expanduser("~/.thinclient-lock.pid"), os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except Exception:
        return 0
    _install_exit_signals()
    _lock_signal(True)
    try:
        run_lock_gui()
    finally:
        _lock_signal(False)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
