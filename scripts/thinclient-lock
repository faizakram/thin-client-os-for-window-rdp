#!/usr/bin/env python3
# =============================================================================
#  ThinClient OS — user screen lock
#  Installed to: /opt/thinclient/bin/thinclient-lock
#
#  Bound to Super+L (Win+L). Covers the screen, grabs keyboard + pointer so the
#  RDP session behind it stays inaccessible, and requires a password to unlock.
#  A simple default password ("0000") ships; the user can change it right on the
#  lock screen, and a tenant admin can reset it remotely (agent -> set-password).
#  Password hashes are per-user PBKDF2 — no admin rights, no plaintext at rest.
#
#  Usage:
#     thinclient-lock                      # lock the screen (GUI)
#     thinclient-lock set-password PW [USER]   # set/reset a user's lock password
#     thinclient-lock set-hash SALT:HASH [USER] # admin reset, hash only (preferred)
# =============================================================================
import fcntl
import hashlib
import json
import hmac
import os
import time

LOCK_FILE = os.path.expanduser("~/.thinclient-lock")
DEFAULT_PW = "0000"
_ITER = 120000
# Shared runtime signal the agent reads to know the screen is locked (feeds the
# activity view + the recording lock overlay/markers).
#
# It carries THIS PROCESS'S PID, and that is the whole point. An empty flag file
# outlives whatever wrote it: systemd SIGTERMs the X session (a watchdog restart,
# an OTA apply, LightDM cycling), Python's default SIGTERM disposition kills us
# outright, the `finally` below never runs — and /run is tmpfs, so the flag then
# sits there claiming "locked" until the next REBOOT. Downstream that is not
# cosmetic: the agent burns "SCREEN LOCKED" into every live frame and recording,
# reports a LOCK with no matching UNLOCK (the operator's whole shift books as
# away-from-desk), and parks the RDP freeze watchdog. With the PID in the file a
# reader can ask the one question that settles it — is that process still alive?
LOCK_SIGNAL = "/run/thinclient/locked"
# When the manager locks a device the agent writes this file. While it exists the
# operator CANNOT unlock — only the manager (or the agent's auto-expiry window)
# clears it. The lock screen watches it: blocks the password unlock + auto-dismisses
# when it clears.
ADMIN_LOCK = os.environ.get("TC_LICENSE_ADMIN_LOCK", "/var/lib/thinclient/license/admin-lock")

# --- Reaching the administrator from an admin lock -----------------------------
#
# An admin lock is the one the operator CANNOT clear. Without a way to reach the
# person who set it, they are stranded at a screen that tells them to wait, with no
# way to say "I'm here" or ask why. The floating chat launcher is no help: it hides
# itself whenever this lock is up, because an override-redirect bubble would float
# over the lock screen and would have to fight it for the keyboard.
#
# So the messaging lives INSIDE this window instead. The lock already owns the seat
# grab, so there is nothing to hand back and forth — and, more importantly, nothing
# new is ever mapped. An admin lock exists to keep the operator away from the
# desktop; a chat panel that could open an image viewer or a file chooser would be
# a hole in exactly the thing being enforced. Plain text in, plain text out.
CHAT_LOG = "/var/lib/thinclient/chat/log.jsonl"
CHAT_OUTBOX = "/run/thinclient/chat-outbox"
# Touched while the operator has the message pane open, so the agent polls chat
# quickly instead of on its lazy interval — a reply during a lockout should not
# take a minute to land.
CHAT_ACTIVE = "/run/thinclient/chat-active"
CHAT_UNREAD = "/run/thinclient/chat-unread"
MSG_MAX = 2000

# The chat bubble, drawn exactly as the floating launcher draws it.
#
# The operator already knows this shape: it is the thing they press to talk to an
# administrator every other day. Putting a different affordance on the lock screen
# would make them learn a second one at the worst possible moment — while locked out
# and wanting help. Same circle, same gradient, same speech glyph.
#
# These constants are DUPLICATED from thinclient-chat rather than shared, because the
# bundle ships only shell files in lib/ and a chat import would drag a whole GUI
# application (and its single-instance lock) into the locker. tests/test-lock-chat.py
# fails if the two ever drift apart.
BUBBLE_A1 = (0x3d, 0x7b, 0xf5)   # accent start (blue)   — thinclient-chat C_A1
BUBBLE_A2 = (0x6d, 0x5e, 0xfc)   # accent end   (violet) — thinclient-chat C_A2
BUBBLE_BADGE = (0xff, 0x4d, 0x4f)
BUBBLE_SIZE = 60   # thinclient-chat launcher SIZE — same bubble, same size

try:
    import cairo   # noqa: F401
    import math
    HAVE_CAIRO = True
except Exception:
    HAVE_CAIRO = False


def _chat_unread():
    """How many messages are waiting. Shown as the same badge the launcher uses, so a
    locked-out operator can see the administrator has already replied."""
    try:
        return int((open(CHAT_UNREAD).read().strip() or "0"))
    except Exception:
        return 1 if os.path.exists(CHAT_UNREAD) else 0


def _chat_history(limit=40):
    """Recent conversation, oldest first, as (who, text) — text only.

    Attachments are deliberately reduced to a note. A screenshot or an image would
    mean loading a file from disk and offering to open it, and neither belongs on a
    screen whose whole job is that nothing else can be reached from it.
    """
    out = []
    try:
        with open(CHAT_LOG) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    m = json.loads(line)
                except Exception:
                    continue
                who = "You" if m.get("sender") == "device" else "Administrator"
                body = str(m.get("body") or "").strip()
                if not body and m.get("attachment"):
                    body = "(attachment — you can open it after unlocking)"
                if body:
                    out.append((who, body[:MSG_MAX]))
    except OSError:
        pass
    # Anything typed here that the agent has not yet delivered, so a message the
    # operator just sent does not vanish from the screen while it waits.
    try:
        for name in sorted(os.listdir(CHAT_OUTBOX)):
            if not name.endswith(".txt"):
                continue                      # JSON entries are reactions/screenshots
            try:
                with open(os.path.join(CHAT_OUTBOX, name)) as f:
                    body = f.read().strip()
            except OSError:
                continue
            if body:
                out.append(("You", body[:MSG_MAX] + "  (sending…)"))
    except OSError:
        pass
    return out[-limit:]


def _chat_send(body):
    """Queue one plain-text message for the agent to deliver. Best-effort."""
    body = (body or "").strip()[:MSG_MAX]
    if not body:
        return False
    try:
        os.makedirs(CHAT_OUTBOX, exist_ok=True)
        path = os.path.join(CHAT_OUTBOX, "%d-%d.txt" % (int(time.time() * 1000), os.getpid()))
        with open(path, "w") as f:
            f.write(body)
        return True
    except OSError:
        return False


def _chat_stamp():
    """Cheap change detector for the log, so the view only redraws when it must."""
    try:
        st = os.stat(CHAT_LOG)
        return (st.st_mtime, st.st_size)
    except OSError:
        return (0, 0)

def _admin_locked():
    return os.path.exists(ADMIN_LOCK)


def _admin_lock_is_schedule():
    """True when the lock carries working-hours text (4th line of the lock file)."""
    try:
        parts = open(ADMIN_LOCK).read().split("\n")
        return len(parts) > 3 and bool("\n".join(parts[3:]).strip())
    except Exception:
        return False


def _admin_lock_sub():
    """Mode/duration-aware sub-message for the admin-lock screen (file format
    '<epoch>\\n<mode>\\n<hours>'; an old single-line file = timed)."""
    import time as _t
    try:
        parts = open(ADMIN_LOCK).read().split("\n")
        ts = int((parts[0].strip() if parts and parts[0].strip() else "0"))
        mode = parts[1].strip() if len(parts) > 1 and parts[1].strip() else "timed"
        hours = float(parts[2].strip()) if len(parts) > 2 and parts[2].strip() else 24.0
        msg = "\n".join(parts[3:]).strip() if len(parts) > 3 else ""
    except Exception:
        ts, mode, hours, msg = 0, "timed", 24.0, ""
    # A WORKING-HOURS lock ships its own text (which hours apply and when the machine
    # comes back). It replaces the generic wording entirely — being told "your hours
    # are 09:00–18:00, back at 09:00 tomorrow" is far more use than "ask an admin".
    if msg:
        return msg
    if mode == "permanent" or ts <= 0:
        return "You can’t unlock this device — it stays locked until your administrator unlocks it."
    remaining = hours - (_t.time() - ts) / 3600.0
    if remaining <= 0:
        return "You can’t unlock this device — please wait for your administrator to unlock it."
    if remaining >= 1:
        n = int(round(remaining)); rem = "about %d hour%s" % (n, "" if n == 1 else "s")
    else:
        rem = "under an hour"
    return "You can’t unlock this device. It unlocks automatically in %s, or when your administrator unlocks it." % rem


def _lock_signal(on):
    try:
        if on:
            os.makedirs("/run/thinclient", exist_ok=True)
            # Written atomically: the agent polls this file every couple of seconds,
            # and a reader that caught it mid-write would see an empty file and fall
            # back to the (slower, less precise) process scan.
            tmp = LOCK_SIGNAL + ".tmp"
            with open(tmp, "w") as f:
                f.write("%d\n" % os.getpid())
            os.replace(tmp, LOCK_SIGNAL)
        elif os.path.exists(LOCK_SIGNAL):
            os.remove(LOCK_SIGNAL)
    except OSError:
        pass


def _install_exit_signals():
    """Make a polite shutdown actually run our cleanup.

    Python's default SIGTERM/SIGHUP disposition terminates the interpreter without
    unwinding, so `finally` is skipped and the lock signal is orphaned. Every routine
    teardown of the graphical session sends exactly those signals: `systemctl restart
    lightdm` from the watchdog, an OTA apply, a logout, a VT switch away. Translating
    them into a normal exit costs nothing and removes the common half of the
    stale-flag problem at the source. A SIGKILL or a hard X/GTK abort still cannot be
    caught here — that residue is what the reader-side liveness check exists for.
    """
    import signal as _sig

    def _bye(signum, _frame):
        _lock_signal(False)
        # Re-raise with the default handler so the exit status still reports the
        # signal; the process is going away either way.
        try:
            _sig.signal(signum, _sig.SIG_DFL)
            os.kill(os.getpid(), signum)
        except Exception:
            os._exit(0)

    for s in ("SIGTERM", "SIGHUP", "SIGINT"):
        try:
            _sig.signal(getattr(_sig, s), _bye)
        except (ValueError, OSError, AttributeError):
            pass


def _current_zone():
    """The machine's live IANA zone (e.g. 'Asia/Kolkata'), read from
    /etc/localtime. The lock clock seeds os.environ['TZ'] from this before
    tzset() — glibc's tzset() keys its re-read on the TZ *string*, so with TZ
    unset it no-ops and an already-open lock would stay stuck on the zone it
    first resolved (UTC at boot, before the agent applied the policy zone)."""
    try:
        real = os.path.realpath("/etc/localtime")
        i = real.find("/zoneinfo/")
        if i != -1:
            return real[i + len("/zoneinfo/"):]
    except Exception:
        pass
    try:
        with open("/etc/timezone") as f:
            z = f.read().strip()
            if z:
                return z
    except Exception:
        pass
    return None


def _hash(pw, salt_hex):
    return hashlib.pbkdf2_hmac("sha256", pw.encode(), bytes.fromhex(salt_hex), _ITER).hex()


def _load(path=None):
    try:
        with open(path or LOCK_FILE) as f:
            salt, h = f.read().strip().split(":", 1)
            return salt, h
    except Exception:
        return None


def verify(pw):
    rec = _load()
    if rec is None:
        return pw == DEFAULT_PW          # factory default until the user changes it
    salt, h = rec
    try:
        return hmac.compare_digest(_hash(pw, salt), h)
    except Exception:
        return False


# ---------------------------------------------------------------------------------
# Password policy + lockout (security plan A4). The rules live in the shared
# thinclient-secpolicy module; with no policy received they reproduce exactly what this
# lock screen always did — any non-empty password, unlimited tries, no expiry.
# ---------------------------------------------------------------------------------
LOCK_STATE = os.path.expanduser("~/.thinclient-lock-state.json")
WIPED_MARK = os.environ.get("TC_WIPED_MARK", "/var/lib/thinclient/wiped")
LOCKOUT_TITLE = "Locked after too many wrong passwords"
LOCKOUT_SUB = ("Your administrator has been notified and can unlock this device. "
               "You can message them below.")
_SECPOL = None


def secpolicy():
    """The shared policy module, or None. None means "behave as before"."""
    global _SECPOL
    if _SECPOL is None:
        _SECPOL = False
        try:
            import importlib.machinery, importlib.util
            here = os.path.dirname(os.path.abspath(__file__))
            for path in (os.path.join(here, "thinclient-secpolicy"),
                         "/opt/thinclient/bin/thinclient-secpolicy"):
                if os.path.exists(path):
                    spec = importlib.util.spec_from_loader(
                        "tc_secpolicy", importlib.machinery.SourceFileLoader("tc_secpolicy", path))
                    mod = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(mod)
                    _SECPOL = mod
                    break
        except Exception:
            pass
    return _SECPOL or None


def _policy():
    sp = secpolicy()
    return sp.load() if sp else None


def _json_load(path):
    try:
        with open(path) as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def _json_save(path, data):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def _meta_path(target=None):
    return (target or LOCK_FILE) + ".meta.json"


def meta():
    """When the password was set, recent hashes, and flags. `is_default` is not
    stored: no lock file means the factory password is still in force."""
    m = _json_load(_meta_path())
    m["is_default"] = not os.path.exists(LOCK_FILE)
    return m


def set_password(pw, path=None, must_change=False):
    """Store a new password (salted PBKDF2, as always) and record it in the sidecar:
    when it was set (by the manager-vouched clock, so winding the device clock back
    cannot postpone expiry), the previous hash for the no-reuse rule, and whether it
    must be changed at the next unlock (an administrator's reset)."""
    target = path or LOCK_FILE
    prev = None
    try:
        with open(target) as f:
            prev = f.read().strip() or None
    except OSError:
        pass
    salt = os.urandom(8).hex()
    tmp = target + ".tmp"
    with open(tmp, "w") as f:
        f.write("%s:%s\n" % (salt, _hash(pw, salt)))
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)
    _record_new_password(target, prev, must_change)


def _record_new_password(target, prev, must_change):
    sp = secpolicy()
    m = _json_load(_meta_path(target))
    hist = list(m.get("history") or [])
    if prev:
        hist.insert(0, prev)
    m["history"] = hist[:24]
    m["set_at"] = sp.trusted_now() if sp else time.time()
    m["must_change"] = bool(must_change)
    m["weak"] = False
    _json_save(_meta_path(target), m)


def lock_state():
    return _json_load(LOCK_STATE)


def lockout_active():
    """A lockout stands until the MANAGER clears it — not until the next correct
    password. Reboots do not clear it either: the state is on disk."""
    return bool(lock_state().get("locked_at"))


def _note_failure():
    """Count one wrong password. Returns (locked_now, attempts_left or None)."""
    pol = _policy()
    sp = secpolicy()
    if not (pol and sp):
        return False, None
    st, locked = sp.lockout_after_failure(lock_state(), pol)
    try:
        _json_save(LOCK_STATE, st)
    except OSError:
        pass
    left = None
    if pol["lockout"]["enabled"] and not locked:
        left = max(0, pol["lockout"]["attempts"] - st["fails"])
    return locked, left


def _clear_failures():
    """A correct password resets the count — but never a lockout (manager only)."""
    st = lock_state()
    if st.get("fails") and not st.get("locked_at"):
        try:
            _json_save(LOCK_STATE, {"fails": 0})
        except OSError:
            pass


def _wrong_message(left):
    if left is None:
        return "Incorrect password"
    if left == 1:
        return "Incorrect password — 1 attempt left before this device locks"
    return "Incorrect password — %d attempts left" % left


def attempt_unlock(pw):
    """One unlock attempt at the lock screen. Returns one of:
        ("locked", None)          the device is locked out (now or already)
        ("wrong", message)        wrong password, not (yet) locked out
        ("ok", None)              let them in
        ("remind", days_left)     correct; offer to change before it expires
        ("change", reason)        correct, but a new password is required first
    With no policy this is exactly the old behaviour: ok or "Incorrect password"."""
    if lockout_active():
        return ("locked", None)
    if not verify(pw):
        locked, left = _note_failure()
        return ("locked", None) if locked else ("wrong", _wrong_message(left))
    _clear_failures()
    pol, sp = _policy(), secpolicy()
    if not (pol and sp) or not pol["password"]["enabled"]:
        return ("ok", None)
    m = meta()
    if not m.get("set_at") and not m["is_default"]:
        # A password from before the policy: start its clock now, rather than
        # expiring the whole fleet the day a policy is switched on.
        m["set_at"] = sp.trusted_now()
    # The current password was just typed, so its STRENGTH can be judged now — the
    # only moment that is possible (only its hash is stored).
    if sp.check_password(pw, pol):
        m["weak"] = True
    try:
        _json_save(_meta_path(), {k: v for k, v in m.items() if k != "is_default"})
    except OSError:
        pass
    status, detail = sp.password_status(m, pol)
    if status in ("must_change", "expired"):
        return ("change", detail if status == "must_change" else "Your password has expired — please choose a new one")
    if status == "remind":
        return ("remind", detail)
    return ("ok", None)


def attempt_current(pw):
    """The "current password" step of Change password. It counts towards the lockout
    exactly like an unlock attempt — otherwise the change form is an unlimited way to
    guess. Returns ("ok"|"wrong"|"locked", message)."""
    if lockout_active():
        return ("locked", None)
    if verify(pw):
        _clear_failures()
        return ("ok", None)
    locked, left = _note_failure()
    return ("locked", None) if locked else ("wrong", _wrong_message(left).replace(
        "Incorrect password", "Current password is wrong"))


def validate_new(pw):
    """Why `pw` cannot be the new password, or None. No policy: only "not empty"."""
    if not pw:
        return "Password can't be empty"
    pol, sp = _policy(), secpolicy()
    if not (pol and sp):
        return None
    err = sp.check_password(pw, pol)
    if err:
        return err
    if pol["password"]["enabled"] and pol["password"]["history"] > 0:
        cur = _load()
        recent = ([("%s:%s" % cur)] if cur else []) + list(meta().get("history") or [])
        if sp.reused(pw, recent[:pol["password"]["history"] + 1], _hash):
            return "Choose a password you haven't used recently"
    return None


