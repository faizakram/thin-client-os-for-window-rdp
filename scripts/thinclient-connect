#!/usr/bin/env python3
# =============================================================================
#  ThinClient OS — Remote Desktop connection window (Esparks IT Solutions)
#  Installed to: /opt/thinclient/bin/thinclient-connect
#
#  The kiosk's front door. A clean, standard-looking GTK window:
#    * Server / IP, Username, Password, Security -> [Connect] -> Windows RDP
#    * A LIVE network indicator: LAN dot green when wired is up, red when not
#    * A Wi-Fi button that scans/lists networks and connects (via thinclient-wifi)
#  On disconnect/failure it returns to the form (showing the real FreeRDP error).
#  No Linux desktop is ever exposed.
#
#  The FreeRDP argv here is the exact, verified-working command:
#    xfreerdp3 /v:H:P /u:U [/d:D] /from-stdin:force /f /cert:ignore /sec:S
#              /clipboard /dynamic-resolution [/scale-desktop:N /scale-device:M]
#              /sound:sys:pulse /microphone:sys:pulse /log-level:INFO
#
#  Display sizing: a hi-res panel (e.g. 4K) delivered at the server's 100% DPI
#  makes the Windows UI microscopic. The "Display size" control scales it:
#    Auto / 100..200%  -> /scale-desktop (server-side DPI, stays crisp)
#    Zoom to fit       -> /smart-sizing + /size (always enlarges, even if the
#                         server ignores DPI; note: mutually exclusive with
#                         /dynamic-resolution, so that flag is dropped in fit mode)
#
#  Video: without an H.264 GFX codec, full-motion video (YouTube etc.) renders
#  through legacy bitmap codecs and looks blurry/smeared on motion. The "Video"
#  control enables the H.264 GFX pipeline (what Windows mstsc uses):
#    Auto (default) / Balanced -> /gfx:AVC420 (H.264 4:2:0 — ~half the client
#                   decode cost, so FreeRDP won't starve/freeze while the box also
#                   encodes the monitor/record streams)
#    High         -> /gfx:AVC444 (H.264 4:4:4 — sharpest text, heaviest to decode)
#    Compat       -> no /gfx (legacy bitmap path, maximum compatibility)
#  With H.264 on we add /network:auto so the server adapts bitrate over WAN.
#  H.264 decode ships in the image (libavcodec); all flags verified against
#  Debian's FreeRDP 3.15 and against the live server's GFX capabilities.
# =============================================================================
import base64, gi, glob, hashlib, os, re, subprocess, sys, tempfile, threading, time
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

# Internet-speed color thresholds (Mbps) — MUST match the manager + the net badge.
NET_GREEN = 50   # >= green
NET_AMBER = 30   # >= amber, below = red

CONF = os.environ.get("TC_CONF", "/etc/thinclient/server.conf")
# Per-device saved RDP connection (IP/user/password/port/domain). Written on the
# first SUCCESSFUL connect and auto-filled afterwards so the operator enters the
# credentials only once. Lives in the kiosk user's home (persists on an installed
# disk; ephemeral on a live USB), mode 0600. The password is obfuscated with a
# device-local key — NOT strong encryption; the screen lock is the access control.
PROFILE = os.environ.get("TC_RDP_PROFILE", os.path.expanduser("~/.thinclient-rdp"))
# Server-managed RDP profile written by thinclient-agent from the manager. When
# present it takes precedence over the local PROFILE: the form pre-fills the IP +
# username, connects with a password the operator can never see, and the operator
# may override for ONE session (reverts on restart, when the agent re-writes this).
# In RAM (/run is tmpfs) — see the agent: the Windows password is never on disk.
MANAGED_RDP = os.environ.get("TC_MANAGED_RDP", "/run/thinclient/rdp-managed")
# An operator-typed password is kept in RAM as well, so a pulled disk carries none.
# Host, user, port and domain still persist on disk (they are not secrets), so after a
# reboot the form is pre-filled and only the password is typed again.
PROFILE_PW = os.environ.get("TC_RDP_PROFILE_PW", "/run/thinclient/rdp-profile-pw-%d" % os.getuid())
LOGDIR = os.environ.get("TC_LOG_DIR", "/var/log/thinclient")

# OTA update prompt state. `thinclient-update --check` (root, on a timer) writes
# PENDING_FILE when a newer signed release is available; this window prompts the
# user and tracks how many times they deferred in SKIP_CACHE (user-owned).
PENDING_FILE = os.environ.get("TC_UPDATE_PENDING", "/var/lib/thinclient/updates/pending")
# Written by the agent (in the world-writable run dir, so this session-user window
# can also remove it) when an admin clicks "Force update now" — tells this window
# to apply the pending update SILENTLY (no confirmation / skip prompt).
FORCE_SILENT_FILE = "/run/thinclient/update-force-silent"
SKIP_CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "thinclient", "update-skips")

def _read_kv(path):
    d = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, _, v = line.partition("=")
                    d[k.strip()] = v.strip()
    except OSError:
        pass
    return d

def pending_update_version():
    """Version string of a staged update, or '' if none is pending."""
    return _read_kv(PENDING_FILE).get("version", "")

# Device licensing / admin lock. The agent (thinclient-agent) writes the state;
# this window refuses RDP when locked — but ONLY if enforcement is switched on,
# so an unconfigured/unlicensed appliance behaves exactly as before (fail-safe).
LICENSE_CONF = os.environ.get("TC_LICENSE_CONF", "/etc/thinclient/license.conf")
LICENSE_STATE = os.environ.get("TC_LICENSE_STATE", "/var/lib/thinclient/license/state")
LICENSE_ADMIN_LOCK = os.environ.get("TC_LICENSE_ADMIN_LOCK", "/var/lib/thinclient/license/admin-lock")
WIPED_MARK = os.environ.get("TC_WIPED_MARK", "/var/lib/thinclient/wiped")

def _admin_lock_message():
    """User-facing admin-lock message, aware of the lock's mode + remaining time
    (file format: '<epoch>\\n<mode>\\n<hours>'; an old single-line file = timed)."""
    try:
        parts = open(LICENSE_ADMIN_LOCK).read().split("\n")
        ts = int((parts[0].strip() if parts and parts[0].strip() else "0"))
        mode = parts[1].strip() if len(parts) > 1 and parts[1].strip() else "timed"
        hours = float(parts[2].strip()) if len(parts) > 2 and parts[2].strip() else 24.0
        msg = "\n".join(parts[3:]).strip() if len(parts) > 3 else ""
    except Exception:
        ts, mode, hours, msg = 0, "timed", 24.0, ""
    # Working-hours lock: show the group's own text instead of the generic wording.
    if msg:
        return "🕒 " + msg
    if mode == "permanent" or ts <= 0:
        return "🔒 Locked by your administrator. This device stays locked until they unlock it — you can't unlock it yourself."
    remaining = hours - (time.time() - ts) / 3600.0
    if remaining <= 0:
        return "🔒 Locked by your administrator — you can't unlock this. Please wait for them to unlock it."
    if remaining >= 1:
        n = int(round(remaining)); rem = "about %d hour%s" % (n, "" if n == 1 else "s")
    else:
        rem = "under an hour"
    return "🔒 Locked by your administrator — you can't unlock this. It unlocks automatically in %s (or when they unlock it)." % rem


def license_block_reason():
    """Return a user-facing message if the device must not start a session, else
    None. An explicit admin LOCK is a management action and ALWAYS blocks — it is
    independent of billing. The licence-EXPIRY kill-switch only applies when
    LICENSE_ENFORCE is switched on (so an unlicensed appliance never self-locks)."""
    if os.path.exists(WIPED_MARK):
        # Remotely wiped (lost or stolen): no credentials left, nothing to connect with.
        return "⛔ This device has been reset for security reasons. Contact your administrator."
    if os.path.exists(LICENSE_ADMIN_LOCK):
        return _admin_lock_message()
    enforce = (_read_kv(LICENSE_CONF).get("LICENSE_ENFORCE", "false") or "false").lower()
    if enforce not in ("true", "1", "yes", "on"):
        return None
    st = _read_kv(LICENSE_STATE)
    if st.get("state", "") == "locked":
        # Tell the operator WHICH failure this is. write_state() records `exp` only
        # when a signed licence was actually verified, so no `exp` means this device
        # has never held one — it could not enrol or cannot reach the manager. Calling
        # that "expired" sends the admin hunting for a billing problem when the real
        # fault is enrolment or connectivity, which is a very different fix.
        if not st.get("exp"):
            # If the agent is asking to be adopted, show the code the administrator
            # needs. Without it the operator can only report "it says not licensed",
            # which tells the admin nothing about WHICH machine is waiting.
            code = ""
            try:
                with open("/var/lib/thinclient/adopt/code") as f:
                    code = f.read().strip()
            except OSError:
                pass
            if code:
                return ("This device is waiting to be added to your account.\n"
                        "Give your administrator this code:  %s" % code)
            return ("This device is not licensed yet — it has not been able to "
                    "register with the management server. Please contact your "
                    "administrator.")
        return "This device's licence has expired. Please contact your administrator."
    return None

# Shared runtime signal the agent reads to know an RDP session is live (feeds the
# tenant-admin activity view: working hours = time an RDP session was connected).
RDP_SIGNAL = "/run/thinclient/rdp-connected"
# The agent's session-freeze watchdog drops this right before it kills a hung
# FreeRDP, so we show the operator a clear "session reset - reconnect" screen
# rather than dumping them back at the blank connect form.
FREEZE_MARK = "/run/thinclient/rdp-froze"

def _rdp_signal(on):
    try:
        if on:
            os.makedirs("/run/thinclient", exist_ok=True)
            open(RDP_SIGNAL, "w").close()
        elif os.path.exists(RDP_SIGNAL):
            os.remove(RDP_SIGNAL)
    except OSError:
        pass

def _consume_freeze_mark():
    """True (once) if the agent reset a frozen session while this one was running."""
    try:
        if os.path.exists(FREEZE_MARK):
            os.remove(FREEZE_MARK)
            return True
    except OSError:
        pass
    return False

def _current_zone():
    """The machine's live IANA zone (e.g. 'Asia/Kolkata') from /etc/localtime.
    The header clock seeds os.environ['TZ'] from this before tzset() — glibc keys
    its re-read on the TZ string, so with TZ unset tzset() no-ops and the clock
    would stay on the zone it first saw (UTC at boot, before the agent applied the
    policy zone). Same pattern as the lock screen; keeps them in sync."""
    try:
        real = os.path.realpath("/etc/localtime")
        i = real.find("/zoneinfo/")
        if i != -1:
            return real[i + len("/zoneinfo/"):]
    except Exception:
        pass
    try:
        with open("/etc/timezone") as f:
            z = f.read().strip()
            if z:
                return z
    except Exception:
        pass
    return None


def _lock_on_startup():
    """Show the screen lock BEFORE the connect form (login-before-desktop). Run
    from HERE (not the X-session script) so this connect process is already alive
    while the user is at the lock — otherwise the watchdog/rescue see 'no session'
    during the lock and restart X (black screen) or drop to the tty diagnostic.

    Fails CLOSED: the locker returns 0 only on a genuine unlock. If it crashes or
    cannot display, we must NOT fall through and reveal the connect form (it can
    carry a pre-filled RDP password) — so retry instead of exposing the desktop."""
    import time as _t
    lock = "/opt/thinclient/bin/thinclient-lock"
    if not (os.path.exists(lock) and os.access(lock, os.X_OK)):
        return
    for _ in range(60):
        try:
            rc = subprocess.run([lock]).returncode   # blocks; 0 = genuine unlock
        except Exception:
            rc = -1
        if rc == 0:
            return
        sys.stderr.write("thinclient-connect: boot lock did not unlock cleanly (rc=%s); retrying\n" % rc)
        _t.sleep(1)
    # Persistently unable to display the lock (broken locker) — proceed rather than
    # brick the device forever. Last-resort fail-open, and it is logged above.
    sys.stderr.write("thinclient-connect: boot lock unavailable after retries; proceeding\n")

def rdp_bin():
    # Prefer the PCM-only FreeRDP (built without the FFmpeg audio DSP -> no AAC mic
    # encoder -> no NaN deadlock/freeze) when the agent has installed it. Fully
    # reversible: RDP_PCM=0, or the dir absent, falls back to the system client.
    if conf_get("RDP_PCM", "1").lower() not in ("0", "false", "no", "off"):
        for pcm in ("/opt/freerdp-pcm/bin/xfreerdp3", "/opt/freerdp-pcm/bin/xfreerdp"):
            if os.access(pcm, os.X_OK):
                return pcm
    for b in ("xfreerdp3", "xfreerdp"):
        p = subprocess.run(["which", b], capture_output=True, text=True)
        if p.returncode == 0:
            return p.stdout.strip()
    return ""

def conf_get(key, default=""):
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                if k.strip() == key:
                    return v.strip().strip('"').strip("'")
    except OSError:
        pass
    return default

def _obf_key():
    """Device-local key for obfuscating the saved password. Derived from the
    machine-id so the token isn't literal plaintext in the file/backups. It is
    only obfuscation (the key lives on the same disk) — the screen lock is the
    real access control, per the deployment's policy."""
    try:
        with open("/etc/machine-id") as f:
            mid = f.read().strip()
    except OSError:
        mid = "thinclient"
    return hashlib.sha256(("tc-rdp:" + mid).encode()).digest()

def _obfuscate(s):
    if not s:
        return ""
    k = _obf_key()
    b = s.encode("utf-8")
    return base64.b64encode(bytes(c ^ k[i % len(k)] for i, c in enumerate(b))).decode("ascii")

def _deobfuscate(tok):
    if not tok:
        return ""
    try:
        x = base64.b64decode(tok.encode("ascii"))
        k = _obf_key()
        return bytes(c ^ k[i % len(k)] for i, c in enumerate(x)).decode("utf-8")
    except Exception:
        return ""

def profile_get(key, default=""):
    """Read a field from the saved per-device RDP profile (PROFILE)."""
    try:
        with open(PROFILE) as f:
            for line in f:
                line = line.strip()
                if line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                if k.strip() == key:
                    return v.strip()
    except OSError:
        pass
    return default

def _write_private(path, text):
    """Atomic write, mode 0600 from the moment it exists."""
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def save_profile(host, port, user, pw, dom):
    """Persist the last SUCCESSFUL connection so it auto-fills next time.

    Everything EXCEPT the password goes to disk. The password goes to RAM only
    (PROFILE_PW): it used to sit in this file "obfuscated" with a key derived from
    /etc/machine-id — on the same disk — so a pulled disk gave it up in minutes.
    Failures are non-fatal (best effort)."""
    try:
        _write_private(PROFILE,
            "# ThinClient saved RDP connection (per-device, auto-filled).\n"
            "# The password is NOT stored here — it is kept in memory until restart.\n"
            "SERVER_IP=%s\nPORT=%s\nUSERNAME=%s\nDOMAIN=%s\n" % (host, port, user, dom))
    except OSError:
        pass
    try:
        os.makedirs(os.path.dirname(PROFILE_PW), exist_ok=True)
        _write_private(PROFILE_PW, _obfuscate(pw))
    except OSError:
        pass


def saved_password():
    """The operator-typed password, from RAM. Moves an old on-disk copy into RAM the
    first time it is seen and rewrites the profile without it, so updating the device
    does not make anyone retype a password they saved — it lasts until the next
    restart, like any other password now."""
    try:
        with open(PROFILE_PW) as f:
            return _deobfuscate(f.read().strip())
    except OSError:
        pass
    legacy = profile_get("PASSWORD_OBF")
    if not legacy:
        return ""
    pw = _deobfuscate(legacy)
    save_profile(profile_get("SERVER_IP"), profile_get("PORT", "3389"),
                 profile_get("USERNAME"), pw, profile_get("DOMAIN"))
    return pw

# --- Security policy + Windows-server identity (security plan G1) ---------------
_SECPOL = None


def secpolicy():
    """The shared security-policy module, or None if it cannot be loaded. None means
    "behave exactly as before": a missing or broken module must never be the reason
    an operator cannot connect."""
    global _SECPOL
    if _SECPOL is None:
        _SECPOL = False
        try:
            import importlib.machinery, importlib.util
            here = os.path.dirname(os.path.abspath(__file__))
            for path in (os.path.join(here, "thinclient-secpolicy"),
                         "/opt/thinclient/bin/thinclient-secpolicy"):
                if os.path.exists(path):
                    spec = importlib.util.spec_from_loader(
                        "tc_secpolicy", importlib.machinery.SourceFileLoader("tc_secpolicy", path))
                    mod = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(mod)
                    _SECPOL = mod
                    break
        except Exception as e:
            sys.stderr.write("thinclient-connect: security policy unavailable: %s\n" % e)
    return _SECPOL or None


def _recv_exact(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise OSError("connection closed")
        buf += chunk
    return buf


def rdp_cert_fingerprint(host, port, timeout=5.0):
    """(sha256-hex, None) for the TLS certificate an RDP server presents, or
    (None, reason). Speaks only the opening of RDP: the same X.224 connection request
    FreeRDP sends (asking for TLS or NLA), then the TLS handshake — and hangs up. No
    credentials are ever sent. Pure standard library."""
    import hashlib, socket, ssl, struct
    # TPKT(4) + X.224 Connection Request(7) + RDP_NEG_REQ(8): requestedProtocols =
    # PROTOCOL_SSL | PROTOCOL_HYBRID, i.e. "TLS, NLA welcome" — what FreeRDP asks for.
    req = bytes([0x03, 0x00, 0x00, 0x13,
                 0x0e, 0xe0, 0x00, 0x00, 0x00, 0x00, 0x00,
                 0x01, 0x00, 0x08, 0x00, 0x03, 0x00, 0x00, 0x00])
    try:
        with socket.create_connection((host, int(port)), timeout=timeout) as s:
            s.settimeout(timeout)
            s.sendall(req)
            hdr = _recv_exact(s, 4)
            if hdr[0] != 0x03:
                return None, "not-rdp"
            body = _recv_exact(s, struct.unpack(">H", hdr[2:4])[0] - 4)
            if len(body) >= 15 and body[7] == 0x03:
                return None, "negotiation-failed"
            if len(body) >= 15 and body[7] == 0x02 and struct.unpack("<I", body[11:15])[0] == 0:
                return None, "no-tls"          # legacy "RDP security": there is no certificate
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE    # self-signed is normal for RDP: we PIN, not trust
            with ctx.wrap_socket(s) as t:
                der = t.getpeercert(binary_form=True)
            return (hashlib.sha256(der).hexdigest(), None) if der else (None, "no-certificate")
    except (OSError, ssl.SSLError, ValueError) as e:
        return None, "unreachable" if isinstance(e, (socket.timeout, ConnectionError)) else "tls-error"


CERT_SEEN = os.environ.get("TC_CERT_SEEN", "/run/thinclient/cert-seen.json")


def record_cert(host, port, fp, decision, error):
    """Leave what this connection saw for the agent to report to the manager, which
    learns the first fingerprint per server and alerts on a different one. RAM only."""
    import json, time as _t
    try:
        with open(CERT_SEEN) as f:
            seen = json.load(f)
    except (OSError, ValueError):
        seen = {}
    seen["%s:%s" % (host.strip().lower(), int(port))] = {
        "fp": fp, "decision": decision, "error": error, "at": int(_t.time())}
    try:
        os.makedirs(os.path.dirname(CERT_SEEN), exist_ok=True)
        tmp = CERT_SEEN + ".tmp"
        with open(tmp, "w") as f:
            json.dump(seen, f)
        os.chmod(tmp, 0o644)
        os.replace(tmp, CERT_SEEN)
    except OSError:
        pass


def server_identity_decision(host, port):
    """"allow" or a refusal message — whether to hand this server the password.

    Pinning OFF (no policy yet): returns "allow" WITHOUT touching the network, so the
    connection is byte-for-byte what it was before. REPORT mode: always "allow",
    noting what was seen (a mismatch is reported loudly). ENFORCE mode: refuses a
    server whose certificate does not match the one the manager learned for it, and
    one whose identity could not be checked at all.

    Known limit: FreeRDP opens its own connection a moment later with /cert:ignore,
    and reconnects mid-session the same way. An attacker able to let this check pass
    and intercept only FreeRDP's connection is not stopped here; one who sits on the
    path — the normal case — intercepts this check too, and is."""
    sp = secpolicy()
    if not sp:
        return "allow"
    try:
        policy = sp.load()
    except Exception:
        return "allow"
    if policy["cert_pin"] == "off":
        return "allow"
    fp, err = rdp_cert_fingerprint(host, port)
    if fp is None:
        record_cert(host, port, None, "unverified", err)
        if policy["cert_pin"] == "enforce":
            return ("This server's identity couldn't be checked, so your password was not sent. "
                    "Try again in a moment; if it keeps happening, contact your administrator.")
        return "allow"
    decision, _ = sp.pin_decision(policy, host, port, fp)
    record_cert(host, port, fp, decision, None)
    if decision == "refuse":
        return ("This server is not the one your device knows, so your password was not sent. "
                "Your administrator has been notified.")
    return "allow"


def managed_rdp():
    """The server-managed RDP profile (written by the agent from the manager), or
    None. host/user are cleartext; the password is obfuscated with the same
    machine-id key, so _deobfuscate recovers it. Returns {host, user, pw}."""
    host = user = pwobf = ""
    try:
        with open(MANAGED_RDP) as f:
            for line in f:
                line = line.strip()
                if line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                k = k.strip(); v = v.strip()
                if k == "HOST": host = v
                elif k == "USER": user = v
                elif k == "PASSWORD_OBF": pwobf = v
    except OSError:
        return None
    if not host:
        return None
    return {"host": host, "user": user, "pw": _deobfuscate(pwobf)}

def _mask_ip(v):
    """Show the operator only the last octet of the admin-set server IP, e.g.
    '•••.•••.•••.152' — the rest is hidden. A non-IPv4 host (a name) is fully
    masked. The real address is kept separately and used for the connection."""
    v = (v or "").strip()
    if not v:
        return ""
    p = v.split(".")
    if len(p) == 4 and all(o.isdigit() and 0 <= int(o) <= 255 for o in p):
        return "•••.•••.•••.%s" % p[3]
    return "••••••••"

def _mask_user(v):
    """The username is admin-set too — fully star it on the operator's screen."""
    return "••••••••" if (v or "").strip() else ""

def net_status():
    """Return 'lan' if wired is connected, 'wifi' if Wi-Fi is connected, else ''."""
    try:
        p = subprocess.run(["nmcli", "-t", "-f", "TYPE,STATE", "device", "status"],
                           capture_output=True, text=True, timeout=4)
        if p.returncode == 0:
            lines = p.stdout.splitlines()
            if any(l.startswith("ethernet:connected") for l in lines):
                return "lan"
            if any(l.startswith("wifi:connected") for l in lines):
                return "wifi"
            return ""
    except Exception:
        pass
    # Fallback: any wired interface with carrier == 1
    try:
        base = "/sys/class/net"
        for ifc in os.listdir(base):
            if ifc[:1] == "e":  # en*, eth*
                cp = os.path.join(base, ifc, "carrier")
                if os.path.exists(cp) and open(cp).read().strip() == "1":
                    return "lan"
    except OSError:
        pass
    return ""

def screen_size():
    """Physical screen resolution (w, h) via xrandr; Gdk fallback; default 1080p.
    Used to auto-pick a DPI scale and to show the real resolution on screen."""
    try:
        p = subprocess.run(["xrandr", "--current"], capture_output=True, text=True, timeout=4)
        if p.returncode == 0:
            best = (0, 0)
            for line in p.stdout.splitlines():
                if "*" not in line:            # only the active mode line is starred
                    continue
                m = re.match(r"\s*(\d+)x(\d+)\b", line)
                if m:
                    w, h = int(m.group(1)), int(m.group(2))
                    if w * h > best[0] * best[1]:
                        best = (w, h)
            if best[0]:
                return best
    except Exception:
        pass
    try:
        disp = Gdk.Display.get_default()
        mon = disp.get_primary_monitor() or disp.get_monitor(0)
        g = mon.get_geometry(); sf = mon.get_scale_factor()
        if g.width:
            return (g.width * sf, g.height * sf)
    except Exception:
        pass
    return (1920, 1080)

def auto_scale_pct(width):
    """Sensible desktop DPI scale so a hi-res panel isn't microscopic at 100%."""
    if width >= 3840: return 200
    if width >= 3000: return 175
    if width >= 2560: return 150
    return 100

