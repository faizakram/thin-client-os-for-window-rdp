#!/usr/bin/env python3
# =============================================================================
#  ThinClient Manager — device agent (runs on each ThinClient appliance)
#  Installed to: /opt/thinclient/bin/thinclient-agent
#
#  Responsibilities (Phase 1 — licensing):
#    * Fetch a fresh signed licence token from the control plane (monthly
#      rotation), best-effort — a network outage must NOT lock a paid device.
#    * VERIFY the cached token offline against the baked-in public key
#      (/etc/thinclient/license-pubkey.pem) using openssl (same tool as OTA).
#    * Decide active | grace | locked from the token's own `exp` + a grace
#      window, and write /var/lib/thinclient/license/state. The connect window
#      reads that file and refuses to launch RDP when "locked".
#
#  Because expiry lives inside the SIGNED token, a device enforces its own
#  licence with no network — pulling the cable cannot keep an expired box alive.
#
#  CLI:
#    thinclient-agent enforce                         # full cycle (timer/boot)
#    thinclient-agent state                           # print current state
#    thinclient-agent verify <token_file> <pubkey> [device_id] [now] [grace]
#                                                     # verify+classify (testing)
# =============================================================================
import base64, datetime, glob, hashlib, json, math, os, re, shutil, subprocess, sys, tempfile, threading, time

GRACE_DEFAULT = 3 * 86400            # 3 days after exp before hard-lock
# Shared runtime signals (created world-writable at boot via tmpfiles.d):
#   rdp-connected  — present while an RDP session is live (written by connect)
#   locked         — present while the screen lock GUI is up (written by lock)
#   rec-overlay.txt — dynamic drawtext for the recording lock banner (agent)
RUN_DIR = "/run/thinclient"
SIG_RDP = os.path.join(RUN_DIR, "rdp-connected")
SIG_LOCK = os.path.join(RUN_DIR, "locked")
OVERLAY_FILE = os.path.join(RUN_DIR, "rec-overlay.txt")
# Support chat store (agent syncs it with the manager; thinclient-chat is the UI):
CHAT_DIR = "/var/lib/thinclient/chat"
CHAT_LOG = os.path.join(CHAT_DIR, "log.jsonl")   # both directions (agent-written)
CHAT_OUTBOX = os.path.join(RUN_DIR, "chat-outbox")  # operator msgs to send
CHAT_UNREAD = os.path.join(RUN_DIR, "chat-unread")  # drives the floating badge
CHAT_ATT_DIR = os.path.join(CHAT_DIR, "att")        # image attachments (downloaded admin + sent)
CHAT_ACTIVE = os.path.join(RUN_DIR, "chat-active")  # thinclient-chat touches this while the panel is open
# Per-outbox-file screenshot upload attempts, so a permanent failure is dropped
# instead of retrying forever and filling the panel with stuck bubbles.
_CHAT_SHOT_FAILS = {}
_CHAT_SHOT_MAX_TRIES = 3
CHAT_TYPING = os.path.join(RUN_DIR, "chat-typing")  # thinclient-chat touches this while the operator types
CHAT_ADMIN_TYPING = os.path.join(RUN_DIR, "chat-admin-typing")  # we write this when an admin is typing
STATE_DIR = os.environ.get("TC_LICENSE_DIR", "/var/lib/thinclient/license")
PUBKEY = os.environ.get("TC_LICENSE_PUBKEY", "/etc/thinclient/license-pubkey.pem")
TOKEN_CACHE = os.path.join(STATE_DIR, "token")
STATE_FILE = os.path.join(STATE_DIR, "state")
CONF = os.environ.get("TC_LICENSE_CONF", "/etc/thinclient/license.conf")
# license.conf holds this device's secret (and the fleet enrolment token), so it is
# readable by root only. The connect screen runs as the operator and needs just one
# harmless switch from it; the agent copies that, and nothing else, to this file.
LICENSE_PUBLIC = os.environ.get("TC_LICENSE_PUBLIC", os.path.join(STATE_DIR, "public.conf"))
_PUBLIC_KEYS = ("LICENSE_ENFORCE",)


def _b64u_decode(s: str) -> bytes:
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


def verify_token(token: str, pubkey_path: str) -> dict:
    """Return the claims dict if the RS256 signature is valid; else raise."""
    parts = token.strip().split(".")
    if len(parts) != 3:
        raise ValueError("malformed token")
    h, p, sig = parts
    signing_input = ("%s.%s" % (h, p)).encode()
    raw_sig = _b64u_decode(sig)
    with tempfile.TemporaryDirectory() as d:
        msg, sg = os.path.join(d, "msg"), os.path.join(d, "sig")
        with open(msg, "wb") as f:
            f.write(signing_input)
        with open(sg, "wb") as f:
            f.write(raw_sig)
        rc = subprocess.run(
            ["openssl", "dgst", "-sha256", "-verify", pubkey_path, "-signature", sg, msg],
            capture_output=True,
        ).returncode
    if rc != 0:
        raise ValueError("bad signature")
    try:
        header = json.loads(_b64u_decode(h))
        claims = json.loads(_b64u_decode(p))
    except Exception:
        raise ValueError("bad token payload")
    if header.get("alg") != "RS256":
        raise ValueError("unexpected alg")
    for k in ("device_id", "tenant_id", "exp", "iat"):
        if k not in claims:
            raise ValueError("missing claim: %s" % k)
    return claims


def license_state(claims: dict, device_id: str, grace: int, now: float) -> str:
    if device_id and claims.get("device_id") != device_id:
        return "locked"
    exp = float(claims["exp"])
    if now <= exp:
        return "active"
    if now <= exp + grace:
        return "grace"
    return "locked"


# --------------------------- config + device identity ------------------------
_CONF_CACHE = {"mtime": None, "data": {}}


def _conf_all() -> dict:
    """Parse license.conf ONCE per file change (not ~10x per poll). Keyed on the
    file mtime, so an admin edit or _set_conf_key write refreshes it next read."""
    try:
        mtime = os.stat(CONF).st_mtime
    except OSError:
        return {}
    if _CONF_CACHE["mtime"] != mtime:
        data = {}
        try:
            with open(CONF) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, _, v = line.partition("=")
                        data[k.strip()] = v.strip().strip('"').strip("'")
        except OSError:
            pass
        _CONF_CACHE["mtime"] = mtime
        _CONF_CACHE["data"] = data
        # Whoever just wrote it (installer, activation file, this agent), it is made
        # root-only again here — every change passes through this read within a poll.
        _protect_license_conf(data)
    return _CONF_CACHE["data"]


def _protect_license_conf(data):
    """license.conf -> 0600, and the operator-readable copy of its public keys."""
    if os.geteuid() != 0 and not os.environ.get("TC_LICENSE_PUBLIC"):
        return                                   # not the service: leave files alone
    try:
        os.chmod(CONF, 0o600)
    except OSError:
        pass
    try:
        body = "".join("%s=%s\n" % (k, data.get(k, "")) for k in _PUBLIC_KEYS if k in data)
        try:
            with open(LICENSE_PUBLIC) as f:
                if f.read() == body:
                    return
        except OSError:
            pass
        os.makedirs(os.path.dirname(LICENSE_PUBLIC), exist_ok=True)
        tmp = LICENSE_PUBLIC + ".tmp"
        with open(tmp, "w") as f:
            f.write(body)
        os.chmod(tmp, 0o644)
        os.replace(tmp, LICENSE_PUBLIC)
    except OSError:
        pass


def conf_get(key: str, default: str = "") -> str:
    return _conf_all().get(key, default)


_DEVICE_ID = None


def device_id() -> str:
    global _DEVICE_ID
    if _DEVICE_ID is None:
        try:
            mid = open("/etc/machine-id").read().strip()
        except OSError:
            mid = os.uname().nodename
        _DEVICE_ID = hashlib.sha256(mid.encode()).hexdigest()[:32]  # immutable per box
    return _DEVICE_ID


def write_state(state: str, claims: dict | None):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(STATE_FILE, "w") as f:
            f.write("state=%s\n" % state)
            if claims:
                f.write("exp=%d\ntenant_id=%s\nplan=%s\n"
                        % (int(claims.get("exp", 0)), claims.get("tenant_id", ""),
                           claims.get("plan", "")))
        os.chmod(STATE_FILE, 0o644)
    except OSError:
        pass


# ------------------------------- commands ------------------------------------
def _set_conf_key(key: str, value: str):
    """Replace or append key=value in the licence config (/etc/thinclient/license.conf)."""
    try:
        try:
            with open(CONF) as f:
                lines = f.readlines()
        except OSError:
            lines = []
        out, found = [], False
        for ln in lines:
            if ln.lstrip().startswith(key + "="):
                out.append("%s=%s\n" % (key, value)); found = True
            else:
                out.append(ln)
        if not found:
            out.append("%s=%s\n" % (key, value))
        fd = os.open(CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.writelines(out)
        os.chmod(CONF, 0o600)                   # holds the device secret: root only
    except OSError:
        pass


# --------------------------- adoption (last-resort enrolment) -----------------
# A machine whose credentials or tenant token never landed is invisible AND
# unreachable: every manager<->device path is device-initiated and needs credentials,
# so there is no way in. It CAN still reach the update channel (which needs none), so
# once it has this code it can ask, in the open, to be adopted: it shows a short
# pairing code on its own screen and a super admin assigns it to an account.
#
# Security model: this request proves nothing and is given nothing. The admin
# recognising the machine IS the boundary. Credentials are collected afterwards using
# `secret` below, which is long, random, never displayed and never leaves the device
# except over TLS - so the 6-character code a human reads off the screen never has to
# carry any weight.
ADOPT_DIR = "/var/lib/thinclient/adopt"
ADOPT_CODE = os.path.join(ADOPT_DIR, "code")       # also read by the connect screen
ADOPT_SECRET = os.path.join(ADOPT_DIR, "secret")
_ADOPT_AT = [0.0]
_ADOPT_EVERY = 60
# Deliberately excludes O/0/I/1/S/5 - a code is read aloud off a screen.
_ADOPT_ALPHABET = "ABCDEFGHJKLMNPQRTUVWXYZ2346789"


def _hostname() -> str:
    try:
        return os.uname().nodename
    except Exception:
        return "thinclient"


def _machine_facts() -> dict:
    """A few recognisable details so the approver can tell WHICH machine is asking.
    Same shape thinclient-enroll reports, so the dashboard shows one consistent set of
    fields however a machine arrived. Best-effort — never fail on a missing sysfs file."""
    def rd(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except OSError:
            return ""
    facts = {}
    vendor, model = rd("/sys/class/dmi/id/sys_vendor"), rd("/sys/class/dmi/id/product_name")
    if vendor or model:
        facts["model"] = ("%s %s" % (vendor, model)).strip()
    serial = rd("/sys/class/dmi/id/product_serial")
    if serial and serial.lower() not in ("none", "default string", "to be filled by o.e.m."):
        facts["serial"] = serial
    try:
        for line in open("/proc/cpuinfo"):
            if line.startswith("model name"):
                facts["cpu"] = line.split(":", 1)[1].strip()
                break
    except OSError:
        pass
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("MemTotal"):
                facts["ram"] = "%d GB" % round(int(line.split()[1]) / 1048576.0)
                break
    except Exception:
        pass
    facts["version"] = _current_version()
    return facts


def _is_live_medium() -> bool:
    """True when we are running from the installer USB rather than an installed disk.
    The live image is one image on every stick, so anything that mints an identity
    here creates a machine that vanishes the moment the USB is unplugged."""
    return os.path.exists("/run/live/medium") or os.path.exists("/lib/live/mount")


def _adopt_identity():
    """This machine's pairing code + claim secret, created once and then reused so the
    code on screen stays stable across reboots (an admin may be told it by phone)."""
    try:
        os.makedirs(ADOPT_DIR, exist_ok=True)
        code = open(ADOPT_CODE).read().strip() if os.path.exists(ADOPT_CODE) else ""
        secret = open(ADOPT_SECRET).read().strip() if os.path.exists(ADOPT_SECRET) else ""
        if not code or len(code) < 7:
            raw = os.urandom(6)
            code = "%s-%s" % ("".join(_ADOPT_ALPHABET[b % len(_ADOPT_ALPHABET)] for b in raw[:3]),
                              "".join(_ADOPT_ALPHABET[b % len(_ADOPT_ALPHABET)] for b in raw[3:]))
            with open(ADOPT_CODE, "w") as f:
                f.write(code + "\n")
            os.chmod(ADOPT_CODE, 0o644)            # the connect screen displays it
        if not secret or len(secret) < 24:
            secret = base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip("=")
            with open(ADOPT_SECRET, "w") as f:
                f.write(secret + "\n")
            os.chmod(ADOPT_SECRET, 0o600)          # never displayed, never shared
        return code, secret
    except OSError:
        return "", ""


def _adopt_clear():
    for p in (ADOPT_CODE, ADOPT_SECRET):
        try: os.remove(p)
        except OSError: pass


def _adopt_cycle(base: str) -> bool:
    """Ask to be adopted, then collect credentials once an admin has approved.
    Returns True when this device just became enrolled."""
    # NEVER from the installer USB. ensure_enrolled() has always refused to
    # self-register here; adoption missed the same guard, so a live session would put
    # its own pairing code on screen while the operator was still installing. An
    # admin seeing that code approves it, and the fleet gains a phantom device that
    # dies at the next reboot, holds a licence seat, and makes a perfectly good
    # install look like it failed.
    if _is_live_medium():
        return False
    if time.time() - _ADOPT_AT[0] < _ADOPT_EVERY:
        return False
    _ADOPT_AT[0] = time.time()
    code, secret = _adopt_identity()
    if not (code and secret):
        return False
    hw = device_id()
    ident = {"hwid": hw, "pairing_code": code, "claim_secret": secret}
    # Collect first: if an admin approved since the last cycle, take the credentials
    # before re-announcing ourselves.
    st = _curl_json("%s/api/adopt/status" % base, dict(ident))
    if st and st.get("status") == "approved" and st.get("enroll_code") and st.get("secret"):
        _set_conf_key("ENROLL_CODE", st["enroll_code"])
        _set_conf_key("DEVICE_SECRET", st["secret"])
        _adopt_clear()
        print("agent: adopted by an administrator — enrolled as %s" % st["enroll_code"], file=sys.stderr)
        return True
    # "denied" is an admin decision — respect it and stop asking.
    if st and st.get("status") == "denied":
        return False
    # "claimed" used to stop here too, which was a one-way door: a machine whose
    # credentials were handed over but never actually arrived (or were later wiped)
    # asked once, was told "already claimed", and sat on the waiting screen forever
    # with no way back. Fall through to the request below instead — it either
    # re-issues to the holder of the original claim secret or puts this machine back
    # in the pending queue for an admin to approve again. Never a dead end.
    # Send the name the installer was given (DEVICE_NAME in license.conf) as well as
    # the hostname. Without it the manager can only fall back to the hostname, which on
    # a fresh install is still the ISO's own default — so an adopted machine came
    # back under a name nobody chose and had to be renamed by hand.
    _curl_json("%s/api/adopt/request" % base,
               dict(ident, hostname=_hostname(), name=conf_get("DEVICE_NAME", ""),
                    machine=_machine_facts()))
    print("agent: waiting to be adopted — pairing code %s" % code, file=sys.stderr)
    return False


def ensure_enrolled() -> bool:
    """Self-register into a tenant when TENANT_TOKEN is set but this device has no
    per-device credentials yet (first boot after an auto-enrol install)."""
    if conf_get("ENROLL_CODE") and conf_get("DEVICE_SECRET"):
        return True
    # Don't self-register the LIVE / installer environment — only the INSTALLED
    # system should appear in the fleet. (Live boots share one machine-id and
    # would otherwise create a throwaway device on every USB boot.)
    if os.path.exists("/run/live/medium") or os.path.exists("/lib/live/mount"):
        return False
    token = conf_get("TENANT_TOKEN")
    url = conf_get("CONTROL_URL")
    if not (token and url):
        return False
    # Prefer the name the admin typed at install time (DEVICE_NAME in
    # license.conf); fall back to the machine hostname.
    name = conf_get("DEVICE_NAME", "")
    if not name:
        try:
            name = os.uname().nodename
        except Exception:
            name = "thinclient"
    resp = _curl_json("%s/api/devices/register" % url.rstrip("/"),
                      {"tenant_token": token, "hwid": device_id(), "name": name})
    if resp and resp.get("enroll_code") and resp.get("secret"):
        _set_conf_key("ENROLL_CODE", resp["enroll_code"])
        _set_conf_key("DEVICE_SECRET", resp["secret"])
        print("agent: self-registered into tenant (enroll_code=%s)" % resp["enroll_code"], file=sys.stderr)
        return True
    return False


def cmd_enforce() -> int:
    ensure_enrolled()
    grace = int(conf_get("LICENSE_GRACE_SECONDS", str(GRACE_DEFAULT)) or GRACE_DEFAULT)
    did = device_id()
    url = conf_get("CONTROL_URL")
    code = conf_get("ENROLL_CODE")
    secret = conf_get("DEVICE_SECRET")

    # 1) Best-effort: rotate the token from the control plane.
    if url and code and secret:
        try:
            body = json.dumps({"enroll_code": code, "secret": secret, "hwid": did}).encode()
            os.makedirs(STATE_DIR, exist_ok=True)
            fresh = subprocess.run(
                ["curl", "-fsSL", "--connect-timeout", "15", "--max-time", "60",
                 "-H", "Content-Type: application/json", "-d", body.decode(),
                 "%s/api/licenses/token" % url.rstrip("/")],
                capture_output=True, text=True, timeout=90,
            )
            if fresh.returncode == 0 and fresh.stdout.strip():
                tok = json.loads(fresh.stdout).get("token", "")
                if tok:
                    verify_token(tok, PUBKEY)          # only cache if it verifies
                    with open(TOKEN_CACHE, "w") as f:
                        f.write(tok)
        except Exception:
            pass  # offline / server down -> fall back to the cached token

    # 2) Enforce using whatever token we have (fresh or previously cached).
    try:
        token = open(TOKEN_CACHE).read().strip()
        claims = verify_token(token, PUBKEY)
        state = license_state(claims, did, grace, time.time())
        write_state(state, claims)
    except Exception as e:
        # No valid token at all -> locked (fail closed). A never-licensed device
        # cannot run; a previously-licensed one keeps its last cached state file.
        if not os.path.exists(STATE_FILE):
            write_state("locked", None)
        print("agent: %s" % e, file=sys.stderr)
        return 1
    print(state)
    return 0


def cmd_state() -> int:
    try:
        sys.stdout.write(open(STATE_FILE).read())
    except OSError:
        print("state=unknown")
    return 0


def cmd_verify(argv) -> int:
    # verify <token_file> <pubkey> [device_id] [now] [grace]
    token = open(argv[0]).read()
    pubkey = argv[1]
    did = argv[2] if len(argv) > 2 else ""
    now = float(argv[3]) if len(argv) > 3 else time.time()
    grace = int(argv[4]) if len(argv) > 4 else GRACE_DEFAULT
    try:
        claims = verify_token(token, pubkey)
    except ValueError as e:
        print("invalid %s" % e)
        return 2
    print(license_state(claims, did, grace, now))
    return 0


# ------------------------- fleet ops: commands + stream ----------------------
ADMIN_LOCK = os.path.join(STATE_DIR, "admin-lock")   # connect window refuses RDP


def _read_admin_lock():
    """(epoch, mode, hours, message) from the admin-lock file, or None. File format:
    '<epoch>\\n<mode>\\n<hours>\\n<message>' where mode = 'timed' | 'permanent'. The
    message is optional and carries WORKING-HOURS text for a schedule lock (empty for
    a normal admin lock). Back-compat: an old single-line file (just the epoch) reads
    as a 24h timed lock with no message."""
    try:
        parts = open(ADMIN_LOCK).read().split("\n")
    except OSError:
        return None
    try:
        ts = int((parts[0].strip() if parts and parts[0].strip() else "0"))
    except ValueError:
        return None
    if ts <= 0:
        return None
    mode = parts[1].strip() if len(parts) > 1 and parts[1].strip() else "timed"
    try:
        hours = float(parts[2].strip()) if len(parts) > 2 and parts[2].strip() else float(conf_get("ADMIN_LOCK_MAX_HOURS", "24") or 24)
    except (TypeError, ValueError):
        hours = 24.0
    # The message may itself contain newlines only if we wrote them; we never do, so
    # everything after line 3 is the message (rejoined defensively).
    msg = "\n".join(parts[3:]).strip() if len(parts) > 3 else ""
    return (ts, "permanent" if mode == "permanent" else "timed", hours, msg)


def _drop_rdp_session(reason: str = "") -> None:
    """End the RDP session that is running RIGHT NOW.

    A lock has to do two things: refuse the NEXT connection, and end the CURRENT one.
    set_admin_lock() only does the first — it writes the state file that the connect
    window reads. But the connect window sits BEHIND the operator's full-screen RDP
    session, so on a machine already in use a lock was completely invisible: the
    dashboard said "locked", the red banner was painted on a window nobody could see,
    and the operator carried on working. The manual LOCK command always killed the
    session for this reason; the working-hours lock never did, which is why an access
    group appeared to do nothing at all.
    """
    if not _rdp_active():
        return
    for name in ("xfreerdp3", "xfreerdp"):
        try:
            subprocess.run(["pkill", "-x", name], capture_output=True, timeout=10)
        except Exception:
            pass
    if reason:
        print("agent: ended the RDP session (%s)" % reason, file=sys.stderr)


def set_admin_lock(locked: bool, mode: str = "timed", hours: float = 24.0, message: str = ""):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        if locked:
            m = "permanent" if str(mode).lower() == "permanent" else "timed"
            msg = (message or "").replace("\n", " ").strip()
            prev = _read_admin_lock()
            if prev is None:
                # PRESERVE the original lock time on re-asserting polls (drives expiry).
                with open(ADMIN_LOCK, "w") as f:
                    f.write("%d\n%s\n%g\n%s\n" % (int(time.time()), m, float(hours), msg))
            elif prev[1] != m or abs(prev[2] - float(hours)) > 0.01 or prev[3] != msg:
                # Mode, duration or the working-hours text changed — update in place,
                # keeping the original start so expiry still measures from the lock.
                with open(ADMIN_LOCK, "w") as f:
                    f.write("%d\n%s\n%g\n%s\n" % (prev[0], m, float(hours), msg))
        elif os.path.exists(ADMIN_LOCK):
            os.remove(ADMIN_LOCK)
    except OSError:
        pass


def _admin_lock_expired() -> bool:
    """A TIMED admin lock auto-releases after its hours (a safety net so an offline or
    forgotten lock doesn't strand the operator forever). A PERMANENT lock never
    auto-expires — it clears only on a manager UNLOCK."""
    info = _read_admin_lock()
    if not info:
        return False
    ts, mode, hours, _msg = info
    if mode == "permanent":
        return False
    return (time.time() - ts) > hours * 3600


ACCESS_WARN = os.path.join(RUN_DIR, "access-warn")   # netbadge shows a countdown


def _set_access_warn(minutes):
    """Publish 'your machine locks in N minutes' for the floating net badge, or clear
    it. Written to RUN_DIR (tmpfs) because it is live state, not configuration."""
    try:
        n = int(minutes) if minutes else 0
    except (TypeError, ValueError):
        n = 0
    try:
        if n > 0:
            os.makedirs(RUN_DIR, exist_ok=True)
            tmp = ACCESS_WARN + ".tmp"
            with open(tmp, "w") as f:
                f.write("MINUTES=%d\nTS=%d\n" % (n, int(time.time())))
            os.replace(tmp, ACCESS_WARN)       # atomic: the badge never reads a half file
        elif os.path.exists(ACCESS_WARN):
            os.remove(ACCESS_WARN)
    except OSError:
        pass


# After an admin lock auto-expires, ignore the manager's still-set `locked` flag
# until it toggles OFF (a genuine unlock) — so a stale/forgotten lock doesn't keep
# re-locking the operator. Reset when the manager sends locked=false.
_ADMIN_LOCK_EXPIRED_IGNORE = False


def _curl_json(url: str, payload: dict) -> dict | None:
    try:
        r = subprocess.run(
            ["curl", "-fsS", "--max-time", "30", "-X", "POST",
             "-H", "content-type: application/json", "-d", json.dumps(payload), url],
            capture_output=True, text=True, timeout=40,
        )
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout)
    except Exception:
        pass
    return None


# ---------------------------------------------------------------------------
#  Disk hygiene + log sync
#
#  A thin client is an appliance nobody logs into, so anything that grows without a
#  ceiling grows until the disk is full — and a full disk takes down recording, the
#  update, and the RDP session together. Two things had no ceiling: the systemd
#  JOURNAL (systemd's own default is 10% of the filesystem, up to 4 GB) and, on any
#  machine installed from an image that predates it, our logrotate rule. Both are
#  system config, which the OTA payload cannot carry (it ships bin/lib/assets/share
#  only) — so the agent asserts them at runtime instead, which also repairs a device
#  whose config was lost.
# ---------------------------------------------------------------------------
JOURNALD_DROPIN = "/etc/systemd/journald.conf.d/thinclient.conf"
LOGROTATE_CONF = "/etc/logrotate.d/thinclient"
JOURNAL_CAP = "200M"

_JOURNALD_CONF = """# ThinClient OS — written by thinclient-agent. Keep the journal bounded: this is an
# appliance, and an unbounded journal eventually fills the disk and takes recording,
# updates and the session down with it.
[Journal]
SystemMaxUse=%s
SystemMaxFileSize=20M
RuntimeMaxUse=50M
MaxRetentionSec=2week
""" % JOURNAL_CAP

_LOGROTATE_CONF = """/var/log/thinclient/*.log {
    daily
    rotate 7
    size 5M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root thinclient
    create 0640 root thinclient
}
"""


UPDATE_STATE = "/var/lib/thinclient/update-last"


def _update_last() -> dict:
    """The outcome of the most recent update attempt, as recorded by thinclient-update.
    Reported on every poll so a device that keeps trying and failing SAYS SO, instead
    of presenting an endless spinner with no reason attached."""
    st = {}
    try:
        with open(UPDATE_STATE) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    st[k.strip()] = v.strip()
    except OSError:
        return {}        # no attempt recorded yet — normal on a fresh device
    res = (st.get("result") or "").strip()
    if res not in ("ok", "failed", "rolled_back"):
        return {}
    out = {"upd_result": res}
    if st.get("version"):
        out["upd_version"] = st["version"][:32]
    if st.get("message"):
        out["upd_message"] = st["message"][:200]
    try:
        if st.get("at"):
            out["upd_at_ms"] = int(st["at"]) * 1000
    except ValueError:
        pass
    return out


def _disk_stats() -> dict:
    """Used-percent and free MB for the root filesystem. Reported on every poll so a
    device filling up is VISIBLE before it breaks, instead of being discovered when
    recording silently stops."""
    try:
        st = os.statvfs("/")
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        if total <= 0:
            return {}
        return {"disk_pct": round((total - free) * 100.0 / total, 1),
                "disk_free_mb": int(free / 1048576)}
    except Exception:
        return {}


def _write_if_absent(path: str, body: str) -> bool:
    """Write a config file only when it is missing. Never overwrite: an operator may
    have tuned it deliberately, and this runs on every agent start."""
    try:
        if os.path.exists(path):
            return False
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(body)
        os.chmod(path, 0o644)
        return True
    except OSError as e:
        print("agent: could not write %s: %s" % (path, e), file=sys.stderr)
        return False


def _disk_hygiene():
    """Assert the log ceilings once per agent start. Idempotent and cheap: if both
    files are already there this does nothing but one vacuum check."""
    try:
        if _is_live_medium():
            return                      # the USB is read-only and throwaway
        if _write_if_absent(JOURNALD_DROPIN, _JOURNALD_CONF):
            print("agent: capped the systemd journal at %s" % JOURNAL_CAP, file=sys.stderr)
            subprocess.run(["systemctl", "restart", "systemd-journald"],
                           capture_output=True, timeout=30)
        if _write_if_absent(LOGROTATE_CONF, _LOGROTATE_CONF):
            print("agent: installed the logrotate rule for /var/log/thinclient", file=sys.stderr)
        # Bring an ALREADY-oversized journal back under the cap. Writing the config
        # alone only bounds future growth; a device that has been running for months
        # keeps whatever it accumulated until something vacuums it.
        subprocess.run(["journalctl", "--vacuum-size=" + JOURNAL_CAP],
                       capture_output=True, timeout=120)
    except Exception as e:
        print("agent: disk hygiene skipped: %s" % e, file=sys.stderr)


# Periodic diagnostics sync. The on-demand GETLOGS path already builds and uploads a
# bundle; this simply puts it on a schedule so a problem can be investigated AFTER the
# fact, rather than only while someone is watching. LOG_SYNC_HOURS=0 disables it.
_LOG_SYNC_AT = [0.0]
_HYGIENE_CHECKED = False


def _log_sync_maybe():
    try:
        hrs = float(conf_get("LOG_SYNC_HOURS", "24") or 24)
    except ValueError:
        hrs = 24.0
    if hrs <= 0:
        return
    now = time.time()
    if _LOG_SYNC_AT[0] == 0.0:
        # Stagger the first run per machine so a fleet coming up together does not
        # upload every bundle in the same minute.
        _LOG_SYNC_AT[0] = now - (hrs * 3600.0) + (int(device_id()[:8], 16) % 3600)
        return
    if now - _LOG_SYNC_AT[0] < hrs * 3600.0:
        return
    _LOG_SYNC_AT[0] = now
    threading.Thread(target=_upload_logs, daemon=True).start()


def _collect_logs_tar():
    """Bundle a diagnostics snapshot into a .tar.gz; return its path (or None).
    Captures the resource picture (top/free/ps/loadavg) + kernel + journal + the
    thinclient logs + running capture/RDP processes — enough to diagnose a freeze
    or a stuck session. Secrets in license.conf are redacted."""
    import glob
    d = tempfile.mkdtemp(prefix="tclogs-")

    def _run(name, cmd):
        try:
            with open(os.path.join(d, name), "wb") as f:
                subprocess.run(_nice() + cmd, stdout=f, stderr=subprocess.STDOUT, timeout=30)
        except Exception:
            pass

    def _run_user(name, cmd):
        """Run a command inside the kiosk user's session (so it can reach that
        user's PipeWire/DBus) — wpctl as root just prints 'Could not connect to
        PipeWire', which made every audio snapshot useless."""
        try:
            import pwd
            user = conf_get("SESSION_USER", "thinclient")
            uid = pwd.getpwnam(user).pw_uid
            full = ["sudo", "-n", "-u", user,
                    "XDG_RUNTIME_DIR=/run/user/%d" % uid,
                    "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%d/bus" % uid] + cmd
            with open(os.path.join(d, name), "wb") as f:
                subprocess.run(full, stdout=f, stderr=subprocess.STDOUT, timeout=30)
        except Exception:
            pass

    _run("uptime.txt", ["uptime"])
    _run("loadavg.txt", ["cat", "/proc/loadavg"])
    _run("meminfo.txt", ["free", "-m"])
    _run("top.txt", ["top", "-bn1"])
    _run("ps-by-cpu.txt", ["ps", "-eo", "pid,ppid,pcpu,pmem,rss,stat,comm", "--sort=-pcpu"])
    _run("df.txt", ["df", "-h"])
    _run("dmesg.txt", ["dmesg", "--ctime"])
    _run("journal.txt", ["journalctl", "-b", "--no-pager", "-n", "4000"])
    # PREVIOUS boot — the crucial one after a full hang + power-cycle/watchdog reboot
    # (needs the persistent journal from _ensure_call_stability; empty on old boots).
    _run("prev-boot.txt", ["journalctl", "-b", "-1", "--no-pager", "-n", "6000"])
    _run("prev-boot-kernel.txt", ["journalctl", "-b", "-1", "-k", "--no-pager"])
    _run("capture-procs.txt", ["pgrep", "-a", "-f", "xfreerdp|ffmpeg|Xorg|thinclient|wireplumber|pipewire"])
    # --- Why a capture input will not deliver -------------------------------------
    # A camera or microphone that ENUMERATES but never produces frames leaves no error
    # anywhere: ffmpeg just blocks, its stderr stays empty, and from outside it is
    # indistinguishable from a healthy capture. These probe the inputs DIRECTLY and
    # keep whatever they say. Every probe is time-bounded (-t) and wrapped in a hard
    # timeout — an unbounded v4l2/pulse read is exactly the kind of thing that hangs
    # a diagnostics collector forever.
    _run("usb-tree.txt", ["lsusb", "-t"])
    _run("usb-devices.txt", ["lsusb"])
    _run("video-holders.txt", ["sh", "-c", "fuser -v /dev/video* 2>&1 | head -20"])
    _run("video-formats.txt", ["sh", "-c",
         "for d in /dev/video*; do echo \"== $d\"; v4l2-ctl -d $d --list-formats-ext 2>&1 | head -25; done"])
    _run("audio-sources.txt", ["sh", "-c",
         "runuser -u thinclient -- wpctl status 2>&1 | sed -n '/Sources:/,/^$/p' | head -20"])
    # The decisive pair: try to actually READ two seconds from each input.
    # Try EVERY plausible input format, not just the one we happen to pin. Asking a
    # camera for a format it does not offer does not error — it hangs — so a single
    # pinned probe just reproduces the bug instead of diagnosing it. Testing the
    # alternatives is what distinguishes "this camera is broken" from "we asked it
    # the wrong question", and that distinction decides whether hardware gets bought.
    _run("probe-camera.txt", ["sh", "-c",
         "for f in yuyv422 NONE mjpeg; do "
         "  echo \"===== input_format=$f\"; "
         "  if [ \"$f\" = NONE ]; then a=''; else a=\"-input_format $f\"; fi; "
         "  timeout 7 ffmpeg -hide_banner $a -f v4l2 -video_size 640x480 -framerate 10 "
         "    -i /dev/video0 -t 2 -f null - 2>&1 | tail -6; "
         "  echo \"result=$?\"; "
         "done"])
    _run("probe-mic.txt", ["sh", "-c",
         "timeout 20 ffmpeg -hide_banner -f pulse -i default -t 2 -f null - 2>&1 | tail -20; echo \"exit=$?\""])

    # The RECORDER's own stderr. Without this a stalled capture could only be inferred
    # from the outside — ffmpeg alive, /tmp empty, and no way to see what it was
    # complaining about. ffmpeg writes here per session; take the newest few.
    try:
        errs = sorted(glob.glob("/tmp/tcrec-*/ffmpeg.err"), key=os.path.getmtime, reverse=True)[:3]
        for i, e in enumerate(errs):
            try:
                shutil.copy(e, os.path.join(d, "ffmpeg-err-%d.txt" % i))
            except OSError:
                pass
        # What the recorder actually produced, which is the other half of the picture.
        _run("rec-tmp-listing.txt", ["sh", "-c",
             "ls -la /tmp/tcrec-*/ /tmp/tcrec-*/screen /tmp/tcrec-*/camera 2>/dev/null | head -60"])
    except Exception:
        pass
    # --- RDP FREEZE ROOT-CAUSE CAPTURE ---------------------------------------
    # The call-time freeze is a spin-loop in ONE FreeRDP thread (load ~1.0, X alive,
    # codec-independent). Capture WHICH thread is hot + a full backtrace so we can see
    # the exact loop (audio channel is the prime suspect). gdb gives the userspace
    # stack; install it on demand if missing (best-effort). Disable via RDP_FREEZE_GDB=0.
    rpid = ""
    for _b in ("xfreerdp3", "xfreerdp"):
        try:
            _o = subprocess.run(["pgrep", "-o", "-x", _b], capture_output=True, text=True, timeout=5).stdout.strip()
            if _o:
                rpid = _o.split()[0]; break
        except Exception:
            pass
    if rpid:
        # per-thread CPU + state + what each is blocked on (the hot one is the spinner)
        _run("rdp-threads.txt", ["ps", "-L", "-o", "pid,tid,pcpu,stat,wchan:28,comm", "--sort=-pcpu", "-p", rpid])
        try:
            with open(os.path.join(d, "rdp-thread-stacks.txt"), "w") as f:
                for tdir in sorted(glob.glob("/proc/%s/task/*" % rpid)):
                    f.write("== tid %s ==\n" % os.path.basename(tdir))
                    for nm in ("comm", "wchan", "syscall", "stack"):
                        try:
                            f.write("%s: %s\n" % (nm, open(os.path.join(tdir, nm)).read().strip()))
                        except OSError:
                            pass
                    f.write("\n")
        except Exception:
            pass
        if conf_get("RDP_FREEZE_GDB", "1").lower() not in ("0", "false", "no", "off"):
            if not shutil.which("gdb"):
                try:
                    subprocess.run(["apt-get", "install", "-y", "--no-install-recommends", "gdb"],
                                   capture_output=True, timeout=200)
                except Exception:
                    pass
            if shutil.which("gdb"):
                _run("rdp-gdb-backtrace.txt", ["gdb", "-p", rpid, "-batch", "-nx",
                     "-ex", "set pagination off", "-ex", "thread apply all bt",
                     "-ex", "detach", "-ex", "quit"])
    _run_user("audio.txt", ["wpctl", "status"])   # as the kiosk user -> real graph
    # Inspect the current default sink + source so we can see EXACTLY which mic is
    # live (the "customers can't hear" case = the wrong mic, e.g. a webcam, chosen).
    _run_user("audio-default.txt", ["sh", "-c",
              "for id in $(wpctl status | sed -n '/Sinks:/,/Source outputs:/p' "
              "| grep -oE '\\*[[:space:]]+[0-9]+' | grep -oE '[0-9]+'); do "
              "echo '== default sink/source'; wpctl inspect \"$id\" "
              "| grep -E 'node.name|node.description|device.bus|alsa.card_name'; done"])
    _run("swaps.txt", ["cat", "/proc/swaps"])
    _run("net.txt", ["nmcli", "device", "status"])
    try:
        with open(os.path.join(d, "version.txt"), "w") as f:
            f.write("version=%s\nrdp_active=%s\n" % (_current_version(), _rdp_active()))
    except Exception:
        pass
    for lg in glob.glob("/var/log/thinclient/*.log"):
        try:
            shutil.copy(lg, os.path.join(d, "tc-" + os.path.basename(lg)))
        except Exception:
            pass
    # RDP connect errors the operator hit (connect writes plain-language to the
    # screen; the FULL technical detail lands here for an admin to pull).
    try:
        if os.path.exists("/run/thinclient/rdp-errors.log"):
            shutil.copy("/run/thinclient/rdp-errors.log", os.path.join(d, "rdp-errors.log"))
    except Exception:
        pass
    try:  # SANITISED license.conf — never ship secrets in a log bundle
        redact = ("DEVICE_SECRET", "PASSWORD", "TENANT_TOKEN", "ENROLL_CODE")
        with open(CONF) as f, open(os.path.join(d, "license.conf.txt"), "w") as o:
            for line in f:
                o.write("%s=<redacted>\n" % line.split("=", 1)[0] if line.split("=", 1)[0] in redact else line)
    except Exception:
        pass

    tarpath = os.path.join(tempfile.gettempdir(), "tclogs-%d.tar.gz" % int(time.time()))
    try:
        subprocess.run(_nice() + ["tar", "-czf", tarpath, "-C", d, "."], timeout=60)
    except Exception:
        tarpath = None
    shutil.rmtree(d, ignore_errors=True)
    return tarpath if (tarpath and os.path.exists(tarpath)) else None


def _upload_logs():
    """GETLOGS handler: collect the diagnostics bundle and upload it to the tenant
    bucket (reuses the recording upload path with kind='logs')."""
    if os.path.exists("/run/live/medium") or os.path.exists("/lib/live/mount"):
        return
    url = conf_get("CONTROL_URL"); code = conf_get("ENROLL_CODE"); secret = conf_get("DEVICE_SECRET")
    if not (url and code and secret):
        return
    base = url.rstrip("/")
    creds = {"enroll_code": code, "secret": secret, "hwid": device_id()}
    path = _collect_logs_tar()
    if not path:
        print("agent: log collection failed", file=sys.stderr); return
    try:
        resp = _curl_json("%s/api/agent/upload-url" % base, dict(creds, kind="logs"))
        if not resp or not resp.get("upload_url"):
            print("agent: no logs upload URL (tenant storage configured?)", file=sys.stderr); return
        size = os.path.getsize(path)
        rc = subprocess.run(["curl", "-fsS", "--max-time", "300", "-X", "PUT",
                             "-H", "content-type: application/gzip", "--upload-file", path, resp["upload_url"]],
                            capture_output=True, timeout=310).returncode
        _curl_json("%s/api/agent/recording-done" % base,
                   dict(creds, recording_id=resp.get("recording_id"), size_bytes=size, ok=(rc == 0)))
        print("agent: uploaded logs (%d bytes, ok=%s)" % (size, rc == 0), file=sys.stderr)
    finally:
        try: os.remove(path)
        except Exception: pass


def _chat_quote_of(mid: str):
    """Build the quote block for a message we already have in the local log, so a
    reply shows its quote instantly instead of waiting for the server to echo it."""
    if not mid:
        return None
    try:
        with open(CHAT_LOG) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except Exception:
                    continue
                if str(e.get("id", "")) == str(mid):
                    return {"id": mid,
                            "from": "admin" if e.get("sender") == "admin" else "me",
                            "body": str(e.get("body", ""))[:140],
                            "is_image": bool(e.get("att"))}
    except OSError:
        pass
    return None


def _chat_append(sender: str, body: str, at=None, frm=None, mid=None, att=None, reply=None):
    try:
        os.makedirs(CHAT_DIR, exist_ok=True)
        entry = {"sender": sender, "body": body, "at": at or time.time()}
        if reply:
            entry["reply"] = reply     # {"id","from","body","is_image"} for the quote
        if frm:
            entry["from"] = frm        # admin alias ("Admin 1"/"Super Admin 2") for display
        if mid:
            entry["id"] = mid          # manager message id (so reactions can target it)
        if att:
            entry["att"] = att         # local image path for thinclient-chat to render inline
        with open(CHAT_LOG, "a") as f:
            f.write(json.dumps(entry) + "\n")
        os.chmod(CHAT_LOG, 0o644)
    except OSError:
        pass


def _entry_epoch(at):
    """Epoch seconds for a log entry's `at` — device messages store time.time()
    (a number), admin messages store the manager's ISO createdAt (a string)."""
    if at is None:
        return None
    if isinstance(at, (int, float)):
        return float(at)
    s = str(at)
    try:
        return float(s)                       # epoch as a string
    except ValueError:
        pass
    try:
        return datetime.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


_CHAT_LAST_PRUNE = 0.0

def _chat_prune(days):
    """Trim the local chat log (and delete its now-expired image attachments) to the
    last `days` days — matching the manager's message-retention sweep so the device
    doesn't keep chat forever. Throttled to ~once every 6h. `days` comes from the
    poll (chat_retention_days); default/clamp 1..7."""
    global _CHAT_LAST_PRUNE
    now = time.time()
    if now - _CHAT_LAST_PRUNE < 6 * 3600:
        return
    _CHAT_LAST_PRUNE = now
    try:
        days = max(1, min(7, int(days or 7)))
    except (TypeError, ValueError):
        days = 7
    cutoff = now - days * 86400
    if not os.path.exists(CHAT_LOG):
        return
    try:
        kept, dropped_atts = [], []
        with open(CHAT_LOG) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    e = json.loads(line)
                except ValueError:
                    continue                  # drop corrupt lines
                ts = _entry_epoch(e.get("at"))
                if ts is None or ts >= cutoff:
                    kept.append(line)         # keep fresh (and un-timestamped) entries
                elif e.get("att"):
                    dropped_atts.append(e["att"])
        tmp = CHAT_LOG + ".tmp"
        with open(tmp, "w") as f:
            if kept:
                f.write("\n".join(kept) + "\n")
        os.replace(tmp, CHAT_LOG)
        os.chmod(CHAT_LOG, 0o644)
        for a in dropped_atts:                # reclaim the local image files too
            try:
                if a and os.path.isfile(a):
                    os.remove(a)
            except OSError:
                pass
    except OSError:
        pass


# --- chat image attachments -------------------------------------------------
_CHAT_LAST_ACTIVITY = 0.0   # bumped on any chat traffic; drives the fast poll cadence
_ATT_EXT = {"image/png": "png", "image/jpeg": "jpg", "image/webp": "webp", "image/gif": "gif"}


def _chat_active() -> bool:
    """True when the operator is actively chatting — the panel is open (chat-active
    heartbeat fresh) or a message flowed in the last 45s — so the daemon polls fast."""
    try:
        if time.time() - os.stat(CHAT_ACTIVE).st_mtime < 8:
            return True
    except OSError:
        pass
    return (time.time() - _CHAT_LAST_ACTIVITY) < 45


_EMOJI_FONT_CHECKED = False
EMOJI_MARKER = "/var/lib/thinclient/.emoji-font-tried"


def _ensure_emoji_font():
    """Install a colour emoji font if the image predates it.

    OTA updates ship SCRIPTS only (bin/ + lib/), never packages — so a font added
    to the build's package list reaches existing devices only via a new ISO. Until
    then every emoji in the chat renders as an empty box, which reads as a broken
    chat. This is a one-shot, idempotent self-heal: it runs at most once per device
    (marker file), only when the font is genuinely absent, and never blocks polling.
    The font is only picked up by already-running GUI apps after a restart.
    """
    global _EMOJI_FONT_CHECKED
    if _EMOJI_FONT_CHECKED:
        return
    _EMOJI_FONT_CHECKED = True
    try:
        if os.path.exists(EMOJI_MARKER):
            return
        have = subprocess.run(["fc-list", ":family"], capture_output=True, text=True, timeout=20)
        if have.returncode == 0 and "noto color emoji" in (have.stdout or "").lower():
            return                                  # already present, nothing to do
        print("agent: no colour emoji font — installing fonts-noto-color-emoji", file=sys.stderr)
        env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
        subprocess.run(["apt-get", "update", "-qq"], env=env, capture_output=True, timeout=180)
        r = subprocess.run(["apt-get", "install", "-y", "--no-install-recommends",
                            "fonts-noto-color-emoji"],
                           env=env, capture_output=True, text=True, timeout=600)
        # Marker either way: a device with no package source must not retry forever.
        os.makedirs(os.path.dirname(EMOJI_MARKER), exist_ok=True)
        with open(EMOJI_MARKER, "w") as f:
            f.write("%d rc=%d\n" % (int(time.time()), r.returncode))
        if r.returncode == 0:
            subprocess.run(["fc-cache", "-f"], capture_output=True, timeout=120)
            print("agent: colour emoji font installed (visible after the next restart)", file=sys.stderr)
        else:
            print("agent: emoji font install failed: %s"
                  % (r.stderr or "").strip()[-200:], file=sys.stderr)
    except Exception as e:
        print("agent: emoji font check failed: %s" % e, file=sys.stderr)


def _operator_typing() -> bool:
    """True while thinclient-chat is touching the typing heartbeat. Deliberately a
    short window: a crashed panel must not leave the admin's indicator stuck on."""
    try:
        return (time.time() - os.stat(CHAT_TYPING).st_mtime) < 4
    except OSError:
        return False


def _set_admin_typing(on: bool):
    """Publish 'the admin is typing' for the chat panel to render."""
    try:
        if on:
            os.makedirs(RUN_DIR, exist_ok=True)
            with open(CHAT_ADMIN_TYPING, "w") as f:
                f.write("%d\n" % int(time.time()))
        elif os.path.exists(CHAT_ADMIN_TYPING):
            os.remove(CHAT_ADMIN_TYPING)
    except OSError:
        pass


def _capture_screenshot() -> str | None:
    """Grab the current screen (whatever the operator sees, incl. the RDP session)
    to a temp JPEG. Returns the path or None."""
    env, disp = _rec_env()
    try:
        out = os.path.join(tempfile.mkdtemp(prefix="tcshot-"), "shot.jpg")
        p = subprocess.run(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-f", "x11grab", "-i", disp,
             "-frames:v", "1", "-q:v", "4", "-y", out],
            env=env, capture_output=True, timeout=15)
        if p.returncode == 0 and os.path.exists(out) and os.path.getsize(out) > 0:
            return out
    except Exception:
        pass
    return None


def _chat_att_fetch(base: str, creds: dict, mid: str, mime: str) -> str | None:
    """Download an admin's image attachment for message `mid` to the local att
    store; return the saved path (or None)."""
    if not mid:
        return None
    ext = _ATT_EXT.get(mime or "", "jpg")
    dst = os.path.join(CHAT_ATT_DIR, "%s.%s" % (mid, ext))
    if os.path.exists(dst) and os.path.getsize(dst) > 0:
        return dst
    try:
        os.makedirs(CHAT_ATT_DIR, exist_ok=True)
        rc = subprocess.run(
            ["curl", "-fsS", "--max-time", "30", "-X", "POST",
             "-H", "content-type: application/json",
             "-d", json.dumps(dict(creds, id=mid)), "-o", dst,
             "%s/api/agent/chat-att" % base],
            capture_output=True, timeout=35).returncode
        if rc == 0 and os.path.exists(dst) and os.path.getsize(dst) > 0:
            os.chmod(dst, 0o644)
            return dst
        try: os.remove(dst)
        except OSError: pass
    except Exception:
        pass
    return None


def _chat_upload_image(base: str, creds: dict, path: str, caption: str = "") -> dict | None:
    """Share a local image with the admins (multipart). Returns the manager resp."""
    mime = "image/jpeg"
    if path.endswith(".png"):
        mime = "image/png"
    try:
        args = ["curl", "-fsS", "--max-time", "60", "-X", "POST",
                "-F", "enroll_code=%s" % creds.get("enroll_code", ""),
                "-F", "secret=%s" % creds.get("secret", ""),
                "-F", "hwid=%s" % creds.get("hwid", "")]
        if caption:
            args += ["-F", "body=%s" % caption[:2000]]
        args += ["-F", "file=@%s;type=%s" % (path, mime), "%s/api/agent/message" % base]
        r = subprocess.run(args, capture_output=True, text=True, timeout=70)
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout)
        # Silence here is what made a stuck screenshot queue undiagnosable: the
        # operator saw "sending..." forever and nothing said why.
        print("agent: chat image upload failed (curl %s): %s %s"
              % (r.returncode, (r.stderr or "").strip()[-200:], (r.stdout or "").strip()[:200]),
              file=sys.stderr)
    except Exception as e:
        print("agent: chat image upload error: %s" % e, file=sys.stderr)
    return None


def _chat_set_reaction(mid: str, reaction):
    """Set/clear the reaction on a logged message (matched by manager id) by
    rewriting the small JSONL log. Used for admin reactions on operator messages."""
    if not mid:
        return
    try:
        lines = open(CHAT_LOG).read().splitlines()
    except OSError:
        return
    out, changed = [], False
    for ln in lines:
        try:
            e = json.loads(ln)
        except Exception:
            out.append(ln); continue
        if e.get("id") == mid:
            if reaction:
                e["reaction"] = reaction
            else:
                e.pop("reaction", None)
            changed = True
        out.append(json.dumps(e))
    if changed:
        try:
            with open(CHAT_LOG, "w") as f:
                f.write("\n".join(out) + "\n")
        except OSError:
            pass


def _chat_sync(base: str, creds: dict, admin_msgs: list, reactions=None):
    """Deliver admin replies (with their alias + any image) into the local log
    (+ raise the unread badge), apply admin reactions to the operator's messages,
    then flush the operator's outbox (text, quick reactions, AND screenshots).
    thinclient-chat is the UI."""
    global _CHAT_LAST_ACTIVITY
    if os.path.exists("/run/live/medium") or os.path.exists("/lib/live/mount"):
        return
    try:
        os.makedirs(CHAT_OUTBOX, exist_ok=True); os.chmod(CHAT_OUTBOX, 0o1777)
    except OSError:
        pass
    new = 0
    for m in admin_msgs or []:
        body = str(m.get("body", "")).strip()
        att_path = None
        if m.get("att"):                      # admin shared an image — fetch it to show
            att_path = _chat_att_fetch(base, creds, str(m.get("id", "")), str(m.get("att")))
        if body or att_path:
            _chat_append("admin", body, m.get("at"), frm=m.get("from"), mid=m.get("id"),
                         att=att_path, reply=m.get("reply_to")); new += 1
    # Admin reactions placed on the operator's own messages.
    for rx in reactions or []:
        _chat_set_reaction(str(rx.get("id", "")), rx.get("reaction"))
    if new:  # bump the unread count — the chat launcher bubble shows the badge
        _CHAT_LAST_ACTIVITY = time.time()
        try:
            cur = int((open(CHAT_UNREAD).read().strip() or "0"))
        except Exception:
            cur = 0
        try:
            with open(CHAT_UNREAD, "w") as f:
                f.write(str(cur + new))
        except OSError:
            pass
    # Send queued operator messages + reactions + screenshots; on success log them
    # + drop the file.
    try:
        files = sorted(os.listdir(CHAT_OUTBOX))
    except OSError:
        files = []
    for name in files:
        p = os.path.join(CHAT_OUTBOX, name)
        try:
            with open(p) as f:
                raw = f.read().strip()
        except OSError:
            continue
        if not raw:
            try: os.remove(p)
            except OSError: pass
            continue
        # Outbox item is EITHER plain text, OR JSON: {"reactTo","reaction"} for a
        # reaction, {"screenshot":true,"body"?} to share the current screen.
        # Outbox JSON may also be {"body":..., "reply_to": <id>} — a normal message
        # that quotes an earlier one.
        rx = shot = None
        reply_to = ""
        if raw.startswith("{"):
            try:
                j = json.loads(raw)
                if j.get("reactTo"): rx = j
                elif j.get("screenshot"): shot = j
                elif j.get("body") is not None:
                    reply_to = str(j.get("reply_to", "") or "")
                    raw = str(j.get("body", ""))     # send the text, keep the quote
            except Exception:
                pass
        if rx:
            resp = _curl_json("%s/api/agent/message" % base,
                              dict(creds, reactTo=str(rx["reactTo"]), reaction=str(rx.get("reaction", ""))))
            if resp and resp.get("ok"):
                _chat_set_reaction(str(rx["reactTo"]), rx.get("reaction"))
                _CHAT_LAST_ACTIVITY = time.time()
                try: os.remove(p)
                except OSError: pass
        elif shot is not None:
            cap = str(shot.get("body", ""))
            path = _capture_screenshot()
            if path:
                resp = _chat_upload_image(base, creds, path, cap)
                if not (resp and resp.get("ok")):
                    # A failed upload used to leave the outbox file in place, so it
                    # retried forever — and every press of the button stacked another
                    # "sending..." bubble that could never clear. Retry a few times,
                    # then give up and SAY so.
                    n = _CHAT_SHOT_FAILS.get(name, 0) + 1
                    _CHAT_SHOT_FAILS[name] = n
                    if n >= _CHAT_SHOT_MAX_TRIES:
                        _CHAT_SHOT_FAILS.pop(name, None)
                        _chat_append("device",
                                     "Couldn't share the screenshot (upload failed). "
                                     "Please try again.", time.time())
                        print("agent: giving up on screenshot after %d attempts" % n, file=sys.stderr)
                        try: os.remove(p)
                        except OSError: pass
                if resp and resp.get("ok"):
                    _CHAT_SHOT_FAILS.pop(name, None)
                    mid = resp.get("id")
                    local = None
                    try:
                        os.makedirs(CHAT_ATT_DIR, exist_ok=True)
                        local = os.path.join(CHAT_ATT_DIR, "%s.jpg" % mid)
                        shutil.copyfile(path, local); os.chmod(local, 0o644)
                    except OSError:
                        local = path
                    _chat_append("device", cap, time.time(), mid=mid, att=local)
                    _CHAT_LAST_ACTIVITY = time.time()
                    try: os.remove(p)
                    except OSError: pass
                try: shutil.rmtree(os.path.dirname(path), ignore_errors=True)
                except Exception: pass
            else:
                # capture failed — drop the request so it doesn't wedge the outbox
                try: os.remove(p)
                except OSError: pass
        else:
            payload = dict(creds, body=raw[:2000])
            if reply_to:
                payload["reply_to"] = reply_to
            resp = _curl_json("%s/api/agent/message" % base, payload)
            if resp and resp.get("ok"):
                # Mirror the quote locally so our own bubble shows it immediately,
                # rather than only after a round trip.
                _chat_append("device", raw, time.time(), mid=resp.get("id"),
                             reply=_chat_quote_of(reply_to) if reply_to else None)
                _CHAT_LAST_ACTIVITY = time.time()
                try: os.remove(p)
                except OSError: pass


def execute(ctype: str) -> str:
    try:
        if ctype == "SHUTDOWN":
            subprocess.Popen(["systemctl", "poweroff"])
            return "ok"
        if ctype == "REBOOT":
            subprocess.Popen(["systemctl", "reboot"])
            return "ok"
        if ctype == "FORCE_UPDATE":
            # Admin-forced OTA: apply now, SILENTLY — no user confirmation, no skip
            # option. Two markers the update-apply reads: `update-force-silent` (the
            # connect window shows only a brief "installing…" notice) and
            # `update-force` (apply even during a live RDP session — the admin chose
            # to force it, so the session is interrupted + reconnects; the Windows
            # session persists). The apply still re-verifies + only installs a
            # genuinely newer, signed build.
            try:
                os.makedirs(RUN_DIR, exist_ok=True)   # /run/thinclient (world-writable)
                for _mk in ("update-force-silent", "update-force"):
                    with open(os.path.join(RUN_DIR, _mk), "w") as f:
                        f.write("1")
            except Exception:
                pass
            # run (not Popen) so the short-lived systemctl child is reaped, no zombie.
            subprocess.run(["systemctl", "--no-block", "start", "thinclient-update-apply.service"],
                           capture_output=True, timeout=15)
            return "ok"
        if ctype == "GETLOGS":
            # Collect a diagnostics bundle (logs + CPU/mem snapshot) and upload it
            # to the tenant's storage so an admin can pull it. Runs in a thread so
            # the poll returns immediately.
            threading.Thread(target=_upload_logs, daemon=True).start()
            return "ok"
        if ctype == "SPEEDTEST":
            # On-demand internet speed test, triggered by the admin from the manager
            # (e.g. when a freeze is reported). Runs NOW even during a live call — it's
            # a deliberate check — in a thread so the poll returns immediately; the
            # fresh speed/latency/loss + net_tested_ms flow back on the next poll.
            threading.Thread(target=_do_speedtest, daemon=True).start()
            return "ok"
        if ctype == "TERMINATE_SESSION":
            subprocess.run(["pkill", "-x", "xfreerdp3"], capture_output=True, timeout=10)
            subprocess.run(["pkill", "-x", "xfreerdp"], capture_output=True, timeout=10)
            return "ok"
        if ctype == "LOCK":
            set_admin_lock(True)
            # Take effect immediately on a LIVE session: drop the RDP session so
            # the connect window regains control and refuses to reconnect while
            # locked. Without this, a lock would only apply on the next reconnect.
            _drop_rdp_session("admin lock")
            return "ok"
        if ctype == "UNLOCK":
            set_admin_lock(False); return "ok"
        if ctype == "WIPE":
            # NOT done here: the acknowledgement that follows needs the very device
            # secret the wipe destroys. Flag it; the poll loop wipes AFTER acking, so the
            # manager learns the wipe was received.
            _PENDING_WIPE[0] = True
            return "ok"
        # Streaming + recording are driven by the poll flags, not commands; accept
        # these as no-ops so any stragglers ACK "ok" instead of logging FAILED.
        if ctype in ("STREAM_START", "STREAM_STOP", "RECORD_START", "RECORD_STOP"):
            return "ok"
        return "failed"
    except Exception as e:
        print("agent exec %s: %s" % (ctype, e), file=sys.stderr)
        return "failed"


def _xauth_candidates(disp: str) -> list:
    """Xauthority files to try, best first. The agent runs as root, so it can read
    any of them; the hard part is which holds the cookie for the LIVE session's X
    server. LightDM does NOT use ~/.Xauthority, so a single hard-coded path fails
    with 'cannot open display'. We prefer the -auth the running X server was
    actually started with, then fall back through LightDM's known locations."""
    import re
    cands = []
    c = conf_get("CAPTURE_XAUTHORITY", "")
    if c:
        cands.append(c)
    # Definitive: parse the running X server's own -auth argument.
    try:
        ps = subprocess.run(["ps", "-eo", "args"], capture_output=True, text=True, timeout=5).stdout
        for line in ps.splitlines():
            if ("Xorg" in line or "/usr/bin/X " in line or line.strip().startswith("X ")) and "-auth" in line:
                m = re.search(r"-auth\s+(\S+)", line)
                if m:
                    cands.append(m.group(1))
                    break
    except Exception:
        pass
    cands += [
        "/var/run/lightdm/root/%s" % disp,
        "/run/lightdm/root/%s" % disp,
        "/var/lib/lightdm/.Xauthority",
        "/home/thinclient/.Xauthority",
    ]
    seen, out = set(), []
    for x in cands:
        if x and x not in seen and os.path.exists(x):
            seen.add(x)
            out.append(x)
    return out or ["/home/thinclient/.Xauthority"]


_XAUTH_OK = None   # cached working Xauthority (probed once)


def _working_xauth(disp: str) -> str:
    """Pick the Xauthority that can actually open the display. Unlike a one-frame
    grab, ffmpeg for live/recording runs for minutes, so we can't iterate mid-run;
    probe each candidate once (xdpyinfo) and cache the winner. This is why live +
    recording were flaky — the old code used only the first candidate."""
    global _XAUTH_OK
    if _XAUTH_OK and os.path.exists(_XAUTH_OK):
        return _XAUTH_OK
    for x in _xauth_candidates(disp):
        try:
            rc = subprocess.run(["xdpyinfo"], env=dict(os.environ, DISPLAY=disp, XAUTHORITY=x),
                                capture_output=True, timeout=5).returncode
            if rc == 0:
                _XAUTH_OK = x
                return x
        except Exception:
            pass
    cands = _xauth_candidates(disp)
    return cands[0] if cands else ""


_STREAM_ACTIVE = False   # set by cmd_poll; the daemon uses it to pick its cadence
_LAST_UPDATE_TRIGGER = ""   # newest version we've already kicked an update check for
_LAST_UPDATE_AT = [0.0]     # when we kicked it, so a deferred attempt is retried
# An attempt can legitimately decline to install right now - the commonest reason is
# an active RDP session, which apply refuses to interrupt. Re-kick the SAME version
# on this cadence so a device whose operator works all day still lands the update at
# their next break, instead of waiting for the 6-hourly timer.
_UPDATE_RETRIGGER_S = 1800
# How long after kicking an update we still describe ourselves as "updating" to the
# manager, so the dashboard can show the Update button as already-in-progress instead
# of letting a second admin queue a duplicate push. A successful apply restarts this
# process, which clears it naturally; this cap is what releases the button if the
# attempt instead DEFERRED (an operator was mid-session).
_UPDATE_BUSY_S = 600


def _update_in_flight() -> bool:
    """True while an update attempt we started is still outstanding."""
    if not _LAST_UPDATE_TRIGGER or not _LAST_UPDATE_AT[0]:
        return False
    if time.time() - _LAST_UPDATE_AT[0] >= _UPDATE_BUSY_S:
        return False
    # Already running it => the apply finished (or was unnecessary).
    return _ver_gt(_LAST_UPDATE_TRIGGER, _current_version())
# When this agent run first reached the manager. Updates wait for the link to SETTLE
# after boot/reconnect: right after a device comes up the network often flaps (DHCP,
# Wi-Fi association, a VPN coming up), and starting a download into that is how you
# get a half-fetched bundle and a retry storm. One reachable poll is not proof of a
# stable link; a couple of minutes of it is.
_FIRST_POLL_OK = [0.0]
_UPDATE_SETTLE_S = 120
_VERSION = None


def _current_version() -> str:
    global _VERSION
    if _VERSION is None:   # VERSION only changes on OTA, which restarts this service
        try:
            _VERSION = open("/opt/thinclient/VERSION").read().strip() or "0.0.0"
        except OSError:
            _VERSION = "0.0.0"
    return _VERSION


def _ver_gt(a: str, b: str) -> bool:
    def parts(v):
        out = []
        for p in (v or "0").split("."):
            try:
                out.append(int(p))
            except ValueError:
                out.append(0)
        return out
    return parts(a) > parts(b)


def _maybe_trigger_update(latest: str):
    """The control plane reports the newest release as <latest>. If it's newer
    than what we run, kick the (signed, verified) update check NOW instead of
    waiting for the 6-hour timer — so a push notifies within one poll (~5s)."""
    global _LAST_UPDATE_TRIGGER
    if not latest:
        return
    if (latest == _LAST_UPDATE_TRIGGER
            and time.time() - _LAST_UPDATE_AT[0] < _UPDATE_RETRIGGER_S):
        return
    if not _ver_gt(latest, _current_version()):
        return
    # Let the connection settle first. Returning WITHOUT setting _LAST_UPDATE_TRIGGER
    # matters: the next poll re-evaluates, so this delays the update rather than
    # skipping it. The 6-hourly timer remains the backstop either way.
    up_for = time.time() - _FIRST_POLL_OK[0] if _FIRST_POLL_OK[0] else 0.0
    if up_for < _UPDATE_SETTLE_S:
        return
    _LAST_UPDATE_TRIGGER = latest
    _LAST_UPDATE_AT[0] = time.time()
    try:
        subprocess.run(["systemctl", "start", "--no-block", "thinclient-update.service"],
                       capture_output=True, timeout=10)
        print("agent: newer version %s available -> triggered update check" % latest, file=sys.stderr)
    except Exception:
        pass


# --------------------- recording (one muxed screen+mic+camera file) ----------
# A single ffmpeg captures the screen (base) with the webcam as a picture-in-
# picture overlay and the microphone as the audio track -> ONE .mp4, uploaded as
# one object. It runs continuously across screen locks; a drawtext overlay shows
# "SCREEN LOCKED — <elapsed>" during lock periods, and LOCK/UNLOCK markers are
# recorded so the dashboard can show lock chapters.
_REC_SESSION = None    # {"proc","path","started","markers","locked","lock_at","stop","thread"}
_REC_LOCK = threading.Lock()
_REC_SEQ = 0           # unique suffix so a restarted capture never reuses a path
_REC_STALL_SECS = 60   # HLS index idle this long while ffmpeg is "alive" = wedged capture
_CAM_FALLBACK_UNTIL = 0.0   # camera dropped (screen-only) until this time after a quick cam failure
_CAM_FAILS = 0             # consecutive camera failures (escalates the fallback window)
_REC_FAILS = 0             # consecutive fast recording deaths (drives restart backoff)
_REC_RETRY_AT = 0.0        # don't launch a new recording before this wall-clock (backoff)
_REC_MAX_RUNS = 60         # ffmpeg restarts folded into ONE recording before rolling a new file
_REC_MAX_SESSION_SECS = 12 * 3600   # roll a fresh file after this long (a natural daily boundary)
_REC_INDICATOR = None  # yad "* REC" window shown while capturing (consent)
_REC_IND_LABEL = None  # its current text, so it's rebuilt when the active sources change
REC_DIR = "/var/lib/thinclient/rec"
_NO_MERGE = False      # runtime safety: if the merged (tee) capture fails, fall back
                       # to separate live + record encoders for the rest of this uptime

# --- Durability (Phase 1): retry queue + boot recovery + metadata sidecars --------
# Recordings are captured to local .ts and uploaded when the segment finalizes. A
# power-cut/crash before that, or a failed upload, used to leave the file stranded on
# disk with no retry. Now every leftover in REC_DIR is re-uploaded by a periodic
# background "drain" (also runs right after the first successful poll on boot). A tiny
# JSON sidecar next to each file preserves its lock markers + duration so a recovered
# orphan keeps that info even though its in-memory session is gone.
_PENDING_LOCK = threading.Lock()
_UPLOAD_INFLIGHT = set()   # media paths an uploader currently owns (prevents double-upload)
_LAST_DRAIN = 0.0          # throttle the drain
_DRAIN_RUNNING = False     # a drain worker is active (never overlap)


def _sidecar_path(media_path: str) -> str:
    return os.path.splitext(media_path)[0] + ".meta.json"


def _save_sidecar(media_path: str, meta: dict):
    try:
        with open(_sidecar_path(media_path), "w") as f:
            json.dump(meta, f)
    except Exception:
        pass


def _read_sidecar(media_path: str) -> dict:
    try:
        with open(_sidecar_path(media_path)) as f:
            return json.load(f) or {}
    except Exception:
        return {}


def _write_sidecar(sess: dict):
    """Persist the legacy session's markers + start time next to its .ts, so a crash
    (which never runs _finalize_session) still leaves recoverable metadata. HLS
    recordings stream to S3 continuously (durable already) and have no local .ts, so
    there's nothing to sidecar."""
    if not sess.get("path"):
        return
    _save_sidecar(sess.get("path", ""), {
        "started": int(sess.get("started", 0)), "kind": "session",
        "markers": list(sess.get("markers", [])),
    })


def _mark_inflight(p: str):
    with _PENDING_LOCK: _UPLOAD_INFLIGHT.add(p)


def _clear_inflight(p: str):
    with _PENDING_LOCK: _UPLOAD_INFLIGHT.discard(p)


def _is_inflight(p: str) -> bool:
    with _PENDING_LOCK: return p in _UPLOAD_INFLIGHT


def _probe_duration(path: str) -> int:
    """Seconds, via ffprobe — used when recovering an orphan whose in-memory duration
    is gone. 0 if it can't be read (the manager still stores/plays the file)."""
    try:
        out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                              "-of", "default=nw=1:nk=1", path], capture_output=True, timeout=30)
        return max(0, int(float(out.stdout.decode().strip())))
    except Exception:
        return 0


def _no_merge_fallback():
    global _NO_MERGE
    if not _NO_MERGE:
        print("agent: merged live+record capture failed -> using separate encoders", file=sys.stderr)
    _NO_MERGE = True


def _merge_screen() -> bool:
    """Should the recorder ALSO serve the live screen (one capture, tee'd)? Only when
    live + record are BOTH active for the screen — the case that used to run two
    screen grabs. A config kill-switch (CAPTURE_MERGE=0) or the runtime fallback
    disables it."""
    if _NO_MERGE or conf_get("CAPTURE_MERGE", "1").lower() in ("0", "false", "no", "off"):
        return False
    return bool(_STREAM_ACTIVE)


def _lock_owner_alive(pid: int) -> bool:
    """Is `pid` a LIVE thinclient-lock? Checked against /proc rather than a bare
    signal-0, because PIDs are recycled: /run is tmpfs and survives an X restart, so
    a stale flag can easily outlive its writer long enough for the number to be
    handed to something else entirely, and "some process exists" would then keep the
    device locked forever on a coincidence."""
    if pid <= 0:
        return False
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return b"thinclient-lock" in f.read()
    except OSError:
        return False          # no such process, or it exited while we looked


_LOCKER_SCAN = [0.0, False]    # (checked_at, result) — see _locker_running


def _locker_running() -> bool:
    """Fallback liveness check: is ANY screen locker up? Used only when the signal
    file carries no usable PID — a flag written by a pre-1.0.156 locker, or caught
    mid-write. Deliberately not the primary check: it cannot tell one locker from
    another, and it costs a process spawn.

    Cached for 2s because the recording overlay asks once a SECOND; without the cache
    a legacy flag plus a genuinely-locked screen would fork pgrep 60 times a minute
    for the whole lock."""
    now = time.time()
    if now - _LOCKER_SCAN[0] < 2.0:
        return _LOCKER_SCAN[1]
    try:
        alive = subprocess.run(["pgrep", "-f", "thinclient-lock"],
                               capture_output=True, timeout=5).returncode == 0
    except Exception:
        alive = True          # can't tell -> assume locked; never expose a live desktop
    _LOCKER_SCAN[0], _LOCKER_SCAN[1] = now, alive
    return alive


def _screen_locked() -> bool:
    """The OPERATOR's screen lock (Super+L, the idle lock, the boot lock), read from
    /run/thinclient/locked — and verified against the process that wrote it.

    Trusting the file alone was the bug. thinclient-lock removes it in a `finally`,
    which a SIGKILL, an X/GTK abort or (before 1.0.156) any SIGTERM skips entirely;
    /run is tmpfs, so the orphaned flag then said "locked" until the next reboot. The
    device carried on working normally underneath while the agent stamped
    "SCREEN LOCKED" onto the live view and the recordings, logged a LOCK that never
    got its UNLOCK — booking the rest of the operator's shift as away-from-desk — and
    left the RDP freeze watchdog parked. thinclient-xsession's auto-lock loop already
    learned this lesson and gates on the process; this is the other half.

    Self-healing: an orphaned flag is DELETED here, so the LOCK/UNLOCK edge detector
    closes the dangling lock on the very next poll without anyone rebooting the box.
    """
    try:
        with open(SIG_LOCK) as f:
            raw = f.read().strip()
    except OSError:
        return False                      # no flag at all -> not locked
    try:
        alive = _lock_owner_alive(int(raw.split()[0]))
    except (ValueError, IndexError):
        alive = _locker_running()         # legacy/empty flag -> fall back to a scan
    if alive:
        return True
    try:
        os.remove(SIG_LOCK)
        print("agent: cleared a stale screen-lock flag (its locker is gone)", file=sys.stderr)
    except OSError:
        pass
    return False


def _is_locked() -> bool:
    return os.path.exists(ADMIN_LOCK) or _screen_locked()


def _fmt_hms(sec: int) -> str:
    sec = max(0, int(sec))
    return "%02d:%02d:%02d" % (sec // 3600, (sec % 3600) // 60, sec % 60)


def _write_overlay(text: str):
    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        with open(OVERLAY_FILE, "w") as f:
            f.write(text or "")
    except OSError:
        pass


def _rec_env():
    disp = conf_get("CAPTURE_DISPLAY", os.environ.get("DISPLAY", ":0"))
    env = dict(os.environ, DISPLAY=disp, XAUTHORITY=_working_xauth(disp))
    # Audio: the agent runs as root, so point ffmpeg's PipeWire/Pulse capture at
    # the kiosk user's session runtime dir (best-effort; mic just fails if absent).
    try:
        import pwd
        uid = pwd.getpwnam(conf_get("SESSION_USER", "thinclient")).pw_uid
        env["XDG_RUNTIME_DIR"] = "/run/user/%d" % uid
        env.setdefault("PULSE_SERVER", "unix:/run/user/%d/pulse/native" % uid)
    except Exception:
        pass
    return env, disp


def _rec_indicator(on: bool, cfg=None):
    """Small, unobtrusive recording badge in the top-right corner (consent) — it
    must NOT block the screen; recording runs in the background while the user
    keeps working. It NAMES the active monitoring sources ("● REC  Screen · Camera
    · Mic") so the operator can clearly see exactly what is being captured. Shown
    only when the tenant's recording-notice is on; a tenant can run silent (no
    badge) if staff are told via a monitoring policy. openbox keeps yad windows
    their own size (see rc.xml.in) so this stays tiny."""
    global _REC_INDICATOR, _REC_IND_LABEL
    label = None
    if on:
        parts = []
        if cfg:
            if cfg.get("screen"): parts.append("Screen")
            if cfg.get("camera"): parts.append("Camera")
            if cfg.get("mic"):    parts.append("Mic")
        label = "● REC" + ("  " + " · ".join(parts) if parts else "")
    # (Re)create when turning on OR when the active-source label changed mid-session
    # (the admin toggled a source), so the badge always reflects what's live now.
    if on and (_REC_INDICATOR is None or label != _REC_IND_LABEL):
        if _REC_INDICATOR is not None:
            try: _REC_INDICATOR.terminate(); _REC_INDICATOR.wait(timeout=5)
            except Exception: pass
            _REC_INDICATOR = None
        env, _ = _rec_env()
        w = max(64, 34 + 8 * len(label))   # widen to fit the source names
        try:
            _REC_INDICATOR = subprocess.Popen(
                ["yad", "--title=Recording", "--no-buttons", "--undecorated", "--sticky",
                 "--on-top", "--skip-taskbar", "--geometry=%dx26-14+12" % w, "--timeout=0",
                 "--text=<span foreground='#ff4d4d' weight='bold'>%s</span>" % label],
                env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            _REC_IND_LABEL = label
        except Exception:
            _REC_INDICATOR = None
    elif not on and _REC_INDICATOR is not None:
        try:
            _REC_INDICATOR.terminate()
            _REC_INDICATOR.wait(timeout=5)   # reap it — no lingering zombie
        except Exception:
            pass
        _REC_INDICATOR = None
        _REC_IND_LABEL = None


def _nice():
    """Run every capture/encode at IDLE cpu + io priority so it can NEVER starve
    the FreeRDP session (the operator's real work). On a low-power thin client an
    uncapped x264 encoder otherwise grabs every core and the remote desktop
    freezes. Combined with the downscale/fps/thread/bitrate caps below."""
    pre = []
    if shutil.which("nice"):   pre += ["nice", "-n", "19"]
    if shutil.which("ionice"): pre += ["ionice", "-c", "3"]
    return pre


def _cap(key: str, default: str) -> str:
    return conf_get(key, default) or default


def _rdp_active() -> bool:
    """True while an RDP session is live (thinclient-connect maintains this file)."""
    return os.path.exists("/run/thinclient/rdp-connected")


def _cap_rt(key: str, idle: str, rdp: str) -> str:
    """A capture setting that gets LIGHTER while an RDP session is active, so the
    monitor + record encoders can't starve the operator's remote desktop — the
    'RDP froze during a call while being watched/recorded' case. An explicit
    config value always wins; otherwise pick the idle vs rdp-active default."""
    v = conf_get(key, "")
    if v:
        return v
    return rdp if _rdp_active() else idle


_CAM_FMT = {}      # device -> the input format it actually offers
# Sits beside update-last / rec / adopt, not in the licence dir.
CAM_FORMAT_STATE = "/var/lib/thinclient/cam-format"

# Which capture variant to try next for the camera.
#
# A UVC camera can advertise a format and still refuse to stream it. Seen in the
# field on an "HD 2MP WEBCAM (0c45:636b)": it lists MJPG at 640x480/10fps, a
# standalone ffmpeg captures it happily, and the recorder's open of the very same
# device with the very same arguments dies after five seconds with
#
#     ioctl(VIDIOC_STREAMON): Protocol error
#
# The same camera's firmware also failed several UVC control queries at probe time,
# so "advertises it" is not the same as "will stream it right now". Abandoning the
# camera for eight minutes on that basis is the wrong response when the device very
# likely WILL stream a different alt-setting, so each consecutive failure now moves
# to the next variant instead of giving up on the camera altogether.
_CAM_ATTEMPT = 0


# The webcam's device node, and when we last worked it out.
_CAM_DEV = {"dev": "", "at": 0.0}
# Long enough that the poll (every few seconds) does not shell out constantly, short
# enough that a camera which moved is picked up within a minute without a reboot.
_CAM_DEV_TTL = 60.0
# How long a node that still exists is trusted WITHOUT re-probing it. The old 60s
# forced a USB resume every minute (see _camera_device). Ten minutes was too long:
# a node chosen wrongly during a re-enumeration then stuck for the whole window and
# churned 5-second recordings. Two minutes halves the power cycling and still
# self-corrects on a timer, and _cam_downgrade() now re-probes on FAILURE, which is
# what actually catches a bad choice.
_CAM_DEV_RETRUST = 120.0

# --- Camera USB health -------------------------------------------------------
# A webcam that drops off the bus and returns within a second used to cost a whole
# shift of camera footage: the recorder restarted in the same second, found no node,
# and was born screen-only — and a screen-only session is never upgraded mid-run.
# These track the outage so a re-enumeration is treated as the blip it is.
_CAM_HEALTH = {
    "node": "",        # the node we last saw working
    "lost_at": 0.0,    # when it first went missing (0.0 = present)
    "reported": False, # CAMERA_LOST already queued for this outage
    "resets": 0,       # software replugs attempted without a recovery since
    "last_reset": 0.0,
}
# A node absent for less than this is a re-enumeration, not an unplug. The observed
# gap on real hardware is ~1s (disconnect 15:05:59 -> back 15:06:00); 8s is generous
# without making a genuine unplug look present for long.
_CAM_SETTLE_SECS = 8.0
_CAM_RESET_BACKOFF = 120.0   # never software-replug more often than this
_CAM_RESET_MAX = 4           # replug attempts per batch before pausing
_CAM_RESET_WINDOW = 1800.0   # after this quiet, allow a fresh batch of attempts
_CAM_PWR_DONE = set()        # sysfs dirs already switched to power/control=on


def _usb_dir_for_node(node):
    """The USB device directory (e.g. /sys/bus/usb/devices/3-1) behind /dev/videoN.

    Returns "" when it cannot be resolved, so every caller degrades to doing nothing
    rather than guessing at a path."""
    name = os.path.basename(node or "")
    if not name:
        return ""
    try:
        cur = os.path.realpath("/sys/class/video4linux/%s/device" % name)
    except Exception:
        return ""
    # .../usb3/3-1/3-1:1.0 -> walk up to the node that carries idVendor (the DEVICE,
    # not the interface). Bounded so a symlink loop cannot spin here.
    for _ in range(6):
        if os.path.exists(os.path.join(cur, "idVendor")):
            return cur
        parent = os.path.dirname(cur)
        # Stop at the filesystem root. The range() above is the real bound — a
        # sysfs-prefix test here would add nothing to it and would make this
        # function impossible to exercise against a temporary tree.
        if parent == cur or parent in ("/", ""):
            break
        cur = parent
    return ""


def _usb_port_dir(usb_dir):
    """The sysfs PORT that a USB device is plugged into.

    This is the whole point of the permanent fix. When a camera fails hard — "device
    not accepting address, error -71" — it disappears from sysfs entirely, so there is
    nothing left to reset and the obvious recovery paths all give up exactly when they
    are needed. The PORT object persists regardless, because it belongs to the hub, not
    to whatever is plugged into it. Disabling and re-enabling that port is the closest
    software equivalent of pulling the plug and putting it back.

      /sys/bus/usb/devices/3-1        -> .../usb3/3-0:1.0/usb3-port1
      /sys/bus/usb/devices/3-2.1      -> .../3-2/3-2:1.0/3-2-port1

    Returns "" when it cannot be derived."""
    name = os.path.basename(usb_dir or "")
    if not name or "-" not in name:
        return ""
    bus, _, path = name.partition("-")
    if not bus.isdigit() or not path:
        return ""
    base = "/sys/bus/usb/devices"
    if "." in path:
        parent = name.rsplit(".", 1)[0]          # 3-2.1 -> 3-2
        port = path.rsplit(".", 1)[1]
        cand = os.path.join(base, parent, "%s:1.0" % parent, "%s-port%s" % (parent, port))
    else:
        cand = os.path.join(base, "usb%s" % bus, "%s-0:1.0" % bus,
                            "usb%s-port%s" % (bus, path))
    return cand if os.path.isdir(cand) else ""


def _usb_port_cycle(port_dir, expect_vid="", expect_pid=""):
    """Disable and re-enable a USB port — a power/link cycle done in software.

    Works when the device itself is GONE, which is the failure operators currently fix
    by hand. Support depends on the host controller: the `disable` attribute is absent
    on some, so a missing file is a normal outcome and not an error.

    SAFETY: on this hardware the camera sits on a two-port controller whose OTHER port
    carries the USB audio adapter, the headset HID and Bluetooth. Cutting the wrong
    port would drop an operator's headset mid-call. So if anything IS attached to the
    port, it must be the camera we remembered; an empty port is fine (that is the
    failure we are recovering from), a different device is not."""
    if not port_dir:
        return False
    if expect_vid:
        # The port's current occupant, if any, is linked as "device".
        occupant = os.path.join(port_dir, "device")
        if os.path.exists(occupant):
            try:
                vid = open(os.path.join(occupant, "idVendor")).read().strip()
                pid = open(os.path.join(occupant, "idProduct")).read().strip()
            except OSError:
                vid = pid = ""
            if vid and (vid, pid) != (expect_vid, expect_pid):
                print("agent: refusing to cycle %s - it now holds %s:%s, not the camera %s:%s"
                      % (port_dir, vid, pid, expect_vid, expect_pid), file=sys.stderr)
                return False
    dis = os.path.join(port_dir, "disable")
    if not os.path.exists(dis):
        return False
    try:
        open(dis, "w").write("1")
        time.sleep(1.5)                  # let the port actually drop
        open(dis, "w").write("0")
        print("agent: cycled USB port %s" % port_dir, file=sys.stderr)
        return True
    except OSError as e:
        print("agent: USB port cycle failed (%s): %s" % (port_dir, e), file=sys.stderr)
        return False


def _cam_power_on(usb_dir):
    """Stop the kernel autosuspending THIS camera.

    Re-applied whenever the node changes, not once at boot: a re-enumerated webcam is
    a brand-new USB device instance whose power/control reverts to "auto". Applying it
    only at startup would silently wear off after the first drop - the exact shape of
    bug this whole change exists to remove."""
    if not usb_dir:
        return
    pc = os.path.join(usb_dir, "power", "control")
    try:
        if os.path.exists(pc):
            if open(pc).read().strip() != "on":
                open(pc, "w").write("on")
                print("agent: camera autosuspend disabled (%s)" % usb_dir, file=sys.stderr)
            _CAM_PWR_DONE.add(usb_dir)
    except OSError:
        pass


def _cam_owns_active_mic(usb_dir):
    """Is the camera ALSO the microphone somebody is using right now?

    These webcams are composite devices - video and audio on one chip (0c45:636b
    exposes two Video and two Audio interfaces). A USB reset resets the whole device,
    so replugging it under an operator who is on a call through the SAME webcam would
    cut their audio. Where the headset is a separate adapter this is false and the
    reset is safe, which is the common case here."""
    if not usb_dir:
        return False
    snd = os.path.join(usb_dir, "sound")
    if not os.path.isdir(snd):
        return False        # no audio function at all -> nothing to protect
    cards = [d for d in os.listdir(snd) if d.startswith("card")]
    if not cards:
        return False
    nums = [c[4:] for c in cards if c[4:].isdigit()]
    if not nums:
        return False
    # Held capture PCMs for those cards = somebody is recording from this device.
    pats = " ".join("/dev/snd/pcmC%sD*c" % n for n in nums)
    try:
        r = subprocess.run(["sh", "-c", "fuser %s 2>/dev/null" % pats],
                           capture_output=True, text=True, timeout=5)
        return bool((r.stdout or "").strip())
    except Exception:
        # Cannot tell -> assume it IS in use. Losing a camera frame is recoverable;
        # cutting an operator's call audio is not.
        return True


def _camera_usb_reset(node):
    """Do in software exactly what the operator does by hand: replug the camera.

    Operators report that unplugging and re-plugging the SAME port fixes this, which
    means the port is fine and the device firmware has hung. A hung device answers a
    bus-level reset, so there is no reason a person has to walk over.

    A ladder, because the gentle option does not always take:
      1. USBDEVFS_RESET on the usbfs node  - what /usr/bin/usbreset does.
      2. De-authorize and re-authorize the port - forces full re-enumeration.
    Returns the method that was used, or "" if nothing was attempted."""
    # Live lookup first; fall back to where the camera was when it last worked. The
    # fallback is what makes recovery possible at all during a hard failure, when the
    # device is no longer in sysfs to be looked up.
    usb_dir = (_usb_dir_for_node(node)
               or _usb_dir_for_node(_CAM_HEALTH.get("node", ""))
               or _CAM_HEALTH.get("usb_dir", ""))
    port_dir = _CAM_HEALTH.get("port_dir", "") or _usb_port_dir(usb_dir)
    if not usb_dir and not port_dir:
        return ""
    if _cam_owns_active_mic(usb_dir):
        print("agent: camera reset skipped - it is also the microphone in use", file=sys.stderr)
        return ""
    now = time.time()
    if now - _CAM_HEALTH["last_reset"] < _CAM_RESET_BACKOFF:
        return ""
    # The attempt cap stops us thrashing a bus when a camera is simply unplugged. But
    # giving up FOREVER is wrong too: tonight a camera was dead for eleven minutes and
    # came back the moment power was cycled. So the cap lapses after a quiet spell and
    # a fresh batch of attempts is allowed — rare retries, not a loop.
    if now - _CAM_HEALTH["last_reset"] > _CAM_RESET_WINDOW:
        _CAM_HEALTH["resets"] = 0
    if _CAM_HEALTH["resets"] >= _CAM_RESET_MAX:
        return ""           # this batch is spent; try again after _CAM_RESET_WINDOW
    _CAM_HEALTH["last_reset"] = now
    _CAM_HEALTH["resets"] += 1

    # 1) USBDEVFS_RESET, via the device's usbfs path.
    try:
        busnum = int(open(os.path.join(usb_dir, "busnum")).read().strip())
        devnum = int(open(os.path.join(usb_dir, "devnum")).read().strip())
        usbfs = "/dev/bus/usb/%03d/%03d" % (busnum, devnum)
        if os.path.exists(usbfs):
            import fcntl
            USBDEVFS_RESET = ord("U") << 8 | 20
            fd = os.open(usbfs, os.O_WRONLY)
            try:
                fcntl.ioctl(fd, USBDEVFS_RESET, 0)
                print("agent: camera USB reset (usbfs %s)" % usbfs, file=sys.stderr)
                return "usbreset"
            finally:
                os.close(fd)
    except Exception as e:
        print("agent: camera usbfs reset failed: %s" % e, file=sys.stderr)

    # 2) Port de-authorize / re-authorize - a harder replug.
    try:
        auth = os.path.join(usb_dir, "authorized") if usb_dir else ""
        if auth and os.path.exists(auth):
            open(auth, "w").write("0")
            time.sleep(1.0)
            open(auth, "w").write("1")
            print("agent: camera re-authorized (%s)" % usb_dir, file=sys.stderr)
            return "reauthorize"
    except OSError as e:
        print("agent: camera re-authorize failed: %s" % e, file=sys.stderr)

    # 3) Cycle the PORT. The last rung and the only one that survives the device
    #    disappearing, because the port belongs to the hub rather than to the camera.
    #    This is what an operator does by hand when nothing else brings it back.
    _CAM_HEALTH["tried_port"] = usb_dir
    if _usb_port_cycle(port_dir, _CAM_HEALTH.get("vid", ""), _CAM_HEALTH.get("pid", "")):
        return "portcycle"
    return ""


def _ensure_camera_stable():
    """Never let the kernel power-manage a webcam on this appliance.

    The machine is mains-powered at a desk; USB power saving buys nothing and costs a
    camera. Mirrors _ensure_wifi_stable(): persistent config for the future AND an
    immediate sysfs write so existing devices are fixed without a reboot - which is
    what lets this ship as an OTA rather than waiting for a reinstall.

    The kernel command line (usbcore.autosuspend=-1) cannot be delivered this way: it
    needs update-grub and a reboot, so the ISO carries it and this covers the fleet
    that is already out there."""
    # 1) Global default for everything enumerated FROM NOW ON - including the camera
    #    each time it re-enumerates, which is the case a udev rule can be slow for.
    try:
        open("/sys/module/usbcore/parameters/autosuspend", "w").write("-1")
    except OSError:
        pass
    # 2) Persistent rule: webcam vendors seen in the fleet, plus any UVC device.
    rule = (
        "# ThinClient: never autosuspend a webcam. A USB webcam that is suspended and\n"
        "# resumed repeatedly (the agent used to re-probe it every 60s) eventually fails\n"
        "# to resume, drops off the bus with -71/EPROTO, and the recording loses its\n"
        "# camera track until somebody physically replugs it.\n"
        "# Vendor matching only: bInterfaceClass belongs to the usb_INTERFACE while\n"
        "# power/control lives on the usb_DEVICE, so an interface-class rule here would\n"
        "# silently never match. Devices from any other vendor are covered by the\n"
        "# usbcore autosuspend default set above and by the sysfs sweep below.\n"
    )
    for v in ("0c45", "046d", "1908", "eb1a", "05a3", "2bdf"):
        rule += ('ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="%s", '
                 'TEST=="power/control", ATTR{power/control}="on"\n' % v)
    try:
        _write_if_changed("/etc/udev/rules.d/73-thinclient-camera-nopm.rules", rule)
    except Exception:
        pass
    # 3) Apply NOW to every video device present, so this takes effect on the live
    #    session rather than at the next reboot.
    for node in glob.glob("/dev/video*"):
        _cam_power_on(_usb_dir_for_node(node))


def _cam_event(kind, **meta):
    """Queue a CAMERA_LOST / CAMERA_RECOVERED event for the manager.

    Without these the fault is unmeasurable: the camera returns within a second, so
    the console still shows it connected while the recording has no camera track.
    There would be no way to tell whether a fix worked - only whether people
    complained less."""
    try:
        _ACT_QUEUE.append({"kind": kind, "at": time.time(),
                           "meta": {k: v for k, v in meta.items() if v not in (None, "")}})
    except Exception:
        pass



def _camera_device() -> str:
    """Which node is the webcam RIGHT NOW — not which node it was at boot.

    /dev/video0 used to be assumed. That holds until the camera re-enumerates, and
    this one does: a webcam on a marginal USB connection dropped and came back four
    times in three seconds, after which it was /dev/video1 (with /dev/video2 for its
    metadata stream) and /dev/video0 no longer existed at all. The agent went on
    looking at the old path, decided no camera was attached, and quietly recorded
    screen-only until somebody rebooted the machine.

    A UVC camera registers more than one node and only some of them capture video, so
    picking the lowest number is not enough either - /dev/video1 here is the camera and
    /dev/video2 is metadata. We ask each node what it can actually do and take the
    first that offers real pixel formats.

    An explicit CAMERA_DEVICE in the config is an instruction and is returned as-is.
    Returns "" when there is genuinely no camera, so every existing
    os.path.exists() check reads false exactly as it did before."""
    forced = conf_get("CAMERA_DEVICE", "")
    if forced:
        return forced
    now = time.time()
    cached = _CAM_DEV["dev"]
    # A cached node that still EXISTS is trusted without re-probing it.
    #
    # This used to re-run v4l2-ctl every 60s even when the node was sitting there
    # working. Each probe opens the device, which forces a runtime-PM RESUME, and two
    # seconds after it closes the kernel suspends it again — roughly SIXTY
    # suspend/resume cycles an hour, for ever. That is what the
    # "Failed to query (GET_DEF) UVC control 9" line every 63 seconds in the kernel log
    # actually was, and hammering cheap webcam firmware like that is a good way to make
    # it drop off the bus. The long TTL below is only a safety net for the odd case
    # where the camera moves while the old node happens to still exist.
    if cached and os.path.exists(cached):
        if _CAM_HEALTH["lost_at"]:
            # It came back. Report the outage and re-apply the no-autosuspend setting:
            # a re-enumerated camera is a NEW usb device whose power/control is "auto".
            down = max(0.0, now - _CAM_HEALTH["lost_at"])
            usb_dir = _usb_dir_for_node(cached)
            _cam_power_on(usb_dir)
            if _CAM_HEALTH["reported"]:
                # Only credit a recovery method if the camera came back SOON after we
                # tried it, and on the SAME port. Otherwise a human replugged it.
                #
                # This matters more than it looks: on 20 Sep the agent cycled the old
                # port seven times, the camera never returned there, somebody moved it
                # to a different socket — and the event still said
                # recoveredBy="portcycle". Telemetry that flatters the code is worse
                # than none, because it is what the decision to roll out gets made on.
                same_port = (usb_dir and usb_dir == _CAM_HEALTH.get("tried_port"))
                soon = (time.time() - _CAM_HEALTH.get("tried_at", 0)) < 45
                by = _CAM_HEALTH.get("tried") if (same_port and soon) else "self"
                _cam_event("CAMERA_RECOVERED", node=cached, downSec=down,
                           recoveredBy=by or "self", attempts=_CAM_HEALTH["resets"])
                print("agent: camera recovered after %.1fs (%s)" % (down, by or "self"),
                      file=sys.stderr)
            _CAM_HEALTH.update({"lost_at": 0.0, "reported": False, "resets": 0,
                                "tried": "", "tried_at": 0.0, "tried_port": ""})
        _CAM_HEALTH["node"] = cached
        # Remember WHERE the camera is while it is working. After a hard failure the
        # device vanishes from sysfs and none of this can be derived any more — so it
        # has to be captured now, or the recovery ladder has nothing to act on.
        # Re-learn whenever the camera MOVES, not just the first time. Somebody
        # replugging it into a different socket is the normal way this changes — and
        # after that the old location is not merely useless, it is a port that now
        # holds nothing, so the recovery ladder would cycle empty space for ever and
        # never discover where the camera actually went.
        ud_now = _usb_dir_for_node(cached)
        if ud_now and ud_now != _CAM_HEALTH.get("usb_dir"):
            ud = ud_now
            if ud:
                _CAM_HEALTH["usb_dir"] = ud
                _CAM_HEALTH["port_dir"] = _usb_port_dir(ud)
                # WHICH device this is, so a port cycle can prove it is still the
                # camera's port before pulling its power.
                try:
                    _CAM_HEALTH["vid"] = open(os.path.join(ud, "idVendor")).read().strip()
                    _CAM_HEALTH["pid"] = open(os.path.join(ud, "idProduct")).read().strip()
                except OSError:
                    pass
        if now - _CAM_DEV["at"] < _CAM_DEV_RETRUST:
            return cached
        _CAM_DEV["at"] = now                  # still there; keep trusting it
        return cached

    # The node is GONE. Record when, so the recorder can tell a one-second
    # re-enumeration from a camera somebody actually unplugged.
    if cached and not _CAM_HEALTH["lost_at"]:
        _CAM_HEALTH["lost_at"] = now
        _CAM_HEALTH["node"] = cached

    def num(path):
        tail = path.rsplit("video", 1)[-1]
        return int(tail) if tail.isdigit() else 9999

    found = ""
    for node in sorted(glob.glob("/dev/video*"), key=num):
        try:
            r = subprocess.run(["v4l2-ctl", "-d", node, "--list-formats"],
                               capture_output=True, text=True, timeout=5)
        except Exception:
            continue
        out = r.stdout or ""
        # A capture node lists pixel formats ("[0]: 'MJPG' ..."). A metadata node
        # lists none, which is exactly how the two are told apart.
        if r.returncode == 0 and "'" in out and "[0]" in out:
            found = node
            break
    if not found:
        # No v4l2-ctl, or nothing answered. Fall back to the historical assumption
        # ONLY if it is really there, so a missing camera still reads as missing.
        legacy = "/dev/video0"
        found = legacy if os.path.exists(legacy) else ""
    if found and found != cached:
        print("agent: camera device is %s%s" % (found, (" (was %s)" % cached) if cached else ""),
              file=sys.stderr)
    _CAM_DEV["dev"], _CAM_DEV["at"] = found, now
    return found


def _cam_identity(cam_dev: str) -> str:
    """Which camera is this, as opposed to which device node.

    The learnt format used to be cached against "/dev/video0", so swapping the webcam
    silently applied the old camera's format to the new one. Keyed on what the driver
    says the hardware IS, a different camera simply re-probes."""
    try:
        r = subprocess.run(["v4l2-ctl", "-d", cam_dev, "--info"],
                           capture_output=True, text=True, timeout=10)
        want = ("card type", "bus info", "driver name")
        bits = [ln.strip() for ln in (r.stdout or "").splitlines()
                if ln.strip().lower().startswith(want)]
        if bits:
            return hashlib.sha256("|".join(bits).encode()).hexdigest()[:16]
    except Exception:
        pass
    return ""


def _cam_probe_format(cam_dev: str) -> str:
    """Which input format does THIS camera actually offer? Cached per device.

    We used to hard-pin MJPEG on the belief that "virtually all USB webcams" support
    it. One did not: a Lenovo FHD Webcam whose /dev/video0 advertises ONLY 'YUYV'.
    Asking a camera for a format it cannot produce does not fail loudly — the input
    simply never delivers a frame, and because ffmpeg emits nothing until EVERY input
    is producing, the camera took the SCREEN and the microphone down with it. The
    machine recorded nothing at all while reporting a healthy camera.

    MJPEG stays the preference where it exists: it is compressed on the camera, so it
    costs a fraction of the USB bandwidth of raw YUYV. Falling back to yuyv422 is fine
    at the 640x480/10fps we pin (~6 MB/s, comfortable on USB 2.0's ~60 MB/s)."""
    ident = _cam_identity(cam_dev) or cam_dev
    if ident in _CAM_FMT:
        return _CAM_FMT[ident]
    # A format we established on a previous run. Persisted because the probe needs the
    # camera to be FREE, and on a recording appliance it usually is not: the capture
    # that needs the answer is itself holding the device. Without this the probe fails,
    # we fall back, and the wrong format is used forever.
    disk = CAM_FORMAT_STATE
    try:
        with open(disk) as f:
            saved = f.read().strip()
        # "<identity> <format>"; a bare format is a pre-1.0.148 file for an unknown
        # camera and is ignored rather than trusted — that is the stale-cache bug.
        parts = saved.split()
        if len(parts) == 2 and parts[0] == ident and parts[1] in ("mjpeg", "yuyv422", "none"):
            fmt = "" if parts[1] == "none" else parts[1]
            _CAM_FMT[ident] = fmt
            return fmt
    except OSError:
        pass
    try:
        r = subprocess.run(["v4l2-ctl", "-d", cam_dev, "--list-formats"],
                           capture_output=True, text=True, timeout=10)
        out = (r.stdout or "").upper()
        if r.returncode != 0 or not out.strip():
            # Could not read the camera's formats — almost always because ffmpeg already
            # holds it while a recording restarts.
            #
            # This used to guess "mjpeg". On a camera that only offers YUYV that guess
            # does NOT fail: ffmpeg opens the device and then spins at ~99% CPU emitting
            # nothing at all, with an empty stderr. Sia ran 57 minutes that way on 23 Sep
            # and produced a 176-byte recording — no screen either, because one ffmpeg
            # serves both outputs.
            #
            # So pin nothing and let ffmpeg negotiate. The size stays pinned, which is
            # what actually protects USB2 bandwidth; the format was only ever an
            # optimisation. Still NOT cached — the next call retries and one will catch
            # the camera free.
            return ""
        if "MJPG" in out or "MJPEG" in out:
            fmt = "mjpeg"
        elif "YUYV" in out:
            fmt = "yuyv422"
            print("agent: %s offers no MJPEG - capturing raw YUYV" % cam_dev, file=sys.stderr)
        else:
            fmt = ""
            print("agent: %s offers neither MJPEG nor YUYV - letting ffmpeg choose"
                  % cam_dev, file=sys.stderr)
    except Exception:
        # Same reasoning as above: an unreadable camera is a reason to stop guessing,
        # not a reason to guess the format that wedges ffmpeg silently.
        return ""               # transient: retry next time rather than remembering
    _CAM_FMT[ident] = fmt
    try:
        os.makedirs(os.path.dirname(disk), exist_ok=True)
        with open(disk, "w") as f:
            f.write("%s %s\n" % (ident, fmt or "none"))
    except OSError:
        pass
    return fmt


def _cam_variants(cam_dev: str) -> list:
    """The capture settings to try, best first.

    An explicit CAMERA_FORMAT/SIZE in the config is an instruction, not a hint, so it
    is the only variant. Otherwise: the format the camera advertises, then the other
    one, then no format pin, then no pin and no size. A camera that refuses to
    STREAMON in one alt-setting very often streams happily in another, and working
    through them costs a few seconds where giving up costs every camera track for the
    next eight minutes."""
    size = _cap("CAMERA_SIZE", "640x480")
    forced = _cap("CAMERA_FORMAT", "")
    if forced:
        return [(forced, size)]
    probed = _cam_probe_format(cam_dev)
    if not probed:
        # The probe could not read the camera, so there is nothing to prefer. Try
        # unpinned first (ffmpeg negotiates), then each format explicitly. Listing
        # ("", size) twice — which is what pairing it with a single "other" produced —
        # wastes a rotation slot repeating an attempt that has already failed.
        return [("", size), ("mjpeg", size), ("yuyv422", size), ("", "")]
    other = "yuyv422" if probed == "mjpeg" else "mjpeg"
    return [(probed, size), (other, size), ("", size), ("", "")]


def _cam_input(cam_dev: str) -> list:
    """v4l2 input args, with format+size PINNED by default. Unpinned, ffmpeg takes the
    driver default (often raw YUYV at full resolution) which overruns USB2 bandwidth
    and the camera ffmpeg dies mid-stream. The format is PROBED per camera rather than
    assumed - see _cam_probe_format - and rotated on repeated failure, see
    _cam_variants. Override via CAMERA_FORMAT/SIZE/FPS; set CAMERA_FORMAT= (empty) to
    skip the format pin for an odd camera."""
    variants = _cam_variants(cam_dev)
    fmt, size = variants[_CAM_ATTEMPT % len(variants)]
    args = ["-f", "v4l2"]
    if fmt:
        args += ["-input_format", fmt]
    if size:
        args += ["-video_size", size]
    # 10 is plenty to identify somebody and costs a third less than 15; every extra
    # frame of real-world video is pure bitrate.
    args += ["-framerate", _cap("CAMERA_FPS", "10"), "-i", cam_dev]
    return args


def _x264(extra: list, maxrate: str = None, bufsize: str = None) -> list:
    """Shared x264 encode opts with a THREAD cap + BITRATE ceiling so the encoder
    can't monopolise the CPU/uplink. extra carries per-mode flags (hls vs mp4).
    maxrate/bufsize override the ceiling for a stream with a different budget (the
    camera) - passed explicitly rather than appended after, so the command carries ONE
    unambiguous cap instead of relying on ffmpeg's last-option-wins."""
    return (["-c:v", "libx264", "-preset", _cap_rt("CAPTURE_PRESET", "veryfast", "ultrafast"),
             "-threads", _cap_rt("CAPTURE_THREADS", "2", "1"),
             "-maxrate", maxrate or _cap("CAPTURE_MAXRATE", "1500k"),
             "-bufsize", bufsize or _cap("CAPTURE_BUFSIZE", "3000k"),
             "-pix_fmt", "yuv420p"] + extra)


# --- Video encoder selection: GPU (VA-API) if the box can do it, else CPU x264 --
VAAPI_DEV = "/dev/dri/renderD128"
_VENC = None   # None=unprobed; then "vaapi" or "x264"


def _venc_mode() -> str:
    """Choose the H.264 encoder ONCE. Prefer VA-API (offloads the encoder to the
    GPU: ~40%->~5% CPU per stream) but ONLY after a real test-encode succeeds, so a
    box without a capable GPU (or a broken driver) transparently stays on libx264.
    Config: CAPTURE_ENCODER=auto|vaapi|x264."""
    global _VENC
    if _VENC is not None:
        return _VENC
    pref = (conf_get("CAPTURE_ENCODER", "auto") or "auto").lower()
    if pref == "x264" or not os.path.exists(VAAPI_DEV):
        _VENC = "x264"; return _VENC
    try:
        # Probe with the SAME rate-control args + a scale/format/hwupload filter the
        # real capture uses, so a driver that rejects an arg fails HERE (clean x264)
        # instead of dying a few seconds into the actual capture.
        r = subprocess.run(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-vaapi_device", VAAPI_DEV,
             "-f", "lavfi", "-i", "color=black:s=640x480:d=0.3",
             "-vf", "scale=320:-2,format=nv12,hwupload",
             "-c:v", "h264_vaapi", "-qp", _cap("CAPTURE_VAAPI_QP", "24"), "-f", "null", "-"],
            capture_output=True, timeout=25)
        _VENC = "vaapi" if r.returncode == 0 else "x264"
        if _VENC == "x264" and r.stderr:
            print("agent: VA-API probe failed -> libx264: %s"
                  % r.stderr.decode("utf-8", "replace").strip().replace("\n", " ")[:240], file=sys.stderr)
    except Exception:
        _VENC = "x264"
    if _VENC == "vaapi":
        print("agent: VA-API GPU H.264 encoder OK -> using it (low-CPU capture)", file=sys.stderr)
    return _VENC


def _venc_downgrade():
    """Runtime safety net: a VA-API capture died fast -> drop to libx264 for the
    rest of this uptime so recording/live can NEVER silently break on a bad GPU."""
    global _VENC
    if _VENC == "vaapi":
        print("agent: VA-API capture failed at runtime -> falling back to libx264", file=sys.stderr)
    _VENC = "x264"


def _venc_device() -> list:
    return ["-vaapi_device", VAAPI_DEV] if _venc_mode() == "vaapi" else []


def _venc_outfmt() -> str:
    """The pixel format the filter chain must end in, just before the encoder."""
    return "nv12,hwupload" if _venc_mode() == "vaapi" else "yuv420p"


def _venc(extra: list) -> list:
    """Encoder output opts for the active encoder (VA-API GPU or libx264 CPU)."""
    if _venc_mode() == "vaapi":
        # Many Intel i915 VAAPI drivers ONLY support CQP rate control — they reject
        # bitrate/VBR/CBR ("supported modes: CQP", confirmed on real hardware). So use
        # constant-QP, the universal VAAPI mode. Quality-based, no hard bitrate cap,
        # but screen content at QP24 stays modest.
        return (["-c:v", "h264_vaapi", "-qp", _cap("CAPTURE_VAAPI_QP", "24")] + extra)
    return _x264(extra)


def _venc_cam(extra: list = None) -> list:
    """Encoder opts for the CAMERA stream, which needs its OWN budget.

    A webcam shows real-world motion and sensor noise, so it SATURATES whatever
    ceiling it is handed, while a mostly-static desktop uses a fraction of the same
    allowance. Measured on real hardware with both sharing the screen's 1500k cap:
    the camera produced 25.3 MB against the screen's 5.7 MB over the same 3.6 minutes
    - 4.4x - i.e. ~421 MB/hour for the camera alone and 523 MB/hour for the pair,
    against ~104 MB/hour for screen-only recording.

    Surveillance needs a recognisable face, not a broadcast master, so the camera gets
    a smaller ceiling (x264) or a higher constant-QP (VAAPI, which is the only rate
    control these Intel drivers accept). Both are overridable per device.

    Re-measured across the live fleet: with the camera at 600k it was still producing
    110 KB per 3s segment against the screen's 116 KB - near-parity, for a stream with
    roughly a SIXTH of the screen's pixels, i.e. ~6x the bits per pixel. That is why
    the webcam looked sharper than the desktop it was meant to support, and why the
    camera accounted for 42% of all recorded bytes. The ceiling is now sized for
    identification instead: 480px wide at ~220k, which is ample for "who is at this
    machine" and roughly a third of the bytes.

    `extra` carries per-mode flags (hls vs mp4). It exists because the LIVE camera
    stream used to be encoded with the SCREEN's budget - 1500k / qp 24 - so the one
    camera stream nobody retains was also the most expensive thing on the uplink.
    """
    tail = extra if extra is not None else ["-g", "20"]
    if _venc_mode() == "vaapi":
        return ["-c:v", "h264_vaapi", "-qp", _cap("CAMERA_VAAPI_QP", "34")] + tail
    return _x264(tail,
                 maxrate=_cap("CAMERA_MAXRATE", "220k"),
                 bufsize=_cap("CAMERA_BUFSIZE", "440k"))


def _session_ffmpeg_cmd(cfg: dict, out: str, disp: str, hls_dir: str = None, rec_hls_dir: str = None):
    """One ffmpeg: screen (base) + webcam PiP overlay + mic audio + a drawtext
    lock banner read live from OVERLAY_FILE. Returns None if there's no video
    source to capture.

    When hls_dir is given, the SINGLE encoded stream is tee'd to BOTH the recording
    .mp4 AND a live HLS playlist in hls_dir — so the screen is captured + encoded
    ONCE for live view + recording together, instead of two ffmpegs each grabbing
    the screen (the CPU-starvation 'live + record is painful' bottleneck)."""
    have_screen = bool(cfg.get("screen"))
    cam_dev = _camera_device()
    have_camera = bool(cfg.get("camera")) and os.path.exists(cam_dev)
    have_mic = bool(cfg.get("mic"))

    c = _nice() + ["ffmpeg", "-y", "-loglevel", "error"] + _venc_device()
    fps = _cap_rt("CAPTURE_FPS", "10", "6")
    inputs, screen_i, cam_i, mic_i, idx = [], None, None, None, 0
    if have_screen:
        inputs += ["-f", "x11grab", "-framerate", fps, "-i", disp]; screen_i = idx; idx += 1
    if have_camera:
        inputs += _cam_input(cam_dev); cam_i = idx; idx += 1
    if have_mic:
        inputs += ["-f", conf_get("AUDIO_FORMAT", "pulse"), "-i", conf_get("AUDIO_DEVICE", "default")]
        mic_i = idx; idx += 1
    if screen_i is None and cam_i is None:
        return None

    font = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
    # drawtext reads OVERLAY_FILE each frame (reload=1); empty file => nothing drawn.
    draw = ("drawtext=textfile=%s:reload=1:fontfile=%s:fontcolor=white:fontsize=30:"
            "shadowcolor=black@0.85:shadowx=2:shadowy=2:x=(w-text_w)/2:y=48" % (OVERLAY_FILE, font))
    # Filter tail before the encoder. CPU path stays byte-identical to before; the
    # GPU path draws on the RGB frame then uploads an NV12 surface for h264_vaapi.
    tail = ("%s,format=nv12,hwupload" % draw) if _venc_mode() == "vaapi" else ("format=yuv420p,%s" % draw)
    parts = []
    # The camera gets its OWN stream when we are recording to HLS, instead of being
    # shrunk into a corner of the screen. A 320px picture-in-picture is nearly useless
    # for surveillance — you cannot recognise anybody in it — and it also meant the
    # live view had no camera pane to offer while recording, so Screen/Camera/Split
    # was unavailable exactly when it matters. Two outputs from ONE ffmpeg keeps the
    # single-owner webcam opened once, so there is still no v4l2 contention.
    cam_own_stream = (rec_hls_dir is not None and cam_i is not None and screen_i is not None)
    if screen_i is not None:
        base = "[%d:v]" % screen_i
        if cam_i is not None and not cam_own_stream:
            parts.append("[%d:v]scale=320:-2[cam]" % cam_i)
            parts.append("%s[cam]overlay=W-w-24:24[bg]" % base)
            base = "[bg]"
        parts.append("%sscale=%s:-2,%s[v]" % (base, _cap_rt("CAPTURE_SCALE_W", "1280", "960"), tail))
    else:
        parts.append("[%d:v]%s[v]" % (cam_i, tail))
    if cam_own_stream:
        # Its own encode at camera resolution. No drawtext: the lock banner belongs on
        # the screen, and no audio here either - the mic rides with the screen stream.
        parts.append("[%d:v]scale=%s:-2,%s[cv]"
                     % (cam_i, conf_get("CAMERA_SCALE_W", "480"),
                        "format=nv12,hwupload" if _venc_mode() == "vaapi" else "format=yuv420p"))
    fc = ";".join(parts)

    cmd = c + inputs + ["-filter_complex", fc, "-map", "[v]"]
    if mic_i is not None:
        # MONO at 64k, not stereo at 128k. Measured on a real production segment: the
        # audio track was 55 KB of a 124 KB segment — about 41% of the screen stream —
        # for a single room microphone. 128k stereo is a music setting; surveillance
        # audio needs to be intelligible, and 64k mono AAC is comfortably above the
        # threshold for that while halving the bytes. A webcam mic is one capsule
        # anyway, so "stereo" was duplicating a mono source at full price.
        cmd += ["-map", "%d:a" % mic_i, "-c:a", "aac",
                "-ac", _cap("MIC_CHANNELS", "1"),
                "-b:a", _cap("MIC_BITRATE", "64k")]
    if rec_hls_dir is not None:
        # Phase 2: the recording is a RETAINED HLS segment stream (screen + mic audio
        # + camera PiP) uploaded to S3 continuously and played back as VOD-HLS. Same
        # encode/filter as any recording — just an HLS muxer instead of one mpegts
        # file. list_size 0 + NO delete_segments keeps every segment in index.m3u8; a
        # clean stop writes #EXT-X-ENDLIST so it becomes seekable VOD.
        vaapi = _venc_mode() == "vaapi"
        enc_extra = ["-g", "20"] if vaapi else ["-tune", "zerolatency", "-g", "20"]
        hls_out = ["-f", "hls", "-hls_time", "3", "-hls_list_size", "0",
                   "-hls_flags", "append_list"]
        # One retained HLS stream per SOURCE, each in its own subdirectory so its own
        # uploader thread can push it to rec/<id>/<src>/ independently.
        sdir = os.path.join(rec_hls_dir, "screen")
        token = os.urandom(3).hex()
        cmd += _venc(enc_extra) + hls_out + [
            "-hls_segment_filename", os.path.join(sdir, "%s-seg%%05d.ts" % token),
            os.path.join(sdir, "index.m3u8")]
        if cam_own_stream:
            cdir = os.path.join(rec_hls_dir, "camera")
            ctok = os.urandom(3).hex()
            cmd += ["-map", "[cv]"] + _venc_cam() + hls_out + [
                "-hls_segment_filename", os.path.join(cdir, "%s-seg%%05d.ts" % ctok),
                os.path.join(cdir, "index.m3u8")]
    elif hls_dir is not None:
        # ONE encode -> tee to the recording (all streams) AND a live HLS playlist
        # (video only). The recording branch is MPEG-TS, NOT mp4: teeing one H.264
        # encode to both HLS (mpegts/Annex-B framing) and mp4 (AVCC/length-prefixed)
        # corrupts the mp4 branch — the samples come out with the wrong NAL framing
        # and NO player can decode them (black video), while live stays fine. Both
        # branches are mpegts here, so no framing conflict; the .ts is remuxed to a
        # clean, seekable .mp4 on stop (_faststart_remux). Unique segment token = the
        # same anti-loop guard; `select=v` keeps audio out of the live stream.
        token = os.urandom(3).hex()
        seg = os.path.join(hls_dir, "%s-seg%%05d.ts" % token)
        pl = os.path.join(hls_dir, "live.m3u8")
        tee = ("[select=v:f=hls:hls_time=3:hls_list_size=6:"
               "hls_flags=delete_segments+append_list+omit_endlist:hls_segment_filename=%s]%s"
               "|[f=mpegts]%s" % (seg, pl, out))
        vaapi = _venc_mode() == "vaapi"
        enc_extra = ["-g", "20"] if vaapi else ["-tune", "zerolatency", "-g", "20"]
        cmd += _venc(enc_extra) + ["-f", "tee", tee]
    else:
        # Record-only: also capture to MPEG-TS (Annex-B), then remux to a faststart
        # mp4 on stop — uniform with the tee path and avoids the fragmented-mp4
        # duration-0 issue that some browsers refuse to play.
        cmd += _venc(["-f", "mpegts", out])
    return cmd


def _rec_overlay_loop(sess: dict, stop_evt):
    """While recording, track lock state: record LOCK/UNLOCK markers on change and
    keep the on-video banner ("SCREEN LOCKED — <elapsed>") current."""
    while not stop_evt.is_set():
        locked = _is_locked()
        if locked != sess["locked"]:
            at = int(time.time() - sess["started"])
            sess["markers"].append({"type": "LOCK" if locked else "UNLOCK", "atSec": at})
            sess["locked"] = locked
            sess["lock_at"] = time.time() if locked else 0
            _write_sidecar(sess)   # keep the sidecar's markers current for recovery
        _write_overlay("SCREEN LOCKED   —   %s" % _fmt_hms(time.time() - sess["lock_at"]) if locked else "")
        stop_evt.wait(1.0)


def _audio_ok(env) -> bool:
    """Quick probe: can ffmpeg actually open the mic? If not (unplugged USB mic,
    PipeWire not up), record VIDEO-ONLY instead of letting the whole capture abort
    on a bad audio input."""
    if conf_get("REC_AUDIO_PROBE", "1").lower() not in ("1", "true", "yes", "on"):
        return True
    try:
        rc = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error",
                             "-f", conf_get("AUDIO_FORMAT", "pulse"), "-i", conf_get("AUDIO_DEVICE", "default"),
                             "-t", "0.2", "-f", "null", "-"], env=env, capture_output=True, timeout=8).returncode
        return rc == 0
    except Exception:
        return False


_MIC_FALLBACK_UNTIL = 0.0   # mic dropped (video-only) until this time
_MIC_FAILS = 0
_MIC_STALL_LIMIT = 3        # consecutive stalled resumes before blaming the mic


def _mic_downgrade():
    """The capture is alive but producing NOTHING, repeatedly, and the microphone is
    in the pipeline. ffmpeg emits no output until EVERY input is producing, so an
    audio source that accepts the open but never delivers frames silently blocks the
    VIDEO too: the process looks healthy, /tmp stays empty, and not one second of
    screen is recorded. Seen in the field with a USB headset as the default source —
    ffmpeg never even appeared as a PipeWire client.

    _audio_ok() only probes BEFORE the capture starts, so it cannot catch a source
    that blocks once the real capture attaches. Drop the mic and record video-only,
    then retry later: a recording with no sound is worth immeasurably more than no
    recording at all."""
    global _MIC_FALLBACK_UNTIL, _MIC_FAILS
    _MIC_FAILS += 1
    win = int(min(300 * (2 ** (_MIC_FAILS - 1)), 3600))
    _MIC_FALLBACK_UNTIL = time.time() + win
    print("agent: capture stalled with the mic attached -> video-only for ~%d min (attempt %d)"
          % (win // 60, _MIC_FAILS), file=sys.stderr)


# Errors that mean the USB endpoint has wedged, NOT that ffmpeg was asked for a format
# the camera dislikes. STREAMON returning EPROTO with nothing else holding the device is
# the signature: the node is enumerated and free, but the stream will not start.
#
# The distinction matters because the two need opposite treatment. A format problem is
# fixed by trying another format; a wedged endpoint is not fixed by ANY format, so
# rotating through four of them burns ~90 seconds and then drops the camera for minutes —
# which is what an operator sees as "the camera stopped working again".
_CAM_USB_FAULT = (
    "vidioc_streamon",          # the stream would not start
    "protocol error",           # EPROTO — the classic wedged-endpoint signature
    "input/output error",       # EIO
    "no such device",           # ENODEV: it vanished mid-open
)


def _cam_usb_fault(err: str) -> str:
    """The USB-level phrase in an ffmpeg error, or "" if this looks like a format issue."""
    low = (err or "").lower()
    for k in _CAM_USB_FAULT:
        if k in low:
            return k
    return ""


def _cam_downgrade(err: str = ""):
    """A camera recording died almost immediately. The webcam is a single-owner v4l2
    device whose decode + PiP overlay (and, on a software-encode fallback, the extra CPU)
    can wedge or crash the WHOLE capture — and when the recorder restarts it races the
    dying ffmpeg for the still-held camera, churning empty recordings forever. So drop the
    camera and record SCREEN-ONLY, then retry LATER. A bad/busy camera must never take down
    the screen recording. The window ESCALATES per consecutive failure (2m,4m,8m,... cap
    15m) so a persistently busy/redirected webcam is retried rarely, not every window.

    The cap used to be SIX HOURS, and that was the wrong trade for a surveillance
    product. The camera is only ever retried when a FRESH recording session begins —
    never mid-session — so a retry costs one ffmpeg start, while the backoff costs a
    missing camera track on every session inside the window. One transient failure
    (a USB enumeration race at boot, a webcam still held by a closing process) was
    therefore buying hours of screen-only recordings with no split view, on a device
    whose camera was working perfectly well. 15 minutes still throttles a genuinely
    busy camera to ~4 attempts an hour, which is ample crash-loop protection."""
    global _CAM_FALLBACK_UNTIL, _CAM_FAILS, _CAM_ATTEMPT
    _CAM_FAILS += 1
    cam_dev = _camera_device()

    # Distrust the cached node the moment capture FAILS.
    #
    # This is the other half of not re-probing on a timer. A UVC camera registers
    # more than one node, and immediately after a re-enumeration the capture node may
    # not be back yet — so a probe run in that instant can settle on the WRONG node
    # (seen for real: "camera device is /dev/video1 (was /dev/video0)" one second
    # after a re-enumeration, after which every capture died with
    # "Error opening input file /dev/video1"). The old 60s TTL papered over that by
    # re-probing on a timer; removing it without this made a wrong choice stick for
    # the whole trust window and churn 5-second recordings the entire time.
    #
    # Failure is a better trigger than a clock: it re-probes exactly when the choice
    # has been proven wrong, and never when it is working.
    _CAM_DEV["dev"], _CAM_DEV["at"] = "", 0.0
    cam_dev = _camera_device() or cam_dev

    # Who actually had the device, recorded AT THE MOMENT IT FAILED.
    #
    # The diagnostics bundle already runs this, but it runs when somebody asks for
    # logs — by then the recorder has long since released the camera and the file is
    # empty, which is exactly how this fault stayed unexplained through several
    # releases. Captured here it names the holder while the failure is live.
    held = ""
    try:
        r = subprocess.run(["sh", "-c", "fuser -v /dev/video* 2>&1 | head -12"],
                           capture_output=True, text=True, timeout=8)
        held = " ".join((r.stdout or "").split())
        print("agent: camera holders at failure: %s" % (held or "(none)"), file=sys.stderr)
    except Exception:
        pass
    # "(none)" is the important case: a USB fault with nobody holding the device is
    # resettable, whereas the same error while another process owns the camera means
    # waiting for that process, not power-cycling underneath it.
    held = held.strip()

    # A wedged USB endpoint is not a format problem — replug it instead.
    #
    # Without this the ladder below rotated through every capture format against a
    # camera that could not stream in ANY of them, then dropped it for minutes, then
    # repeated. The recovery an operator performs by hand is unplugging and replugging
    # the SAME port, which means the port is fine and the device firmware has hung — and
    # a hung device answers a bus-level reset. _camera_usb_reset carries its own backoff,
    # attempt cap, and refuses to act when the camera is also the microphone in use.
    fault = _cam_usb_fault(err)
    if fault and not held:
        print("agent: camera USB fault (%s) with no other holder - replugging in software"
              % fault, file=sys.stderr)
        if not _CAM_HEALTH.get("reported"):
            _CAM_HEALTH["reported"] = True
            _cam_event("CAMERA_LOST", node=cam_dev, reason=fault)
        method = _camera_usb_reset(cam_dev)
        if method:
            _CAM_HEALTH["tried"] = method
            _CAM_HEALTH["tried_at"] = time.time()
            # Do NOT advance the format rotation: the format was never the problem, and
            # spending a variant on it means the real format is retried later and less
            # often. The next recording attempt retries the same one against a camera
            # that has just been reset.
            return

    # Try a different capture format before writing the camera off. Only once every
    # variant has failed does the backoff window open, so a camera that simply
    # dislikes one alt-setting recovers in seconds rather than being dropped for
    # minutes at a time.
    variants = _cam_variants(cam_dev)
    _CAM_ATTEMPT += 1
    if _CAM_ATTEMPT % len(variants) != 0:
        fmt, size = variants[_CAM_ATTEMPT % len(variants)]
        print("agent: camera capture failed -> retrying as %s %s (variant %d of %d)"
              % (fmt or "driver default", size or "driver size",
                 (_CAM_ATTEMPT % len(variants)) + 1, len(variants)), file=sys.stderr)
        return

    win = int(min(120 * (2 ** (max(1, _CAM_FAILS // max(1, len(variants))) - 1)), 900))
    _CAM_FALLBACK_UNTIL = time.time() + win
    print("agent: camera capture failing in every format -> screen-only for ~%d min (attempt %d)"
          % (win // 60, _CAM_FAILS), file=sys.stderr)


def _tail_text(path: str, n: int = 800) -> str:
    """Last n bytes of a file as text — used to surface ffmpeg's own error on a fast
    death (its stderr goes to a per-session file, so failures are finally diagnosable)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2); sz = f.tell(); f.seek(max(0, sz - n))
            return f.read().decode("utf-8", "replace").strip()
    except Exception:
        return ""


def _rec_session_stalled(sess: dict) -> bool:
    """True when an HLS recording's ffmpeg is still alive but has stopped producing
    segments — e.g. its X11 capture wedged after the RDP display froze. ffmpeg rewrites
    index.m3u8 every ~3s as each segment completes; if it hasn't advanced in
    _REC_STALL_SECS the pipeline is stuck and proc.poll() (still None) can't see it, so
    the recording would silently die until reboot. Give a young session a grace period so
    startup (no index yet) isn't mistaken for a stall."""
    if not sess.get("hls"):
        return False
    # Grace the CURRENT ffmpeg run, not the whole session. A resumed ffmpeg needs a
    # few seconds to cut its first segment, but the session clock is long past the
    # grace window by then — so a resumed process was being judged instantly.
    ref = sess.get("started_run") or sess.get("started", 0)
    if time.time() - ref < _REC_STALL_SECS:
        return False
    # The index moved when recording split into one HLS stream PER SOURCE: it is now
    # <outdir>/screen/index.m3u8, not <outdir>/index.m3u8. This check was left on the
    # old flat path, so os.stat raised OSError on every call and the function returned
    # True for EVERY session older than a minute — a permanent false "stalled". The
    # recorder then killed and resumed ffmpeg on every poll (~6s) until it hit
    # _REC_MAX_RUNS, sealed the file and started another, which is why recordings
    # arrived as a string of ~8-minute fragments. Check both layouts and take the
    # freshest, so older flat sessions still work.
    # Judge EVERY enabled source, and take the STALEST — not the freshest.
    #
    # Taking the freshest meant one healthy stream masked a dead one. On 23 Sep Joey's
    # screen stopped producing segments at 17:02 while his camera ran on until 17:53:
    # the camera's fresh mtime kept saying "not stalled" and the machine recorded no
    # screen at all for fifty minutes. A recording is only healthy when every source it
    # claims to capture is still moving.
    outdir = sess.get("outdir", "")
    want = ["screen"] if not sess.get("camera") else ["screen", "camera"]
    stalest = None
    for src in want:
        try:
            m = os.stat(os.path.join(outdir, src, "index.m3u8")).st_mtime
        except OSError:
            # Older flat layout (one stream, no per-source directory).
            try:
                m = os.stat(os.path.join(outdir, "index.m3u8")).st_mtime
            except OSError:
                return True               # this source has never produced an index
        if stalest is None or m < stalest:
            stalest = m
    if stalest is None:
        return True                       # genuinely never produced an index
    return (time.time() - stalest) > _REC_STALL_SECS


def _rec_resume(sess: dict, cfg: dict) -> bool:
    """Restart ffmpeg INTO THE SAME recording — same recording id, same temp dir, same
    uploader thread — so an involuntary ffmpeg exit does NOT split the day into another
    file. ffmpeg picks a fresh random segment prefix each run, which the uploader spots
    and marks with #EXT-X-DISCONTINUITY, so players handle the seam correctly.

    Returns True if the recording was resumed; False to fall back to sealing + a new file."""
    try:
        p = sess.get("proc")
        if p is not None and p.poll() is None:      # stalled-but-alive: force it down first
            for fn in (p.terminate, p.kill):
                try: fn()
                except Exception: pass
            try: p.wait(timeout=5)
            except Exception: pass
        if sess.get("errfh") is not None:
            try: sess["errfh"].close()
            except Exception: pass
        env, disp = _rec_env()
        rcfg = dict(cfg); rcfg["camera"] = sess.get("camera", False)
        # Keep the resumed run identical to the session it is resuming INTO — including
        # a mic that was already dropped, so a resume cannot quietly re-attach the
        # blocked audio source the session was restarted to escape.
        rcfg["mic"] = bool(rcfg.get("mic") and sess.get("mic", True)
                           and time.time() >= _MIC_FALLBACK_UNTIL)
        if rcfg.get("mic") and not _audio_ok(env):
            rcfg["mic"] = False
        cmd = _session_ffmpeg_cmd(rcfg, None, disp, rec_hls_dir=sess["outdir"])
        if cmd is None:
            return False
        errpath = os.path.join(sess["outdir"], "ffmpeg.err")
        try: errfh = open(errpath, "wb")
        except OSError: errfh = None
        np = subprocess.Popen(cmd, env=env, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                              stderr=(errfh if errfh is not None else subprocess.DEVNULL))
    except Exception as e:
        print("agent: recording resume failed (%s) -> starting a new file" % e, file=sys.stderr)
        return False
    sess["proc"] = np
    sess["errpath"] = errpath
    sess["errfh"] = errfh
    sess["runs"] = sess.get("runs", 1) + 1
    sess["started_run"] = time.time()
    print("agent: recording resumed into the SAME file %s (ffmpeg run %d)"
          % (sess["rid"], sess["runs"]), file=sys.stderr)
    return True


def _rec_start(base: str, creds: dict, cfg: dict):
    global _REC_SESSION, _REC_SEQ
    # Never record the live/installer environment.
    if os.path.exists("/run/live/medium") or os.path.exists("/lib/live/mount"):
        return
    with _REC_LOCK:
        # The webcam is a single-owner v4l2 device, so exactly one of the two
        # subsystems may hold it. The RECORDER wins: a recording is the artefact that
        # has to be complete after the fact, and the live screen pane is served from
        # the recording's own segments anyway (Increment 2b) - so the camera composited
        # into that stream is visible live AND kept in the recording, from one capture.
        #
        # This used to yield the camera to live whenever a stream was active
        # (`not _STREAM_ACTIVE`), which had two bad effects: the recording silently
        # LOST its camera for as long as an admin watched, and the camera appeared
        # twice during the handover (still composited into the recording's segments
        # while live had also opened it as its own pane). Live now skips the camera
        # instead - see _rec_owns_camera() - so there is one owner and one capture.
        #
        # If the camera genuinely cannot be opened (busy, or redirected into the RDP
        # session) the existing _CAM_FALLBACK_UNTIL backoff drops this recording to
        # screen-only; want_camera then goes False, _rec_owns_camera() follows, and
        # live is free to take the camera instead. So the fallback still works.
        global _REC_FAILS, _REC_RETRY_AT, _CAM_FAILS
        cam_dev = _camera_device()
        cam_wanted = bool(cfg.get("camera"))
        cam_present = bool(cam_dev) and os.path.exists(cam_dev)
        now_t = time.time()

        # A camera that vanished MOMENTS ago is re-enumerating, not unplugged. On real
        # hardware the gap is about a second (USB disconnect 15:05:59, back 15:06:00),
        # and the recorder used to restart inside that second, find nothing, and be born
        # screen-only — which then lasted the whole session because a screen-only
        # recording is never upgraded mid-run. One blip cost 109 minutes of camera.
        cam_settling = (cam_wanted and not cam_present and _CAM_HEALTH["lost_at"]
                        and now_t - _CAM_HEALTH["lost_at"] < _CAM_SETTLE_SECS)

        # Past the settle window it is a real outage: say so once, then try a software
        # replug. Operators report that unplugging and re-plugging the SAME port fixes
        # it, which means the port is fine and the firmware has hung — so the agent can
        # do that itself instead of costing somebody a walk and an hour of footage.
        if (cam_wanted and not cam_present and _CAM_HEALTH["lost_at"]
                and now_t - _CAM_HEALTH["lost_at"] >= _CAM_SETTLE_SECS):
            if not _CAM_HEALTH["reported"]:
                _CAM_HEALTH["reported"] = True
                _cam_event("CAMERA_LOST", node=_CAM_HEALTH.get("node", ""))
                print("agent: camera lost (%s) - attempting recovery"
                      % _CAM_HEALTH.get("node", "?"), file=sys.stderr)
            method = _camera_usb_reset(_CAM_HEALTH.get("node", ""))
            if method:
                # Record WHAT was tried and WHEN — not that it worked. Credit is only
                # given below if the camera actually returns shortly afterwards.
                _CAM_HEALTH["tried"] = method
                _CAM_HEALTH["tried_at"] = time.time()

        want_camera = (cam_wanted and cam_present and now_t >= _CAM_FALLBACK_UNTIL)
        if _REC_SESSION is not None:
            alive = _REC_SESSION["proc"].poll() is None
            stalled = alive and _rec_session_stalled(_REC_SESSION)
            cur_cam = _REC_SESSION.get("camera", False)
            # Restart to DROP the camera when it must go (unplugged, or the busy/RDP
            # fallback window opened - live no longer takes it away mid-recording), but
            # NEVER tear down a healthy recording just to ADD the camera.
            # On a device whose webcam is busy/redirected into RDP, that "upgrade" fails
            # instantly and repeats every fallback window -> the recording start/stops
            # forever. So a screen-only recording STAYS screen-only until a natural restart;
            # the camera is only (re)tried when a fresh recording begins.
            # The camera must also be picked up again when it MOVES. A webcam that
            # re-enumerates onto a different node leaves this session capturing a path
            # that no longer exists, and nothing else notices: want_camera is true (the
            # new node is there), so the drop-the-camera test above never fires and the
            # recording runs on happily with a dead camera input.
            cam_moved = cur_cam and want_camera and _REC_SESSION.get("cam_dev") not in ("", cam_dev)
            if cam_moved:
                print("agent: camera moved %s -> %s; restarting the recording"
                      % (_REC_SESSION.get("cam_dev"), cam_dev), file=sys.stderr)
            must_drop_cam = (cur_cam and not want_camera) or cam_moved

            # Add the camera back to a screen-only session — ONCE.
            #
            # The rule above ("never tear down a healthy recording to ADD the camera")
            # exists because a busy/redirected webcam made that upgrade fail instantly
            # and repeat every fallback window, churning recordings for ever. That
            # reasoning is sound; the blanket ban was not. It meant a one-second USB
            # blip locked a session to screen-only for hours, and the 2-15 minute
            # camera backoff was irrelevant because it is only consulted when a FRESH
            # session begins — and sessions here run for a whole shift.
            #
            # Bounded to a single upgrade per session, so the worst case is one extra
            # restart rather than the endless churn the ban was written to prevent.
            cam_upgrade = (alive and not stalled and not must_drop_cam
                           and want_camera and not cur_cam
                           and not _REC_SESSION.get("cam_upgraded")
                           and time.time() - _REC_SESSION.get("started_run", 0) > 20)
            if cam_upgrade:
                _REC_SESSION["cam_upgraded"] = True
                print("agent: camera is back - restarting the recording once to add it",
                      file=sys.stderr)

            if alive and not stalled and not must_drop_cam and not cam_upgrade:
                _REC_FAILS = 0           # a live, healthy session clears the fail streak
                if cur_cam:
                    _CAM_FAILS = 0       # a working camera recording clears the cam streak
                    globals()["_CAM_ATTEMPT"] = 0   # ...and the format ladder
                return                   # still recording — don't churn it
            ran = time.time() - _REC_SESSION.get("started_run", _REC_SESSION.get("started", 0))
            died_fast = (not alive) and ran < 20
            # ALWAYS report why ffmpeg stopped — exit code + its own stderr. This used to
            # be logged only for deaths inside 20s, which meant a session that ran for an
            # hour and then exited told us NOTHING, and the recording silently split.
            # Bound before the branch. `died_fast` implies `not alive` today, so the
            # assignment below always happens before err is read — but that is a coupling
            # between two conditions, not a guarantee, and the failure mode is a
            # NameError that takes out the recorder tick.
            err = ""
            if not alive:
                err = _tail_text(_REC_SESSION.get("errpath", ""))
                print("agent: recording ffmpeg exited rc=%s after %ds%s"
                      % (_REC_SESSION["proc"].returncode, int(ran),
                         (": " + err.replace("\n", " | ")[-240:]) if err else " (no stderr captured)"),
                      file=sys.stderr)
            if died_fast:
                # A hardware-encode death this fast means the GPU pipeline is bad.
                if _REC_SESSION.get("venc") == "vaapi":
                    _venc_downgrade()
                # A camera session that can't survive 20s -> drop the camera. The webcam
                # (decode + PiP overlay, heavier still under software encode) is the usual
                # culprit + is single-owner, so keeping it retries the same crash forever.
                if _REC_SESSION.get("camera"):
                    # ffmpeg's own stderr, so the handler can tell a wedged USB endpoint
                    # from a format the camera dislikes — they need opposite treatment.
                    _cam_downgrade(err)
                _REC_FAILS += 1
                _REC_RETRY_AT = time.time() + min(10 * _REC_FAILS, 120)   # back off the churn
            else:
                _REC_FAILS = 0
            # An involuntary interruption (ffmpeg exited, or wedged and we killed it) is
            # NOT a new recording — the operator did nothing. Resume into the SAME file so
            # a day is one recording, as an admin expects, instead of a dozen fragments.
            # We still roll a fresh file when: the camera config genuinely changed, the
            # pipeline is crash-looping (died_fast — a new file with downgraded settings is
            # the right move), we've folded in too many restarts, or the session has run
            # long enough to deserve a natural boundary.
            # A stall means ffmpeg was alive and producing nothing. Count them: a
            # session that keeps stalling with the microphone attached is the signature
            # of a blocked audio input, which starves the video too. After a few, drop
            # the mic and roll a fresh recording without it rather than resuming into
            # the same dead pipeline until _REC_MAX_RUNS.
            must_drop_mic = False
            if stalled:
                _REC_SESSION["stalls"] = _REC_SESSION.get("stalls", 0) + 1
                if (_REC_SESSION["stalls"] >= _MIC_STALL_LIMIT
                        and _REC_SESSION.get("mic")
                        and time.time() >= _MIC_FALLBACK_UNTIL):
                    _mic_downgrade()
                    must_drop_mic = True
            else:
                _REC_SESSION["stalls"] = 0
            total_ran = time.time() - _REC_SESSION.get("started", 0)
            if (not must_drop_cam and not cam_upgrade and not must_drop_mic and not died_fast
                    and _REC_SESSION.get("runs", 1) < _REC_MAX_RUNS
                    and total_ran < _REC_MAX_SESSION_SECS
                    and _rec_resume(_REC_SESSION, cfg)):
                return
            # Otherwise: seal what we have (already durable in S3) and start a FRESH
            # recording. Finalize kills a stalled-but-alive ffmpeg before sealing.
            dead = _REC_SESSION; _REC_SESSION = None
            threading.Thread(target=_finalize_hls_session, args=(base, dict(creds), dead), daemon=True).start()
            reason = ("stalled" if stalled else
                      ("adding the camera back" if cam_upgrade else
                       ("camera handoff" if alive else "ffmpeg exited")))
            print("agent: recording restart (%s)" % reason, file=sys.stderr)
        # Back off after repeated fast failures so we don't churn empty recordings every
        # poll (each churn also creates + seals a DB row + spins up ffmpeg). want_camera
        # above has already gone screen-only, so the next attempt is much lighter.
        if time.time() < _REC_RETRY_AT:
            return

        # THE fix for the reported fault. Do not START a session during the few
        # seconds a camera takes to re-enumerate: a session born without the camera
        # stays screen-only for its whole run, so beginning one inside that window
        # traded a one-second blip for 109 minutes of missing camera. Waiting costs a
        # few seconds of screen footage at most, and the poll comes round again
        # shortly; if the camera really is unplugged the settle window expires and the
        # session starts screen-only exactly as before.
        if cam_settling and _REC_SESSION is None:
            return

        env, disp = _rec_env()
        # Mic is optional — never let a bad audio device abort the whole capture.
        rcfg = dict(cfg); rcfg["camera"] = want_camera
        if rcfg.get("mic") and time.time() < _MIC_FALLBACK_UNTIL:
            rcfg["mic"] = False          # a blocked audio source starved the last capture
        if rcfg.get("mic") and not _audio_ok(env):
            print("agent: mic unavailable; recording video-only", file=sys.stderr)
            rcfg["mic"] = False
        # Capture to a RETAINED HLS segment stream in a temp dir; the uploader pushes
        # each segment + index.m3u8 to S3 continuously (durable within seconds), so the
        # device holds only the unsent tail. Sealed to VOD (#EXT-X-ENDLIST) on stop.
        outdir = tempfile.mkdtemp(prefix="tcrec-")
        # ffmpeg will not create these, and a missing directory kills the capture.
        for _sub in ("screen", "camera"):
            try: os.makedirs(os.path.join(outdir, _sub), exist_ok=True)
            except OSError: pass
        _REC_SEQ += 1
        # Build the capture command BEFORE registering anything with the manager.
        # _session_ffmpeg_cmd returns None when there is no VIDEO source at all (a
        # mic-only monitoring config), and this used to register the recording first
        # — so every poll created a fresh Recording row that was never fed, and with
        # no backoff on this path it did so every few seconds. Deciding first means a
        # config we cannot capture costs nothing, and the backoff stops the retry loop.
        cmd = _session_ffmpeg_cmd(rcfg, None, disp, rec_hls_dir=outdir)
        if cmd is None:
            shutil.rmtree(outdir, ignore_errors=True)
            _REC_RETRY_AT = time.time() + 300
            print("agent: no screen or camera enabled — nothing to record "
                  "(mic alone cannot be recorded); retrying in 5 min", file=sys.stderr)
            return
        # Register the recording with the manager (needs tenant storage + connectivity).
        rid = _rec_hls_begin(base, dict(creds))
        if not rid:
            shutil.rmtree(outdir, ignore_errors=True)
            return                       # no tenant storage / offline -> skip this cycle
        _write_overlay("")               # start clean (drawtext needs the file to exist)
        errpath = os.path.join(outdir, "ffmpeg.err")   # keep ffmpeg's stderr for diagnosis
        try:
            errfh = open(errpath, "wb")
        except OSError:
            errfh = None
        try:
            p = subprocess.Popen(cmd, env=env, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                 stderr=(errfh if errfh is not None else subprocess.DEVNULL))
        except Exception as e:
            print("agent: failed to start recording: %s" % e, file=sys.stderr)
            if errfh is not None:
                try: errfh.close()
                except Exception: pass
            shutil.rmtree(outdir, ignore_errors=True)
            return
        stop = threading.Event(); up_stop = threading.Event()
        sess = {"proc": p, "rid": rid, "outdir": outdir, "started": time.time(),
                "started_run": time.time(), "runs": 1, "markers": [],
                "locked": False, "lock_at": 0, "stop": stop, "up_stop": up_stop,
                "thread": None, "up_thread": None, "errpath": errpath, "errfh": errfh,
                "camera": want_camera, "cam_dev": cam_dev if want_camera else "",
                "screen_src": bool(rcfg.get("screen")),
                "mic": bool(rcfg.get("mic")), "stalls": 0,
                "venc": _venc_mode(), "hls": True}
        _REC_LIVE_PUB[0] = 0.0        # this session hasn't published a live window yet
        _REC_LIVE_HANDOFF[0] = False  # ... so live keeps its own capture until it has
        # An uploader per source. The camera is its own retained stream now, so it gets
        # its own thread pushing to rec/<id>/camera/ — that is what lets the live view
        # offer a real Camera pane (and a full-size camera recording to review) while
        # a recording is running.
        up = threading.Thread(target=_rec_hls_uploader,
                              args=(rid, "screen", os.path.join(outdir, "screen"), up_stop, base, dict(creds)),
                              daemon=True)
        sess["up_thread"] = up; up.start()
        if want_camera:
            cam_stop = threading.Event()
            cam_up = threading.Thread(target=_rec_hls_uploader,
                                      args=(rid, "camera", os.path.join(outdir, "camera"), cam_stop, base, dict(creds)),
                                      daemon=True)
            sess["cam_stop"] = cam_stop
            sess["cam_thread"] = cam_up
            cam_up.start()
        th = threading.Thread(target=_rec_overlay_loop, args=(sess, stop), daemon=True)
        sess["thread"] = th; th.start()
        _REC_SESSION = sess
        print("agent: HLS recording %s -> %s" % (rid, outdir), file=sys.stderr)
    # Show the small badge (naming the active sources) unless the tenant runs silent.
    _rec_indicator(bool(cfg.get("notice", True)), cfg)


def _rec_stop_and_upload(base: str, creds: dict):
    global _REC_SESSION
    with _REC_LOCK:
        sess = _REC_SESSION
        _REC_SESSION = None
    if sess is None:
        return
    _rec_indicator(False)
    fn = _finalize_hls_session if sess.get("hls") else _finalize_session
    threading.Thread(target=fn, args=(base, creds, sess), daemon=True).start()


def _finalize_session(base: str, creds: dict, sess: dict):
    try:
        sess["stop"].set()               # stop the overlay/marker loop
    except Exception:
        pass
    # If this session also served the live screen (tee), stop its uploader + drop the
    # segment dir — the live view resumes from a fresh capture on the next poll.
    if sess.get("hls_stop") is not None:
        try: sess["hls_stop"].set()
        except Exception: pass
    if sess.get("hls_dir"):
        shutil.rmtree(sess["hls_dir"], ignore_errors=True)
    _write_overlay("")
    p = sess["proc"]; path = sess["path"]
    try:
        if p.poll() is None:
            p.communicate(input=b"q", timeout=12)   # graceful stop -> finalize container
    except Exception:
        for fn in (p.terminate, p.kill):
            try: fn()
            except Exception: pass
    if not (os.path.exists(path) and os.path.getsize(path) > 0):
        print("agent: recording empty; skipped", file=sys.stderr)
        return
    dur = max(0, int(time.time() - sess["started"]))
    # The capture is a FRAGMENTED mp4 (empty_moov) so a killed ffmpeg still leaves a
    # valid file — but that format reports duration 0 and browsers (esp. Safari/iOS)
    # won't play it as a plain <video>. Remux (stream-copy, no re-encode) to a
    # faststart progressive mp4 with a real moov so it plays in any browser/player;
    # fall back to the fragmented original if the remux fails.
    upload_path = _faststart_remux(path)
    markers = sess.get("markers", [])
    # Mark the paths in-flight so the background drain never double-uploads them.
    _mark_inflight(path); _mark_inflight(upload_path)
    try:
        ok = _upload_recording(base, creds, upload_path, dur, markers)
    finally:
        _clear_inflight(path); _clear_inflight(upload_path)
    # Only delete after a CONFIRMED upload — a failed PUT must not silently destroy
    # the only copy of a monitored session. On failure keep the file AND persist its
    # markers+duration so the periodic drain (or the next boot) retries it; prune the
    # oldest leftovers so a run of failures can't fill the disk.
    if ok:
        for f in {path, upload_path, _sidecar_path(path)}:
            try: os.remove(f)
            except Exception: pass
    else:
        _save_sidecar(path, {"started": int(sess.get("started", 0)), "kind": "session",
                             "markers": markers, "duration": dur})
        _prune_rec_dir(keep=20)


def _faststart_remux(path: str) -> str:
    """Remux the captured MPEG-TS into a progressive faststart .mp4 (moov at the
    front, real duration + sample tables, AVCC framing) so it plays + seeks in any
    browser/player. Stream-copy only (no re-encode) → quick + lossless; ffmpeg
    converts the TS Annex-B H.264 (and ADTS AAC) to the mp4's length-prefixed form
    automatically. Returns the .mp4 path, or the original .ts if the remux fails."""
    if not path.endswith(".ts"):
        return path
    out = path[:-3] + ".mp4"
    try:
        rc = subprocess.run(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-fflags", "+genpts", "-i", path,
             "-c", "copy", "-movflags", "+faststart", out],
            capture_output=True, timeout=600).returncode
        if rc == 0 and os.path.exists(out) and os.path.getsize(out) > 0:
            return out
        print("agent: ts->mp4 remux failed (rc=%s); uploading raw .ts" % rc, file=sys.stderr)
    except Exception as e:
        print("agent: ts->mp4 remux error: %s" % e, file=sys.stderr)
    return path


def _prune_rec_dir(keep: int = 20):
    try:
        files = sorted((os.path.join(REC_DIR, f) for f in os.listdir(REC_DIR) if f.endswith((".ts", ".mp4"))),
                       key=lambda p: os.path.getmtime(p))
        for p in files[:-keep]:
            try: os.remove(p)
            except Exception: pass
    except Exception:
        pass


def _upload_recording(base: str, creds: dict, path: str, dur: int, markers: list) -> bool:
    resp = _curl_json("%s/api/agent/upload-url" % base, dict(creds, kind="session"))
    if not resp or not resp.get("upload_url"):
        print("agent: no upload URL (tenant storage configured?)", file=sys.stderr)
        return False
    size = os.path.getsize(path)
    mime = "video/mp4" if path.endswith(".mp4") else "video/mp2t"
    rc = subprocess.run(
        ["curl", "-fsS", "--max-time", "1800", "-X", "PUT",
         "-H", "content-type: %s" % mime, "--upload-file", path, resp["upload_url"]],
        capture_output=True, timeout=1850).returncode
    _curl_json("%s/api/agent/recording-done" % base,
               dict(creds, recording_id=resp.get("recording_id"),
                    duration_sec=dur, size_bytes=size, ok=(rc == 0), markers=markers))
    print("agent: uploaded session (%d bytes, ok=%s, %d markers)" % (size, rc == 0, len(markers)), file=sys.stderr)
    return rc == 0


# --- Phase 2: recording as a RETAINED HLS segment stream (durable in S3 within
# seconds, played back as VOD-HLS). Mirrors the live uploader, but targets rec-url,
# keeps every segment (retention), and seals with #EXT-X-ENDLIST + rec-done. --------
def _rec_hls_begin(base: str, creds: dict):
    """Register a Phase-2 HLS recording -> recording_id (None if no tenant storage /
    offline, in which case we simply don't record this cycle)."""
    resp = _curl_json("%s/api/agent/rec-start" % base, dict(creds))
    return resp.get("recording_id") if resp else None


def _rec_url_put(base: str, creds: dict, rid: str, src: str, path: str, fname: str) -> bool:
    resp = _curl_json("%s/api/agent/rec-url" % base, dict(creds, recording_id=rid, src=src, file=fname))
    if not resp or not resp.get("upload_url"):
        return False
    ctype = "application/vnd.apple.mpegurl" if fname.endswith(".m3u8") else "video/mp2t"
    try:
        rc = subprocess.run(["curl", "-fsS", "--max-time", "30", "-X", "PUT",
                             "-H", "content-type: %s" % ctype, "--upload-file", path, resp["upload_url"]],
                            capture_output=True, timeout=35).returncode
    except Exception:
        # A slow/hung PUT (flaky uplink) would raise TimeoutExpired — must NOT escape
        # to the uploader loop or it kills the whole recording's upload thread. Report
        # failure; the next flush retries this file.
        return False
    return rc == 0


_REC_UP_MAX_BACKLOG = 1200   # ceiling; the real cap is sized to tmpfs — see below
_REC_UP_MIN_BACKLOG = 120    # ~6 min of cover; never buffer less than this


def _rec_backlog_cap() -> int:
    """How many un-uploaded segments may sit in /tmp before the oldest are dropped.

    /tmp is tmpfs — RAM — and the appliance mounts it with no `size=`, so tmpfs takes
    its default of half of physical memory. A fixed 1200-segment cap is ~130 MB per
    source (~260 MB with screen + camera), which is nothing on an 8 GB box and a
    quarter of the whole tmpfs on a 2 GB one. Size the buffer to the machine instead:
    take a quarter of what /tmp currently has free, so a small machine buffers less
    rather than competing with the session for memory.

    The buffer itself is NOT optional. HLS is file-based — ffmpeg writes a segment and
    curl uploads that file — and it is what lets a recording survive a network blip
    instead of losing those seconds for good. The goal is to bound it, not remove it.
    """
    try:
        st = os.statvfs("/tmp")
        free = st.f_bavail * st.f_frsize
        seg = 110 * 1024                       # measured average segment, both sources
        cap = int((free * 0.25) / seg)
        return max(_REC_UP_MIN_BACKLOG, min(_REC_UP_MAX_BACKLOG, cap))
    except Exception:
        return _REC_UP_MAX_BACKLOG

# How far the recording uploader is behind real time, in segments (published by
# _rec_hls_uploader, read by _rec_owns_screen). This matters because the recorder
# uploads OLDEST-FIRST to keep the recording complete, whereas the live pipeline
# deletes what it can't keep up with and so always sits at the live edge. On a
# congested uplink the recorder's rolling window is therefore the last 20 segments
# it MANAGED TO SEND, which can be far behind now - and the manager's freshness gate
# can't see it, because the manifest keeps being republished (fresh manifest, stale
# video). So live only hands its own capture over while the uploader is keeping up.
_REC_UP_BEHIND = [0]
_REC_LIVE_HANDOFF = [False]   # sticky, so we don't churn ffmpeg around the threshold
# When the recorder first got its rolling live window into S3 for THIS session, i.e.
# the moment the manager became able to serve live from the recording. 0 = not yet.
_REC_LIVE_PUB = [0.0]
_LAG_HANDOFF_MAX = 4          # hand over only when the uploader is near real time
_LAG_HANDBACK = 20            # take it back if it falls a whole live window behind


def _rec_hls_uploader(rid: str, src: str, outdir: str, stop_evt, base: str, creds: dict):
    """Continuously upload the retained HLS to S3. Two rules make this robust on a slow
    or flaky uplink (where ffmpeg outruns the link):

      1. We upload an index we BUILD OURSELVES that lists ONLY segments already in S3.
         ffmpeg's own index lists every segment it has written (hls_list_size 0),
         including ones not yet uploaded — publishing that would make the player 404 on
         the missing tail. And uploading it only when fully caught up would let a slow
         link STARVE the index forever (segments keep coming, the index never re-posts,
         and the manager — which reads the index — sees the recording frozen). Building
         from the confirmed-uploaded set every pass keeps the manifest valid AND moving.

      2. The local segment backlog is bounded: once it's clearly hopeless (>~1h of
         un-uploaded segments) we drop the OLDEST so /tmp can't fill and ffmpeg can't
         die on a full disk. On an adequate uplink the backlog is ~0 and nothing drops.
    """
    uploaded = []            # confirmed-in-S3 segment filenames, in order
    uploaded_set = set()
    last_idx = [0.0]         # wall-clock of the last FULL manifest publish
    last_live = [0.0]        # wall-clock of the last rolling live-window publish
    LIVE_WINDOW = 20         # segments (~66s) - enough for hls.js to buffer safely
    # The rolling window is ~800 bytes, so it is published as fast as segments land
    # (one per ~3.3s): the same number of manifest PUTs the old publish-the-whole-index
    # loop made, with none of its bytes, and NO added live latency. The floor only
    # throttles the burst while a backlog drains.
    LIVE_EVERY = 2
    FULL_EVERY = 60          # seconds between full-index publishes (VOD durability)
    last_log = [0.0]
    NOMINAL = 3.333333       # only used for a segment ffmpeg hasn't indexed yet
    durs = {}                # segment filename -> its REAL duration, per ffmpeg
    last_scan = [0.0]

    def _scan_durs():
        """Read the TRUE segment durations out of ffmpeg's own index.

        We publish an index we build ourselves (it must list only segments already
        confirmed in S3), and it used to declare a flat 3.333333s for every segment.
        That is a guess, and a wrong one: `-hls_time 3` is a floor, the muxer can only
        cut on a keyframe, so the real length follows CAPTURE_FPS and the GOP. Measured
        on a 10fps/GOP-20 device the segments were ~3.0s, so a 487s recording declared
        ~540s - the VOD timeline ran ~11% long and seeking drifted by minutes near the
        end. ffmpeg writes the true #EXTINF for every segment it closes, so read them
        from there instead of guessing.

        Cheap enough to do per publish: a local read of a file that reaches ~320 KB
        after 8 hours, on tmpfs. It was previously avoided because the index was
        re-published every ~3s; now the full one goes out once a minute.
        """
        try:
            with open(os.path.join(outdir, "index.m3u8")) as fh:
                pend = None
                for line in fh:
                    line = line.strip()
                    if line.startswith("#EXTINF:"):
                        try:
                            pend = float(line[8:].split(",")[0])
                        except ValueError:
                            pend = None
                    elif line and not line.startswith("#"):
                        if pend is not None:
                            durs[os.path.basename(line)] = pend
                        pend = None
        except OSError:
            pass
        last_scan[0] = time.time()

    def _header(seq, files):
        # TARGETDURATION must be >= the longest EXTINF or players may stall; derive it
        # from what we are actually listing rather than hardcoding it.
        longest = NOMINAL
        for f in files:
            d = durs.get(f)
            if d and d > longest:
                longest = d
        return ["#EXTM3U", "#EXT-X-VERSION:3",
                "#EXT-X-TARGETDURATION:%d" % max(4, int(math.ceil(longest))),
                "#EXT-X-MEDIA-SEQUENCE:%d" % seq]

    def _entries(files):
        """Playlist body for `files`, inserting a discontinuity wherever the segment
        prefix changes (a change of prefix means the recording was RESUMED, and
        players need the marker or the seam stalls)."""
        if time.time() - last_scan[0] >= 2:
            _scan_durs()
        out = []
        prev_pfx = None
        for f in files:
            pfx = f.split("-", 1)[0]
            if prev_pfx is not None and pfx != prev_pfx:
                out.append("#EXT-X-DISCONTINUITY")
            prev_pfx = pfx
            out.append("#EXTINF:%.6f," % durs.get(f, NOMINAL))
            out.append(f)
        return out

    def put_live_index():
        """Small SLIDING window for live viewing.

        The full index is re-uploaded whole every time it changes, and it grows with
        every segment - so its cost is quadratic in the recording's length. Measured:
        2% of video volume over 21 minutes, but ~450 MB against 830 MB over 8 hours.
        The manager also DOWNLOADS the whole thing per viewer to slice a window from
        it. Publishing a fixed-size window separately makes both costs constant.
        """
        win = uploaded[-LIVE_WINDOW:]
        if not win:
            return False
        seq = max(0, len(uploaded) - len(win))
        body = _entries(win)          # scans durations first, so _header sees them
        out = _header(seq, win) + body
        tmp = os.path.join(outdir, "_up_live.m3u8")
        try:
            with open(tmp, "w") as fh:
                fh.write("\n".join(out) + "\n")
        except OSError:
            return False
        ok = _rec_url_put(base, creds, rid, src, tmp, "live.m3u8")
        if ok:
            last_live[0] = time.time()
            if not _REC_LIVE_PUB[0]:
                # The manager can serve live from this recording from now on.
                _REC_LIVE_PUB[0] = last_live[0]
        return ok

    def put_index(final=False):
        # hls_time is 3 (segments ~3.33s); a fixed EXTINF is close enough for VOD/live
        # playback and avoids re-parsing ffmpeg's ever-growing index each second.
        # Every ffmpeg run writes "<random>-segNNNNN.ts", so a change of prefix means
        # the recording was RESUMED after an interruption; _entries inserts the
        # discontinuity players need there or the timeline seam stalls playback.
        if final:
            _scan_durs()              # ffmpeg has exited: pick up the last EXTINFs
        body = _entries(uploaded)     # scans durations first, so _header sees them
        out = _header(0, uploaded) + body
        if final:
            out.append("#EXT-X-ENDLIST")
        tmp = os.path.join(outdir, "_up_index.m3u8")
        try:
            with open(tmp, "w") as fh:
                fh.write("\n".join(out) + "\n")
        except OSError:
            return False
        ok = _rec_url_put(base, creds, rid, src, tmp, "index.m3u8")
        if ok:
            last_idx[0] = time.time()
        return ok

    def flush(final=False):
        try:
            # Sort by mtime, NOT by name: after a resume the new ffmpeg run uses a
            # different random prefix, so alphabetical order would interleave the two
            # runs and scramble the recording. Modification time is always chronological.
            def _when(n):
                try: return os.stat(os.path.join(outdir, n)).st_mtime
                except OSError: return 0.0
            files = sorted((x for x in os.listdir(outdir) if x.endswith(".ts")),
                           key=lambda n: (_when(n), n))
        except Exception:
            files = []
        # Skip the highest-numbered segment while recording — ffmpeg may still be
        # writing it; uploading (then deleting) a partial file would corrupt it. On the
        # final flush ffmpeg has exited, so every segment is complete.
        newest = None if final else (files[-1] if files else None)
        pending = [f for f in files if f not in uploaded_set and f != newest]
        while len(pending) > _rec_backlog_cap():    # uplink hopelessly behind -> bound /tmp
            drop = pending.pop(0)
            try: os.remove(os.path.join(outdir, drop))
            except OSError: pass
        dirty = False
        for f in pending:
            if _rec_url_put(base, creds, rid, src, os.path.join(outdir, f), f):
                uploaded.append(f); uploaded_set.add(f); dirty = True
                # Durable in S3 now -> free it locally so /tmp doesn't fill.
                try: os.remove(os.path.join(outdir, f))
                except OSError: pass
                # Re-publish the manifest at most ~every 10s WHILE draining a backlog.
                # Draining the whole backlog before publishing (as a single post-loop
                # publish would) STARVES the manifest on a slow uplink — the manager
                # reads the index and sees the recording frozen even though segments
                # keep landing. Interleaving keeps it within ~10s of S3, cheaply.
                now_ = time.time()
                # The rolling window is what live actually reads, and it is a fixed
                # ~1 KB - so publish it briskly.
                if now_ - last_live[0] >= LIVE_EVERY:
                    put_live_index()
                # The full index only matters for VOD playback and for recovering an
                # interrupted recording, so it can lag: at worst a crash loses the
                # last minute of the INDEX (never the segments, which are already in
                # S3 and get re-indexed by the final publish or the drain).
                if now_ - last_idx[0] >= FULL_EVERY:
                    if put_index():
                        dirty = False
            else:
                break   # transient uplink error: retry this file next pass, keep order
        if final:
            put_index(final=True)          # seal: the complete, ENDLIST'd manifest
        elif dirty:
            # Publish on the SAME two cadences as the drain loop above. Calling
            # put_index() here unconditionally (as this did) re-uploaded the whole
            # growing manifest once per segment - ~3.3s - which is the quadratic cost
            # the rolling window exists to avoid, and it made FULL_EVERY apply only
            # while a backlog was draining. Live reads live.m3u8; the full index is
            # for VOD + crash recovery, so it can lag.
            now_ = time.time()
            if now_ - last_live[0] >= LIVE_EVERY:
                put_live_index()
            if now_ - last_idx[0] >= FULL_EVERY:
                put_index()
        # Publish the backlog depth for _rec_owns_screen. Uploaded segments are deleted
        # locally, so whatever .ts is still on disk and not confirmed in S3 IS the lag.
        _REC_UP_BEHIND[0] = len([x for x in files if x not in uploaded_set and x != newest])
        # Heartbeat so a lagging uplink is diagnosable from the journal (once/30s).
        if time.time() - last_log[0] >= 30:
            last_log[0] = time.time()
            behind = len([x for x in (pending if not final else []) if x not in uploaded_set])
            print("agent: rec upload %s -> %d segs in S3, ~%d queued locally" % (rid, len(uploaded), behind), file=sys.stderr)

    while not stop_evt.is_set():
        try:
            flush()
        except Exception as e:
            # The uploader must survive ANY transient error (network, disk, parse) —
            # dying would silently freeze the recording in S3 while ffmpeg keeps going.
            print("agent: rec uploader error (continuing): %s" % e, file=sys.stderr)
        stop_evt.wait(1.0)
    try:
        flush(final=True)   # final pass: sealed (ENDLIST) manifest + last segments
    except Exception as e:
        print("agent: rec uploader final-flush error: %s" % e, file=sys.stderr)


def _finalize_hls_session(base: str, creds: dict, sess: dict):
    """Stop an HLS recording cleanly (ffmpeg writes ENDLIST), let the uploader flush
    the final segments + manifest, then seal the row via rec-done and drop the local
    temp dir (the media already lives in S3)."""
    try:
        sess["stop"].set()               # stop the overlay/marker loop
    except Exception:
        pass
    _write_overlay("")
    p = sess["proc"]
    try:
        if p.poll() is None:
            p.communicate(input=b"q", timeout=12)   # graceful -> ffmpeg finalizes ENDLIST
    except Exception:
        # A stalled ffmpeg ignores "q"; force it down and reap it so it can't zombie.
        for fn in (p.terminate, p.kill):
            try: fn()
            except Exception: pass
        try: p.wait(timeout=5)
        except Exception: pass
    # Let the uploader push the ENDLIST'd manifest + trailing segments, then reap it.
    try:
        sess["up_stop"].set()
    except Exception:
        pass
    try:
        if sess.get("cam_stop") is not None:
            sess["cam_stop"].set()
    except Exception:
        pass
    for _k in ("up_thread", "cam_thread"):
        _t = sess.get(_k)
        if _t is not None:
            _t.join(timeout=45)   # each flushes its own ENDLIST'd manifest
    dur = max(0, int(time.time() - sess["started"]))
    _curl_json("%s/api/agent/rec-done" % base,
               dict(creds, recording_id=sess["rid"], duration_sec=dur,
                    markers=sess.get("markers", []), ok=True))
    if sess.get("errfh") is not None:
        try: sess["errfh"].close()
        except Exception: pass
    shutil.rmtree(sess.get("outdir", "") or "/nonexistent", ignore_errors=True)
    print("agent: sealed HLS recording %s (%ds, %d markers)" % (sess["rid"], dur, len(sess.get("markers", []))), file=sys.stderr)


def _recover_one(base: str, creds: dict, ts_path, mp4_path) -> bool:
    """Upload one orphaned recording (leftover from a crash, shutdown, or a failed
    upload). Prefers an already-remuxed .mp4; otherwise remuxes the .ts. Markers +
    duration come from the sidecar, falling back to ffprobe. Deletes the files +
    sidecar only on a confirmed upload; on failure they stay for the next attempt."""
    if mp4_path and os.path.exists(mp4_path) and os.path.getsize(mp4_path) > 0:
        upload_path = mp4_path
    elif ts_path and os.path.exists(ts_path) and os.path.getsize(ts_path) > 0:
        upload_path = _faststart_remux(ts_path)   # -> .mp4 (or the .ts if remux fails)
    else:
        return False
    meta = _read_sidecar(ts_path or mp4_path)
    markers = meta.get("markers") if isinstance(meta.get("markers"), list) else []
    dur = meta.get("duration")
    if not isinstance(dur, int) or dur <= 0:
        dur = _probe_duration(upload_path)
    paths = {p for p in (ts_path, mp4_path, upload_path) if p}
    for p in paths: _mark_inflight(p)
    try:
        ok = _upload_recording(base, creds, upload_path, dur, markers)
    finally:
        for p in paths: _clear_inflight(p)
    if ok:
        for p in paths | {_sidecar_path(ts_path or mp4_path)}:
            try: os.remove(p)
            except Exception: pass
        print("agent: recovered orphaned recording %s" % os.path.basename(upload_path), file=sys.stderr)
    return ok


def _drain_worker(base: str, creds: dict):
    """Re-upload every finished-but-unsent recording in REC_DIR. Skips the file the
    live session is writing, anything an uploader already holds, and freshly-written
    files (<45 s, still being handed off). Also sweeps sidecars whose media is gone."""
    global _DRAIN_RUNNING
    try:
        try:
            names = os.listdir(REC_DIR)
        except OSError:
            return
        with _REC_LOCK:
            # HLS sessions (Phase 2) upload to /tmp/tcrec-* and carry no "path" key;
            # only legacy .ts sessions have one. .get() keeps the drain from crashing
            # (KeyError: 'path') every cycle while an HLS recording is active — which
            # otherwise disabled Phase-1 orphan recovery and spammed the journal.
            active = (_REC_SESSION.get("path") if _REC_SESSION else None)
        now = time.time()
        stems: dict = {}   # stem -> {"ts","mp4","mtime","nonempty"}
        media_stems = set()
        for n in names:
            if not n.startswith("session-"):
                continue
            p = os.path.join(REC_DIR, n)
            if not (n.endswith(".ts") or n.endswith(".mp4")):
                continue
            media_stems.add(os.path.splitext(p)[0])
            if p == active or _is_inflight(p):
                continue
            try:
                st = os.stat(p)
            except OSError:
                continue
            if now - st.st_mtime < 45:   # still being written / just handed to a finalizer
                continue
            stem = os.path.splitext(p)[0]
            e = stems.setdefault(stem, {"ts": None, "mp4": None, "mtime": 0.0, "nonempty": False})
            e["ts" if n.endswith(".ts") else "mp4"] = p
            e["mtime"] = max(e["mtime"], st.st_mtime)
            if st.st_size > 0:
                e["nonempty"] = True
        # Sweep orphan sidecars (media already uploaded/pruned away).
        for n in names:
            if n.startswith("session-") and n.endswith(".meta.json"):
                if os.path.join(REC_DIR, os.path.splitext(os.path.splitext(n)[0])[0]) not in media_stems:
                    try: os.remove(os.path.join(REC_DIR, n))
                    except OSError: pass
        # Oldest first, so history uploads in order.
        for stem in sorted(stems, key=lambda s: stems[s]["mtime"]):
            e = stems[stem]
            if not e["nonempty"]:   # empty leftovers -> just clean up
                for f in (e["ts"], e["mp4"], stem + ".meta.json"):
                    if f:
                        try: os.remove(f)
                        except OSError: pass
                continue
            if not _recover_one(base, creds, e["ts"], e["mp4"]):
                break   # still offline / storage down — stop; retry on the next drain
    except Exception as e:
        # The drain must never take down its thread with a traceback — one bad cycle
        # would otherwise repeat forever and disable orphan recovery. Log one line.
        print("agent: drain error: %s" % e, file=sys.stderr)
    finally:
        _DRAIN_RUNNING = False


def _drain_pending_recordings(base: str, creds: dict):
    """Kick a background drain (retry queue + boot recovery). Throttled, non-overlapping,
    and off the poll thread so a big re-upload never stalls the heartbeat. The first
    call after boot runs immediately (_LAST_DRAIN starts at 0)."""
    global _LAST_DRAIN, _DRAIN_RUNNING
    now = time.time()
    if _DRAIN_RUNNING or (now - _LAST_DRAIN) < 120:
        return
    _LAST_DRAIN = now
    _DRAIN_RUNNING = True
    threading.Thread(target=_drain_worker, args=(base, dict(creds)), daemon=True).start()


# ------------------------ live streaming (HLS -> tenant S3) ------------------
# ffmpeg emits a rolling HLS playlist + segments locally; a background thread
# syncs them to the tenant's bucket via presigned PUTs. The dashboard plays the
# manager-rewritten playlist. Media never passes through the control plane.
_LIVE = {}   # src -> {"proc", "thread", "dir", "stop"}
_LIVE_LOCK = threading.Lock()

# Device internet-speed measurement. The live-segment upload rate is a BAD proxy
# for link capacity — the stream is bitrate-capped and each segment is a tiny
# HTTPS PUT dominated by TLS/handshake overhead, so a 30 Mbps link read as
# ~1 Mbps. Instead run a REAL periodic download speed test (curl's own
# speed_download over a fixed payload from a fast endpoint) and report THAT as the
# device's internet speed. Runs at idle CPU/IO priority, INFREQUENTLY (~30 min) and
# never during a live RDP call, so its 2 MB burst can't compete with the session on a
# shared uplink. The operator still sees a periodically-refreshed figure; live link
# quality comes from the cheap latency probe. Tunable: SPEEDTEST_URL/BYTES/INTERVAL.
_SPEED_KBPS = 0
_NET_UP_KBPS = -1      # latest measured UPLOAD speed (kbps), -1 = not measured yet
_SPEED_LOCK = threading.Lock()
_NET_LAT_MS = -1        # latest TCP latency to the RDP server (ms), -1 = unknown
_NET_LOSS_PCT = -1      # latest TCP loss to the RDP server (%), -1 = unknown
_NET_TESTED_MS = 0      # wall-clock (ms) of the last completed bandwidth test, 0 = never
_SPEEDTEST_BUSY = threading.Lock()   # ensures only ONE 2MB test runs at a time


def _speedtest_once() -> int:
    url = conf_get("SPEEDTEST_URL", "https://speed.cloudflare.com/__down")
    nbytes = conf_get("SPEEDTEST_BYTES", "6000000")             # per-connection payload (~6 MB)
    conns = max(1, min(8, int(conf_get("SPEEDTEST_CONNS", "4") or 4)))   # parallel streams
    full = "%s%sbytes=%s" % (url, "&" if "?" in url else "?", nbytes)
    try:
        # Measure like fast.com/speedtest — MANY parallel streams (one TCP flow can't
        # saturate a link) — but aggregate CORRECTLY: total bytes downloaded across all
        # connections / the WALL-CLOCK of the test. (Summing curl's per-connection
        # speed_download OVER-reports: each is averaged over that connection's own
        # short, non-overlapping lifetime, so the sum can exceed the real link — that's
        # why a 100 Mbps line read ~184. total_bytes/wall_clock can NEVER exceed the
        # true capacity.) Idle IO priority keeps it polite.
        t0 = time.time()
        procs = []
        for _ in range(conns):
            procs.append(subprocess.Popen(
                _nice() + ["curl", "-fsS", "--max-time", "25", "-o", "/dev/null",
                           "-w", "%{size_download}", full],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True))
        total_bytes = 0.0
        for p in procs:
            try:
                out, _ = p.communicate(timeout=30)
                if p.returncode == 0 and out and out.strip():
                    total_bytes += float(out.strip())
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass
        elapsed = time.time() - t0
        if total_bytes > 0 and elapsed > 0:
            return int(total_bytes * 8 / 1000 / elapsed)   # total bits / wall-clock -> kbps
    except Exception:
        pass
    return 0


def _uploadtest_once() -> int:
    """Measure UPLOAD throughput — the metric that actually gates live streaming +
    recording. A machine with fast DOWNLOAD but a poor UPLINK cannot push its video
    segments (they're deleted locally before the slow upload finishes -> the live
    view spins). POSTs a few MB to the manager and reads curl's measured upload rate
    (reported even on a timeout, so a stalled/near-zero uplink shows a low number)."""
    url = conf_get("CONTROL_URL")
    if not url:
        return -1
    base = url.rstrip("/")
    mb = max(1, min(10, int(conf_get("UPTEST_MB", "4") or 4)))
    tmp = None
    try:
        fd, tmp = tempfile.mkstemp(prefix="tcup-")
        os.write(fd, b"\0" * (mb * 1024 * 1024)); os.close(fd)
        r = subprocess.run(
            _nice() + ["curl", "-fsS", "--max-time", "25", "-o", "/dev/null",
                       "-w", "%{speed_upload}", "-X", "POST",
                       "-H", "content-type: application/octet-stream",
                       "-H", "x-tc-enroll: %s" % conf_get("ENROLL_CODE"),
                       "-H", "x-tc-secret: %s" % conf_get("DEVICE_SECRET"),
                       "-H", "x-tc-hwid: %s" % device_id(),
                       "--data-binary", "@%s" % tmp, "%s/api/agent/uptest" % base],
            capture_output=True, text=True, timeout=35)
        bps = float((r.stdout or "0").strip() or 0)   # speed_upload = bytes/sec
        return int(bps * 8 / 1000)                     # -> kbps
    except Exception:
        return -1
    finally:
        if tmp:
            try: os.remove(tmp)
            except OSError: pass


def _rdp_server_ip():
    """The RDP server the device is talking to — for the live latency/loss probe.
    Prefer the actual running FreeRDP target, then the managed RDP host. '' if none."""
    try:
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                parts = open("/proc/%s/cmdline" % pid, "rb").read().split(b"\0")
            except OSError:
                continue
            if not any(b"xfreerdp" in p for p in parts):
                continue
            for p in parts:
                s = p.decode("utf-8", "replace")
                if s.startswith("/v:"):
                    h = s[3:].split(":")[0].strip()
                    if h:
                        return h
    except OSError:
        pass
    try:
        for line in open(MANAGED_RDP):
            if line.startswith("HOST="):
                h = line.split("=", 1)[1].strip()
                if h:
                    return h
    except OSError:
        pass
    return ""


def _tcp_probe(host, port=3389, n=4):
    """Latency + loss to the RDP server via TCP connects — ICMP is firewalled on
    these Windows servers, so ping is useless. Returns (avg_ms, loss_pct), or
    (-1, -1) if the host is unknown. This is what turns red during a packet-loss
    freeze (connects go slow / fail)."""
    if not host:
        return (-1, -1)
    import socket
    ok = 0
    tot = 0.0
    for _ in range(max(1, n)):
        t0 = time.time()
        try:
            s = socket.create_connection((host, port), timeout=2)
            s.close()
            ok += 1
            tot += time.time() - t0
        except Exception:
            pass
        time.sleep(0.12)
    if ok == 0:
        # Couldn't reach the server on ANY try. During a LIVE session this is a real
        # outage -> report 100% loss (indicator turns red, explains a freeze). But
        # when NOT in a session (idle at the connect screen, server off, or RDP host
        # not configured) it just means "couldn't measure" — reporting 100% loss here
        # wrongly turned a device with perfectly good internet RED. Report unknown.
        return (-1, 100) if _rdp_connected() else (-1, -1)
    return (int(tot / ok * 1000), int((n - ok) * 100 / n))


def _write_net_state(kbps, lat_ms, loss_pct):
    """Publish the current link stats where the operator-facing UI can read them —
    the connect status bar and the floating net badge both read this file. Simple
    key=val, world-readable (the UI runs as the session user, the agent as root)."""
    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        mbps = int(round(kbps / 1000.0)) if kbps and kbps > 0 else 0
        path = os.path.join(RUN_DIR, "net-speed")
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write("MBPS=%d\nLATENCY_MS=%d\nLOSS_PCT=%d\nTS=%d\n"
                    % (mbps, lat_ms, loss_pct, int(time.time())))
        os.replace(tmp, path)
        os.chmod(path, 0o644)
    except Exception:
        pass


def _speed_loop():
    # Publishes the device's internet speed + live latency/loss so BOTH the manager
    # (net_kbps in the poll) AND the operator's own screen (connect status bar + the
    # floating net badge, via /run/thinclient/net-speed) can show it. The bandwidth
    # test runs on a slow, data-cheap cadence; the TCP latency probe runs every cycle
    # (tiny) and is what turns the indicator red the instant the link starts dropping.
    global _NET_LAT_MS, _NET_LOSS_PCT
    interval = int(conf_get("SPEEDTEST_INTERVAL", "1800") or 1800)  # 2MB bandwidth test — every 30 min
    probe = int(conf_get("NET_PROBE_INTERVAL", "15") or 15)         # cheap latency probe — every cycle
    last_speed = 0.0
    while True:
        now = time.time()
        # The 2 MB download is the ONLY heavy transfer here and it's shared-uplink
        # traffic. So: run it RARELY (every ~30 min — bandwidth doesn't change minute
        # to minute) and PREFER idle gaps — skip it while a live RDP call is up so a
        # burst can't compete with the session on a congested link. But force a reading
        # if we've had none for 2x the interval, so an always-in-call operator still
        # sees a figure. (An admin can also trigger an immediate test any time via the
        # SPEEDTEST command — that runs even mid-call.) The cheap latency/loss probe
        # runs every cycle (a few packets) — the real-time signal that flags a drop.
        elapsed = now - last_speed
        due = elapsed >= (interval if _SPEED_KBPS > 0 else 60)   # retry fast only until the FIRST reading
        forced = last_speed == 0.0 or elapsed >= interval * 2
        if due and (not _rdp_connected() or forced):
            _do_speedtest()          # updates speed + latency + loss + tested_ms + state file
            last_speed = now
        else:
            lat, loss = _tcp_probe(_rdp_server_ip())
            with _SPEED_LOCK:
                _NET_LAT_MS = lat
                _NET_LOSS_PCT = loss
            _write_net_state(_SPEED_KBPS, lat, loss)
        time.sleep(max(5, probe))


def _do_speedtest():
    """Run ONE bandwidth test + latency probe and publish the results. Guarded so the
    periodic loop and an on-demand admin trigger can never run two 2 MB downloads at
    once. Used by _speed_loop AND the SPEEDTEST command (which fires it mid-call)."""
    global _SPEED_KBPS, _NET_UP_KBPS, _NET_LAT_MS, _NET_LOSS_PCT, _NET_TESTED_MS
    if not _SPEEDTEST_BUSY.acquire(blocking=False):
        return                       # a test is already in flight
    try:
        k = _speedtest_once()
        up = _uploadtest_once()      # UPLOAD — the metric that gates live streaming
        lat, loss = _tcp_probe(_rdp_server_ip())
        with _SPEED_LOCK:
            if k > 0:
                _SPEED_KBPS = k
            if up >= 0:
                _NET_UP_KBPS = up
            _NET_LAT_MS = lat
            _NET_LOSS_PCT = loss
            _NET_TESTED_MS = int(time.time() * 1000)
            kb = _SPEED_KBPS
        _write_net_state(kb, lat, loss)
    finally:
        _SPEEDTEST_BUSY.release()


def _net_kbps() -> int:
    with _SPEED_LOCK:
        return _SPEED_KBPS


# Phone-USB-tethering interfaces enumerate as an ethernet device — tell them apart
# from a real wired NIC by driver: ipheth=iPhone, rndis/cdc_*=Android/USB tether,
# qmi_wwan/cdc_mbim=LTE modem.
_TETHER_DRIVERS = ("ipheth", "rndis_host", "cdc_ncm", "cdc_ether", "cdc_mbim",
                   "cdc_eem", "huawei_cdc_ncm", "qmi_wwan")


def _net_type() -> str:
    """How the device actually reaches the internet, for the manager's connection
    icon: 'lan' (wired), 'wifi', 'cellular' (phone USB-tether or LTE modem), or
    'unknown'. Classifies the interface that carries the DEFAULT ROUTE (the one
    really in use), so a device with both eth+wifi is reported by what it's using."""
    dev = None
    try:
        r = subprocess.run(["ip", "route", "show", "default"],
                           capture_output=True, text=True, timeout=3).stdout
        for line in r.splitlines():
            toks = line.split()
            if "dev" in toks:
                dev = toks[toks.index("dev") + 1]
                break
    except Exception:
        pass
    if not dev or dev == "lo":
        return "unknown"
    # Wi-Fi: has a wireless/phy80211 sysfs node.
    if (os.path.exists("/sys/class/net/%s/wireless" % dev)
            or os.path.exists("/sys/class/net/%s/phy80211" % dev)):
        return "wifi"
    # Mobile: a cellular modem device (wwan) or a phone-tethering driver.
    if os.path.exists("/sys/class/net/%s/device/../wwan" % dev):
        return "cellular"
    drv = ""
    try:
        drv = os.path.basename(os.path.realpath("/sys/class/net/%s/device/driver" % dev))
    except Exception:
        pass
    if drv in _TETHER_DRIVERS:
        return "cellular"
    return "lan"


# How long after the recorder's rolling window first reaches S3 before live hands
# its own capture over. It only has to cover the manager's 4s active-recording cache
# plus a little slack, because by then the feed live will switch to demonstrably
# EXISTS - which is why this is measured from the first successful publish rather
# than from ffmpeg starting. A fixed 45s from start was both too long on a healthy
# device and, worse, unsafe on a device that cannot upload at all: it handed the
# screen over on a timer even though nothing had ever reached storage.
_REC_HANDOFF_S = 12


def _rec_owns_screen():
    """True when the recorder's capture IS the live screen feed, so the live
    subsystem must NOT start a second x11grab of the same display.

    The manager serves the live SCREEN pane straight from an active HLS recording's
    own segments (one stream feeds live + record). A live screen grab alongside that
    is pure waste: two x11grabs and two encodes of the same display, and nothing ever
    plays the second one. It also starves the capture - that contention is why some
    devices recorded ~1 of 6 requested frames.

    This keyed on a "hls_screen" flag that the tee'd-capture design used to set;
    Phase 2 (recording as a retained HLS stream) stopped setting it, so the guard
    read False forever and the duplicate grab came back unnoticed. It now keys on
    the session that actually exists.

    The handoff is deliberately late: for the first _REC_HANDOFF_S seconds live keeps
    its own capture, because the manager may not have picked the recording up yet.
    If the recorder dies, this flips back to False and live restarts its own grab on
    the next poll (2s while streaming), so the pane self-heals either way.
    """
    s = _REC_SESSION
    try:
        if not (s and s.get("hls") and s.get("screen_src", True)) or s["proc"].poll() is not None:
            _REC_LIVE_HANDOFF[0] = False
            return False
        if not _REC_LIVE_PUB[0]:
            # Nothing published for THIS session yet, so we cannot be handed off -
            # and the sticky flag must not survive from the previous session, or a
            # recorder restart would leave live not capturing while the new session
            # is still getting its first window into S3.
            _REC_LIVE_HANDOFF[0] = False
            return False
        behind = _REC_UP_BEHIND[0]
        if _REC_LIVE_HANDOFF[0]:
            # Already handed over: only take the screen back if the uploader falls a
            # whole live window behind, i.e. the "live" view would be showing video
            # from more than a minute ago.
            if behind > _LAG_HANDBACK:
                print("agent: uploader %d segs behind -> live takes its own screen capture back"
                      % behind, file=sys.stderr)
                _REC_LIVE_HANDOFF[0] = False
        elif (_REC_LIVE_PUB[0]
                and time.time() - _REC_LIVE_PUB[0] >= _REC_HANDOFF_S
                and behind <= _LAG_HANDOFF_MAX):
            _REC_LIVE_HANDOFF[0] = True
        return _REC_LIVE_HANDOFF[0]
    except Exception:
        return False


def _rec_owns_camera():
    """True when the recorder currently holds the webcam for its picture-in-picture
    overlay - so the live subsystem must NOT open it as a second source.

    /dev/video0 is a SINGLE-OWNER v4l2 device. The screen already had this guard
    (_rec_owns_screen), but the camera never did: the recorder would take the camera
    for its PiP and live would then fail to open it, leaving a dead camera pane while
    the camera was in fact visible inside the screen pane. That contention is also
    what produced the camera "Device or resource busy" crash-loop.

    Keeping the recorder as the sole owner is the cheaper arrangement too: the camera
    rides in the SAME segments as the screen, so it costs no extra PUT requests -
    a separate camera stream would double them, and requests already cost about twice
    what the storage does at fleet scale.
    """
    s = _REC_SESSION
    try:
        return bool(s and s.get("camera") and s["proc"].poll() is None)
    except Exception:
        return False


def _live_sources(cfg=None, skip_screen=False, skip_camera=False):
    # Which live panes to capture. Honor the admin's per-device source toggles
    # (cfg = the server's record config): stream the screen only if Screen
    # monitoring is enabled, and the camera only if Camera is enabled AND a camera
    # is actually attached. cfg=None (no config) keeps the legacy "both" behavior.
    # skip_screen=True when the recorder already serves the screen (merged capture),
    # skip_camera=True when the recorder holds the webcam for its PiP overlay.
    want_screen = (not skip_screen) and (True if cfg is None else bool(cfg.get("screen", True)))
    want_camera = ((not skip_camera)
                   and (True if cfg is None else bool(cfg.get("camera", True))))
    srcs = []
    if want_screen:
        srcs.append("screen")
    if want_camera and os.path.exists(_camera_device()):
        srcs.append("camera")
    return srcs


def _hls_cmd(src: str, disp: str, outdir: str):
    # Unique per-session segment prefix so filenames NEVER repeat across streams.
    # ffmpeg otherwise restarts numbering at seg00000 every session, so a leftover/
    # cached segment of the same name replays as "live" (old-video-loops bug). With
    # a fresh token each start, hls.js + any cache always sees a new URL.
    token = os.urandom(3).hex()
    seg = os.path.join(outdir, "%s-seg%%05d.ts" % token)   # e.g. a1b2c3-seg00000.ts
    pl = os.path.join(outdir, "live.m3u8")
    common = ["-g", "20", "-f", "hls", "-hls_time", "3", "-hls_list_size", "6",
              "-hls_flags", "delete_segments+append_list+omit_endlist",
              "-hls_segment_filename", seg, pl]
    vaapi = _venc_mode() == "vaapi"
    c = _nice() + ["ffmpeg", "-y", "-loglevel", "error"] + _venc_device()
    if src == "screen":
        # x264 path stays byte-identical (incl. -tune zerolatency, which h264_vaapi rejects).
        enc = _venc(common) if vaapi else _x264(["-tune", "zerolatency"] + common)
        vf = "scale=%s:-2%s" % (_cap_rt("CAPTURE_SCALE_W", "1280", "960"),
                                ",format=nv12,hwupload" if vaapi else "")
        return c + ["-f", "x11grab", "-framerate", _cap_rt("CAPTURE_FPS", "10", "6"), "-i", disp,
                    "-vf", vf] + enc
    # CAMERA: use the camera's budget, not the screen's. This stream was previously
    # encoded at CAPTURE_MAXRATE/CAPTURE_VAAPI_QP, so the live webcam ran at up to
    # 1500k for a 640x480 picture - more bits per pixel than the desktop beside it.
    enc = _venc_cam(common if vaapi else ["-tune", "zerolatency"] + common)
    # Capture stays pinned at whatever _cam_input negotiates (640x480 MJPEG is the
    # one mode virtually every USB webcam offers); we shrink at ENCODE time so a
    # camera can never fail to open because we asked it for a mode it lacks.
    vf = "scale=%s:-2%s" % (conf_get("CAMERA_SCALE_W", "480"),
                            ",format=nv12,hwupload" if vaapi else "")
    return c + _cam_input(_camera_device()) + ["-vf", vf] + enc


def _live_put(base: str, creds: dict, src: str, path: str, fname: str) -> bool:
    resp = _curl_json("%s/api/agent/live-url" % base, dict(creds, src=src, file=fname))
    if not resp or not resp.get("upload_url"):
        return False
    ctype = "application/vnd.apple.mpegurl" if fname.endswith(".m3u8") else "video/mp2t"
    rc = subprocess.run(["curl", "-fsS", "--max-time", "30", "-X", "PUT",
                         "-H", "content-type: %s" % ctype, "--upload-file", path, resp["upload_url"]],
                        capture_output=True, timeout=35).returncode
    return rc == 0


def _live_uploader(src: str, outdir: str, stop_evt, base: str, creds: dict):
    uploaded = set()
    pl_mtime = None
    while not stop_evt.is_set():
        try:
            files = os.listdir(outdir)
        except Exception:
            files = []
        ts = set(x for x in files if x.endswith(".ts"))
        for f in sorted(x for x in ts if x not in uploaded):
            if _live_put(base, creds, src, os.path.join(outdir, f), f):
                uploaded.add(f)
        uploaded &= ts     # forget segments ffmpeg deleted -> the set stays bounded
        # Only re-PUT the playlist when it actually rolled (mtime changed) instead of
        # every second — the .m3u8 only changes ~every hls_time (3s), so this cuts
        # ~2/3 of the playlist uploads (2 curl spawns + 2 HTTPS calls each).
        pl = os.path.join(outdir, "live.m3u8")
        try:
            m = os.stat(pl).st_mtime
        except OSError:
            m = None
        if m is not None and m != pl_mtime:
            if _live_put(base, creds, src, pl, "live.m3u8"):
                pl_mtime = m
        stop_evt.wait(1.0)


def _live_start(base: str, creds: dict, cfg=None, skip_screen=False, skip_camera=False):
    if os.path.exists("/run/live/medium") or os.path.exists("/lib/live/mount"):
        return
    env, disp = _rec_env()
    with _LIVE_LOCK:
        srcs = _live_sources(cfg, skip_screen=skip_screen, skip_camera=skip_camera)
        # Reap FIRST: drop any entry whose ffmpeg died (display lost, encoder
        # error) OR whose source vanished (camera unplugged -> no longer in srcs).
        # Iterating _LIVE keys (not just current srcs) is what stops a dead camera
        # entry + its uploader thread from spinning forever on a gone device.
        for src in list(_LIVE.keys()):
            ent = _LIVE[src]
            died = ent["proc"].poll() is not None
            if died or src not in srcs:
                # Runtime VA-API safety (same as recording): a hardware-encode live
                # source that died fast -> drop to libx264 so the restart below works.
                if (died and ent.get("venc") == "vaapi"
                        and time.time() - ent.get("started", 0) < 20):
                    _venc_downgrade()
                _LIVE.pop(src, None)
                try: ent["stop"].set()
                except Exception: pass
                shutil.rmtree(ent["dir"], ignore_errors=True)
                # Name the ACTUAL reason: "device gone" for every non-death read as a
                # vanished camera in the journal, which is misleading now that the
                # commonest case by far is the recorder taking the source over.
                if died:
                    why = "ffmpeg died"
                elif src == "screen" and skip_screen:
                    why = "recorder now serves it"
                elif src == "camera" and skip_camera:
                    why = "recorder holds the camera"
                else:
                    why = "source disabled or unplugged"
                print("agent: live %s reaped (%s)" % (src, why), file=sys.stderr)
        # Start any requested source that isn't already running.
        for src in srcs:
            if src in _LIVE:
                continue
            outdir = tempfile.mkdtemp(prefix="tclive-%s-" % src)
            try:
                p = subprocess.Popen(_hls_cmd(src, disp, outdir), env=env, stdin=subprocess.PIPE,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                print("agent: live %s failed to start: %s" % (src, e), file=sys.stderr)
                shutil.rmtree(outdir, ignore_errors=True)
                continue
            evt = threading.Event()
            th = threading.Thread(target=_live_uploader, args=(src, outdir, evt, base, dict(creds)), daemon=True)
            th.start()
            _LIVE[src] = {"proc": p, "thread": th, "dir": outdir, "stop": evt,
                          "started": time.time(), "venc": _venc_mode()}
            print("agent: live %s started (HLS -> storage)" % src, file=sys.stderr)


def _live_stop():
    import shutil
    with _LIVE_LOCK:
        items = list(_LIVE.items())
        _LIVE.clear()
    for src, info in items:
        try:
            info["stop"].set()
        except Exception:
            pass
        p = info["proc"]
        try:
            if p.poll() is None:
                p.communicate(input=b"q", timeout=6)
        except Exception:
            for fn in (p.terminate, p.kill):
                try: fn()
                except Exception: pass
        shutil.rmtree(info["dir"], ignore_errors=True)


# --------------------------- activity reporting ------------------------------
# Report session/lock/idle transitions so the manager can build the tenant-admin
# day-wise activity view. Edges come from the shared signal files (rdp-connected,
# locked) + xprintidle; delivered best-effort, queued while offline.
_ACT_STATE = {"rdp": None, "locked": None, "idle": None}

# Where the edge detector remembers what it last saw, ACROSS restarts.
#
# THE BUG THIS EXISTS TO FIX
# --------------------------
# The agent only reports CHANGES, and its memory of "what it was last time" used to die
# with the process. So every reboot, power cut, crash or OTA update that happened while
# RDP was up swallowed the RDP_DISCONNECT entirely: on the next start the previous value
# was None, the edge detector had nothing to compare against, and the manager was left
# with a session that never ended. Measured on the live fleet: 1387 connects against 777
# disconnects. Sessions dangled for days — one device still read as "connected" six days
# after it was switched off.
#
# Persisting the state closes that. On startup the agent compares what it last saw with
# what is true now, and reports the transition it slept through.
_ACT_FILE = "/var/lib/thinclient/activity.json"
_ACT_SAVED = 0.0
# How often the "still connected" mark is refreshed while a session is up. It is also
# the worst-case error in a recovered disconnect time, so it is short enough to be
# accurate and long enough not to write to flash every few seconds.
_ACT_HEARTBEAT_SEC = 60


def _save_activity_state(force: bool = False) -> None:
    """Record what we can see right now, and WHEN we could see it.

    The timestamp is the point of the exercise: if the machine dies mid-session, the
    last mark is the latest moment we know the session was alive, and that is the
    honest end time to report — not the moment the agent happens to come back."""
    global _ACT_SAVED
    now = time.time()
    if not force and now - _ACT_SAVED < _ACT_HEARTBEAT_SEC:
        return
    _ACT_SAVED = now
    try:
        os.makedirs(os.path.dirname(_ACT_FILE), exist_ok=True)
        tmp = _ACT_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({"state": _ACT_STATE, "at": now, "queue": _ACT_QUEUE[-200:]}, fh)
        os.replace(tmp, _ACT_FILE)          # atomic: a half-written file is never read
    except Exception:
        pass                                # never let bookkeeping break the poll


def _restore_activity_state() -> None:
    """Pick the edge detector back up where it left off, and report what it missed."""
    global _ACT_QUEUE
    try:
        with open(_ACT_FILE) as fh:
            saved = json.load(fh)
    except Exception:
        return
    prev = saved.get("state") or {}
    at = float(saved.get("at") or 0)
    # Events queued but never delivered (offline when the machine went down) survive too
    # — they were already real observations, and dropping them loses working time.
    for ev in saved.get("queue") or []:
        if isinstance(ev, dict) and ev.get("kind"):
            _ACT_QUEUE.append(ev)

    for key in ("rdp", "locked", "idle"):
        if isinstance(prev.get(key), bool):
            _ACT_STATE[key] = prev[key]

    # The transition we slept through. Only RDP is reconstructed: an unreported lock or
    # idle state is cosmetic, but an unreported disconnect corrupts somebody's hours.
    if prev.get("rdp") is True and at > 0 and not _rdp_connected():
        _ACT_QUEUE.append({"kind": "RDP_DISCONNECT", "at": at})
        _ACT_STATE["rdp"] = False
_ACT_QUEUE = []


def _is_idle() -> bool:
    disp = conf_get("CAPTURE_DISPLAY", ":0")
    try:
        out = subprocess.run(["xprintidle"],
                             env=dict(os.environ, DISPLAY=disp, XAUTHORITY=_working_xauth(disp)),
                             capture_output=True, text=True, timeout=5).stdout.strip()
        thr = int(conf_get("IDLE_THRESHOLD_SEC", "300") or 300) * 1000
        return int(out) >= thr
    except Exception:
        return False


_IDLE_LAST_CHECK = 0.0
_IDLE_LAST = False


def _detect_activity() -> list:
    global _IDLE_LAST_CHECK, _IDLE_LAST
    now = time.time()
    events = []

    changed = []

    def edge(key, cur, on_kind, off_kind):
        prev = _ACT_STATE[key]
        _ACT_STATE[key] = cur
        if prev != cur:
            changed.append(key)
        if prev is not None and cur != prev:
            events.append({"kind": on_kind if cur else off_kind, "at": now})

    edge("rdp", _rdp_connected(), "RDP_CONNECT", "RDP_DISCONNECT")   # cheap; keep per-poll
    edge("locked", _is_locked(), "LOCK", "UNLOCK")                   # file check; cheap
    # Idle uses a 300s threshold, so probe xprintidle at most every 30s rather than
    # spawning a process on every 2-5s poll, 24/7.
    if now - _IDLE_LAST_CHECK >= 30:
        _IDLE_LAST_CHECK = now
        _IDLE_LAST = _is_idle()
    edge("idle", _IDLE_LAST, "IDLE_START", "IDLE_END")
    # Written immediately on a change, and on a slow heartbeat the rest of the time, so
    # the file always says both what was true and how recently we knew it.
    _save_activity_state(force=bool(changed))
    return events


def _rdp_connected() -> bool:
    """The RDP-connected signal file is only authoritative if a FreeRDP process is
    actually alive — a leaked/stale file (session restarted while RDP was up) must
    not pin working-hours to 'connected' forever."""
    if not os.path.exists(SIG_RDP):
        return False
    for b in ("xfreerdp3", "xfreerdp"):
        try:
            if subprocess.run(["pgrep", "-x", b], capture_output=True, timeout=5).returncode == 0:
                return True
        except Exception:
            pass
    return False


def _report_activity(base: str, creds: dict):
    global _ACT_QUEUE
    _ACT_QUEUE.extend(_detect_activity())
    if not _ACT_QUEUE:
        return
    _ACT_QUEUE = _ACT_QUEUE[-500:]                 # cap the backlog if long offline
    resp = _curl_json("%s/api/agent/activity" % base, dict(creds, events=_ACT_QUEUE))
    if resp is not None:
        _ACT_QUEUE = []                            # delivered -> clear
        # Persist the now-empty queue at once: otherwise a crash between delivery and
        # the next heartbeat would replay events the server already has.
        _save_activity_state(force=True)


# --- RDP session freeze watchdog -----------------------------------------------
# A call inside the RDP session can hang the FreeRDP CLIENT (the remote desktop
# freezes) while the OS itself stays perfectly alive — kernel, systemd, agent all
# fine. So NONE of the OS-level safety nets help: the hardware watchdog never fires
# (the kernel isn't stuck), and the operator is stranded on a dead screen until
# they power-cycle. Both "Ani/Zoya screen stuck" reports are this: an orderly
# reboot in the logs (someone hit the power button), FreeRDP had to be SIGKILLed.
#
# We detect it the only way that's visible from OUTSIDE FreeRDP: the operator is
# actively interacting (idle time low — they're moving the mouse / clicking because
# the screen is stuck) yet the remote DESKTOP CONTENT has not changed at all for a
# sustained window. Confirmed live: when frozen, the mouse POINTER still moves (X is
# alive) while FreeRDP's picture is stuck — so we grab with the cursor EXCLUDED
# (draw_mouse=0) and compare only the content; a healthy session always repaints its
# content as you work, and a merely-idle desktop is skipped by the idle gate. On a
# hit we drop a marker + SIGKILL FreeRDP (a hung one ignores SIGTERM); thinclient-
# connect sees the marker and shows a reassuring "Session reset - Reconnect" screen.
_FREEZE_MARK = os.path.join(RUN_DIR, "rdp-froze")


def _idle_ms():
    """Milliseconds since the last real keyboard/mouse input, or None on failure."""
    disp = conf_get("CAPTURE_DISPLAY", ":0")
    try:
        out = subprocess.run(["xprintidle"],
                             env=dict(os.environ, DISPLAY=disp, XAUTHORITY=_working_xauth(disp)),
                             capture_output=True, text=True, timeout=5).stdout.strip()
        return int(out)
    except Exception:
        return None


def _screen_fingerprint():
    """A cheap digest of the whole screen, downscaled tiny, with the mouse cursor
    EXCLUDED (draw_mouse=0) — during a freeze the pointer keeps moving while the
    remote desktop is stuck, so counting the cursor would hide the freeze. We want
    to know only whether the CONTENT changed. None if it can't grab."""
    env, disp = _rec_env()
    try:
        p = subprocess.run(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-draw_mouse", "0",
             "-f", "x11grab", "-i", disp, "-frames:v", "1",
             "-vf", "scale=160:90", "-pix_fmt", "gray", "-f", "rawvideo", "-"],
            env=env, capture_output=True, timeout=8)
        if p.returncode == 0 and p.stdout:
            return hashlib.md5(p.stdout).digest()
    except Exception:
        pass
    return None


def _recover_frozen_session():
    """Drop the marker connect looks for, then kill the hung FreeRDP so the session
    is rebuilt cleanly — no power-cycle, no lost server-side work."""
    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        open(_FREEZE_MARK, "w").close()
    except OSError:
        pass
    print("agent: RDP session appears FROZEN (active input, content static) -> resetting FreeRDP",
          file=sys.stderr)
    # SIGKILL, not SIGTERM: a hung FreeRDP ignores SIGTERM (every freeze log showed
    # it taking the full 90s stop-timeout before systemd SIGKILLed it).
    for b in ("xfreerdp3", "xfreerdp"):
        try:
            subprocess.run(["pkill", "-KILL", "-x", b], capture_output=True, timeout=10)
        except Exception:
            pass


def _session_freeze_watchdog():
    # RE-ENABLED (default ON) 2026-08-19 now the root cause is known: the call freeze
    # is a FreeRDP MICROPHONE-AAC-encoder deadlock (NaN mic samples spin avcodec while
    # it holds the PulseAudio lock -> whole session hangs). We can't prevent the
    # FreeRDP bug from a script, so this RECOVERS it — screen frozen while the operator
    # is actively interacting -> SIGKILL FreeRDP + auto-reconnect (~15s) instead of a
    # dead screen needing a power-cycle. NOTE: the earlier "it false-fires every 2 min"
    # was a MISDIAGNOSIS (that was the forced-update cascade restarting sessions; this
    # watchdog logged ZERO fires). Disable per-device with RDP_FREEZE_WATCHDOG=0.
    if not shutil.which("ffmpeg") or not shutil.which("xprintidle"):
        return
    active_ms  = int(conf_get("RDP_FREEZE_ACTIVE_MS", "6000") or 6000)   # "operator is interacting"
    freeze_sec = int(conf_get("RDP_FREEZE_SEC", "5") or 5)               # static-while-active window
    poll       = int(conf_get("RDP_FREEZE_POLL", "2") or 2)              # how often we sample
    last_fp = None
    stuck_since = None
    while True:
        time.sleep(poll)
        try:
            # Gates are re-checked EVERY iteration, NOT once at thread start. The PCM
            # client is installed by a BACKGROUND thread that can finish AFTER this
            # watchdog starts, so a start-time-only check stayed armed for the whole
            # session and FALSE-FIRED on the freeze-immune PCM client -> reset a healthy
            # call (exactly what the operator reported as a "freeze"). Re-checking here
            # makes the watchdog go dormant the instant PCM is present, and lets
            # RDP_FREEZE_WATCHDOG=0 take hold within one poll with no agent restart.
            if conf_get("RDP_FREEZE_WATCHDOG", "1").lower() in ("0", "false", "no", "off"):
                return
            # On the PCM-only FreeRDP the mic-AAC freeze CANNOT happen, so this
            # content-static detector would ONLY ever false-fire. Stay dormant there.
            if conf_get("RDP_PCM", "1").lower() not in ("0", "false", "no", "off") and \
               os.access("/opt/freerdp-pcm/bin/xfreerdp", os.X_OK):
                return
            # Only meaningful inside a live RDP session, and never at the lock screen
            # (the password field is deliberately near-static between keystrokes).
            if not _rdp_connected() or _is_locked():
                last_fp = None; stuck_since = None; continue
            idle = _idle_ms()
            if idle is None or idle > active_ms:
                # If the operator isn't touching anything we can't tell frozen from
                # a fine-but-idle desktop — so we simply don't judge.
                last_fp = None; stuck_since = None; continue
            fp = _screen_fingerprint()
            if fp is None:
                last_fp = None; stuck_since = None; continue
            if fp != last_fp:
                last_fp = fp; stuck_since = None; continue   # screen is repainting -> healthy
            # Screen byte-identical WHILE the operator is actively interacting.
            if stuck_since is None:
                stuck_since = time.time()
            elif time.time() - stuck_since >= freeze_sec:
                _recover_frozen_session()
                last_fp = None; stuck_since = None
                time.sleep(30)                                # let the reconnect land before re-arming
        except Exception:
            last_fp = None; stuck_since = None


_TZ_CURRENT = None
_TZ_RE = None
# Deprecated IANA aliases -> canonical. Debian trixie moved these out of the
# default tzdata into tzdata-legacy, so a device without that package can't
# resolve the alias. Mapping to the canonical name (which IS in the default
# tzdata) means an OTA'd device shows the right time even without a reflash.
_TZ_ALIASES = {
    "Asia/Calcutta": "Asia/Kolkata", "Asia/Rangoon": "Asia/Yangon",
    "Asia/Katmandu": "Asia/Kathmandu", "Asia/Saigon": "Asia/Ho_Chi_Minh",
    "Asia/Ashkhabad": "Asia/Ashgabat", "Asia/Thimbu": "Asia/Thimphu",
    "Asia/Ujung_Pandang": "Asia/Makassar", "Asia/Dacca": "Asia/Dhaka",
    "Europe/Kiev": "Europe/Kyiv", "Europe/Uzhgorod": "Europe/Kyiv",
    "Europe/Zaporozhye": "Europe/Kyiv", "America/Buenos_Aires": "America/Argentina/Buenos_Aires",
    "Pacific/Ponape": "Pacific/Pohnpei", "Pacific/Truk": "Pacific/Chuuk",
}


def _apply_timezone(tz: str):
    """Apply the server-chosen IANA timezone to the whole machine (timedatectl ->
    /etc/localtime), so the lock-screen clock + system time show the right local
    time. Validated to a safe IANA shape; only re-applied when it changes."""
    global _TZ_CURRENT, _TZ_RE
    if not tz or tz == _TZ_CURRENT:
        return
    if _TZ_RE is None:
        import re
        _TZ_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$")
    if len(tz) > 64 or not _TZ_RE.match(tz):
        return
    # If the exact zone isn't present (e.g. a deprecated alias without
    # tzdata-legacy), fall back to the canonical name, which IS in default tzdata.
    if not os.path.exists(os.path.join("/usr/share/zoneinfo", tz)):
        canon = _TZ_ALIASES.get(tz)
        if canon and os.path.exists(os.path.join("/usr/share/zoneinfo", canon)):
            print("agent: timezone %r not installed; using canonical %r" % (tz, canon), file=sys.stderr)
            tz = canon
        else:
            print("agent: timezone %r not found in /usr/share/zoneinfo (install tzdata-legacy?)" % tz, file=sys.stderr)
            return
    try:
        r = subprocess.run(["timedatectl", "set-timezone", tz], capture_output=True, timeout=10)
        if r.returncode == 0:
            _TZ_CURRENT = tz
            os.environ["TZ"] = tz
            try: time.tzset()
            except Exception: pass
            print("agent: timezone set to %s" % tz, file=sys.stderr)
        else:
            print("agent: timedatectl set-timezone %s failed rc=%s: %s"
                  % (tz, r.returncode, (r.stderr or b"").decode("utf-8", "replace").strip()), file=sys.stderr)
    except Exception as e:
        print("agent: timezone set failed: %s" % e, file=sys.stderr)


# The server-managed RDP profile — including the Windows password — lives in RAM
# (/run is tmpfs), never on disk. It used to be /var/lib/thinclient/rdp-managed, "protected"
# by XOR with a key derived from /etc/machine-id on the SAME disk: anyone holding a pulled
# disk could read the password in minutes. The manager resends it on every poll, so after
# a reboot the device has it again within seconds of reaching the manager.
MANAGED_RDP = os.path.join(RUN_DIR, "rdp-managed")
LEGACY_MANAGED_RDP = "/var/lib/thinclient/rdp-managed"


def _purge_disk_credentials():
    """Delete the on-disk copy left by older versions. Run at every start, so a device
    that was rolled back and forward again cannot keep one either."""
    for f in (LEGACY_MANAGED_RDP, LEGACY_MANAGED_RDP + ".tmp"):
        try:
            os.remove(f)
            print("agent: removed on-disk RDP credentials (%s)" % f, file=sys.stderr)
        except FileNotFoundError:
            pass
        except OSError as e:
            print("agent: could not remove %s: %s" % (f, e), file=sys.stderr)

_RDP_OBF_KEY = None


def _rdp_obf_key():
    """Device-local obfuscation key — MUST match thinclient-connect's _obf_key so
    the connect form can de-obfuscate the password we write. Cached (machine-id is
    immutable) so we don't re-read + hash it every poll."""
    global _RDP_OBF_KEY
    if _RDP_OBF_KEY is None:
        try:
            with open("/etc/machine-id") as f:
                mid = f.read().strip()
        except OSError:
            mid = "thinclient"
        _RDP_OBF_KEY = hashlib.sha256(("tc-rdp:" + mid).encode()).digest()
    return _RDP_OBF_KEY

def _rdp_obfuscate(s):
    if not s:
        return ""
    k = _rdp_obf_key()
    b = s.encode("utf-8")
    return base64.b64encode(bytes(c ^ k[i % len(k)] for i, c in enumerate(b))).decode("ascii")

SERVER_CONF = "/etc/thinclient/server.conf"


def _set_server_conf_key(key: str, val: str) -> bool:
    """Set/replace KEY=val in server.conf (the connect form's config) without
    disturbing other keys. Returns True if the file changed."""
    try:
        lines, found = [], False
        try:
            with open(SERVER_CONF) as f:
                for line in f:
                    s = line.strip()
                    if s and not s.startswith("#") and s.split("=", 1)[0].strip() == key:
                        lines.append("%s=%s\n" % (key, val)); found = True
                    else:
                        lines.append(line)
        except OSError:
            pass
        if not found:
            if lines and not lines[-1].endswith("\n"):
                lines.append("\n")
            lines.append("%s=%s\n" % (key, val))
        content = "".join(lines)
        try:
            if open(SERVER_CONF).read() == content:
                return False
        except OSError:
            pass
        with open(SERVER_CONF, "w") as f:
            f.write(content)
        return True
    except OSError:
        return False


def _apply_update_url(url):
    """Point this device's update channel at whatever the manager tells it.

    UPDATE_URL used to be baked into the image and could only be changed by
    reinstalling. That turned a single firewall rule into a permanent problem: on
    21 Sep a device on a customer LAN that blocks github.com could not be updated by
    ANY remote means, while polling this manager perfectly happily the whole time.
    A device that can still reach its manager should never be unreachable for updates.

    Deliberately narrow: only an https URL on the host this device already talks to
    (its CONTROL_URL) is accepted. A device must not be talked into fetching its own
    firmware from somewhere else — the signature check is the real defence, but there
    is no reason to widen the target as well.
    """
    try:
        if not url or not isinstance(url, str) or not url.startswith("https://"):
            return
        control = (conf_get("CONTROL_URL", "") or "").rstrip("/")
        if not control:
            return
        # Same scheme+host as the control plane, nothing else.
        from urllib.parse import urlparse
        a, b = urlparse(url), urlparse(control)
        if (a.scheme, a.netloc) != (b.scheme, b.netloc):
            print("agent: refusing update_url on a different host than CONTROL_URL",
                  file=sys.stderr)
            return
        cur = (conf_get("UPDATE_URL", "") or "").rstrip("/")
        if cur == url.rstrip("/"):
            return
        if _set_server_conf_key("UPDATE_URL", url.rstrip("/")):
            print("agent: update channel moved to %s" % url.rstrip("/"), file=sys.stderr)
    except Exception as e:
        print("agent: update_url apply failed: %s" % e, file=sys.stderr)


def _apply_gfx_codec(code):
    """Server-managed RDP video codec (e.g. force 'off' = legacy bitmap on a box
    whose H.264/GFX pipeline hangs). Written to server.conf; the connect form reads
    GFX_CODEC on its next start, so it applies on the next session/reconnect without
    interrupting a live RDP session."""
    if code in ("auto", "avc444", "avc420", "off"):
        _set_server_conf_key("GFX_CODEC", code)


def _apply_managed_rdp(rdp):
    """Write (or remove) the server-managed RDP profile the connect form reads.
    `rdp` = {host,user,password} from the poll, or None/empty to clear. The file is
    in RAM (MANAGED_RDP, under /run) and gone at power-off; the obfuscation is kept
    only so the format the connect form reads is unchanged. The file is
    root:<session-group> 0640 so the kiosk user can read it but it is not
    world-readable. Removing the file drops the device back to its local
    profile (the 'remember what the operator typed' behaviour)."""
    try:
        if not rdp or not rdp.get("host"):
            if os.path.exists(MANAGED_RDP):
                os.remove(MANAGED_RDP)
            return
        content = ("# Server-managed RDP connection (agent-written). Password is\n"
                   "# obfuscated with a device-local key; never displayed on-screen.\n"
                   "HOST=%s\nUSER=%s\nPASSWORD_OBF=%s\n" % (
                       rdp.get("host", ""), rdp.get("user") or "",
                       _rdp_obfuscate(rdp.get("password") or "")))
        try:
            if open(MANAGED_RDP).read() == content:
                return   # unchanged — skip the rewrite + chown/passwd lookup every poll
        except OSError:
            pass
        os.makedirs(os.path.dirname(MANAGED_RDP), exist_ok=True)
        tmp = MANAGED_RDP + ".tmp"
        with open(tmp, "w") as f:
            f.write(content)
        os.chmod(tmp, 0o640)
        try:
            import pwd
            gid = pwd.getpwnam(conf_get("SESSION_USER", "thinclient")).pw_gid
            os.chown(tmp, 0, gid)          # root : the kiosk user's primary group
        except Exception:
            pass
        os.replace(tmp, MANAGED_RDP)
    except Exception as e:
        print("agent: managed rdp write failed: %s" % e, file=sys.stderr)


def cmd_poll() -> int:
    global _STREAM_ACTIVE
    ensure_enrolled()
    url = conf_get("CONTROL_URL")
    code = conf_get("ENROLL_CODE")
    secret = conf_get("DEVICE_SECRET")
    if not (url and code and secret):
        _STREAM_ACTIVE = False
        # Not enrolled. This used to idle silently, which is exactly how a machine
        # became invisible AND unreachable: nothing here to authenticate with, and no
        # inbound channel for anyone to fix it. Instead, ask to be ADOPTED — show a
        # pairing code and let an administrator claim this machine from the console.
        if url:
            try:
                if _adopt_cycle(url.rstrip("/")):
                    return 0   # just adopted; the next poll runs enrolled
            except Exception as e:
                print("agent: adoption check failed: %s" % e, file=sys.stderr)
        return 0
    base = url.rstrip("/")
    creds = {"enroll_code": code, "secret": secret, "hwid": device_id()}

    # Report the running OS version so the manager can show it + know if an update
    # is needed. (Only in the poll body; creds stays the auth triple for acks etc.)
    with _SPEED_LOCK:
        _lat_ms, _loss_pct, _tested_ms, _up_kbps = _NET_LAT_MS, _NET_LOSS_PCT, _NET_TESTED_MS, _NET_UP_KBPS
    global _ADMIN_LOCK_EXPIRED_IGNORE
    # Offline-safe auto-expiry: runs every tick regardless of connectivity, so a
    # device that is admin-locked then goes OFFLINE still releases the operator after
    # the window instead of stranding them until it can reach the manager again.
    if os.path.exists(ADMIN_LOCK) and _admin_lock_expired():
        set_admin_lock(False); _ADMIN_LOCK_EXPIRED_IGNORE = True
    # A wrong-password lockout holds even if this poll never reaches the manager.
    _hold_local_lockout()
    resp = _curl_json("%s/api/agent/poll" % base, dict(
        creds, version=_current_version(),
        camera=os.path.exists(_camera_device()),  # is a camera attached?
        updating=_update_in_flight(),                                     # an update of ours is mid-flight

        rec_camera=_rec_owns_camera(),                                   # camera is part of the recording
        # A SEPARATE retained camera stream exists (rec/<id>/camera/), so the manager
        # may offer a real Camera pane. Older firmware composited the camera into the
        # screen as a thumbnail and does NOT send this — without a distinct field the
        # dashboard would offer those devices a camera pane that 404s.
        cam_stream=_rec_owns_camera(),
        rdp_active=_rdp_active(),                                        # operator in a live RDP session?
        admin_locked=os.path.exists(ADMIN_LOCK),                         # device's actual lock state
        # The OPERATOR's own screen lock, reported separately — it is what puts the
        # "SCREEN LOCKED" banner on the live view and the recordings, and it is NOT
        # the admin lock. When a stale flag wedged this on (see _screen_locked), the
        # console had no way to see it: the device looked normal in every field it
        # reported while an admin stared at a lock banner over a working desktop.
        screen_locked=_screen_locked(),
        net_kbps=_net_kbps(),                                            # real download speed test
        **({"net_up_kbps": _up_kbps} if _up_kbps >= 0 else {}),          # measured UPLOAD speed (kbps)
        net_latency_ms=_lat_ms,                                          # live TCP latency to RDP server
        net_loss_pct=_loss_pct,                                          # live TCP loss to RDP server
        net_tested_ms=_tested_ms,                                        # when the last bandwidth test ran
        net_type=_net_type(),                                            # lan | wifi | cellular (connection icon)
        typing=_operator_typing(),                                       # "operator is typing" for the admin
        chat_open=_chat_active(),                                        # panel open -> server may expect fast polls
        **_disk_stats(),                                                 # disk fills = recording/updates/session all die
        **_update_last(),                                                # why the last update attempt ended how it did
        security=_security_report(),                                     # what this device's security IS
        cert_seen=_cert_seen(),                                          # RDP server certificates seen
        now_ms=int(time.time() * 1000)))                                 # device wall clock (live-view time source)
    if resp is None:
        _STREAM_ACTIVE = False
        return 0  # offline — try again next tick
    if not _FIRST_POLL_OK[0]:
        _FIRST_POLL_OK[0] = time.time()   # link is up; the settle window starts now
    _STREAM_ACTIVE = bool(resp.get("stream"))
    # "admin is typing" — published for the chat panel. An absent field means not
    # typing, so older servers simply clear it.
    _set_admin_typing(bool(resp.get("admin_typing")))
    # One-shot: an older image may have no colour emoji font. Done in a thread so a
    # slow apt can never delay the poll loop.
    if not _EMOJI_FONT_CHECKED:
        threading.Thread(target=_ensure_emoji_font, daemon=True).start()
    # Same one-shot treatment for the log ceilings: journalctl --vacuum can take a
    # while on a device that has been accumulating for months, and the poll loop must
    # never wait on it.
    global _HYGIENE_CHECKED
    if not _HYGIENE_CHECKED:
        _HYGIENE_CHECKED = True
        threading.Thread(target=_disk_hygiene, daemon=True).start()
    # Apply the manager's lock intent — but honor the auto-expiry: once a lock has
    # exceeded the window we release the operator and IGNORE a still-set flag until
    # the manager genuinely toggles it off (then future locks apply normally again).
    locked_flag = bool(resp.get("locked"))
    lock_kind = resp.get("lock_kind") or "admin"
    lock_msg = resp.get("lock_message") or ""
    # A wrong-password lockout outranks the manager's lock flag — this is the trap the
    # security plan warns about. The manager's "not locked" used to be copied on every
    # poll, so a lockout the DEVICE raised would have been undone within seconds, before
    # the manager had even heard of it. It is released only when the manager has
    # acknowledged THIS lockout (lockout_ack == its locked_at) and then says unlocked:
    # i.e. an administrator pressed Unlock after seeing it.
    if _reconcile_lockout(locked_flag, resp.get("lockout_ack")):
        pass                                   # still locked out — leave the lock alone
    elif not locked_flag:
        set_admin_lock(False); _ADMIN_LOCK_EXPIRED_IGNORE = False
    elif lock_kind == "schedule":
        # A WORKING-HOURS lock is re-derived by the manager on every poll and clears
        # itself the moment the window reopens, so the stale-lock protections above
        # don't apply to it — and MUST NOT, or an earlier expired admin lock would
        # silently suppress the group's schedule for the rest of the day.
        _ADMIN_LOCK_EXPIRED_IGNORE = False
        set_admin_lock(True, "permanent", 24, lock_msg)
        # Working hours have closed: end the session in progress, not just block the
        # next one. The operator has already had the 10-minute closing warning via the
        # floating badge, which is the one thing that IS drawn over the RDP window.
        _drop_rdp_session("working hours closed")
    elif _ADMIN_LOCK_EXPIRED_IGNORE:
        pass                                   # stale/forgotten lock — stay released
    elif os.path.exists(ADMIN_LOCK) and _admin_lock_expired():
        set_admin_lock(False); _ADMIN_LOCK_EXPIRED_IGNORE = True
    else:
        set_admin_lock(True, resp.get("lock_mode", "timed"), resp.get("lock_hours", 24) or 24)
        # Same for a lock the manager asserts on the poll rather than as a command —
        # it must not depend on the operator happening to disconnect.
        _drop_rdp_session("admin lock")
    # Closing-time warning: published for the floating badge, which is already on top
    # of the full-screen RDP session — the one place the operator is certain to see it.
    _set_access_warn(resp.get("access_warn_minutes"))
    # Live key rotation: the server hands us a new secret over this already-
    # authenticated channel — adopt it immediately, no re-provisioning/USB.
    new_secret = resp.get("rotate_secret")
    if new_secret:
        _set_conf_key("DEVICE_SECRET", new_secret)
        # Adopt it into the creds used for the REST of this poll (acks, activity,
        # live/recording upload URLs) + any threads spawned this tick — otherwise
        # they'd keep presenting the old secret until the next poll.
        secret = new_secret
        creds["secret"] = new_secret
        print("agent: adopted rotated device secret", file=sys.stderr)
    # Admin reset the screen-lock password: hand it to the locker, which hashes
    # + stores it for the kiosk user (server never keeps the plaintext).
    lock_hash = resp.get("set_lock_hash")
    if lock_hash:
        # The manager hashed it: the password itself was never stored or sent.
        try:
            subprocess.run(["/opt/thinclient/bin/thinclient-lock", "set-hash", lock_hash,
                            conf_get("SESSION_USER", "thinclient")], capture_output=True, timeout=15)
            print("agent: screen-lock password reset by admin (hash)", file=sys.stderr)
        except Exception as e:
            print("agent: lock password reset failed: %s" % e, file=sys.stderr)
    lock_pw = resp.get("set_lock_password")
    if lock_pw:
        try:
            subprocess.run(["/opt/thinclient/bin/thinclient-lock", "set-password", lock_pw,
                            conf_get("SESSION_USER", "thinclient")], capture_output=True, timeout=15)
            print("agent: screen-lock password reset by admin", file=sys.stderr)
        except Exception as e:
            print("agent: lock password reset failed: %s" % e, file=sys.stderr)
    # Instant update signal: check for the pushed release now, not in 6 hours.
    _maybe_trigger_update(resp.get("update_version", ""))
    # Timezone: apply the tenant/device-chosen zone (drives the lock-screen clock).
    _apply_timezone(resp.get("timezone", ""))
    # Managed RDP connection: mirror the server-set profile to disk (or clear it).
    _apply_managed_rdp(resp.get("rdp"))
    # Server-managed RDP video codec (e.g. pin a hang-prone box to legacy bitmap).
    _apply_gfx_codec(resp.get("gfx_codec"))
    _apply_update_url(resp.get("update_url"))
    # Security policy: saved for the lock screen / connect window to read, and the
    # manager's clock noted so password expiry cannot be beaten by winding the clock back.
    _apply_security_policy(resp.get("security"), resp.get("server_ms"))
    # The account's Admin Mode password (as a hash), when the manager has one set.
    _apply_admin_hash(resp.get("admin_mode_hash"))
    # Support chat: deliver admin replies + send the operator's queued messages.
    _chat_sync(base, dict(creds), resp.get("chat", []), resp.get("chat_reactions"))
    # Prune the local chat log to the tenant's retention (throttled ~6h) so the
    # device doesn't keep chat forever after the manager's daily sweep clears it.
    _chat_prune(resp.get("chat_retention_days"))
    for c in resp.get("commands", []):
        result = execute(c.get("type", ""))
        ack = dict(creds, command_id=c.get("id"), result=result)
        _curl_json("%s/api/agent/ack" % base, ack)
    if _PENDING_WIPE[0]:
        wipe_device()
        return 0                     # nothing after this has credentials to work with
    # Activity: report RDP/lock/idle transitions for the day-wise activity view.
    _report_activity(base, dict(creds))
    # Recording/monitoring config: null to stop, else {screen, camera, mic, notice}
    # — the admin's per-device source toggles. Live uses the same subset so only
    # the enabled sources are ever captured.
    rec_cfg = resp.get("record")
    # Recording runs FIRST: when live + record are both active it captures the
    # screen ONCE and tees it to the live view too (one grab, one encode), which is
    # the fix for the "live + record is painful" CPU-starvation bottleneck.
    # Anti-freeze pause: only relevant to a SEPARATE recorder (adds load on top of
    # live). With the merged single capture there IS no extra load, so don't pause.
    rec_run = rec_cfg
    if (rec_run and resp.get("stream") and _rdp_active() and not _merge_screen()
            and conf_get("REC_PAUSE_ON_LIVE_CALL", "0").lower() in ("1", "true", "yes", "on")):
        rec_run = None
    if rec_run:
        _rec_start(base, dict(creds), rec_run)
    else:
        _rec_stop_and_upload(base, dict(creds))
    # Live view = HLS to the tenant's storage, limited to the ENABLED sources. While
    # a recording is running its merged capture IS the live feed (screen with the
    # camera composited in), so live adds nothing the recorder already covers -
    # no duplicate x11grab, and no second open of the single-owner webcam.
    if resp.get("stream"):
        _live_start(base, dict(creds), rec_cfg,
                    skip_screen=_rec_owns_screen(), skip_camera=_rec_owns_camera())
    else:
        _live_stop()
    # Durability: re-upload any recording left stranded by a crash/shutdown/failed
    # upload. Throttled + backgrounded, so it never stalls the poll. On the first poll
    # after boot this recovers orphans from a power-cut mid-recording.
    _drain_pending_recordings(base, dict(creds))
    _log_sync_maybe()
    return 0


# --- Security policy (security plan) ----------------------------------------------
# The manager sends a `security` policy on every poll; it is saved, so a device that
# starts offline keeps applying the last one it was given. No policy = today's
# behaviour, which is what lets this code reach the fleet before anything is switched on.
CERT_SEEN = os.path.join(RUN_DIR, "cert-seen.json")
_SECPOL_MOD = None


def _secpolicy():
    """The shared thinclient-secpolicy module (next to this script), or None."""
    global _SECPOL_MOD
    if _SECPOL_MOD is None:
        _SECPOL_MOD = False
        try:
            import importlib.machinery, importlib.util
            here = os.path.dirname(os.path.abspath(__file__))
            for path in (os.path.join(here, "thinclient-secpolicy"),
                         "/opt/thinclient/bin/thinclient-secpolicy"):
                if os.path.exists(path):
                    spec = importlib.util.spec_from_loader(
                        "tc_secpolicy", importlib.machinery.SourceFileLoader("tc_secpolicy", path))
                    mod = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(mod)
                    _SECPOL_MOD = mod
                    break
        except Exception as e:
            print("agent: security policy module unavailable: %s" % e, file=sys.stderr)
    return _SECPOL_MOD or None


def _apply_security_policy(raw, server_ms):
    """Save the manager's policy and note the time it vouched for. Each protection
    reads the saved policy itself, so applying it here is just persisting it."""
    sp = _secpolicy()
    if not sp:
        return None
    if server_ms:
        sp.note_server_time(float(server_ms) / 1000.0)
    if raw is None:
        return sp.load()          # an older manager sends nothing: keep what we have
    changed = False
    try:
        changed = sp.save(raw)
        if changed:
            print("agent: security policy updated", file=sys.stderr)
    except Exception as e:
        print("agent: security policy not saved: %s" % e, file=sys.stderr)
    pol = sp.load()
    # Device-level protections that need DOING, not just reading: once after each
    # agent start, then only when the policy actually changes — not on every poll. In
    # the background, because grub-mkconfig takes seconds and must never hold the poll.
    if changed or not _PROTECTIONS_DONE[0]:
        _PROTECTIONS_DONE[0] = True
        threading.Thread(target=_apply_device_protections, args=(pol,), daemon=True).start()
    return pol


_PROTECTIONS_DONE = [False]


def _apply_device_protections(pol):
    try:
        apply_mem_harden(bool(pol.get("mem_harden")))
    except Exception as e:
        print("agent: memory hardening failed: %s" % e, file=sys.stderr)
    try:
        apply_usb_storage_block(bool(pol.get("usb_storage_block")))
    except Exception as e:
        print("agent: USB storage block failed: %s" % e, file=sys.stderr)


def _cert_seen():
    """What the connect window saw of each RDP server's certificate (RAM file)."""
    try:
        with open(CERT_SEEN) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _security_report():
    """Reported on every poll: what this device's security actually IS, as opposed to
    what the manager asked for. Cheap — the expensive facts are gathered in the
    background (_refresh_hardware_facts).

    Can never break the poll: if gathering any part fails, that part is left out and
    the poll goes on. A reporting bug must never cost a device its link to the manager."""
    rep = {}
    for part in (lambda: dict(_SECURITY_FACTS), _hardware_facts, _lockout_report, _mem_harden_report,
                 _admin_password_report):
        try:
            rep.update(part() or {})
        except Exception as e:
            print("agent: security report part failed: %s" % e, file=sys.stderr)
    return rep


# --- Memory hardening (security plan A3) ------------------------------------------
# Switched on per tenant from the manager, after it has been tried on each hardware
# model: the IOMMU line is the one part with any history of upsetting old graphics, so
# integrated graphics are left out of it (igfx_off) and the whole thing is reversible.
#   init_on_alloc / init_on_free  memory is zeroed as it is handed out and as it is
#                                 released — finished sessions and old recordings do not
#                                 linger, and at shutdown every exiting process's memory
#                                 is zeroed on its way out
#   intel_iommu=on,igfx_off       devices on Thunderbolt/PCIe ports cannot read RAM at
#                                 will (AMD machines enable their IOMMU by default)
# plus: sleep and hibernate masked (sleep keeps RAM powered; hibernate writes it to
# disk), FireWire drivers blocked (a classic way to read memory from a port).
#
# Kernel parameters need a reboot, and THIS IS THE FIRST OTA THAT CHANGES THE BOOT
# CONFIGURATION — earlier fixes avoided it on purpose. So: installed systems only (a
# USB-booted machine has no /etc/default/grub of its own); the new grub.cfg is built
# to a SEPARATE file and only swapped in if that worked and it carries the parameters;
# any failure restores /etc/default/grub and leaves the working grub.cfg untouched.
MEM_HARDEN_PARAMS = ("init_on_alloc=1", "init_on_free=1", "intel_iommu=on,igfx_off")
MEM_HARDEN_STATE = "/var/lib/thinclient/mem-harden-applied"
GRUB_DEFAULT = "/etc/default/grub"
GRUB_CFG = "/boot/grub/grub.cfg"
_SLEEP_TARGETS = ("sleep.target", "suspend.target", "hibernate.target", "hybrid-sleep.target")
_FIREWIRE_CONF = "/etc/modprobe.d/thinclient-no-firewire.conf"
_MEM_HARDEN_LOCK = threading.Lock()


def cmdline_with(line, enable):
    """GRUB_CMDLINE_LINUX="..." with our parameters added or removed, and everything
    else on it left exactly as it was."""
    key, _, rest = line.partition("=")
    val = rest.strip().strip('"')
    words = [w for w in val.split() if w not in MEM_HARDEN_PARAMS]
    if enable:
        words += list(MEM_HARDEN_PARAMS)
    return '%s="%s"' % (key, " ".join(words))


def _grub_default_rewritten(text, enable):
    """The parameters go on GRUB_CMDLINE_LINUX, which EVERY boot entry uses. The
    _DEFAULT line is skipped by the recovery entry — found by running the real
    grub-mkconfig: hardening there would leave "Advanced options > recovery mode"
    booting without it. Never left on _DEFAULT either."""
    out, seen = [], False
    for ln in text.splitlines():
        if ln.startswith("GRUB_CMDLINE_LINUX="):
            out.append(cmdline_with(ln, enable)); seen = True
        elif ln.startswith("GRUB_CMDLINE_LINUX_DEFAULT="):
            out.append(cmdline_with(ln, False))
        else:
            out.append(ln)
    if not seen:
        out.append(cmdline_with('GRUB_CMDLINE_LINUX=""', enable))
    return "\n".join(out) + "\n"


def _apply_kernel_params(enable):
    """Rewrite the boot parameters safely. Returns True if the boot config now matches
    `enable` (effective from the next restart)."""
    if os.path.exists("/run/live/medium") or not os.path.exists(GRUB_DEFAULT):
        return False
    try:
        old = open(GRUB_DEFAULT).read()
    except OSError:
        return False
    new = _grub_default_rewritten(old, enable)
    if new == old:
        return True
    backup = GRUB_DEFAULT + ".tc-prev"
    staged = GRUB_CFG + ".tc-new"
    try:
        with open(backup, "w") as f:
            f.write(old)
        with open(GRUB_DEFAULT, "w") as f:
            f.write(new)
        r = subprocess.run(["grub-mkconfig", "-o", staged], capture_output=True, text=True, timeout=180)
        cfg = open(staged).read() if os.path.exists(staged) else ""
        # EVERY boot entry, the recovery one included — not just "somewhere in the file".
        entries = [l for l in cfg.splitlines() if l.strip().startswith("linux")]
        good = r.returncode == 0 and bool(entries) and (
            all(all(p in l for p in MEM_HARDEN_PARAMS) for l in entries) if enable
            else not any("init_on_free=1" in l for l in entries))
        if not good:
            raise RuntimeError("grub-mkconfig rc=%s %s" % (r.returncode, (r.stderr or "")[-300:]))
        if os.path.exists(GRUB_CFG):
            shutil.copy2(GRUB_CFG, GRUB_CFG + ".tc-prev")
        os.replace(staged, GRUB_CFG)
        print("agent: boot parameters %s (effective after restart)" % ("hardened" if enable else "restored"),
              file=sys.stderr)
        return True
    except Exception as e:
        print("agent: boot parameter change ABORTED, previous config kept: %s" % e, file=sys.stderr)
        try:
            with open(GRUB_DEFAULT, "w") as f:
                f.write(old)
        except OSError:
            pass
        try:
            os.remove(staged)
        except OSError:
            pass
        return False


def apply_mem_harden(enable):
    """Bring the device to the wanted state. Idempotent; a no-op when already there."""
    with _MEM_HARDEN_LOCK:
        want = "1" if enable else "0"
        try:
            if open(MEM_HARDEN_STATE).read().strip() == want:
                return
        except OSError:
            if not enable:
                return                     # never hardened: nothing to undo
        run = lambda *a: subprocess.run(list(a), capture_output=True, timeout=30)
        for t in _SLEEP_TARGETS:
            run("systemctl", "mask" if enable else "unmask", t)
        try:
            if enable:
                with open(_FIREWIRE_CONF, "w") as f:
                    f.write("# thinclient: FireWire can read memory directly; blocked.\n"
                            "install firewire_ohci /bin/false\ninstall firewire_core /bin/false\n")
            elif os.path.exists(_FIREWIRE_CONF):
                os.remove(_FIREWIRE_CONF)
        except OSError:
            pass
        if _apply_kernel_params(enable):
            try:
                with open(MEM_HARDEN_STATE, "w") as f:
                    f.write(want + "\n")
            except OSError:
                pass


# --- USB storage block (security plan G7) -----------------------------------------
# Pen drives, USB disks and USB card readers stop working; keyboards, mice, webcams,
# headsets, printers, phone tethering and 4G modems do not — they are other USB classes
# with their own drivers. Only the storage drivers (usb-storage, uas) are refused.
#
# Never on a device that BOOTS from USB: some thin clients do, and a later initramfs
# rebuild would copy this refusal into early boot and leave the machine unable to find
# its own disk. MMC/SD drivers are never touched for the same reason (eMMC boot disks).
_USB_BLOCK_CONF = "/etc/modprobe.d/thinclient-no-usb-storage.conf"


def _boot_disk_transport():
    """'usb', 'sata', 'nvme', ... for the disk holding /, or None if unknown."""
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/"], capture_output=True,
                             text=True, timeout=10).stdout.strip()
        if not src.startswith("/dev/"):
            return None
        parent = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True,
                                text=True, timeout=10).stdout.strip().splitlines()
        disk = "/dev/" + (parent[0].strip() if parent and parent[0].strip() else os.path.basename(src))
        tran = subprocess.run(["lsblk", "-dno", "TRAN", disk], capture_output=True,
                              text=True, timeout=10).stdout.strip()
        return tran or None
    except Exception:
        return None


def apply_usb_storage_block(enable):
    """Returns the state reached: "blocked" | "allowed" | "skipped-usb-boot" | "skipped-live"."""
    if not enable:
        if os.path.exists(_USB_BLOCK_CONF):
            try:
                os.remove(_USB_BLOCK_CONF)
                print("agent: USB storage allowed again", file=sys.stderr)
            except OSError:
                pass
        _SECURITY_FACTS["usb_storage"] = "allowed"
        return "allowed"
    if os.path.exists("/run/live/medium"):
        _SECURITY_FACTS["usb_storage"] = "skipped-live"
        return "skipped-live"
    tran = _boot_disk_transport()
    if tran in (None, "usb"):
        # Unknown counts as unsafe: better an unblocked port than an unbootable machine.
        _SECURITY_FACTS["usb_storage"] = "skipped-usb-boot"
        print("agent: USB storage block skipped — boot disk transport is %s" % tran, file=sys.stderr)
        return "skipped-usb-boot"
    try:
        with open(_USB_BLOCK_CONF, "w") as f:
            f.write("# thinclient: USB mass storage blocked by policy (other USB devices work).\n"
                    "install usb-storage /bin/false\ninstall uas /bin/false\n")
    except OSError as e:
        print("agent: USB storage block not written: %s" % e, file=sys.stderr)
        return "allowed"
    # Unload now if nothing is using it; otherwise it takes effect once the stick is out.
    subprocess.run(["modprobe", "-r", "uas", "usb-storage"], capture_output=True, timeout=20)
    _SECURITY_FACTS["usb_storage"] = "blocked"
    return "blocked"


# --- Device hostname ----------------------------------------------------------------
# A device installed without a name kept the image's own default hostname, which named
# the vendor on every customer network it joined. Each device's hostname is now what
# the installer would give it today: derived from its device name, else "thinclient".
# Devices already named at install time already match and are left alone.
#
# In TWO phases, because sudo and friends look the machine's own name up in /etc/hosts:
# renaming the file while the old name is still the running one would make them stall
# on a DNS lookup until the restart. So: (1) the new name goes into /etc/hostname and
# BOTH names into /etc/hosts; (2) after the restart, once the new name is the running
# one, the old one is taken out of /etc/hosts.
HOSTNAME_FILE = "/etc/hostname"
HOSTS_FILE = "/etc/hosts"
HOSTNAME_RENAME_STATE = "/var/lib/thinclient/hostname-renamed-from"


def canonical_hostname(device_name):
    """Exactly the installer's rule (install-to-disk.sh): spaces to hyphens, then only
    letters, digits and hyphens, no leading/trailing hyphen, at most 63 characters."""
    hn = "".join(c for c in (device_name or "").replace(" ", "-")
                 if c.isascii() and (c.isalnum() or c == "-")).strip("-")[:63]
    return hn or "thinclient"


def hosts_with(text, add=None, remove=None):
    """/etc/hosts with `add` put on (and `remove` taken off) the loopback lines,
    every other line and every other name untouched."""
    out = []
    for ln in text.splitlines():
        parts = ln.split()
        if parts and parts[0] in ("127.0.0.1", "127.0.1.1") and not ln.lstrip().startswith("#"):
            names = [n for n in parts[1:] if n != remove]
            if add and add not in names and (parts[0] == "127.0.1.1" or "localhost" in names):
                names.append(add)
            if parts[0] == "127.0.1.1" and not names:
                continue
            out.append("%s\t%s" % (parts[0], " ".join(names)))
        else:
            out.append(ln)
    return "\n".join(out) + "\n"


def apply_hostname():
    if os.path.exists("/run/live/medium"):
        return None
    want = canonical_hostname(conf_get("DEVICE_NAME", ""))
    running = _hostname()
    try:
        hosts = open(HOSTS_FILE).read()
    except OSError:
        return None
    try:
        old = open(HOSTNAME_RENAME_STATE).read().strip()
    except OSError:
        old = ""
    if running == want:
        # Phase 2: the restart has happened; drop the old name.
        if old and old != want:
            new_hosts = hosts_with(hosts, remove=old)
            if new_hosts != hosts:
                with open(HOSTS_FILE, "w") as f:
                    f.write(new_hosts)
            os.remove(HOSTNAME_RENAME_STATE)
            print("agent: hostname now %s (old name retired)" % want, file=sys.stderr)
        return want
    # Phase 1: the new name takes effect at the next restart; both resolve until then.
    try:
        current_file = open(HOSTNAME_FILE).read().strip()
    except OSError:
        current_file = ""
    if current_file != want:
        with open(HOSTNAME_FILE, "w") as f:
            f.write(want + "\n")
        with open(HOSTNAME_RENAME_STATE, "w") as f:
            f.write(running + "\n")
    new_hosts = hosts_with(hosts, add=want)
    if new_hosts != hosts:
        with open(HOSTS_FILE, "w") as f:
            f.write(new_hosts)
    return want


# --- Remote wipe (security plan A5) ------------------------------------------------
# For a device reported lost or stolen. Phase A disks are not encrypted, so this
# deletes what matters; on an encrypted (Phase B) disk it destroys the key instead.
# Only reaches a device that comes online — the encryption, not this, is the real
# protection — but a thief who plugs it in to see what it is gets nothing.
_PENDING_WIPE = [False]
WIPED_MARK = "/var/lib/thinclient/wiped"
WIPE_MESSAGE = "This device has been reset for security reasons. Contact your administrator."
TC_LOG_DIR = os.environ.get("TC_LOG_DIR", "/var/log/thinclient")


def _wipe_paths():
    home = _kiosk_home()
    return [
        REC_DIR,                                   # recordings awaiting upload
        CHAT_DIR,                                  # admin chat history
        MANAGED_RDP, LEGACY_MANAGED_RDP,           # Windows credentials (RAM + any old disk copy)
        CERT_SEEN,
        os.path.join(home, ".thinclient-rdp"),     # operator-saved connection
        os.path.join(home, ".thinclient-lock"),    # lock password hash + its history
        os.path.join(home, ".thinclient-lock.meta.json"),
        os.path.join(home, ".thinclient-lock-state.json"),
        TC_LOG_DIR,                                # logs name the server and the users
    ] + glob.glob(os.path.join(RUN_DIR, "rdp-profile-pw-*"))


def wipe_device():
    """Erase this device's secrets and data, deregister it, and lock it for good.

    Order matters: the session and recorders stop first so nothing is rewritten
    mid-wipe; the credentials go next so that whatever happens afterwards, the device
    can no longer talk to the manager or to the Windows server."""
    _PENDING_WIPE[0] = False
    print("agent: REMOTE WIPE — erasing device secrets and data", file=sys.stderr)
    _drop_rdp_session("remote wipe")
    for name in ("ffmpeg",):
        try:
            subprocess.run(["pkill", "-x", name], capture_output=True, timeout=10)
        except Exception:
            pass
    # Deregister. TENANT_TOKEN too: with it left, the agent would quietly re-enrol the
    # stolen machine into the fleet at its next start.
    for key in ("DEVICE_SECRET", "ENROLL_CODE", "TENANT_TOKEN", "INSTALL_KEY"):
        _set_conf_key(key, "")
    for path in _wipe_paths():
        try:
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path, ignore_errors=True)
            elif os.path.lexists(path):
                os.remove(path)
        except OSError as e:
            print("agent: wipe could not remove %s: %s" % (path, e), file=sys.stderr)
    # Permanently locked, with a message, until the device is reinstalled. It has no
    # credentials left, so no manager can unlock it — which is the point.
    # No message on the lock itself: both screens read a non-empty message as working-
    # hours text. They check WIPED_MARK first and say what actually happened.
    set_admin_lock(True, "permanent", 24, "")
    try:
        with open(WIPED_MARK, "w") as f:
            f.write("%d\n" % int(time.time()))
    except OSError:
        pass
    print("agent: remote wipe complete", file=sys.stderr)


# --- Hardware & security facts (security plan A1) ---------------------------------
# Which machines CAN be fully protected: memory encryption (the only real defence
# against RAM pulled out and read), a TPM (needed for disk encryption), Secure Boot.
_HW_FACTS = {}
_HW_FACTS_AT = [0.0]
_HW_REFRESH_SECS = 6 * 3600


def _read(path, default=""):
    try:
        with open(path, "rb") as f:
            return f.read().decode("utf-8", "replace")
    except OSError:
        return default


def _kernel_log():
    """The boot's kernel messages. The dmesg ring can have rotated on a box that has
    been up for weeks, so the journal's copy of this boot is preferred."""
    for cmd in (["journalctl", "-k", "-b", "--no-pager", "-q"], ["dmesg"]):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout
            if out:
                return out
        except Exception:
            continue
    return ""


def gather_hardware_facts(root=""):
    """Pure-ish: everything comes from files under `root` (tests point it elsewhere)
    plus the kernel log. Facts it cannot determine are reported as None, never guessed."""
    f = {}
    cpu = _read(root + "/proc/cpuinfo")
    model = next((l.split(":", 1)[1].strip() for l in cpu.splitlines() if l.startswith("model name")), None)
    flags = next((l.split(":", 1)[1].split() for l in cpu.splitlines() if l.startswith("flags")), [])
    f["cpu_model"] = model
    f["mem_enc_supported"] = ("sme" in flags) or ("tme" in flags) if flags else None
    klog = _kernel_log() if not root else _read(root + "/klog")
    f["mem_enc_active"] = bool(
        "x86/tme: enabled by BIOS" in klog or "Memory Encryption Features active" in klog)
    tpm = root + "/sys/class/tpm/tpm0"
    if os.path.isdir(tpm):
        major = _read(tpm + "/tpm_version_major").strip() or None
        # Firmware TPMs (Intel PTT, AMD fTPM) use the CRB interface; discrete chips are
        # nearly always TIS. A heuristic, reported as such — it decides between
        # "TPM only" and "TPM + PIN" in the plan, so it is a hint, not a verdict.
        iface = "crb" if "tpm_crb" in klog else ("tis" if "tpm_tis" in klog else None)
        f["tpm"] = {"present": True, "version": major, "interface": iface}
    else:
        f["tpm"] = {"present": False}
    efi = root + "/sys/firmware/efi"
    f["uefi"] = os.path.isdir(efi)
    sb = _read(efi + "/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-e0f84a3cb4bd", None) \
        if f["uefi"] else None
    f["secure_boot"] = (len(sb) >= 5 and ord(sb[4]) == 1) if sb else (False if f["uefi"] else None)
    f["mor_supported"] = os.path.exists(
        efi + "/efivars/MemoryOverwriteRequestControl-e20939be-32d4-41be-a150-897f85d49829")
    cmdline = _read(root + "/proc/cmdline")
    f["kernel_hardening"] = all(x in cmdline for x in ("init_on_free=1", "init_on_alloc=1"))
    # The kernel's own word first: on some Intel machines (seen on a Pentium Silver
    # N5000 with intel_iommu=on,igfx_off) DMA translation is on — "DMAR: IOMMU enabled",
    # "Default domain type: Translated" — while /sys/class/iommu stays empty.
    try:
        sysfs = bool(os.listdir(root + "/sys/class/iommu"))
    except OSError:
        sysfs = False
    f["iommu_active"] = sysfs or "Default domain type: Translated" in klog or "DMAR: IOMMU enabled" in klog
    f["live_medium"] = os.path.exists(root + "/run/live/medium")
    return f


def _disk_encrypted():
    try:
        out = subprocess.run(["lsblk", "-rno", "TYPE"], capture_output=True, text=True, timeout=10).stdout
        return "crypt" in out.split()
    except Exception:
        return None


def _refresh_hardware_facts():
    """Background: gather once at start, then every 6 hours."""
    while True:
        try:
            facts = gather_hardware_facts()
            facts["disk_encrypted"] = _disk_encrypted()
            _HW_FACTS.clear(); _HW_FACTS.update(facts)
            _HW_FACTS_AT[0] = time.time()
        except Exception as e:
            print("agent: hardware facts failed: %s" % e, file=sys.stderr)
        time.sleep(_HW_REFRESH_SECS)


def _hardware_facts():
    return {"hardware": dict(_HW_FACTS)} if _HW_FACTS else {}


# --- Lock-screen lockout (security plan A4) ---------------------------------------
# The lock screen (running as the kiosk user) records wrong passwords in its home.
# The 3rd one locks it out; the agent turns that into an administrator lock and tells
# the manager. Only an administrator's Unlock lifts it.
def _kiosk_home():
    try:
        import pwd
        return pwd.getpwnam(conf_get("SESSION_USER", "thinclient")).pw_dir
    except Exception:
        return "/home/thinclient"


def _lock_state_path():
    return os.path.join(_kiosk_home(), ".thinclient-lock-state.json")


def _read_json(path):
    try:
        with open(path) as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def _local_lockout():
    """The lockout the lock screen recorded, or None."""
    st = _read_json(_lock_state_path())
    return st if st.get("locked_at") else None


def _clear_local_lockout():
    """An administrator lifted it: fresh tries. Written back owned by the kiosk user,
    because it is the lock screen's file."""
    path = _lock_state_path()
    try:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"fails": 0}, f)
        os.chmod(tmp, 0o600)
        try:
            import pwd
            u = pwd.getpwnam(conf_get("SESSION_USER", "thinclient"))
            os.chown(tmp, u.pw_uid, u.pw_gid)
        except Exception:
            pass
        os.replace(tmp, path)
        print("agent: lockout lifted by an administrator", file=sys.stderr)
    except OSError as e:
        print("agent: could not clear lockout: %s" % e, file=sys.stderr)


def _hold_local_lockout():
    """Keep a recorded lockout locked whatever else happens — offline, between polls,
    or before the manager has heard about it. Permanent, never timed: a timed lock
    auto-releases after its hours, which would hand a guesser three fresh tries a day."""
    if _local_lockout():
        set_admin_lock(True, "permanent", 24, "")
        _drop_rdp_session("wrong-password lockout")
        return True
    return False


def _reconcile_lockout(manager_locked, lockout_ack):
    """True while a wrong-password lockout is in force, so the poll must NOT apply the
    manager's lock flag. Released only when the manager has acknowledged THIS lockout
    (its ack equals our locked_at) AND says unlocked — an administrator pressed Unlock
    after seeing it. Before the acknowledgement, a "not locked" means only that the
    manager has not heard yet, and is ignored."""
    lockout = _local_lockout()
    if lockout is None:
        return False
    try:
        acked = int(float(lockout_ack or 0)) == int(float(lockout["locked_at"]))
    except (TypeError, ValueError):
        acked = False
    if acked and not manager_locked:
        _clear_local_lockout()
        return False
    _hold_local_lockout()
    return True


# Admin Mode (Ctrl+Alt+Shift+A) ships with a default password that is documented in the
# public source. Anyone at the keyboard who knows it can repoint the device at another
# RDP server or run the installer. The account sets its own from the manager, sent as a
# hash (_apply_admin_hash); the report says which devices still have the factory one.
ADMIN_CONF = os.environ.get("TC_ADMIN_CONF", "/etc/thinclient/admin.conf")
_DEFAULT_ADMIN_HASH = ("$6$thinclient00$5UHjCgA9QSMdPfMykia8Q1Inye73MoramQDVWYJYjowv/"
                       "v2EkMKT9FL7X6GlQ.bKRX3tq9e7Ecpky.ofVp.uz.")


_ADMIN_HASH_RE = re.compile(r"^\$6\$(rounds=\d{4,9}\$)?[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}$")
_ADMIN_HASH_MANAGED = {"hash": None}      # the last hash the manager sent


def _current_admin_hash():
    for ln in _read(ADMIN_CONF).splitlines():
        if ln.startswith("ADMIN_PASSWORD_HASH="):
            return ln.split("=", 1)[1].strip()
    return None


def _apply_admin_hash(h):
    """Install the account's Admin Mode password hash from the manager, replacing the
    factory one. Only a well-formed SHA-512 crypt hash is accepted; nothing else in
    admin.conf is touched. No hash sent = leave the device exactly as it is."""
    if not isinstance(h, str) or not _ADMIN_HASH_RE.match(h):
        return False
    _ADMIN_HASH_MANAGED["hash"] = h
    if _current_admin_hash() == h:
        return False
    try:
        lines = _read(ADMIN_CONF).splitlines(True)
        out, found = [], False
        for ln in lines:
            if ln.startswith("ADMIN_PASSWORD_HASH="):
                out.append("ADMIN_PASSWORD_HASH=%s\n" % h); found = True
            else:
                out.append(ln)
        if not found:
            out.append("ADMIN_PASSWORD_HASH=%s\n" % h)
        tmp = ADMIN_CONF + ".tc-new"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.writelines(out)
        os.chmod(tmp, 0o600)
        os.replace(tmp, ADMIN_CONF)
        print("agent: Admin Mode password updated from the manager", file=sys.stderr)
        return True
    except OSError as e:
        print("agent: could not update the Admin Mode password: %s" % e, file=sys.stderr)
        return False


def _admin_password_report():
    cur = _current_admin_hash()
    if cur is None:
        return {"admin_password_default": None}
    return {"admin_password_default": cur == _DEFAULT_ADMIN_HASH,
            "admin_password_managed": bool(_ADMIN_HASH_MANAGED["hash"]) and cur == _ADMIN_HASH_MANAGED["hash"]}


def _mem_harden_report():
    """Hardened in the boot config, and actually running hardened. The two differ until
    the device restarts — the manager shows that as "restart pending"."""
    try:
        applied = open(MEM_HARDEN_STATE).read().strip() == "1"
    except OSError:
        applied = False
    running = all(p in _read("/proc/cmdline") for p in ("init_on_free=1", "init_on_alloc=1"))
    return {"mem_harden": {"applied": applied, "running": running}}


def _lockout_report():
    home = _kiosk_home()
    m = _read_json(os.path.join(home, ".thinclient-lock.meta.json"))
    rep = {"lock_password": {
        "set_at": int(m["set_at"]) if m.get("set_at") else None,
        "is_default": not os.path.exists(os.path.join(home, ".thinclient-lock")),
        "must_change": bool(m.get("must_change")),
        "weak": bool(m.get("weak")),
    }}
    lo = _local_lockout()
    if lo:
        rep["lockout"] = {"locked_at": int(lo["locked_at"]), "fails": int(lo.get("fails", 0))}
    return rep


# Debug access that must never exist on a fleet device. The debug user and its password
# were hard-coded in the (public) source for debug builds, so a device built that way
# could be logged into as root by anyone who has read it. Production builds never had
# them, but nothing proved a debug build had not reached a customer — so every device
# enforces this at every start, whatever image it came from.
_DEBUG_UID = 1002            # the debug build always created its account with this id
_DEBUG_USERS = ("tcdebug",)  # current name; older debug builds used another — found by id
_DEBUG_ACCESS_OPT_IN = "/etc/thinclient/debug-access-allowed"   # hand-made on a lab box only
_SECURITY_FACTS = {}   # what enforcement found; reported to the manager (see _security_report)


def _enforce_no_debug_access():
    """No SSH, no debug console, no debug login — on every start, idempotently.

    The only exception is a box someone has deliberately opted in by creating
    /etc/thinclient/debug-access-allowed by hand. No image creates it and no remote
    command can, so it cannot appear on a fleet device by accident. Anyone able to
    create it already has root on that box."""
    try:
        flags = open("/etc/thinclient/.build-flags").read()
    except OSError:
        flags = ""
    _SECURITY_FACTS["debug_build"] = "DEBUG_SSH=1" in flags
    if os.path.exists(_DEBUG_ACCESS_OPT_IN):
        _SECURITY_FACTS["debug_access"] = "opted-in"
        return
    run = lambda *a: subprocess.run(list(a), capture_output=True, timeout=30)
    found = []
    try:
        for unit in ("ssh.service", "ssh.socket", "sshd.service"):
            if run("systemctl", "is-enabled", unit).returncode == 0 or \
               run("systemctl", "is-active", unit).returncode == 0:
                found.append(unit)
            run("systemctl", "disable", "--now", unit)
            run("systemctl", "mask", unit)
        for f in glob.glob("/etc/ssh/sshd_config.d/*debug*.conf"):
            try:
                os.remove(f); found.append(f)
            except OSError:
                pass
        users = set(_DEBUG_USERS)
        try:
            import pwd
            users.add(pwd.getpwuid(_DEBUG_UID).pw_name)   # whatever an older build named it
        except (KeyError, ImportError):
            pass
        for user in sorted(users):
            if run("id", user).returncode != 0:
                continue
            found.append("user:" + user)
            # Locked and expired rather than deleted: deleting a user can orphan files,
            # and a locked, expired account with no shell and no sudo is equally dead.
            run("usermod", "-L", "-e", "1", "-s", "/usr/sbin/nologin", user)
            run("gpasswd", "-d", user, "sudo")
        # The debug console on Ctrl+Alt+F2.
        if run("systemctl", "is-enabled", "getty@tty2.service").returncode == 0:
            found.append("getty@tty2")
        run("systemctl", "disable", "--now", "getty@tty2.service")
        run("systemctl", "mask", "getty@tty2.service")
        # A debug image set a root password; production images never did. Lock it either
        # way — nothing on this appliance logs in as root with a password.
        run("passwd", "-l", "root")
    except Exception as e:
        print("agent: debug-access enforcement incomplete: %s" % e, file=sys.stderr)
    _SECURITY_FACTS["debug_access"] = "removed" if found else "none"
    _SECURITY_FACTS["ssh_active"] = run("systemctl", "is-active", "ssh.service").returncode == 0
    if found:
        print("agent: removed debug access: %s" % ", ".join(found), file=sys.stderr)


def _harden_session():
    """A kiosk must NEVER expose a login terminal and must always recover its
    desktop. If the X session ever dies (e.g. a GPU/driver crash), (1) no getty
    may appear on the X VT (tty7), and (2) lightdm must restart so the desktop
    comes back instead of a console. Applied once (idempotent, root)."""
    # Version the marker so a newer agent re-applies once even if an older one
    # already ran. (Do NOT skip on live media — the hardening is idempotent and is
    # exactly what a live/USB-booted appliance needs too.)
    marker = os.path.join(STATE_DIR, ".session-hardened-v2")
    if os.path.exists(marker):
        return
    try:
        # No login prompt on the graphical VT (or its dynamic autovt).
        subprocess.run(["systemctl", "mask", "getty@tty7.service", "autovt@tty7.service"],
                       capture_output=True, timeout=20)
        # Root cause on OTA-updated 1.0.15 boxes: /etc/systemd/logind.conf.d baked
        # ReserveVT=7, which asks logind to keep a login getty on X's OWN VT (so the
        # moment X frees VT7, a "<hostname> login:" prompt appears there). Override it to 6 —
        # X never uses VT6 — so logind never eyes the graphical VT. Takes effect next
        # boot; masking getty@tty7 already blocks it at runtime this boot.
        ld = "/etc/systemd/logind.conf.d"
        os.makedirs(ld, exist_ok=True)
        with open(os.path.join(ld, "20-thinclient-vt.conf"), "w") as f:
            f.write("[Login]\nReserveVT=6\n")
        # Always bring the desktop back if lightdm/X exits — never a console.
        d = "/etc/systemd/system/lightdm.service.d"
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "10-thinclient-restart.conf"), "w") as f:
            f.write("[Unit]\nStartLimitIntervalSec=0\n\n[Service]\nRestart=always\nRestartSec=1\n")
        subprocess.run(["systemctl", "daemon-reload"], capture_output=True, timeout=25)
        os.makedirs(STATE_DIR, exist_ok=True)
        open(marker, "w").close()
        print("agent: hardened session recovery (no tty7 getty, lightdm auto-restart)", file=sys.stderr)
    except Exception as e:
        print("agent: session harden failed: %s" % e, file=sys.stderr)


def _cairo_ok() -> bool:
    """True if the kiosk Python can import pycairo (needed for the shaped bubble).
    On any error we return True so we DON'T attempt an install we can't verify."""
    try:
        return subprocess.run([sys.executable, "-c", "import cairo"],
                              capture_output=True, timeout=10).returncode == 0
    except Exception:
        return True


def _ensure_chat_deps() -> None:
    """The round chat-launcher bubble needs pycairo (python3-gi-cairo), which the
    OTA script bundle can't carry. When it's missing, pull just that leaf package
    (~200 KB) so OTA devices get the shaped bubble too — the launcher then hot-swaps
    to it with no reboot. Fully graceful: no network / apt busy -> the solid-tile
    launcher keeps working and we retry on the next boot."""
    if _cairo_ok():
        return
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")

    def _apt(*a) -> int:
        try:
            return subprocess.run(["apt-get", "-y", "-o", "DPkg::Lock::Timeout=90", *a],
                                  env=env, capture_output=True, timeout=300).returncode
        except Exception:
            return 1

    _apt("install", "--no-install-recommends", "python3-gi-cairo")
    if _cairo_ok():
        print("agent: python3-gi-cairo installed (round chat bubble enabled)", file=sys.stderr)
        return
    # Package lists may be stale/absent on the appliance — refresh once and retry.
    _apt("update")
    _apt("install", "--no-install-recommends", "python3-gi-cairo")
    if _cairo_ok():
        print("agent: python3-gi-cairo installed after apt update", file=sys.stderr)


_WIFI_USB_VENDORS = ("2357", "0bda", "0e8d", "148f")   # TP-Link, Realtek, MediaTek, Ralink


def _write_if_changed(path: str, content: str, mode: int = 0o644) -> bool:
    try:
        if open(path).read() == content:
            return False
    except OSError:
        pass
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(content)
        os.chmod(path, mode)
        return True
    except OSError:
        return False


def _has_link() -> bool:
    """A network LINK exists (cable plugged / Wi-Fi associated) — regardless of
    whether the internet actually works."""
    try:
        p = subprocess.run(["nmcli", "-t", "-f", "TYPE,STATE", "device", "status"],
                           capture_output=True, text=True, timeout=5)
        if p.returncode == 0:
            return any(l.startswith("ethernet:connected") or l.startswith("wifi:connected")
                       for l in p.stdout.splitlines())
    except Exception:
        pass
    try:  # carrier fallback
        for ifc in os.listdir("/sys/class/net"):
            if ifc == "lo":
                continue
            try:
                if open("/sys/class/net/%s/carrier" % ifc).read().strip() == "1":
                    return True
            except OSError:
                pass
    except OSError:
        pass
    return False


def _internet_reachable(timeout=2.5) -> bool:
    """True if the internet is actually reachable. Robust anycast endpoints (never
    the customer's RDP server, to avoid spamming its firewall/logs)."""
    import socket
    for host, port in (("1.1.1.1", 443), ("8.8.8.8", 53)):
        try:
            socket.create_connection((host, port), timeout=timeout).close()
            return True
        except Exception:
            continue
    return False


def _net_selfheal_loop() -> None:
    """Self-heal a 'link up but no internet' machine so nobody has to reboot it.
    If a LINK is present but the INTERNET stays unreachable for a sustained period,
    re-initialise networking (fresh DHCP) — the automatic version of the 'restart
    and it works' fix. Heavily guarded: never touches a working link, throttled to
    once per ~5 min, and skipped while an RDP session is live (that link is fine)."""
    if not shutil.which("nmcli"):
        return
    bad = 0
    last_heal = 0.0
    while True:
        time.sleep(30)
        try:
            if not _has_link():
                bad = 0; continue                       # nothing plugged in / associated
            if _rdp_connected() or _internet_reachable():
                bad = 0; continue                       # internet works -> nothing to do
            bad += 1
            # ~2.5 min of link-up-but-no-internet, and not healed in the last ~5 min
            if bad >= 5 and (time.time() - last_heal) > 300:
                last_heal = time.time(); bad = 0
                print("agent: link up but no internet -> re-initialising networking (fresh DHCP)",
                      file=sys.stderr)
                try:
                    subprocess.run(["nmcli", "networking", "off"], capture_output=True, timeout=20)
                    time.sleep(2)
                    subprocess.run(["nmcli", "networking", "on"], capture_output=True, timeout=20)
                except Exception as e:
                    print("agent: net self-heal failed: %s" % e, file=sys.stderr)
        except Exception:
            pass


def _ensure_wifi_stable() -> None:
    """USB Wi-Fi dongles — especially the rtl88xxau family (TP-Link Archer T2U etc.)
    — hit a kernel 'Runtime PM usage count underflow' that RE-ENUMERATES the adapter:
    Wi-Fi drops for ~30s, so the operator's RDP session dies AND a fresh RDP connect
    made during the gap fails. Root fix = stop USB autosuspend + the driver's power
    saving so the dongle never power-cycles. Best-effort: writes persistent config
    (udev/modprobe/NetworkManager) AND applies it immediately (sysfs) so it takes
    effect on the live session without a reboot."""
    changed = False
    # 1) udev: never autosuspend a USB Wi-Fi dongle; kill 802.11 power-save on add.
    rule = "# ThinClient: keep USB Wi-Fi dongles powered (rtl88xxau Runtime-PM reset).\n"
    for v in _WIFI_USB_VENDORS:
        rule += ('ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="%s", '
                 'TEST=="power/control", ATTR{power/control}="on"\n' % v)
    # (802.11 power-save is disabled via NetworkManager + the direct iwconfig call
    # below on the RENAMED interface — a udev RUN on the early 'wlan0' name errors.)
    changed |= _write_if_changed("/etc/udev/rules.d/72-thinclient-wifi-nopm.rules", rule)
    # 2) modprobe: disable rtl88xxau power management + USB selective suspend
    #    (applies when the module next loads — i.e. next reboot).
    mod = ("# ThinClient: stop the USB Wi-Fi power-management reset (rtl88xxau).\n"
           "options 8821au rtw_power_mgnt=0 rtw_enusbss=0\n"
           "options 8812au rtw_power_mgnt=0 rtw_enusbss=0\n"
           "options 88x2bu rtw_power_mgnt=0 rtw_enusbss=0\n"
           "options rtw_8821au rtw_power_mgnt=0 rtw_enusbss=0\n")
    changed |= _write_if_changed("/etc/modprobe.d/thinclient-wifi.conf", mod)
    # 3) NetworkManager: disable Wi-Fi power-save for all connections.
    nm = "[connection]\nwifi.powersave = 2\n"
    changed |= _write_if_changed("/etc/NetworkManager/conf.d/wifi-powersave.conf", nm)

    # ---- apply NOW (sysfs/tools reset on reboot or re-enumeration) ----
    for base in glob.glob("/sys/bus/usb/devices/*"):
        try:
            vid = open(os.path.join(base, "idVendor")).read().strip()
        except OSError:
            continue
        if vid in _WIFI_USB_VENDORS:
            pc = os.path.join(base, "power", "control")
            try:
                if os.path.exists(pc):
                    open(pc, "w").write("on")   # disable this dongle's autosuspend
            except OSError:
                pass
    for ifc in glob.glob("/sys/class/net/*"):
        name = os.path.basename(ifc)
        if name.startswith(("wlan", "wlx", "wlp")):
            try:
                subprocess.run(["iwconfig", name, "power", "off"], capture_output=True, timeout=8)
            except Exception:
                pass
    try:
        subprocess.run(["udevadm", "control", "--reload-rules"], capture_output=True, timeout=10)
        if changed:
            subprocess.run(["nmcli", "general", "reload"], capture_output=True, timeout=10)
    except Exception:
        pass


def _ensure_call_stability() -> None:
    """Close the appliance-specific gaps behind 'a call in the RDP session hangs the
    WHOLE machine' (a normal PC handles the same call fine). One-shot, idempotent,
    applies live where possible; a reboot fully arms the hardware watchdog.

      1. Real-time audio  — PipeWire runs its audio threads at normal priority, so a
         call's bidirectional audio starves under CPU load -> xrun storm -> apparent
         hang. Grant rtprio + memlock (active on the next session login).
      2. zram swap        — no swap = memory pressure (call app + FreeRDP + capture)
         thrashes/hangs. A compressed-RAM swap gives an OOM cushion.
      3. Hardware watchdog— our process watchdog can't recover a hard kernel hang;
         let systemd pet /dev/watchdog so a wedged box auto-reboots in ~1 min.
      4. Persistent journal— today a hang's logs vanish on the power-cycle; keep them
         on disk so the cause is finally diagnosable (GETLOGS pulls the prev boot).
      5. USB no-autosuspend— a USB headset under call load (sharing the bus with the
         Wi-Fi dongle) can power-cycle/reset; disable USB autosuspend fleet-wide."""
    changed = False
    user = conf_get("SESSION_USER", "thinclient") or "thinclient"

    changed |= _write_if_changed(
        "/etc/security/limits.d/95-thinclient-rt-audio.conf",
        "# ThinClient: real-time priority for PipeWire/WirePlumber so a call's audio\n"
        "# is not starved under load (normal-priority audio spins + hangs the box).\n"
        "@audio   -  rtprio     95\n@audio   -  memlock    unlimited\n"
        "%s   -  rtprio     95\n%s   -  memlock    unlimited\n" % (user, user))

    changed |= _write_if_changed(
        "/etc/systemd/system/thinclient-zram.service",
        "[Unit]\nDescription=ThinClient zram swap (OOM cushion)\n"
        "DefaultDependencies=no\nAfter=local-fs.target\n\n"
        "[Service]\nType=oneshot\nRemainAfterExit=yes\n"
        "ExecStart=/bin/sh -c 'modprobe zram num_devices=1 2>/dev/null; "
        "swapoff /dev/zram0 2>/dev/null; echo 1 > /sys/block/zram0/reset 2>/dev/null; "
        "(echo zstd > /sys/block/zram0/comp_algorithm 2>/dev/null || true); "
        "echo 1536M > /sys/block/zram0/disksize && mkswap /dev/zram0 && swapon -p 100 /dev/zram0'\n"
        "ExecStop=/bin/sh -c 'swapoff /dev/zram0 2>/dev/null; echo 1 > /sys/block/zram0/reset 2>/dev/null; true'\n\n"
        "[Install]\nWantedBy=multi-user.target\n")

    changed |= _write_if_changed(
        "/etc/systemd/system.conf.d/10-thinclient-watchdog.conf",
        "# ThinClient: hardware watchdog auto-reboots a fully-hung box (~1 min).\n"
        "[Manager]\nRuntimeWatchdogSec=60\nRebootWatchdogSec=3min\n")

    changed |= _write_if_changed(
        "/etc/systemd/journald.conf.d/10-thinclient.conf",
        "# ThinClient: keep the journal on disk so a hang's cause survives a reboot.\n"
        "[Journal]\nStorage=persistent\nSystemMaxUse=200M\nRuntimeMaxUse=64M\n")

    changed |= _write_if_changed(
        "/etc/modprobe.d/thinclient-usb-noautosuspend.conf",
        "# ThinClient: never autosuspend USB on an always-on kiosk (a USB headset can\n"
        "# otherwise power-cycle mid-call). Covers audio + all USB.\n"
        "options usbcore autosuspend=-1\n")

    # ---- apply what we can NOW (RT limits arrive on the next session; the hardware
    #      watchdog fully arms on a reboot) ----
    try: os.makedirs("/var/log/journal", exist_ok=True)
    except OSError: pass
    try:
        p = "/sys/module/usbcore/parameters/autosuspend"
        if os.path.exists(p):
            open(p, "w").write("-1")               # global USB autosuspend off, live
    except OSError: pass
    for base in glob.glob("/sys/bus/usb/devices/*"):
        pc = os.path.join(base, "power", "control")
        try:
            if os.path.exists(pc):
                open(pc, "w").write("on")
        except OSError: pass
    for mod in ("iTCO_wdt", "sp5100_tco"):         # surface /dev/watchdog if absent
        try: subprocess.run(["modprobe", mod], capture_output=True, timeout=8)
        except Exception: pass
    try:
        subprocess.run(["systemctl", "restart", "systemd-journald"], capture_output=True, timeout=15)
        subprocess.run(["systemctl", "enable", "--now", "thinclient-zram.service"], capture_output=True, timeout=25)
        if changed:
            subprocess.run(["systemctl", "daemon-reload"], capture_output=True, timeout=15)
            # daemon-reexec re-reads system.conf so the hardware watchdog arms without
            # waiting for a full power-reboot (safe: systemd re-execs PID 1 in place).
            subprocess.run(["systemctl", "daemon-reexec"], capture_output=True, timeout=20)
    except Exception:
        pass
    if changed:
        print("agent: call-stability hardening applied (RT audio + zram + watchdog + persistent journal + USB no-autosuspend)", file=sys.stderr)


# --- PERMANENT freeze fix: PCM-only FreeRDP (no FFmpeg audio DSP) ---------------
# The call freeze is a FreeRDP bug — it feeds NaN mic samples into an AAC encoder
# that then spins holding the PulseAudio lock. This build has NO AAC encoder at all
# (WITH_DSP_FFMPEG=OFF), so the mic uses PCM and the deadlock CANNOT occur. It's a
# self-contained install under /opt/freerdp-pcm; thinclient-connect's rdp_bin() picks
# it up automatically. Reversible: RDP_PCM=0 (falls back to the system client).
PCM_FREERDP_URL = "https://github.com/faizakram/thin-client-os-for-window-rdp/releases/download/freerdp-pcm-3.15.0-2/freerdp-pcm.tar.gz"
PCM_FREERDP_SHA = "d341816b88f0d26cba47a93e705870932153b7532345ef53adc1d1690a72e5e6"
PCM_FREERDP_VER = "3.15.0-pcm2"    # production build (no verbose asserts -> fast, no restart/blank)


def _ensure_pcm_freerdp():
    if conf_get("RDP_PCM", "1").lower() in ("0", "false", "no", "off"):
        return
    marker = "/opt/freerdp-pcm/PCM_VERSION"
    try:
        if open(marker).read().strip() == PCM_FREERDP_VER:
            return                                  # already installed
    except OSError:
        pass
    tmp = "/tmp/freerdp-pcm.tar.gz"
    try:
        subprocess.run(["curl", "-fsSL", "--connect-timeout", "20", "-o", tmp, PCM_FREERDP_URL],
                       check=True, timeout=300)
        h = hashlib.sha256(open(tmp, "rb").read()).hexdigest()
        if h != PCM_FREERDP_SHA:
            print("agent: pcm-freerdp sha mismatch (%s) -> refusing" % h[:12], file=sys.stderr)
            return
        subprocess.run(["tar", "xzf", tmp, "-C", "/opt"], check=True, timeout=120)  # -> /opt/freerdp-pcm
        with open(marker, "w") as f:
            f.write(PCM_FREERDP_VER)
        try:
            os.unlink(tmp)
        except OSError:
            pass
        print("agent: installed PCM-only FreeRDP %s -> /opt/freerdp-pcm (no AAC = no freeze)"
              % PCM_FREERDP_VER, file=sys.stderr)
    except Exception as e:
        print("agent: pcm-freerdp install failed: %s" % e, file=sys.stderr)


def cmd_daemon() -> int:
    """Long-running loop (systemd service). Polls for commands + pushes frames
    every few seconds; rotates + enforces the licence every few hours. Idles
    quietly when the control plane isn't configured yet."""
    interval = int(conf_get("AGENT_POLL_SECONDS", "5") or 5)
    enforce_every = int(conf_get("AGENT_ENFORCE_SECONDS", "21600") or 21600)  # 6h
    last_enforce = 0.0
    # FIRST, before anything can observe a new state: recover what the previous run was
    # in the middle of. A session that was up when this machine went down ended then,
    # and this is the only chance to say so.
    _restore_activity_state()
    # Background internet-speed prober (measures a real download speed only while
    # streaming; the poll reports its last reading as net_kbps).
    threading.Thread(target=_speed_loop, daemon=True).start()
    # Best-effort: make sure the chat launcher can draw its shaped round bubble.
    threading.Thread(target=_ensure_chat_deps, daemon=True).start()
    # Best-effort: stop USB Wi-Fi dongles power-cycling (drops Wi-Fi + kills RDP).
    threading.Thread(target=_ensure_wifi_stable, daemon=True).start()
    # Same treatment for webcams: a desk appliance on mains power has nothing to gain
    # from USB power saving and a camera to lose. Runs in a thread because it touches
    # sysfs and udev and must never delay the agent coming up.
    threading.Thread(target=_ensure_camera_stable, daemon=True).start()
    # Self-heal a 'link up but no internet' machine (fresh DHCP) so no manual reboot.
    threading.Thread(target=_net_selfheal_loop, daemon=True).start()
    # Best-effort: harden against a call in the RDP session hanging the whole box
    # (RT audio, zram OOM cushion, hardware watchdog, persistent journal, USB power).
    threading.Thread(target=_ensure_call_stability, daemon=True).start()
    # Recover a FROZEN RDP session automatically: if FreeRDP hangs (screen stuck)
    # while the OS stays alive, reset it + reconnect instead of needing a power-cycle.
    threading.Thread(target=_session_freeze_watchdog, daemon=True).start()
    # PERMANENT freeze fix: install the PCM-only FreeRDP (no AAC mic encoder). Once
    # present, thinclient-connect uses it and the mic-AAC deadlock can't happen.
    threading.Thread(target=_ensure_pcm_freerdp, daemon=True).start()
    # Ensure the shared signal dir exists + is writable by the kiosk user (the
    # RDP + lock scripts drop their signal files here). tmpfiles.d also creates it
    # at boot; this is a belt-and-suspenders in case the agent starts first.
    try:
        os.makedirs(RUN_DIR, exist_ok=True); os.chmod(RUN_DIR, 0o1777)
    except OSError:
        pass
    _purge_disk_credentials()   # the Windows password is never kept on disk
    _harden_session()   # no login terminal + always recover the desktop
    # No SSH / debug console / debug login, whatever image this device came from.
    threading.Thread(target=_enforce_no_debug_access, daemon=True).start()
    try:
        apply_hostname()      # the image's default hostname is not used any more
    except Exception as e:
        print("agent: hostname update skipped: %s" % e, file=sys.stderr)
    # What this device's hardware can do for security, reported to the manager.
    threading.Thread(target=_refresh_hardware_facts, daemon=True).start()
    while True:
        now = time.time()
        if now - last_enforce >= enforce_every:
            try:
                cmd_enforce()
            except Exception as e:
                print("agent enforce: %s" % e, file=sys.stderr)
            last_enforce = now
        try:
            cmd_poll()
        except Exception as e:
            print("agent poll: %s" % e, file=sys.stderr)
        # Adaptive cadence: tight ONLY while a viewer has the stream on, OR while a
        # chat is active (panel open / recent message) so support chat feels near
        # real-time; otherwise idle at the normal interval (low CPU/network).
        if _STREAM_ACTIVE:
            time.sleep(max(1, int(conf_get("AGENT_STREAM_SECONDS", "2") or 2)))
        elif _chat_active():
            time.sleep(max(1, int(conf_get("AGENT_CHAT_SECONDS", "2") or 2)))
        else:
            time.sleep(max(2, interval))


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "enforce"
    if cmd == "enforce":
        return cmd_enforce()
    if cmd == "poll":
        return cmd_poll()
    if cmd == "daemon":
        return cmd_daemon()
    if cmd == "state":
        return cmd_state()
    if cmd == "verify":
        return cmd_verify(sys.argv[2:])
    print("usage: thinclient-agent [enforce|poll|daemon|state|verify ...]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
