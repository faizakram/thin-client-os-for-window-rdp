#!/bin/sh
# =============================================================================
#  ThinClient OS — Image customization hook (runs INSIDE the chroot)
#  Copied by build.sh to config/hooks/live/0100-thinclient-setup.hook.chroot
#
#  Turns a plain Debian rootfs into the locked-down RDP appliance:
#    user + groups, services, security lockdown, plymouth, boot marker.
#  Idempotent where it can be; failures are fatal (set -e) so a broken image
#  never ships silently.
# =============================================================================
set -e
echo "I: [thinclient] applying appliance customization"

# ---------------------------------------------------------------------------
# 1. The single locked-down kiosk user (uid/gid 1000), no interactive login.
# ---------------------------------------------------------------------------
if ! getent group thinclient >/dev/null; then
  groupadd -g 1000 thinclient
fi
if ! id thinclient >/dev/null 2>&1; then
  useradd -m -u 1000 -g 1000 -s /bin/bash -c "Thin Client" thinclient
fi
# LightDM execs the session through the user's shell, so it must be real (bash),
# not nologin. The account stays safe: password is locked, no console getty, and
# the kiosk session exposes no terminal.
usermod -s /bin/bash thinclient || true
# Hardware access for audio/video/input/USB/network — but NOT sudo/adm.
for g in audio video render input plugdev netdev; do
  getent group "$g" >/dev/null 2>&1 && usermod -aG "$g" thinclient || true
done
# No password can ever log this account in interactively.
passwd -l thinclient || true

# ---------------------------------------------------------------------------
# 2. Disable root + guest login entirely.
# ---------------------------------------------------------------------------
passwd -l root || true
usermod -s /usr/sbin/nologin root || true

# ---------------------------------------------------------------------------
# 3. Boot straight to the graphical (kiosk) target; enable our services.
# ---------------------------------------------------------------------------
systemctl set-default graphical.target
systemctl enable thinclient-firstboot.service
systemctl enable thinclient-watchdog.service
systemctl enable NetworkManager.service || true
# OTA auto-update: the timer wakes 2min after boot then every 6h. It is a no-op
# unless UPDATE_ENABLED=true in server.conf, so shipping it enabled is safe.
# NetworkManager-wait-online makes network-online.target meaningful so the
# updater only fires once the box is actually online.
systemctl enable thinclient-update.timer 2>/dev/null || true
systemctl enable NetworkManager-wait-online.service 2>/dev/null || true
# Management agent (licence enforcement + remote commands + screen stream). Idles
# quietly until the device is enrolled in /etc/thinclient/license.conf.
systemctl enable thinclient-agent.service 2>/dev/null || true
# Device activation from a USB stick (imports thinclient-activate.conf on boot;
# udev also triggers it on hot-plug).
systemctl enable thinclient-provision.service 2>/dev/null || true

# Convert /opt/thinclient (a real dir) into /opt/thinclient-releases/<ver> plus a
# symlink, so the updater can swap releases with an atomic `mv -T`. Every path
# that points at /opt/thinclient/... keeps working transparently through the link.
if [ -d /opt/thinclient ] && [ ! -L /opt/thinclient ]; then
  _tcver="$(cat /opt/thinclient/VERSION 2>/dev/null || echo 1.0.0)"
  mkdir -p /opt/thinclient-releases
  rm -rf "/opt/thinclient-releases/${_tcver}"
  mv /opt/thinclient "/opt/thinclient-releases/${_tcver}"
  ln -sfn "/opt/thinclient-releases/${_tcver}" /opt/thinclient
fi
# Enable the PipeWire audio stack for every user session so RDP sound + mic
# redirection has a running PulseAudio-compatible server.
systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null || true
# The hand-rolled xinit service is replaced by LightDM (configured below).
systemctl disable thinclient-x.service 2>/dev/null || true

# --- LightDM autologin -> the kiosk RDP session ------------------------------
mkdir -p /etc/lightdm/lightdm.conf.d
cat >/etc/lightdm/lightdm.conf.d/50-thinclient.conf <<'EOF'
[Seat:*]
autologin-user=thinclient
autologin-user-timeout=0
autologin-session=thinclient
user-session=thinclient
# Skip any greeter; go straight to the session.
greeter-hide-users=true
allow-guest=false
EOF
# The session LightDM launches for the kiosk user.
mkdir -p /usr/share/xsessions
cat >/usr/share/xsessions/thinclient.desktop <<'EOF'
[Desktop Entry]
Name=Thin Client
Comment=Thin Client RDP appliance
Exec=/opt/thinclient/bin/thinclient-xsession
Type=Application
DesktopNames=ThinClient
EOF
# Passwordless autologin groups (Debian LightDM checks these).
groupadd -f autologin || true
groupadd -f nopasswdlogin || true
usermod -aG autologin,nopasswdlogin thinclient || true
# Make LightDM the boot display manager.
echo "/usr/sbin/lightdm" >/etc/X11/default-display-manager 2>/dev/null || true
systemctl enable lightdm.service 2>/dev/null || true
systemctl set-default graphical.target

# ---------------------------------------------------------------------------
# 4. No console login prompts anywhere (mask every getty).
# ---------------------------------------------------------------------------
for i in 1 2 3 4 5 6 7 8; do
  systemctl mask "getty@tty${i}.service" || true
  systemctl mask "autovt@tty${i}.service" || true
done
systemctl mask serial-getty@ttyS0.service || true
systemctl mask console-getty.service || true
systemctl mask getty-static.service || true
# HARD-VERIFY the graphical-VT masks actually took. A SILENT mask failure on
# tty7 is exactly what stranded 1.0.15 devices on "esparksit login:" after X
# released VT7 (logind's ReserveVT=7 then span up autovt@tty7 there). A mask is a
# symlink to /dev/null; check the filesystem directly (robust in a chroot where a
# running systemd isn't present). Fail the BUILD rather than ship an ISO that can
# fall through to a console login.
for u in getty@tty7.service autovt@tty7.service; do
  tgt="$(readlink -f "/etc/systemd/system/$u" 2>/dev/null || true)"
  [ "$tgt" = "/dev/null" ] || { echo "FATAL: $u is not masked (symlink -> '$tgt', expected /dev/null) — refusing to build a console-reachable kiosk" >&2; exit 1; }
done
# The graphical session runs on VT7. If X ever dies (e.g. a GPU/driver crash) a
# kiosk must NEVER fall through to a login prompt there — masking getty/autovt on
# tty7 (above) prevents that, and this drop-in makes lightdm always restart so the
# desktop comes straight back instead of a console.
mkdir -p /etc/systemd/system/lightdm.service.d
cat >/etc/systemd/system/lightdm.service.d/10-thinclient-restart.conf <<'EOF'
[Unit]
StartLimitIntervalSec=0
[Service]
Restart=always
RestartSec=1
EOF
# Prevent logind from spawning gettys on VT switch and cap the VTs.
# CRITICAL: ReserveVT must NOT be 7. VT7 is where X/lightdm runs; a ReserveVT=7
# tells logind to keep a login getty on X's OWN VT, so the instant X releases it
# logind pounces with "esparksit login:" there (the 1.0.15 bug). Point the reserve
# at VT6 (masked, and X never uses it) so logind never eyes the graphical VT.
mkdir -p /etc/systemd/logind.conf.d
cat >/etc/systemd/logind.conf.d/10-thinclient.conf <<'EOF'
[Login]
NAutoVTs=1
ReserveVT=6
KillUserProcesses=no
HandlePowerKey=poweroff
HandleLidSwitch=ignore
EOF

# ---------------------------------------------------------------------------
# 5. Ensure our scripts are executable and secrets are locked down.
# ---------------------------------------------------------------------------
chmod 0755 /opt/thinclient/bin/* 2>/dev/null || true
chmod 0644 /opt/thinclient/lib/* 2>/dev/null || true
chmod 0440 /etc/sudoers.d/thinclient 2>/dev/null || true
chown root:root /etc/sudoers.d/thinclient 2>/dev/null || true
if [ -f /etc/thinclient/admin.conf ]; then
  chown root:root /etc/thinclient/admin.conf; chmod 0600 /etc/thinclient/admin.conf
fi
if [ -f /etc/thinclient/server.conf ]; then
  chown root:thinclient /etc/thinclient/server.conf; chmod 0644 /etc/thinclient/server.conf
fi
# Validate the sudoers drop-in; abort the build if it is malformed.
visudo -cf /etc/sudoers.d/thinclient

# ---------------------------------------------------------------------------
# 6. Log directory + rotation targets.
# ---------------------------------------------------------------------------
mkdir -p /var/log/thinclient
for f in boot rdp watchdog network install thinclient; do
  : >"/var/log/thinclient/${f}.log"
done
chown -R root:thinclient /var/log/thinclient
chmod 0775 /var/log/thinclient

# ---------------------------------------------------------------------------
# 7. Security hardening — remove attack surface / avoid pulling a desktop.
# ---------------------------------------------------------------------------
# === Debug SSH — ONLY when built with TC_DEBUG_SSH=1. OFF for production. =====
# Debug creds (esparks/esparks, root/esparks-debug) exist only in debug images.
if [ "$(sed -n 's/^DEBUG_SSH=//p' /etc/thinclient/.build-flags 2>/dev/null)" = "1" ]; then
  echo "[hook] DEBUG_SSH=1 — enabling debug SSH access"
  systemctl enable ssh.service 2>/dev/null || true
  mkdir -p /etc/ssh/sshd_config.d
  cat >/etc/ssh/sshd_config.d/99-esparks-debug.conf <<'EOF'
PasswordAuthentication yes
PermitRootLogin yes
EOF
  echo 'root:esparks-debug' | chpasswd 2>/dev/null || true
  usermod -s /bin/bash root 2>/dev/null || true   # DEBUG: allow root shell/SSH
else
  # production: no remote login, root stays nologin (set above)
  systemctl disable ssh.service 2>/dev/null || true
  rm -f /etc/ssh/sshd_config.d/99-esparks-debug.conf 2>/dev/null || true
fi
# Kill magic SysRq (prevents console kill combos on an exposed keyboard).
mkdir -p /etc/sysctl.d
cat >/etc/sysctl.d/99-thinclient.conf <<'EOF'
kernel.sysrq = 0
kernel.dmesg_restrict = 1
EOF
# Brand the console banner (Thin Client) instead of the Debian default.
cat >/etc/issue <<'EOF'
Thin Client  \n \l

EOF
cp -f /etc/issue /etc/issue.net 2>/dev/null || true
: >/etc/motd || true

# ---------------------------------------------------------------------------
# 8. NetworkManager owns all interfaces; wired auto-connects.
# ---------------------------------------------------------------------------
mkdir -p /etc/NetworkManager/conf.d
cat >/etc/NetworkManager/conf.d/10-thinclient.conf <<'EOF'
[main]
plugins=keyfile
[device]
wifi.scan-rand-mac-address=no
[connection]
ipv6.ip6-privacy=0
EOF
# Ensure NM is not held back by systemd-networkd.
systemctl disable systemd-networkd.service 2>/dev/null || true

# ---------------------------------------------------------------------------
# 9. Xorg wrapper already installed via includes; make sure legacy wrapper set.
# ---------------------------------------------------------------------------
# (Xwrapper.config shipped in includes.chroot -> /etc/X11/Xwrapper.config)

# ---------------------------------------------------------------------------
# 10. Plymouth: use our theme and rebuild the initramfs so it applies at boot.
# ---------------------------------------------------------------------------
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme thinclient || true
fi
update-initramfs -u || true

# ---------------------------------------------------------------------------
# 11. Branding (Thin Client) + hostname + locale + timezone.
# ---------------------------------------------------------------------------
echo "esparksit" >/etc/hostname
cat >/etc/hosts <<'EOF'
127.0.0.1   localhost esparksit
::1         localhost ip6-localhost ip6-loopback
EOF
# Replace the Debian display name on any surface that shows it (keep ID=debian
# so apt and tooling keep working).
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Thin Client"/' /etc/os-release 2>/dev/null || true
sed -i 's/^NAME=.*/NAME="Thin Client"/' /etc/os-release 2>/dev/null || true
sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null || true
locale-gen 2>/dev/null || true
ln -sf /usr/share/zoneinfo/UTC /etc/localtime || true

# ---------------------------------------------------------------------------
# 12. Render the branded "Connecting" splash PNG if tooling is available.
# ---------------------------------------------------------------------------
if [ -f /opt/thinclient/assets/connecting.svg ]; then
  if command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert -w 1920 -h 1080 /opt/thinclient/assets/connecting.svg \
      -o /opt/thinclient/assets/connecting.png || true
  elif command -v convert >/dev/null 2>&1; then
    convert -background "#0b1220" /opt/thinclient/assets/connecting.svg \
      /opt/thinclient/assets/connecting.png || true
  fi
fi

# ---------------------------------------------------------------------------
# 12b. Rescue diagnostic — if the graphical session fails to start, show the
#      reason on tty1 so it can be photographed. No login required.
# ---------------------------------------------------------------------------
# NOTE: the rescue diagnostic lives OUTSIDE /opt/thinclient on purpose. That dir
# is atomically swapped by OTA updates; the recovery path must survive a bad
# update (and never be dropped by a bundle that doesn't ship it), so it goes to
# /usr/local/sbin, which the updater never touches.
cat >/usr/local/sbin/thinclient-rescue <<'RESC'
#!/bin/sh
# Wait for the kiosk to ACTUALLY come up (FreeRDP running or fresh heartbeat).
# Checking FreeRDP (not just Xorg) means we also catch an X crash-loop/flicker,
# where Xorg is present intermittently but the session never stabilises.
i=0
while [ "$i" -lt 115 ]; do
  # Healthy = X server up (match 'Xorg' OR '/usr/bin/X') AND the connection
  # window (or an RDP session) running. Widened window so a slow GPU init on a
  # cold boot does not trip the diagnostic before the session settles.
  x_up=0
  pgrep -f '[/ ]Xorg' >/dev/null 2>&1 && x_up=1
  pgrep -x X >/dev/null 2>&1 && x_up=1
  if [ "$x_up" = 1 ] && \
     { pgrep -f 'thinclient-connect' >/dev/null 2>&1 || \
       pgrep -f 'thinclient-lock' >/dev/null 2>&1 || \
       pgrep -x xfreerdp3 >/dev/null 2>&1 || pgrep -x xfreerdp >/dev/null 2>&1; }; then
    exit 0
  fi
  # SELF-HEAL (not the give-up path): if a login getty has grabbed the graphical
  # VT (tty7), THAT is why the desktop can't paint. Re-mask + kill it and kick
  # lightdm so the session reclaims the screen. Only if this never succeeds do we
  # fall through to the permanent diagnostic below.
  if pgrep -f 'agetty.*tty7' >/dev/null 2>&1; then
    systemctl mask getty@tty7.service autovt@tty7.service 2>/dev/null || true
    pkill -9 -f 'agetty.*tty7' 2>/dev/null || true
    systemctl restart lightdm 2>/dev/null || true
  fi
  sleep 3; i=$((i + 3))
done
# Kiosk never came up. Stop the display manager so the screen stops flickering,
# then show the real reason on tty1.
systemctl stop lightdm 2>/dev/null || true
sleep 2
chvt 1 2>/dev/null || true
{
  echo "==================================================================="
  echo " Thin Client - DIAGNOSTIC: the display session failed to start"
  echo " >>> PHOTOGRAPH THIS SCREEN and send it to support. <<<"
  echo " Host: $(hostname)   $(date)"
  echo "==================================================================="
  echo "----- GPU -----"
  lspci 2>/dev/null | grep -iE 'vga|display|3d'
  echo "----- kernel amdgpu / drm / firmware messages -----"
  dmesg 2>/dev/null | grep -iE 'amdgpu|drm|firmware' | tail -15
  echo "----- Xorg errors -----"
  grep -E '\(EE\)|no screens|Fatal|Cannot|failed|ABI|module' \
       /var/log/lightdm/x-0.log /var/log/Xorg.0.log 2>/dev/null | tail -25
  echo "----- session errors (.xsession-errors) -----"
  tail -20 /home/thinclient/.xsession-errors 2>/dev/null
  echo "----- lightdm journal -----"
  journalctl -b -u lightdm --no-pager 2>/dev/null | tail -20
  echo "----- Xorg log tail -----"
  tail -20 /var/log/lightdm/x-0.log /var/log/Xorg.0.log 2>/dev/null
  echo "==================================================================="
  echo " Backup: press Ctrl+Alt+F2, login  esparks / esparks , then run: getlogs"
  echo "==================================================================="
} >/dev/tty1 2>&1
sleep 100000   # hold the diagnostic on screen
RESC
chmod 0755 /usr/local/sbin/thinclient-rescue
cat >/etc/systemd/system/thinclient-rescue.service <<'EOF'
[Unit]
Description=Thin client rescue diagnostic
After=lightdm.service
[Service]
Type=simple
ExecStart=/usr/local/sbin/thinclient-rescue
[Install]
WantedBy=graphical.target
EOF
systemctl enable thinclient-rescue.service 2>/dev/null || true

# --- Debug console on tty2 — ONLY when built with TC_DEBUG_SSH=1 -------------
if [ "$(sed -n 's/^DEBUG_SSH=//p' /etc/thinclient/.build-flags 2>/dev/null)" = "1" ]; then
  if ! id esparks >/dev/null 2>&1; then
    useradd -m -u 1002 -s /bin/bash -c "Esparks Debug" esparks
  fi
  echo 'esparks:esparks' | chpasswd
  usermod -aG sudo esparks || true
  cat >/usr/local/bin/getlogs <<'GL'
#!/bin/sh
sudo sh -c '
  echo "===== GPU =====";            lspci | grep -iE "vga|display|3d"
  echo "===== amdgpu/drm dmesg ====="; dmesg | grep -iE "amdgpu|drm|firmware" | tail -20
  echo "===== Xorg errors =====";     grep -E "\(EE\)|no screens|Fatal|Cannot|failed" /var/log/lightdm/x-0.log /var/log/Xorg.0.log 2>/dev/null | tail -30
  echo "===== .xsession-errors ====="; tail -25 /home/thinclient/.xsession-errors 2>/dev/null
  echo "===== lightdm journal =====";  journalctl -b -u lightdm --no-pager | tail -25
'
GL
  chmod 0755 /usr/local/bin/getlogs
  systemctl unmask getty@tty2.service 2>/dev/null || true
  systemctl enable getty@tty2.service 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 13. Build marker for diagnostics.
# ---------------------------------------------------------------------------
mkdir -p /etc/thinclient
{
  echo "product=Thin Client — Thin Client"
  echo "vendor=Thin Client"
  echo "base=Debian $(cat /etc/debian_version 2>/dev/null || echo 13)"
  echo "built_by=live-build"
} >/etc/thinclient/build-info

echo "I: [thinclient] customization complete"
