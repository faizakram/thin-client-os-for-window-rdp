# --- Tools required by the disk installer + diagnostics ----------------------
parted
gdisk
dosfstools
e2fsprogs
rsync
squashfs-tools
grub2-common
grub-common
efibootmgr
pciutils
lshw
htop
# Bootloader binaries are architecture-specific.
#if ARCHITECTURES amd64 i386
grub-efi-amd64-bin
grub-pc-bin
# Secure Boot: signed shim + signed GRUB so the USB boots on PCs that have
# Secure Boot ENABLED (no BIOS changes needed). live-build wires the signed
# shim into the ESP automatically when these are present.
shim-signed
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
grub-efi-arm64-bin
#endif
