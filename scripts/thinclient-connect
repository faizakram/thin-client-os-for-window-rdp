RDP_ERR_LOG = "/run/thinclient/rdp-errors.log"   # world-writable /run; pulled by GETLOGS


def _net_state():
    """NetworkManager connectivity: full | limited | portal | none | unknown."""
    try:
        r = subprocess.run(["nmcli", "networking", "connectivity", "check"],
                           capture_output=True, text=True, timeout=5)
        return (r.stdout or "").strip().lower()
    except Exception:
        return "unknown"


def _friendly_rdp_error(rc, detail):
    """Turn FreeRDP's technical failure into ONE plain-language line for a non-
    technical operator. The full technical detail is logged separately (pullable
    by an admin via GETLOGS) — the user never sees the jargon."""
    d = (detail or "").lower()
    if any(k in d for k in ("logon_failure", "0x20009", "authentication", "access is denied",
                            "account", "credential", "password", "err_authentication", "0x2000e")):
        return "The username or password looks incorrect.\nPlease check them and try again."
    if any(k in d for k in ("dns", "name_not_found", "0x2000c", "could not resolve", "no such host")):
        return "The server address couldn’t be found.\nPlease check the connection details with your admin."
    if _net_state() == "none":
        return "No internet connection.\nPlease check your Wi‑Fi or network cable, then try again."
    return "Couldn’t reach the remote computer.\nIt may be turned off or busy — please try again in a moment."


def _log_rdp_error(host, port, user, rc, detail):
    """Append the FULL technical detail to a log an admin can pull (GETLOGS →
    tc-... bundle). Best-effort; never blocks the operator."""
    try:
        os.makedirs("/run/thinclient", exist_ok=True)
        with open(RDP_ERR_LOG, "a") as f:
            f.write("\n===== %s  connect FAILED  %s:%s user=%s exit=%s =====\n%s\n"
                    % (time.strftime("%Y-%m-%d %H:%M:%S"), host, port, user, rc, (detail or "").strip()))
    except OSError:
        pass


def _tcp_ok(host, port, timeout=2.5):
    import socket
    try:
        socket.create_connection((host, int(port)), timeout=timeout).close()
        return True
    except Exception:
        return False


def _internet_up(timeout=2.5):
    """True if the internet is reachable. Probes robust anycast endpoints built for
    huge query volumes (never the customer's RDP server, where repeated probes
    could trip its firewall / spam its logs)."""
    return _tcp_ok("1.1.1.1", 443, timeout) or _tcp_ok("8.8.8.8", 53, timeout)


def _link_dead(host, port):
    """The RDP link is effectively dead when the internet is unreachable AND the RDP
    server itself can't be reached. Checking BOTH avoids a false alarm on a network
    that blocks public probe hosts but where the RDP path is actually fine — and it
    only touches the RDP server on the rare occasion the internet already looks
    down, so healthy sessions never hammer it."""
    if _internet_up():
        return False
    return not _tcp_ok(host, int(port or 3389))


class Connect(Gtk.Window):
    def __init__(self):
        super().__init__(title="Thin Client — Remote Desktop")
        self.rdp = rdp_bin()
        self.scr_w, self.scr_h = screen_size()
        # Center + MAXIMIZE (not fullscreen) BEFORE mapping so the window never
        # flashes at the top-left corner for a frame. Deliberately maximized, NOT
        # GTK-fullscreen: under this kiosk's openbox a fullscreen window sits in a
        # stacking layer ABOVE the "keep-above" layer, which buried the always-on
        # support-chat bubble behind the home screen. A maximized window fills the
        # screen identically but stays in the normal layer, so the floating bubble
        # (and any dialog) rides above it. (FreeRDP's /f is unaffected.)
        self.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
        self.maximize()
        self.set_default_size(560, 460)

        prov = Gtk.CssProvider(); prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(outer)
        # Top bar: a right-aligned date + 12-hour clock in the device's configured
        # timezone (the same one the lock screen shows). Fills the home screen; the
        # remote Windows shows its own taskbar clock during the RDP session.
        topbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        topbar.set_margin_top(14); topbar.set_margin_start(20); topbar.set_margin_end(24)
        clockbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        clockbox.set_halign(Gtk.Align.END); clockbox.set_hexpand(True)
        self.clock = Gtk.Label(); self.clock.get_style_context().add_class("clock"); self.clock.set_xalign(1)
        self.clockdate = Gtk.Label(); self.clockdate.get_style_context().add_class("clockdate"); self.clockdate.set_xalign(1)
        clockbox.pack_start(self.clock, False, False, 0)
        clockbox.pack_start(self.clockdate, False, False, 0)
        topbar.pack_start(clockbox, True, True, 0)
        outer.pack_start(topbar, False, False, 0)
        self._clock_tick()
        GLib.timeout_add_seconds(1, self._clock_tick)
        # Center a fixed-width card.
        center = Gtk.Alignment(xalign=0.5, yalign=0.5, xscale=0, yscale=0)
        outer.pack_start(center, True, True, 0)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=11)
        card.get_style_context().add_class("card")
        center.add(card)

        title = Gtk.Label(label="Thin Client"); title.get_style_context().add_class("title")
        title.set_xalign(0)
        sub = Gtk.Label(label="Connect to Remote Desktop  ·  Display %d×%d" % (self.scr_w, self.scr_h))
        sub.get_style_context().add_class("subtitle")
        sub.set_xalign(0)
        card.pack_start(title, False, False, 0)
        card.pack_start(sub, False, False, 0)

        # Prominent RED banner at the TOP when the device is admin-locked (replaces
        # the old inline hijack of the network label). Hidden unless locked.
        self.lock_banner = Gtk.Label(); self.lock_banner.set_xalign(0); self.lock_banner.set_line_wrap(True)
        self.lock_banner.get_style_context().add_class("lockbanner")
        self.lock_banner.set_no_show_all(True)   # stays hidden until refresh_lan shows it
        card.pack_start(self.lock_banner, False, False, 0)

        # Compact single-column body: one narrow card, no wasted horizontal space.
        # The pieces below are BUILT here but packed in a deliberate order at the end
        # of the layout — credential status + the big Connect button on top, then the
        # live status and the local controls beneath.
        card.set_size_request(500, -1)

        # --- Network status bar (LAN dot + Wi-Fi button) ---
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bar.get_style_context().add_class("statusbar")
        self.dot = Gtk.Label(label="●")
        self.lan_lbl = Gtk.Label(label="Checking network…"); self.lan_lbl.set_xalign(0)
        wifi_btn = Gtk.Button(label="Wi-Fi…"); wifi_btn.get_style_context().add_class("wifi")
        wifi_btn.connect("clicked", self.on_wifi)
        bar.pack_start(self.dot, False, False, 0)
        bar.pack_start(self.lan_lbl, True, True, 0)
        # Live internet indicator (speed + latency), color-coded like the manager.
        # Value comes from the agent via /run/thinclient/net-speed.
        self.net_lbl = Gtk.Label(label=""); self.net_lbl.set_use_markup(True)
        bar.pack_end(wifi_btn, False, False, 0)
        bar.pack_end(self.net_lbl, False, False, 8)
        self._net_bar = bar   # packed later, in the final single-column order

        # --- Volume + brightness sliders, side by side on ONE compact row. Each is
        # icon + [−] + slider + [+]; the [−]/[+] keep them usable even when narrow.
        # Volume drives the local PipeWire sink (wpctl) that RDP audio plays through;
        # brightness uses the hardware backlight if present, else an xrandr soft dim. ---
        vrow, self.vol_scale = self._make_slider_row(
            "audio-volume-high-symbolic", self._set_volume, self._get_volume())
        brow, self.bri_scale = self._make_slider_row(
            "display-brightness-symbolic", self._set_brightness, self._get_brightness())
        sliders = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        sliders.pack_start(vrow, True, True, 0)
        sliders.pack_start(brow, True, True, 0)
        self._sliders = sliders   # packed later, in the final single-column order

        # --- Device status (READ-ONLY): camera + microphone availability. The
        # user can see they're enabled for monitoring but cannot turn them off. ---
        dbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        dbar.get_style_context().add_class("statusbar")
        self.cam_dot = Gtk.Label(label="●")
        self.cam_lbl = Gtk.Label(label="Camera"); self.cam_lbl.set_xalign(0)
        self.mic_dot = Gtk.Label(label="●")
        self.mic_lbl = Gtk.Label(label="Microphone"); self.mic_lbl.set_xalign(0)
        dbar.pack_start(self.cam_dot, False, False, 0)
        dbar.pack_start(self.cam_lbl, False, False, 0)
        dbar.pack_start(Gtk.Label(label="      "), False, False, 0)
        dbar.pack_start(self.mic_dot, False, False, 0)
        dbar.pack_start(self.mic_lbl, False, False, 0)
        self._dbar = dbar   # packed later, in the final single-column order

        # --- Form fields ---
        grid = Gtk.Grid(row_spacing=8, column_spacing=10)
        def row(r, text, widget):
            lbl = Gtk.Label(label=text); lbl.set_xalign(0)
            grid.attach(lbl, 0, r, 1, 1); grid.attach(widget, 1, r, 1, 1)
            widget.set_hexpand(True)
        # PRECEDENCE: a server-managed profile (pushed from the manager) wins over
        # the local saved profile, which in turn wins over the admin config.
        #  - managed mode: pre-fill the server IP + username; the managed password
        #    is held in self._managed ONLY (never placed in the Entry, so it can't
        #    be revealed or copied) and used at connect time if the operator leaves
        #    the field blank. The operator may override for one session.
        #  - local mode: the "enter once, remembered after" behaviour.
        self._managed = managed_rdp()   # {host,user,pw} or None
        m = self._managed
        # The server IP + username are admin-set and hidden from the operator: the
        # REAL values are kept here (and used to connect), while the fields only show
        # a masked, read-only version (IP: last octet only; username: fully starred).
        self._real_host = (m["host"] if m else (profile_get("SERVER_IP") or conf_get("SERVER_IP"))) or ""
        self._real_user = (m["user"] if m else (profile_get("USERNAME") or conf_get("USERNAME"))) or ""
        self.e_server = Gtk.Entry(text=(_mask_ip(self._real_host) if self._real_host else ""))
        self.e_port   = Gtk.Entry(text=profile_get("PORT") or conf_get("PORT", "3389")); self.e_port.set_width_chars(6)
        self.e_user   = Gtk.Entry(text=(_mask_user(self._real_user) if self._real_user else ""))
        # With a value configured, lock the field (no edit, no focus) so the operator
        # can neither read nor change it. Blank (first-time setup) stays editable.
        if self._real_host:
            self.e_server.set_editable(False); self.e_server.set_can_focus(False)
        if self._real_user:
            self.e_user.set_editable(False); self.e_user.set_can_focus(False)
        # In managed mode the field stays EMPTY (the managed password is never put
        # in a widget); a placeholder tells the operator they can just connect.
        self.e_pass   = Gtk.Entry(text=("" if m else saved_password()))
        self.e_pass.set_visibility(False)
        if m:
            self.e_pass.set_placeholder_text("•••••••• managed — leave blank to use, or type to override")
        # Standard show/hide-password "eye" toggle on the password field. (It only
        # ever reveals what's IN the field — never the managed password, which
        # isn't there — so a managed credential can't be viewed.)
        self.e_pass.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        self.e_pass.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY, "Show / hide password")
        self.e_pass.set_icon_activatable(Gtk.EntryIconPosition.SECONDARY, True)
        self.e_pass.connect("icon-press", self._toggle_pw)
        self.e_dom    = Gtk.Entry(text=profile_get("DOMAIN") or conf_get("DOMAIN"))
        self.c_sec    = Gtk.ComboBoxText()
        for s in ("nla", "tls", "rdp"):
            self.c_sec.append_text(s)
        cur = (conf_get("SECURITY", "nla") or "nla").lower()
        self.c_sec.set_active({"nla": 0, "tls": 1, "rdp": 2}.get(cur, 0))
        # Display size: fixes "everything is tiny" on a hi-res panel. Live-adjustable
        # so no rebuild is ever needed to get a comfortable size.
        self.c_scale = Gtk.ComboBoxText()
        self.scale_opts = [("Auto (recommended)", "auto"), ("100% — native", "100"),
                           ("125%", "125"), ("150%", "150"), ("175%", "175"),
                           ("200%", "200"), ("Zoom to fit", "fit")]
        for _lbl, _v in self.scale_opts:
            self.c_scale.append_text(_lbl)
        _ds = (conf_get("DISPLAY_SCALE", "auto") or "auto").lower()
        self.c_scale.set_active(next((i for i, (_l, v) in enumerate(self.scale_opts) if v == _ds), 0))
        # Video codec: H.264 GFX fixes blurry full-motion video. Live-adjustable.
        self.c_video = Gtk.ComboBoxText()
        self.video_opts = [("Auto (H.264)", "auto"), ("High — sharpest (4:4:4)", "avc444"),
                           ("Balanced (4:2:0)", "avc420"), ("Compatibility (no H.264)", "off")]
        for _lbl, _v in self.video_opts:
            self.c_video.append_text(_lbl)
        _vg = (conf_get("GFX_CODEC", "auto") or "auto").lower()
        self.c_video.set_active(next((i for i, (_l, v) in enumerate(self.video_opts) if v == _vg), 0))
        # Credentials are ADMIN-MANAGED and never shown to the operator — there are
        # NO input fields. Instead a status label shows whether the admin has added
        # credentials, and Connect uses the managed profile. The widgets built above
        # still exist (they hold the values on_connect reads: port/domain/security/
        # display/video from config, and the masked host/user) — they're simply never
        # displayed, so the operator can neither see nor change any of it.
        self.cred_status = Gtk.Label(); self.cred_status.set_xalign(0)
        self.cred_status.set_line_wrap(True)
        self.cred_status.set_margin_top(2)
        self.cred_status.get_style_context().add_class("credstatus")
        # (packed near the top of the card in the final layout block below)

        # --- Connect: the full-width hero button ---
        connect = Gtk.Button(label="Connect"); connect.get_style_context().add_class("connect")
        connect.connect("clicked", self.on_connect)
        connect.set_hexpand(True); connect.set_halign(Gtk.Align.FILL)
        self.connect_btn = connect   # refresh_lan disables it while admin-locked

        # --- Shut down (bottom-left) + version footer (bottom-right) share one row ---
        shutdown = Gtk.Button(label="Shut down")
        shutdown.set_image(Gtk.Image.new_from_icon_name("system-shutdown-symbolic", Gtk.IconSize.BUTTON))
        shutdown.set_always_show_image(True)
        shutdown.get_style_context().add_class("danger")   # dark red — destructive
        shutdown.connect("clicked", lambda *_: subprocess.call(["sudo", "-n", "systemctl", "poweroff"]))
        # Version footer so a tech can read off which OS build the device is running.
        _ver = "0.0.0"
        try:
            _ver = open("/opt/thinclient/VERSION").read().strip() or _ver
        except OSError:
            pass
        verfoot = Gtk.Label(label="Thin Client  ·  v%s" % _ver)
        verfoot.get_style_context().add_class("verfoot"); verfoot.set_xalign(1.0)
        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        bottom.pack_start(shutdown, False, False, 0)
        bottom.pack_end(verfoot, False, False, 0)
        # (Support chat is reached via the always-on floating bubble bottom-right,
        # or Ctrl+Alt+Shift+C — no home-screen button needed.)

        # === Final single-column order. Title / subtitle / lock-banner are already
        # packed above; here come the credential status + big Connect FIRST, then the
        # live network status, the local controls, and the shutdown/version footer. ===
        card.pack_start(self.cred_status, False, False, 0)
        card.pack_start(connect, False, False, 0)
        card.pack_start(self._net_bar, False, False, 0)
        card.pack_start(self._sliders, False, False, 0)
        card.pack_start(self._dbar, False, False, 0)
        card.pack_start(bottom, False, False, 0)

        self.e_pass.connect("activate", self.on_connect)  # Enter in password = connect
        self._net_probing = False
        self.refresh_lan()
        self._refresh_creds()                               # set the credential status label now
        GLib.timeout_add_seconds(5, self._refresh_creds)    # ON-THE-FLY: re-read managed creds (no restart)
        GLib.timeout_add_seconds(4, self.refresh_lan)       # live LAN dot (probe off-thread)
        self._refresh_netspeed()
        GLib.timeout_add_seconds(5, self._refresh_netspeed) # live internet speed/latency
        self.refresh_devices()
        GLib.timeout_add_seconds(30, self.refresh_devices)  # camera/mic (rare hotplug)
        # --- Deferrable software-update prompt ---
        self._upd_dialog = None
        try:
            self._max_skips = max(0, int(conf_get("UPDATE_MAX_SKIPS", "3") or 3))
        except ValueError:
            self._max_skips = 3
        try:
            self._prompt_interval = max(0.0, float(conf_get("UPDATE_PROMPT_HOURS", "4") or 4)) * 3600
        except ValueError:
            self._prompt_interval = 4 * 3600
        GLib.timeout_add_seconds(3, self._initial_update_check)   # shortly after boot
        GLib.timeout_add_seconds(300, self._check_update)         # re-offer while idle
        self.connect("destroy", Gtk.main_quit)

    def _refresh_creds(self):
        """Re-read the admin-managed RDP profile LIVE (so a manager credential change
        applies on the fly — no restart) and update the status label + Connect state.
        Green = the admin has added credentials; red = none yet."""
        self._managed = managed_rdp()
        m = self._managed
        self._real_host = (m["host"] if m else (profile_get("SERVER_IP") or conf_get("SERVER_IP"))) or ""
        self._real_user = (m["user"] if m else (profile_get("USERNAME") or conf_get("USERNAME"))) or ""
        self._has_creds = bool(self._real_host and self._real_user)
        ctx = self.cred_status.get_style_context()
        ctx.remove_class("cred-ok"); ctx.remove_class("cred-none")
        if self._has_creds:
            ctx.add_class("cred-ok")
            self.cred_status.set_text("●  Credentials configured — press Connect to start")
        else:
            ctx.add_class("cred-none")
            self.cred_status.set_text("●  No credentials yet — ask your administrator to add them")
        if hasattr(self, "connect_btn"):
            self.connect_btn.set_sensitive(license_block_reason() is None and self._has_creds)
        return True   # keep the timer running

    def refresh_lan(self):
        # Admin lock: show a prominent RED banner at the TOP + block Connect. The
        # network status below still reflects the real link.
        locked = license_block_reason()
        if hasattr(self, "connect_btn"):
            # Connect needs BOTH: not admin-locked AND admin-added credentials present.
            self.connect_btn.set_sensitive(locked is None and getattr(self, "_has_creds", False))
        if locked:
            self.lock_banner.set_text(locked); self.lock_banner.show()
        else:
            self.lock_banner.hide()
        # Probe the network OFF the UI thread — nmcli can block for seconds on a
        # slow stack and would otherwise freeze the whole home screen. Guarded so
        # a slow probe can't pile up behind the 4s timer. (_apply_net owns the dot.)
        if not self._net_probing:
            self._net_probing = True
            threading.Thread(target=self._net_probe, daemon=True).start()
        return True  # keep the timer running

    def _net_probe(self):
        # Off the UI thread: is the link up, and is the INTERNET actually reachable?
        # A link can be "connected" (cable in, Wi-Fi associated) yet have no working
        # internet — dead switch, captive portal, ISP/router down, no DHCP route —
        # in which case the device can't reach its server OR the manager.
        kind = net_status()
        online = _internet_up() if kind else False
        GLib.idle_add(self._apply_net, kind, online)

    def _apply_net(self, kind, online):
        self._net_probing = False
        ctx = self.dot.get_style_context()
        for c in ("dot-green", "dot-amber", "dot-red"):
            ctx.remove_class(c)
        if not kind:
            ctx.add_class("dot-red")
            self.lan_lbl.set_text("No network — click Wi-Fi to connect")
        elif online:
            ctx.add_class("dot-green")
            self.lan_lbl.set_text("Internet connected (%s)" % ("LAN" if kind == "lan" else "Wi-Fi"))
        else:
            # Link up but the internet isn't working — the honest, actionable state.
            ctx.add_class("dot-amber")
            self.lan_lbl.set_text("%s connected — but no internet. Check the cable/router."
                                  % ("LAN" if kind == "lan" else "Wi-Fi"))
        return False

    def _refresh_netspeed(self):
        """Show the device's internet speed + live latency to the RDP server,
        color-coded with the SAME thresholds as the manager. The value is published
        by the agent to /run/thinclient/net-speed, so the device and the manager
        always show the same figure (both derive from one measurement)."""
        try:
            d = {}
            for line in open("/run/thinclient/net-speed"):
                if "=" in line:
                    k, v = line.strip().split("=", 1); d[k] = v
            mbps = int(d.get("MBPS", "0"))
            lat = int(d.get("LATENCY_MS", "-1"))
            loss = int(d.get("LOSS_PCT", "-1"))
            ts = int(d.get("TS", "0"))
            if time.time() - ts > 120:          # agent not updating -> hide
                self.net_lbl.set_text(""); return True
            color = "#3fb950" if mbps >= NET_GREEN else ("#d29922" if mbps >= NET_AMBER else "#f85149")
            txt = "Internet: %d Mbps" % mbps
            if loss and loss > 0:
                txt += " · %d%% loss" % loss; color = "#f85149"
            elif lat >= 0:
                txt += " · %d ms" % lat
            self.net_lbl.set_markup('<span foreground="%s">%s</span>' % (color, txt))
        except Exception:
            self.net_lbl.set_text("")
        return True

    def refresh_devices(self):
        # Read-only status: is a camera / microphone present? Detected at the
        # driver level. The user can see it's enabled but cannot disable capture —
        # the administrator controls recording.
        cam = bool(glob.glob("/dev/video*"))
        mic = bool(glob.glob("/proc/asound/card*/pcm*c"))
        for present, dot, lbl, on, off in (
            (cam, self.cam_dot, self.cam_lbl, "Camera enabled", "No camera"),
            (mic, self.mic_dot, self.mic_lbl, "Microphone enabled", "No microphone"),
        ):
            ctx = dot.get_style_context()
            ctx.remove_class("dot-green"); ctx.remove_class("dot-red")
            ctx.add_class("dot-green" if present else "dot-red")
            lbl.set_text(on if present else off)
        return True  # keep the timer running

    def _toggle_pw(self, entry, pos, event=None):
        vis = not entry.get_visibility()
        entry.set_visibility(vis)
        entry.set_icon_from_icon_name(
            Gtk.EntryIconPosition.SECONDARY,
            "view-conceal-symbolic" if vis else "view-reveal-symbolic")

    def on_wifi(self, *_):
        # Single instance: ignore repeat clicks while a picker window is already
        # open, so clicking Wi-Fi several times doesn't stack windows. (The flock
        # in thinclient-wifi is the backstop; this avoids even spawning a dupe.)
        if getattr(self, "_wifi_proc", None) is not None and self._wifi_proc.poll() is None:
            return
        try:
            self._wifi_proc = subprocess.Popen(["/opt/thinclient/bin/thinclient-wifi", "menu"])
        except Exception as e:
            self.msg(Gtk.MessageType.ERROR, "Wi-Fi", str(e))

    # ---------------------- Deferrable software updates ----------------------
    def _initial_update_check(self):
        self._check_update(natural=True)
        return False   # one-shot

    def _write_skip_cache(self, ver, skips, last):
        try:
            os.makedirs(os.path.dirname(SKIP_CACHE), exist_ok=True)
            with open(SKIP_CACHE, "w") as f:
                f.write("version=%s\nskips=%d\nlast_offer=%f\n" % (ver, skips, last))
        except OSError:
            pass

    def _update_action(self, ver, natural):
        """Pure decision (no UI): return ('forced'|'offer'|'wait', skips) for the
        pending version. A new version resets the skip counter. `natural`=True
        (boot / return-from-session) always offers; otherwise offer only once
        every UPDATE_PROMPT_HOURS. After UPDATE_MAX_SKIPS deferrals it is forced."""
        import time
        cache = _read_kv(SKIP_CACHE)
        if cache.get("version") == ver:
            try: skips = int(cache.get("skips", "0"))
            except ValueError: skips = 0
            try: last = float(cache.get("last_offer", "0"))
            except ValueError: last = 0.0
        else:
            skips, last = 0, 0.0                  # a new version resets the counter
            self._write_skip_cache(ver, 0, 0.0)
        if skips >= self._max_skips:
            return "forced", skips
        if natural or (time.time() - last) >= self._prompt_interval:
            return "offer", skips
        return "wait", skips

    def _check_update(self, natural=False):
        """Offer a staged update; after UPDATE_MAX_SKIPS deferrals, force it."""
        if self._upd_dialog is not None:
            return True                          # a dialog is already up
        ver = pending_update_version()
        if not ver:
            return True                          # nothing pending
        # Admin forced this update from the dashboard ("Force update now") -> apply
        # SILENTLY: no "update available?" confirmation, no skip option. Just show
        # the brief non-blocking "installing…" notice while the apply service swaps
        # + restarts the session. (Marker persists until a version is actually
        # pending, so it isn't consumed before the download finishes.)
        if os.path.exists(FORCE_SILENT_FILE):
            try: os.remove(FORCE_SILENT_FILE)
            except OSError: pass
            self._trigger_apply(ver)
            return True
        action, skips = self._update_action(ver, natural)
        if action == "forced":
            self._show_update_forced(ver)
        elif action == "offer":
            self._show_update_offer(ver, skips)
        return True

    def _show_update_offer(self, ver, skips):
        import time
        left = self._max_skips - skips
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.NONE, text="Software update available")
        d.format_secondary_text(
            "Version %s is ready to install.\n\n"
            "You can postpone %d more time%s; after that it installs "
            "automatically. It takes about a minute and the screen refreshes once."
            % (ver, left, "" if left == 1 else "s"))
        d.add_button("Remind me later", Gtk.ResponseType.CANCEL)
        d.add_button("Update now", Gtk.ResponseType.OK).get_style_context().add_class("connect")
        self._upd_dialog = d
        self._raise_dialog(d)
        resp = d.run()
        d.destroy()
        self._restore_fs()
        self._upd_dialog = None
        if resp == Gtk.ResponseType.OK:
            self._trigger_apply(ver)
        else:
            self._write_skip_cache(ver, skips + 1, time.time())

    def _show_update_forced(self, ver):
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.NONE, text="Installing required update")
        d.add_button("Update now", Gtk.ResponseType.OK).get_style_context().add_class("connect")
        state = {"left": 30, "tid": 0}
        def body(n):
            return ("Version %s will now be installed (you have postponed the "
                    "maximum number of times).\n\nInstalling in %d seconds…" % (ver, n))
        def tick():
            state["left"] -= 1
            d.format_secondary_text(body(state["left"]))
            if state["left"] <= 0:
                state["tid"] = 0
                d.response(Gtk.ResponseType.OK)
                return False
            return True
        d.format_secondary_text(body(30))
        state["tid"] = GLib.timeout_add_seconds(1, tick)
        self._upd_dialog = d
        self._raise_dialog(d)
        d.run()
        if state["tid"]:
            GLib.source_remove(state["tid"])
        d.destroy()
        self._restore_fs()
        self._upd_dialog = None
        self._trigger_apply(ver)

    def _trigger_apply(self, ver):
        try:
            subprocess.Popen(["sudo", "-n", "systemctl", "--no-block", "start",
                              "thinclient-update-apply.service"])
        except Exception as e:
            self.msg(Gtk.MessageType.ERROR, "Update failed to start", str(e))
            return
        # The apply service downloads, swaps, and restarts the session (which
        # replaces this window). Show a please-wait notice until then.
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.NONE, text="Installing update %s…" % ver)
        d.format_secondary_text("Please wait — the screen will refresh automatically "
                                "when the update is complete. Do not power off.")
        self._upd_dialog = d
        self._raise_dialog(d)   # non-blocking (show_all + raise above fullscreen);
                       # a SUCCESSFUL apply restarts the session and tears this
                       # window down (connect is killed before the failsafe below
                       # fires). Left un-fullscreened on purpose — the failsafe
                       # restores fullscreen if the apply doesn't complete.
        # Failsafe: if the apply fails or is deferred (download error, sha
        # mismatch, or a lingering RDP session), lightdm never restarts and this
        # "please wait" would sit forever ("keeps updating, never closes"). After
        # a grace period, dismiss it + re-enable the form; the update retries on
        # its own later.
        def _apply_failsafe():
            if self._upd_dialog is not d:
                return False                 # already torn down (success) or replaced
            try: d.destroy()
            except Exception: pass
            # Keep _upd_dialog pointing at the notice while its modal loop runs, so
            # the periodic _check_update (which early-returns when _upd_dialog is
            # set) cannot STACK another update dialog underneath this one.
            w = Gtk.MessageDialog(transient_for=self, modal=True,
                                  message_type=Gtk.MessageType.WARNING,
                                  buttons=Gtk.ButtonsType.OK, text="Update didn’t finish")
            w.format_secondary_text("The update couldn’t be completed just now — it will "
                                    "retry automatically later. You can keep working.")
            self._upd_dialog = w
            self._raise_dialog(w)
            w.run(); w.destroy()
            self._restore_fs()
            self._upd_dialog = None
            return False
        GLib.timeout_add_seconds(180, _apply_failsafe)

    def scale_choice(self):
        i = self.c_scale.get_active()
        return self.scale_opts[i][1] if 0 <= i < len(self.scale_opts) else "auto"

    def video_choice(self):
        i = self.c_video.get_active()
        return self.video_opts[i][1] if 0 <= i < len(self.video_opts) else "auto"

    def rdp_argv(self, host, port, user, dom, sec):
        argv = [self.rdp, "/v:%s:%s" % (host, port), "/u:%s" % user]
        if dom:
            argv.append("/d:%s" % dom)
        argv += ["/from-stdin:force", "/f", "/cert:ignore", "/sec:%s" % sec,
                 "/clipboard",
                 # Don't grab the keyboard exclusively — normal typing still goes
                 # to Windows, but the local WM's shortcuts (Super+L screen lock,
                 # admin hotkey) fire even inside the fullscreen RDP session.
                 "-grab-keyboard",
                 # Audio out (speakers) + audio in (microphone) via the local
                 # PulseAudio-compatible server (PipeWire), started by the session.
                 "/sound:sys:pulse", "/microphone:sys:pulse",
                 # Survive transient network blips: FreeRDP transparently
                 # re-establishes the session using the server's reconnect cookie
                 # (the Windows session keeps running) instead of dropping the
                 # operator to the login form. FINITE retries (not unlimited) so a
                 # real outage eventually gives up and returns the user to the home
                 # screen instead of trapping them in "reconnecting…". 15s connect
                 # timeout so a truly-dead host fails promptly.
                 "/auto-reconnect",
                 "/auto-reconnect-max-retries:%s" % (conf_get("RDP_AUTORECONNECT_RETRIES", "10") or "10"),
                 "/timeout:15000",
                 "/log-level:INFO"]
        # --- Video / GFX codec: H.264 pipeline for smooth, sharp motion video ---
        vid = self.video_choice()
        if vid == "avc444":
            argv += ["/gfx:AVC444", "/network:auto"]   # H.264 4:4:4 (sharpest, heaviest to DECODE)
        elif vid in ("auto", "avc420"):
            # DEFAULT is now 4:2:0 — roughly HALF the client-side H.264 decode cost
            # of 4:4:4, so FreeRDP is far less likely to be starved (and freeze) when
            # the box is also encoding the monitor/record streams. Picking "High
            # (4:4:4)" still forces AVC444 for anyone who wants maximum text sharpness.
            argv += ["/gfx:AVC420", "/network:auto"]   # H.264 4:2:0 (default — lighter decode)
        # vid == "off": legacy bitmap path, no /gfx (maximum compatibility)
        # --- Display sizing (all flags verified against Debian FreeRDP 3.15) ---
        choice = self.scale_choice()
        if choice == "fit":
            # Guaranteed-bigger fallback: render a comfortable logical desktop and
            # let FreeRDP scale it to fill the panel. Works even if the server
            # ignores DPI. /smart-sizing is mutually exclusive with
            # /dynamic-resolution, so we deliberately omit the latter here.
            lw, lh = (1920, 1080) if self.scr_w >= 1920 else (self.scr_w, self.scr_h)
            argv += ["/smart-sizing", "/size:%dx%d" % (lw, lh)]
        else:
            pct = auto_scale_pct(self.scr_w) if choice == "auto" else int(choice)
            argv.append("/dynamic-resolution")   # desktop matches the panel size
            if pct != 100:
                # DesktopScaleFactor (100-500) drives the server-side DPI; pair it
                # with a spec-valid DeviceScaleFactor (100/140/180) so Windows
                # actually applies the enlargement.
                dev = 100 if pct < 130 else (140 if pct < 175 else 180)
                argv += ["/scale-desktop:%d" % pct, "/scale-device:%d" % dev]
        return argv

    def on_connect(self, *_):
        blocked = license_block_reason()
        if blocked:
            self.msg(Gtk.MessageType.WARNING, "Device locked", blocked)
            return
        host = self._real_host or self.e_server.get_text().strip()
        port = self.e_port.get_text().strip() or "3389"
        user = self._real_user or self.e_user.get_text().strip()
        # Blank password in managed mode -> use the managed one (which the operator
        # can't see). If they typed something, that override wins for this session.
        pw   = self.e_pass.get_text() or (self._managed["pw"] if self._managed else "")
        dom  = self.e_dom.get_text().strip()
        sec  = self.c_sec.get_active_text() or "nla"
        if not host:
            self.msg(Gtk.MessageType.WARNING, "Missing server", "Enter the Server / IP.")
            return
        if not self.rdp:
            self.msg(Gtk.MessageType.ERROR, "FreeRDP missing", "No RDP client is installed.")
            return

        # Is this really OUR server? Checked before the password leaves the device.
        # With pinning off (the default until the manager turns it on) this returns at
        # once without any network traffic.
        verdict = server_identity_decision(host, port)
        if verdict != "allow":
            self.msg(Gtk.MessageType.ERROR, "Can’t connect safely", verdict, retry=True)
            return

        argv = self.rdp_argv(host, port, user, dom, sec)
        # Persist FreeRDP's own output where GETLOGS captures it (-> tc-rdp.log),
        # rotating the previous session to rdp.prev.log — so a call-time freeze leaves
        # its trail behind (the old random temp file was deleted on exit + never seen).
        rdp_log = os.path.join(LOGDIR, "rdp.log")
        try:
            os.makedirs(LOGDIR, exist_ok=True)
            if os.path.exists(rdp_log):
                os.replace(rdp_log, os.path.join(LOGDIR, "rdp.prev.log"))
            out = open(rdp_log, "wb")
        except OSError:
            rdp_log = ""
            out = tempfile.NamedTemporaryFile(prefix="rdp-", suffix=".log", delete=False,
                                              dir=os.environ.get("TC_RUN_DIR", "/tmp"))
        self.hide()
        while Gtk.events_pending():
            Gtk.main_iteration()
        import time
        t0 = time.time()
        _rdp_signal(True)          # mark session live (activity: working hours)
        # ONE FreeRDP session — no outer relaunch loop. In-session network blips are
        # healed by FreeRDP's own /auto-reconnect (finite retries) WITHOUT exiting,
        # so a brief drop no longer kicks an operator off a call. When FreeRDP DOES
        # exit — the user disconnected/logged off, or a reconnect finally gave up —
        # we return to the connect/home screen and do NOT pull them back in. (The
        # earlier auto-relaunch loop reconnected on ANY non-zero exit, incl. a
        # deliberate disconnect/logoff, so users could never leave the RDP session.)
        self._link_lost = False
        try:
            proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=out, stderr=out)
            # Watch the link in the background: a half-dead connection can leave
            # FreeRDP "connected" but frozen (no clean TCP close, so its own
            # auto-reconnect never fires). The monitor drops such a stalled session
            # so the operator gets a clear "Connection lost" screen, not a freeze.
            mon = threading.Thread(target=self._link_monitor, args=(proc, host, port), daemon=True)
            mon.start()
            proc.communicate(input=(pw + "\n").encode(), timeout=None)
            rc = proc.returncode
        except Exception as e:
            rc = -1
            out.write(("launch error: %s\n" % e).encode())
        finally:
            _rdp_signal(False)     # session ended
        out.flush(); out.close()
        dur = time.time() - t0
        # Remember the connection ONLY on a genuine success, so we never clobber a
        # known-good saved profile with bad credentials. Require BOTH a clean
        # FreeRDP exit (rc == 0 — non-zero covers connect-timeouts to a wrong host
        # and NLA/TLS/RDP auth rejections) AND a real session duration (a fast
        # NLA reject exits <8s). A failed attempt is NOT saved, and the fields keep
        # what was typed so the operator can fix them; the password persists in the
        # field across a disconnect (not cleared). In MANAGED mode we never save
        # locally — the server profile is the source of truth and any operator
        # override must revert on restart.
        if rc == 0 and dur >= 8 and not self._managed:
            save_profile(host, port, user, pw, dom)
        self.show_all()
        self.refresh_lan()
        # Decide what the operator sees. Priority:
        #  1) the link monitor dropped a STALLED session, OR a session that ran a
        #     while then ended with the server now unreachable  -> "Connection lost"
        #     (clearly a network/internet issue, not a stuck machine) + Reconnect.
        #  2) a FAST exit (<8s) -> a plain-language connect error + Try again.
        #  3) a clean disconnect with the network fine -> just the connect screen.
        froze = _consume_freeze_mark()
        # Freeze AUTO-recovery: the agent reset a hung FreeRDP. Reconnect on our own —
        # no operator action — with a brief notice. Loop-guarded: a persistently
        # freezing session falls back to the manual Reconnect screen (never spins).
        if froze and self._froze_reconnect():
            try:
                if out.name != rdp_log:
                    os.unlink(out.name)
            except OSError:
                pass
            return
        if froze or getattr(self, "_link_lost", False) or (dur >= 8 and _link_dead(host, port)):
            self._conn_lost(host, port, froze=froze)
        elif dur < 8:
            try:
                detail = open(out.name).read()[-4000:]
            except OSError:
                detail = "(no output captured)"
            _log_rdp_error(host, port, user, rc, detail)
            self.msg(Gtk.MessageType.ERROR, "Can’t connect right now",
                     _friendly_rdp_error(rc, detail), retry=True)
        try:
            if out.name != rdp_log:   # keep the persistent tc-rdp.log for freeze diagnostics
                os.unlink(out.name)
        except OSError:
            pass
        # Back at the connect screen (safe, no RDP running) — a good moment to
        # offer any pending update.
        self._check_update(natural=True)

    def _link_monitor(self, proc, host, port):
        """Runs while an RDP session is live. If the remote server stops being
        reachable for a sustained window WHILE FreeRDP is still 'alive' (a stalled
        half-dead link that FreeRDP's own /auto-reconnect never noticed), drop the
        session so the operator gets a clear 'Connection lost' screen + Reconnect,
        instead of staring at a frozen desktop."""
        PROBE_EVERY = 5.0
        NEED_FAILS = 4          # sustained loss (~25-35s) before dropping the session
        fails = 0
        try:
            while proc.poll() is None:
                time.sleep(PROBE_EVERY)
                if proc.poll() is not None:
                    break
                if not _link_dead(host, port):
                    fails = 0
                    continue
                fails += 1
                if fails >= NEED_FAILS:
                    self._link_lost = True
                    _log_rdp_error(host, port, "", "stall",
                                   "link monitor: internet + %s:%s unreachable while session alive -> dropping stalled session"
                                   % (host, port))
                    try: proc.terminate()
                    except Exception: pass
                    break
        except Exception:
            pass

    def _froze_reconnect(self) -> bool:
        """Freeze AUTO-recovery: the agent reset a hung FreeRDP. Reconnect on our own —
        NO confirmation, NO button — after a brief on-screen notice so the operator
        sees WHY. Loop-guarded: if it keeps freezing (>3 in 2 min) return False so the
        caller shows the manual Reconnect screen instead of spinning on a broken box."""
        import time as _time
        now = _time.time()
        self._froze_ts = [t for t in getattr(self, "_froze_ts", []) if now - t < 120] + [now]
        if len(self._froze_ts) > 3:
            return False
        note = None
        try:
            note = Gtk.MessageDialog(transient_for=self, modal=False,
                                     message_type=Gtk.MessageType.INFO,
                                     buttons=Gtk.ButtonsType.NONE,
                                     text="Remote session froze — reconnecting…")
            note.set_keep_above(True)
            note.show_all()
            while Gtk.events_pending():        # paint it right away
                Gtk.main_iteration()
        except Exception:
            note = None
        def _go():
            if note is not None:
                try: note.destroy()
                except Exception: pass
            self.on_connect()                   # relaunch automatically
            return False
        GLib.timeout_add(800, _go)              # quick — ~0.8s notice, then reconnect
        return True

    def _conn_lost(self, host, port, froze=False):
        """A clear, reassuring 'Connection lost' screen with a Reconnect button —
        so the operator knows the machine ISN'T stuck, it's the network. When the
        agent reset a FROZEN remote desktop, say exactly that instead — the machine
        is fine, the remote session had hung, and their server-side work is safe."""
        if froze:
            self.msg(Gtk.MessageType.WARNING, "Session reset",
                     "The remote desktop stopped responding, so it was reset for you.\n\n"
                     "This computer is working fine — the remote session had frozen. Your work "
                     "on the server is safe and still there.\n\n"
                     "Press Reconnect to pick up where you left off.",
                     retry=True, retry_label="Reconnect")
            return
        if _net_state() == "none":
            text = ("This device lost its internet connection.\n\n"
                    "This is a network problem — NOT a problem with this computer, and your "
                    "remote session is safe. It will come back as soon as you reconnect.\n\n"
                    "Check your Wi‑Fi or network cable, then press Reconnect.")
        else:
            text = ("The connection to the remote computer dropped.\n\n"
                    "This is usually an internet or network issue — NOT a problem with this "
                    "computer, and your remote session is safe. It resumes when you reconnect.\n\n"
                    "Press Reconnect to continue.")
        self.msg(Gtk.MessageType.WARNING, "Connection lost", text, retry=True, retry_label="Reconnect")

    def _raise_dialog(self, d):
        """Make a modal dialog actually reachable. The connect window is GTK-
        fullscreen, and under this kiosk's openbox the fullscreen stacking layer
        outranks the "above" layer — so a plain transient dialog renders BEHIND
        the fullscreen form and its buttons can't be clicked (the modal grab then
        freezes the visible form: "update window disabled until restart"). Drop
        the parent out of fullscreen while the dialog is up and pin the dialog
        above, so it maps on top and takes clicks. Pair with _restore_fs()."""
        try:
            d.set_transient_for(self)
            d.set_modal(True)
            d.set_keep_above(True)
            self.unfullscreen()        # leave openbox's fullscreen layer
            d.show_all()
            d.present()                # focus + raise onto the top of the stack
        except Exception:
            pass

    def _restore_fs(self):
        try:
            self.maximize()   # re-fill the screen (kiosk uses maximize, not fullscreen)
        except Exception:
            pass

    def _clock_tick(self):
        # Re-resolve the zone only every ~15s (realpath + tzset are wasted work run
        # 60x/min for a minutes-only clock); still catches the boot-time zone fix
        # and a rare mid-session change quickly enough. strftime runs every tick.
        self._clk_n = getattr(self, "_clk_n", 0) + 1
        if os.environ.get("TZ") is None or self._clk_n % 15 == 1:
            z = _current_zone()
            if z and os.environ.get("TZ") != z:
                os.environ["TZ"] = z
                try: time.tzset()
                except Exception: pass
        # 12-hour clock ("2:32 PM"); lstrip drops the leading zero.
        self.clock.set_text(time.strftime("%I:%M %p").lstrip("0"))
        self.clockdate.set_text(time.strftime("%A, %d %B · %Z"))
        return True

    def _make_slider_row(self, icon_name, on_change, init_value):
        """Build a control row: [icon] [−] [==== horizontal slider ====] [+].
        Dragging the slider or clicking −/+ calls on_change(value 0..100); the
        buttons move the slider by 5 (so slider + buttons stay in sync — the slider
        is the single source of truth). Returns (row, scale)."""
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.get_style_context().add_class("statusbar")
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON)
        dn = Gtk.Button(label="−"); dn.get_style_context().add_class("vol"); dn.set_tooltip_text("Decrease")
        up = Gtk.Button(label="+"); up.get_style_context().add_class("vol"); up.set_tooltip_text("Increase")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        scale.set_draw_value(False); scale.set_hexpand(True)
        scale.set_value(init_value)                 # set BEFORE connect -> no spurious fire
        scale.connect("value-changed", lambda s: on_change(s.get_value()))
        dn.connect("clicked", lambda *_: scale.set_value(max(0, scale.get_value() - 5)))
        up.connect("clicked", lambda *_: scale.set_value(min(100, scale.get_value() + 5)))
        row.pack_start(icon, False, False, 0)
        row.pack_start(dn, False, False, 0)
        row.pack_start(scale, True, True, 0)
        row.pack_start(up, False, False, 0)
        return row, scale

    def _set_volume(self, v):
        """Set the default PipeWire sink to v% (0..100). Unmutes first so raising
        from a muted state produces sound. Best-effort (no-op if wpctl not ready)."""
        try:
            subprocess.call(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"])
            subprocess.call(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "%.2f" % (v / 100.0)])
        except Exception:
            pass

    def _get_volume(self):
        """Current sink volume as 0..100 (default 50 if unavailable)."""
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                                 capture_output=True, timeout=3).stdout.decode("utf-8", "replace")
            m = re.search(r"([0-9]+\.[0-9]+)", out)   # "Volume: 0.65 [MUTED]"
            if m:
                return max(0, min(100, round(float(m.group(1)) * 100)))
        except Exception:
            pass
        return 50

    def _set_brightness(self, v):
        """Set screen brightness to v% (clamped 5..100). Prefer a real hardware
        backlight (laptop/AIO panel, writable by the video group via udev); fall
        back to a software dim via xrandr so an external monitor still responds."""
        v = max(5, min(100, int(v)))
        for bl in glob.glob("/sys/class/backlight/*"):
            try:
                mx = int(open(os.path.join(bl, "max_brightness")).read().strip())
                with open(os.path.join(bl, "brightness"), "w") as f:
                    f.write(str(max(1, int(mx * v / 100.0))))
                return                              # hardware backlight set — done
            except Exception:
                pass
        factor = max(0.2, min(1.0, v / 100.0))      # xrandr can't exceed the panel max
        try:
            out = subprocess.run(["xrandr", "--query"], capture_output=True, timeout=3).stdout.decode("utf-8", "replace")
            for ln in out.splitlines():
                if " connected" in ln:
                    subprocess.call(["xrandr", "--output", ln.split()[0], "--brightness", "%.2f" % factor])
        except Exception:
            pass

    def _get_brightness(self):
        """Current brightness as 0..100. Reads a hardware backlight if present;
        otherwise 100 (xrandr software brightness resets to full each X start)."""
        for bl in glob.glob("/sys/class/backlight/*"):
            try:
                cur = int(open(os.path.join(bl, "brightness")).read().strip())
                mx = int(open(os.path.join(bl, "max_brightness")).read().strip())
                if mx > 0:
                    return max(5, min(100, round(cur * 100.0 / mx)))
            except Exception:
                pass
        return 100

    def msg(self, kind, title, text, retry=False, retry_label="Try again"):
        buttons = Gtk.ButtonsType.NONE if retry else Gtk.ButtonsType.OK
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=kind, buttons=buttons, text=title)
        d.format_secondary_text(text)
        if retry:
            d.add_button("Close", Gtk.ResponseType.CLOSE)
            ok = d.add_button(retry_label, Gtk.ResponseType.OK)
            ok.get_style_context().add_class("suggested-action")   # blue primary
            d.set_default_response(Gtk.ResponseType.OK)
        self._raise_dialog(d)
        resp = d.run(); d.destroy()
        self._restore_fs()
        if retry and resp == Gtk.ResponseType.OK:
            GLib.idle_add(self.on_connect)   # re-attempt after the dialog closes

if __name__ == "__main__":
    win = Connect()
    # Lock the screen BEFORE revealing the connect form (login-before-desktop).
    # The window is created but stays hidden until the user unlocks.
    _lock_on_startup()
    win.show_all()
    # Re-assert maximize after the window is mapped — the initial maximize() in
    # __init__ can be dropped if the WM wasn't managing yet; without this the form
    # can appear as a small top-left box. Belt-and-suspenders with the WM keepalive
    # in thinclient-xsession. (Maximize, not fullscreen — see Connect.__init__.)
    win.maximize()
    GLib.timeout_add(400, lambda: (win.maximize(), False)[1])
    Gtk.main()
