# =============================================================================
#  ThinClient OS — X wrapper policy
#  Installed to: /etc/X11/Xwrapper.config
#
#  The kiosk X server is launched by a systemd service (not from an interactive
#  console login), so the default "console" restriction must be relaxed to
#  "anybody". needs_root_rights=yes lets Xorg touch the KMS/DRM devices on VT7.
# =============================================================================
allowed_users=anybody
needs_root_rights=yes
