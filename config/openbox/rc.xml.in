<?xml version="1.0" encoding="UTF-8"?>
<!--
  ThinClient OS — Openbox configuration TEMPLATE
  Rendered to ~/.config/openbox/rc.xml at session start by thinclient-xsession.
  @@ADMIN_HOTKEY@@ is substituted from ADMIN_HOTKEY in /etc/thinclient/admin.conf.

  Design goals:
    * The ONLY keybinding is the hidden admin hotkey. Everything else
      (Alt+Tab, Alt+F4, window menus, workspace switching) is intentionally
      absent, so those shortcuts do nothing.
    * The desktop right-click menu is disabled — there is no menu to reach.
    * Every window is undecorated, maximized, focused and kept below-nothing,
      so the FreeRDP window is effectively borderless fullscreen.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <resistance>
    <strength>0</strength>
    <screen_edge_strength>0</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <popupTime>0</popupTime>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>

  <!-- Keyboard: the hidden admin hotkey + the user screen-lock (Super+L). -->
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <keybind key="@@ADMIN_HOTKEY@@">
      <action name="Execute">
        <command>/opt/thinclient/bin/thinclient-adminmode</command>
      </action>
    </keybind>
    <!-- Win+L locks the screen (a password unlocks it). -->
    <keybind key="W-l">
      <action name="Execute">
        <command>/opt/thinclient/bin/thinclient-lock</command>
      </action>
    </keybind>
    <!-- Ctrl+Alt+Shift+R = recover a FROZEN RDP session. FreeRDP occasionally
         hangs on its H.264/GFX pipeline (spins, stops painting) but stays alive,
         so the watchdog can't tell it's stuck. openbox still gets this key
         (FreeRDP runs with -grab-keyboard OFF), so the operator can kill the hung
         client themselves and drop back to the home screen to reconnect — no
         power-cycle, no waiting for an admin. -->
    <keybind key="C-A-S-r">
      <action name="Execute">
        <command>sh -c 'pkill -x xfreerdp3; pkill -x xfreerdp'</command>
      </action>
    </keybind>
    <!-- Ctrl+Alt+Shift+C opens the support chat with the admin — works over the
         RDP session (keyboard isn't grabbed) so the operator can ask for help
         mid-call without leaving Windows. -->
    <keybind key="C-A-S-c">
      <action name="Execute">
        <command>/opt/thinclient/bin/thinclient-chat --open</command>
      </action>
    </keybind>
  </keyboard>

  <!-- Mouse: no desktop menu, no window controls, no drag-to-move. -->
  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>0</doubleClickTime>
    <screenEdgeWarpTime>0</screenEdgeWarpTime>
    <context name="Desktop"></context>
    <context name="Root"></context>
    <context name="Titlebar"></context>
    <context name="Frame"></context>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
      </mousebind>
    </context>
  </mouse>

  <!-- Borderless everything, but do NOT force-fullscreen every window. The
       kiosk's MAIN windows request their OWN fullscreen — the connect form and
       the lock via GTK fullscreen(), the RDP session via FreeRDP /f — and Openbox
       honors that. Force-fullscreening EVERY window (the old behavior) blew up
       small dialogs + yad popups (the "REC" badge, the Wi-Fi picker, the
       "Installing update" notice) into full grey screens ("N grey areas").
       Openbox centers new windows (placement center:yes), so dialogs now appear
       centered at their natural size. -->
  <applications>
    <application class="*">
      <decor>no</decor>
      <focus>yes</focus>
      <iconic>no</iconic>
    </application>
  </applications>
  <!-- Do NOT pin a layer on the wildcard above: forcing layer=normal overrode the
       recording badge's own always-on-top hint, burying the "REC" indicator behind
       the fullscreen RDP window. Without a forced layer, a window that requests
       _NET_WM_STATE_ABOVE (the badge) stays above. -->

</openbox_config>
