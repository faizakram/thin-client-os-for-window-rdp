#!/usr/bin/env bash
# =============================================================================
#  ThinClient OS — Watchdog
#  Installed to: /opt/thinclient/bin/thinclient-watchdog
#  Runs as a root systemd service (thinclient-watchdog.service).
#
#  Every WATCHDOG_INTERVAL seconds it answers the question:
#     "Is the kiosk RDP session healthy?"
#
#  Health is judged from a HEARTBEAT that thinclient-session refreshes both
#  while connected AND while waiting to reconnect. Using the heartbeat (rather
#  than a naive "is xfreerdp running?" check) means the watchdog does NOT fight
#  the launcher's own intentional reconnect pauses — but it DOES catch a hung
#  Openbox, a deadlocked launcher, or a crashed X server, and force-restarts
#  the whole graphical session so the desktop is never left exposed.
# =============================================================================
set -uo pipefail

export TC_LOGFILE="watchdog"
source "${TC_LIB_DIR:-/opt/thinclient/lib}"/thinclient-common.sh

# The graphical session is now managed by LightDM (display-manager).
X_SERVICE="lightdm.service"

interval="$(conf_get WATCHDOG_INTERVAL 5)"
[[ "$interval" =~ ^[0-9]+$ ]] && (( interval >= 1 )) || interval=5

# Consider the session dead if the heartbeat is older than this. Generous
# enough to never false-positive on a slow reconnect, tight enough to recover
# a truly wedged session within a few seconds.
stale_threshold=$(( interval * 3 ))
(( stale_threshold < 15 )) && stale_threshold=15

# After a forced restart, wait for the session to come back before judging again.
restart_grace=20

log_info "Watchdog started: interval=${interval}s stale_threshold=${stale_threshold}s"

service_active() { systemctl is-active --quiet "$X_SERVICE" 2>/dev/null; }

while :; do
  sleep "$interval"

  # Only supervise when the session service is actually enabled/active. During
  # Admin Mode (which stops lightdm) we must stay hands-off.
  if ! service_active; then
    log_debug "Session service not active; watchdog idle."
    continue
  fi

  # Health is process-based: the session is fine as long as the connection
  # window (or an active RDP session) is running. It is NOT based on a heartbeat,
  # because the connection form blocks on user input (typing) and can't beat —
  # a heartbeat check would falsely restart the session while the user types.
  session_alive=0
  if pgrep -f 'thinclient-connect' >/dev/null 2>&1 \
     || pgrep -x xfreerdp3 >/dev/null 2>&1 || pgrep -x xfreerdp >/dev/null 2>&1; then
    session_alive=1
  fi
  # Also require the X server itself to be up. Match BOTH 'Xorg' and '/usr/bin/X'
  # (LightDM often launches the server as 'X') — a strict 'pgrep -x Xorg' would
  # falsely report the session dead and restart LightDM in a loop.
  x_alive=0
  pgrep -f '[/ ]Xorg' >/dev/null 2>&1 && x_alive=1
  pgrep -f '[/ ]X ' >/dev/null 2>&1 && x_alive=1
  pgrep -x X >/dev/null 2>&1 && x_alive=1

  if (( session_alive == 0 )) || (( x_alive == 0 )); then
    log_warn "Unhealthy session: session_alive=${session_alive} x_alive=${x_alive} state=$(tc_get_state). Restarting ${X_SERVICE}."
    pkill -TERM -f 'xfreerdp' 2>/dev/null || true
    systemctl restart "$X_SERVICE" 2>/dev/null || log_error "Failed to restart ${X_SERVICE}"
    log_info "Restart issued; holding ${restart_grace}s for recovery."
    sleep "$restart_grace"
  else
    # NOTE: do not reference undefined vars here — 'set -u' would crash the
    # watchdog on every healthy tick (systemd would then restart it forever).
    log_debug "Healthy: session_alive=1 x_alive=1 state=$(tc_get_state)"
  fi
done
