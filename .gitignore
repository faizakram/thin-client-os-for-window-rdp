# --- Secrets (never commit) --------------------------------------------------
RDP-creds.txt
*.creds
*.secret

# --- Build artifacts ---------------------------------------------------------
build/
iso/*.iso
iso/*.iso.sha256

# --- Editor / OS cruft -------------------------------------------------------
.DS_Store
*.swp
config/server.conf
update-signing-key.pem
*.tar.gz

# OTA release bundles produced by make-update-bundle.sh
dist/
tmp/*

# Python bytecode — build output, never source.
__pycache__/
*.pyc

# Build-machine settings (manager URL etc.) — never in the public source
config/build.local.env

# Phase B signing keys (boot-signing MOK + TPM PCR policy) — build host ONLY, never committed
keys/
build-phaseb/
build-phaseb-debug/
