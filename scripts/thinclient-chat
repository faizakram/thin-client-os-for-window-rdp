#!/usr/bin/env python3
# =============================================================================
#  ThinClient OS - support chat (operator <-> admin)
#  Installed to: /opt/thinclient/bin/thinclient-chat
#
#  A persistent, always-on floating LAUNCHER bubble in the bottom-right corner
#  (like a website chat widget) - visible on the desktop AND over the full
#  screen RDP session. Clicking it opens a clean chat panel; a red badge shows
#  unread admin replies.
#
#     thinclient-chat            -> run the launcher (started by the session)
#     thinclient-chat --open     -> ask the running launcher to open the panel
#
#  Two render paths, chosen automatically:
#     * pycairo present  -> a true, shaped, round gradient bubble (X-Shape, so
#                           it floats over any background without a compositor)
#     * no pycairo       -> a solid accent tile launcher (opaque, no dark
#                           corners over RDP) - same behaviour, still premium
#
#  Pure UI over a local store that thinclient-agent syncs with the manager:
#     log:    /var/lib/thinclient/chat/log.jsonl   (agent-written, both ways)
#     outbox: /run/thinclient/chat-outbox/         (we drop; agent sends + logs)
#     unread: /run/thinclient/chat-unread          (count; cleared when opened)
#     open:   /run/thinclient/chat-open            (touch to open the panel)
# =============================================================================
import gi, json, math, os, sys, time, fcntl
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango, GdkPixbuf   # noqa: E402
try:
    import cairo   # pycairo (python3-cairo/-gi-cairo) -> shaped round bubble
    HAVE_CAIRO = True
except Exception:
    HAVE_CAIRO = False

CHAT_DIR = "/var/lib/thinclient/chat"
CHAT_LOG = os.path.join(CHAT_DIR, "log.jsonl")
CHAT_OUTBOX = "/run/thinclient/chat-outbox"
CHAT_UNREAD = "/run/thinclient/chat-unread"
CHAT_OPEN = "/run/thinclient/chat-open"
CHAT_ACTIVE = "/run/thinclient/chat-active"   # touched while the panel is open -> agent polls chat fast
CHAT_TYPING = "/run/thinclient/chat-typing"          # we touch this while the operator types
CHAT_ADMIN_TYPING = "/run/thinclient/chat-admin-typing"  # agent writes this when an admin is typing
LOCK = "/run/thinclient/.chat-launcher.lock"
LOCK_SIGNAL = "/run/thinclient/locked"   # present while the screen lock GUI is up
POS_FILE = os.path.expanduser("~/.thinclient-chat-pos")   # where the user parked the bubble

# ---- palette (deliberate: deep navy ground, blue->violet accent) ------------
C_GROUND = "#0b1120"
C_SURFACE = "#141d33"
C_THEM = "#212d4d"
C_TEXT = "#eaf0fb"
C_MUTED = "#93a1c0"
C_A1 = (0x3d, 0x7b, 0xf5)   # accent start (blue)
C_A2 = (0x6d, 0x5e, 0xfc)   # accent end   (violet)
C_BADGE = (0xff, 0x4d, 0x4f)

# Standard emoji palette for the composer + the quick-reaction set (must match
# the manager's REACTIONS list so a reaction round-trips).
EMOJIS = ["😀", "😂", "😊", "😍", "👍", "👎", "❤️", "🙏",
          "🎉", "😄", "😢", "😡", "😮", "🤔", "👏", "🔥"]
REACTIONS = ["👍", "👎", "❤️", "😂", "😮", "😢", "😡", "🙏"]


def _hx(rgb):
    return "#%02x%02x%02x" % rgb


