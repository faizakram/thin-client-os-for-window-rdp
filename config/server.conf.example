# =============================================================================
#  ThinClient OS  —  Remote Server Configuration
#  Location on target system: /etc/thinclient/server.conf
# =============================================================================
#
#  This is the ONLY file an administrator needs to edit to point the thin
#  client at a different Windows RDP server. Changing a value here and
#  restarting the session (or rebooting) immediately changes the target.
#  No code changes are ever required.
#
#  Format ......: KEY=VALUE  (INI-style, one per line)
#  Booleans ....: true / false   (also accepts: 1/0, yes/no, on/off)
#  Comments ....: lines beginning with '#'
#  Secrets .....: PASSWORD is optional here; if left blank the user is
#                 prompted on-screen. If set, this file MUST be root-owned
#                 and chmod 600 (the installer enforces this).
# =============================================================================

# ------------------------------- Connection ---------------------------------
# IPv4/hostname of the Windows Development Server and the RDP port.
SERVER_IP=192.168.1.20
PORT=3389

# Credentials. Leave PASSWORD empty to prompt the user interactively.
# NOTE: a stored password is baked into the image and is recoverable from the
# raw disk. NLA+TLS below keep it off the wire, but treat any built image as a
# secret. Prefer a least-privilege RDP account over Administrator where possible.
USERNAME=developer
PASSWORD=
DOMAIN=

# ------------------------------- Network ------------------------------------
# Wired ethernet always auto-connects (DHCP) with no configuration.
#
# WiFi: optionally bake a default network here so every machine auto-joins with
# zero interaction. Leave blank for wired-only, or to rely purely on the
# on-screen WiFi picker. WIFI_PSK is stored in the image (root-only), so treat
# built images as secrets. Leave WIFI_PSK blank for an open network.
WIFI_SSID=
WIFI_PSK=

# If there is still no network after this many seconds (ethernet/baked-WiFi/DHCP
# had their chance), the locked-down WiFi picker appears so anyone at the machine
# can join a network. The picker can ONLY join WiFi — no desktop is exposed.
NETWORK_GRACE=20

# ------------------------------- Display ------------------------------------
# FULLSCREEN   true  -> borderless fullscreen on the primary monitor
# MULTIMONITOR true  -> span the session across ALL connected monitors
#                       (overrides FULLSCREEN when more than one is present)
FULLSCREEN=true
MULTIMONITOR=true

# Dynamic resolution: the remote desktop resizes with the local display.
DYNAMIC_RESOLUTION=true

# DISPLAY_SCALE — default for the on-screen "Display size" control. Fixes the
# "everything is tiny" look on a high-resolution (2K/4K) panel by telling the
# server to render its UI larger (server-side DPI, stays crisp).
#   auto              -> pick from the detected resolution (4K->200, 1440p->150)
#   100|125|150|175|200 -> force that desktop scale percentage
#   fit               -> zoom the whole desktop to fill the screen (always
#                        enlarges, even if the server ignores DPI; slightly softer)
# Anyone can still change it live on the connect screen with no rebuild.
DISPLAY_SCALE=auto

# GFX_CODEC — default for the on-screen "Video" control. Full-motion video (e.g.
# YouTube in the remote browser) looks blurry without an H.264 GFX codec. This
# enables the same H.264 pipeline Windows' own RDP client uses.
#   auto | avc444 -> H.264 4:4:4  (sharpest; sharp text AND video)  [recommended]
#   avc420        -> H.264 4:2:0  (lighter on bandwidth, slightly softer color)
#   off           -> legacy bitmap path (no H.264; maximum compatibility)
# H.264 decode ships in the image; with H.264 on we also send /network:auto so
# the server adapts bitrate to the link. Change it live on the connect screen.
GFX_CODEC=auto

# ------------------------------ Device redirection --------------------------
CAMERA=true
MICROPHONE=true
SPEAKERS=true
CLIPBOARD=true
USB=false
PRINTER=false
SMARTCARD=false

# ------------------------------ Performance / visuals -----------------------
# GPU        true -> request server-side H.264/AVC444 GFX pipeline when available
# BITMAP_CACHE / DESKTOP_COMPOSITION / FONT_SMOOTHING mirror the classic
# RDP "experience" toggles. Disable on very low-bandwidth links.
GPU=true
BITMAP_CACHE=true
DESKTOP_COMPOSITION=true
FONT_SMOOTHING=true
# NETWORK_PROFILE tunes RemoteFX/codec aggressiveness:
#   auto | modem | broadband | wan | lan
NETWORK_PROFILE=auto

# ------------------------------ Security ------------------------------------
# SECURITY  nla | tls | rdp   (NLA strongly recommended)
# CERT_POLICY  ignore | tofu  (tofu = trust-on-first-use, pins the cert)
SECURITY=nla
CERT_POLICY=tofu

# ------------------------------ Reconnect -----------------------------------
# When the RDP session ends (server reboot, network blip, logoff), the
# launcher shows "Connecting to Remote Workspace..." and retries forever.
AUTO_RECONNECT=true
RECONNECT_INTERVAL=5

# ------------------------------ Watchdog ------------------------------------
# How often (seconds) the watchdog verifies the session is alive.
WATCHDOG_INTERVAL=5

# ------------------------------ Extra flags ---------------------------------
# Any additional raw FreeRDP flags, appended verbatim to the command line.
# Advanced use only. Example: EXTRA_ARGS="/gfx-progressive /timeout:15000"
EXTRA_ARGS=
# ------------------------------ Auto-update ---------------------------------
# Pull-based OTA. When enabled, the device checks UPDATE_URL on boot + every 6h
# and verifies the SIGNED manifest against /etc/thinclient/update-pubkey.pem.
# If a newer release is found, the connect screen shows "Software update
# available"; the user may postpone it up to UPDATE_MAX_SKIPS times, after which
# it installs automatically (never during an RDP session), with health-check +
# rollback. It never touches this file or admin.conf.
#
# UPDATE_URL for GitHub Releases must point at a PUBLIC repo so assets download
# without a token (the bundle is just the /opt/thinclient scripts — no secrets):
#   https://github.com/<owner>/<releases-repo>/releases/latest/download
UPDATE_ENABLED=false
UPDATE_URL=
UPDATE_CHANNEL=stable
UPDATE_ALLOW_UNSIGNED=false

# Prompt behaviour: how many times the user may postpone before it auto-installs,
# and the minimum hours between re-offers while idle at the connect screen (boot
# and returning from a session always re-offer).
UPDATE_MAX_SKIPS=3
UPDATE_PROMPT_HOURS=4
