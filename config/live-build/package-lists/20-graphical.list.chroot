# --- X server, window manager, boot splash, kiosk UI -------------------------
xserver-xorg-core
xserver-xorg
xserver-xorg-legacy
xserver-xorg-input-all
xserver-xorg-video-all
xinit
x11-xserver-utils
x11-utils
openbox
# LightDM: robust, seat-managed X startup + autologin (replaces the hand-rolled
# xinit-on-VT service that failed to bring up Xorg on some AMD hardware).
lightdm
# GTK runtime for the connection window (thinclient-connect, python3 + GTK3).
python3
python3-gi
python3-gi-cairo
gir1.2-gtk-3.0
unclutter
feh
xterm
xdotool
yad
plymouth
plymouth-label
plymouth-themes
fonts-dejavu-core
fonts-liberation2
# GPU / video acceleration for the RDP H.264 pipeline
mesa-va-drivers
va-driver-all
libva2
libva-drm2
libva-x11-2

# Screen capture for the management agent's live-view streaming
scrot
imagemagick

# Idle auto-lock: report X idle time; the session polls it to fire the locker
# (xautolock was removed from Debian trixie)
xprintidle

# Colour emoji. Without this the chat's emoji palette and reaction chips render as
# empty boxes — DejaVu and Liberation carry no emoji glyphs — which looks like a
# broken chat when the feature was actually working all along.
fonts-noto-color-emoji
