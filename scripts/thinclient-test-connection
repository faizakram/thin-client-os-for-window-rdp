#!/usr/bin/env bash
# =============================================================================
#  ThinClient OS — Connection tester
#  Installed to: /opt/thinclient/bin/thinclient-test-connection
#
#  Non-destructive reachability + authentication probe against the configured
#  RDP server. Used by test-rdp.sh, the admin GUI's "Test Connection" button,
#  and diagnostics. Prints a human-readable report and returns:
#     0  = TCP reachable (and auth verified where possible)
#     1  = TCP reachable but RDP auth failed
#     2  = TCP unreachable
#     3  = configuration invalid
# =============================================================================
set -uo pipefail

source "${TC_LIB_DIR:-/opt/thinclient/lib}"/thinclient-common.sh
source "${TC_LIB_DIR:-/opt/thinclient/lib}"/rdp-build-args.sh 2>/dev/null || true
export TC_LOGFILE="network"

SERVER="$(conf_get SERVER_IP)"
PORT="$(conf_get PORT 3389)"
USER_NAME="$(conf_get USERNAME)"

echo "== ThinClient connection test =="
echo "Target : ${SERVER}:${PORT}"
echo "User   : ${USER_NAME:-<prompt>}"
echo

if ! tc_is_valid_host "$SERVER" || ! tc_is_valid_port "$PORT"; then
  echo "[FAIL] Configuration invalid (SERVER_IP='${SERVER}' PORT='${PORT}')."
  log_error "Connection test aborted: invalid config"
  exit 3
fi

# ---- 1. TCP reachability -----------------------------------------------------
echo -n "[1/3] TCP connect to ${SERVER}:${PORT} ... "
tcp_ok=1
if command -v nc >/dev/null 2>&1; then
  nc -z -w 5 "$SERVER" "$PORT" >/dev/null 2>&1 && tcp_ok=0
else
  # Pure-bash /dev/tcp fallback.
  timeout 5 bash -c "exec 3<>/dev/tcp/${SERVER}/${PORT}" >/dev/null 2>&1 && tcp_ok=0
fi
if (( tcp_ok == 0 )); then
  echo "OK"
  log_info "TCP reachable: ${SERVER}:${PORT}"
else
  echo "UNREACHABLE"
  log_error "TCP unreachable: ${SERVER}:${PORT}"
  echo
  echo "Diagnostics:"
  echo "  * Is the Windows server powered on and on the network?"
  echo "  * Is Remote Desktop enabled (System > Remote Desktop)?"
  echo "  * Does the Windows firewall allow inbound TCP ${PORT}?"
  echo "  * Can this client reach the subnet? (see: thinclient-netctl status)"
  exit 2
fi

# ---- 2. Latency snapshot -----------------------------------------------------
echo -n "[2/3] Round-trip latency ... "
if command -v ping >/dev/null 2>&1; then
  rtt="$(ping -c 3 -W 2 "$SERVER" 2>/dev/null | awk -F'/' '/rtt|round-trip/{print $5" ms avg"}')"
  echo "${rtt:-n/a}"
else
  echo "ping unavailable"
fi

# ---- 3. RDP authentication (best-effort) ------------------------------------
echo -n "[3/3] RDP authentication ... "
RDP_BIN="$(tc_rdp_binary 2>/dev/null || true)"
if [[ -z "$RDP_BIN" ]]; then
  echo "SKIPPED (FreeRDP not installed in this environment)"
  echo
  echo "Result: TCP reachable. Install FreeRDP to verify credentials."
  exit 0
fi

# Use FreeRDP's authentication-only handshake (no window is opened).
pw="$(conf_get PASSWORD)"
auth_args=( "/v:${SERVER}:${PORT}" "/cert:ignore" "/auth-only" "/timeout:8000" )
[[ -n "$USER_NAME" ]] && auth_args+=( "/u:${USER_NAME}" )
[[ -n "$(conf_get DOMAIN)" ]] && auth_args+=( "/d:$(conf_get DOMAIN)" )
case "$(conf_get SECURITY nla | tr '[:upper:]' '[:lower:]')" in
  tls) auth_args+=( "/sec:tls" ) ;;
  rdp) auth_args+=( "/sec:rdp" ) ;;
  *)   auth_args+=( "/sec:nla" ) ;;
esac

if [[ -n "$pw" ]]; then
  auth_args+=( "/from-stdin:force" )
  if printf '%s\n' "$pw" | timeout 15 "$RDP_BIN" "${auth_args[@]}" >>"${TC_LOG_DIR}/network.log" 2>&1; then
    echo "OK"
    log_info "RDP auth succeeded for ${USER_NAME}@${SERVER}"
    echo; echo "Result: SUCCESS — server reachable and credentials accepted."
    exit 0
  else
    echo "FAILED"
    log_warn "RDP auth failed for ${USER_NAME}@${SERVER}"
    echo; echo "Result: Server reachable but authentication failed."
    echo "  * Check USERNAME / PASSWORD / DOMAIN in $(/opt/thinclient/bin/thinclient-config path)."
    echo "  * Confirm the account is permitted for Remote Desktop on the server."
    exit 1
  fi
else
  echo "SKIPPED (no PASSWORD stored; user is prompted at connect time)"
  echo; echo "Result: TCP reachable. Credentials will be entered on-screen."
  exit 0
fi
