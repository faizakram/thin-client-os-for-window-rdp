#!/usr/bin/env bash
# =============================================================================
#  ThinClient OS — Network gate
#  Installed to: /opt/thinclient/bin/thinclient-netwait
#
#  Called by the session loop before each RDP attempt. Guarantees the machine
#  has a network before we hammer the RDP server, and drives the WiFi picker
#  when it doesn't:
#
#     online now?  -> return immediately
#     no network?  -> wait NETWORK_GRACE seconds for ethernet/baked-WiFi/DHCP
#     still none?  -> show the WiFi picker until a connection is established
#
#  A transient WiFi blip is absorbed by the grace window (NetworkManager
#  auto-reconnects), so the picker only appears on a genuine, sustained outage.
# =============================================================================
set -uo pipefail

source "${TC_LIB_DIR:-/opt/thinclient/lib}"/thinclient-common.sh
export TC_LOGFILE="network"

# Fast path: already online — the overwhelmingly common case.
tc_have_network && exit 0

grace="$(conf_get NETWORK_GRACE 20)"
[[ "$grace" =~ ^[0-9]+$ ]] || grace=20

# Grace window: give ethernet / the baked WiFi / DHCP a chance before bothering
# anyone. The "Connecting…" splash from the caller stays up during this time.
log_info "No network; waiting up to ${grace}s for auto-connect"
i=0
while (( i < grace )); do
  tc_have_network && { log_info "Network came up during grace (${i}s)"; exit 0; }
  sleep 1
  i=$((i + 1))
done

# True if any WIRED interface has carrier (an Ethernet cable is physically plugged
# and the link is up) — even before DHCP/route completes.
_eth_link() {
  local c ifc
  for c in /sys/class/net/*/carrier; do
    [[ -e "$c" ]] || continue
    ifc="${c%/carrier}"; ifc="${ifc##*/}"
    case "$ifc" in wl*|lo) continue ;; esac              # skip wifi + loopback
    [[ -e "/sys/class/net/$ifc/wireless" ]] && continue  # skip wireless
    [[ "$(cat "$c" 2>/dev/null)" == "1" ]] && return 0
  done
  return 1
}

# Sustained outage. If an Ethernet cable is plugged (link up), just WAIT for DHCP/
# route — never pop the WiFi picker ("no adapter / plug in a dongle") on a wired
# box; that message is wrong and confusing when the cable is in and simply slow to
# come up. Only launch the picker when there is genuinely NO wired link.
log_warn "Still offline after ${grace}s"
eth_wait="$(conf_get TC_ETH_WAIT 60)"; [[ "$eth_wait" =~ ^[0-9]+$ ]] || eth_wait=60
waited=0
while ! tc_have_network; do
  if _eth_link; then
    log_info "Ethernet link up, no route yet — waiting for DHCP (${waited}s)"
    sleep 2; waited=$((waited + 2))
    (( waited >= eth_wait )) && { log_warn "Ethernet up but no route after ${waited}s; proceeding"; break; }
    continue
  fi
  log_warn "No wired link; launching WiFi picker"
  /opt/thinclient/bin/thinclient-wifi picker || true
  tc_have_network && break
  sleep 2
done

log_info "Proceeding to RDP"
exit 0
