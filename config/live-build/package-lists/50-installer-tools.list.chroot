# --- Tools required by the disk installer + diagnostics ----------------------
parted
gdisk
dosfstools
e2fsprogs
rsync
squashfs-tools
grub2-common
grub-common
efibootmgr
pciutils
lshw
htop
# Bootloader binaries are architecture-specific.
#if ARCHITECTURES amd64 i386
grub-efi-amd64-bin
grub-pc-bin
# Secure Boot: signed shim + signed GRUB so the USB boots on PCs that have
# Secure Boot ENABLED (no BIOS changes needed). live-build wires the signed
# shim into the ESP automatically when these are present.
shim-signed
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
grub-efi-arm64-bin
#endif

# Encrypted installs (security plan Phase B): LUKS2 + sealing the disk key into the TPM.
# systemd-cryptenroll lives in systemd-cryptsetup on Debian, not in systemd; tpm2-tools
# brings the TSS2 libraries systemd loads to talk to the TPM. Copied onto every
# installed machine with the rest of the live system.
cryptsetup
cryptsetup-bin
systemd-cryptsetup
tpm2-tools
mokutil
